From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 01:48:24 -0400
Subject: [PATCH] Bluetooth: btbcm: add a patchram_nowait bring-up option

Add a module parameter, off by default, that sends the Write RAM records
of a patch file without waiting for a Command Complete for each, and
waits only for the final Launch RAM. It is meant for bringing up
controllers whose firmware loaders do not acknowledge every record; UART
flow control and a 1-2 ms gap per record pace the stream.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/bluetooth/btbcm.c | 21 +++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/drivers/bluetooth/btbcm.c b/drivers/bluetooth/btbcm.c
index 463d59890..bda7694ae 100644
--- a/drivers/bluetooth/btbcm.c
+++ b/drivers/bluetooth/btbcm.c
@@ -208,6 +208,11 @@ int btbcm_write_pcm_int_params(struct hci_dev *hdev,
 }
 EXPORT_SYMBOL_GPL(btbcm_write_pcm_int_params);
 
+static bool patchram_nowait;
+module_param(patchram_nowait, bool, 0644);
+MODULE_PARM_DESC(patchram_nowait,
+		 "Send patch records without waiting for each Command Complete; only Launch RAM is waited for (bring-up aid)");
+
 int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw)
 {
 	const struct hci_command_hdr *cmd;
@@ -251,6 +256,22 @@ int btbcm_patchram(struct hci_dev *hdev, const struct firmware *fw)
 
 		opcode = le16_to_cpu(cmd->opcode);
 
+		/*
+		 * Some controllers do not answer every Write RAM record. With
+		 * patchram_nowait, stream the records (UART flow control paces
+		 * the link) and wait only for the final Launch RAM.
+		 */
+		if (patchram_nowait && opcode != 0xfc4e) {
+			err = __hci_cmd_send(hdev, opcode, cmd->plen, cmd_param);
+			if (err) {
+				bt_dev_err(hdev, "BCM: Patch command %04x send failed (%d)",
+					   opcode, err);
+				return err;
+			}
+			usleep_range(1000, 2000);
+			continue;
+		}
+
 		skb = __hci_cmd_sync(hdev, opcode, cmd->plen, cmd_param,
 				     HCI_INIT_TIMEOUT);
 		if (IS_ERR(skb)) {

From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 13:59:15 -0400
Subject: [PATCH] PCI: dwc: add a gs201 modem-link bring-up driver

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 drivers/pci/controller/dwc/Kconfig         |  13 +
 drivers/pci/controller/dwc/Makefile        |   1 +
 drivers/pci/controller/dwc/pcie-gs201-cp.c | 644 +++++++++++++++++++++
 3 files changed, 658 insertions(+)
 create mode 100644 drivers/pci/controller/dwc/pcie-gs201-cp.c

diff --git a/drivers/pci/controller/dwc/Kconfig b/drivers/pci/controller/dwc/Kconfig
index 3a3f5b8b6..31de17d0e 100644
--- a/drivers/pci/controller/dwc/Kconfig
+++ b/drivers/pci/controller/dwc/Kconfig
@@ -403,6 +403,19 @@ config PCI_EXYNOS
 	  hardware and therefore the driver re-uses the DesignWare core
 	  functions to implement the driver.
 
+config PCIE_GS201_CP
+	tristate "Google gs201 PCIe for the modem (bring-up)"
+	depends on ARCH_EXYNOS || COMPILE_TEST
+	depends on OF && PCI_MSI && HAVE_ARM_SMCCC
+	select PCIE_DW
+	select EXYNOS_PMU
+	select MFD_SYSCON
+	help
+	  Bring-up driver for PCIe GEN4A_0 of Google's gs201 (Tensor G2), the
+	  link to the Samsung S5300 modem. It powers the modem through its
+	  control lines and trains the link one debugfs step at a time, for
+	  testing on a bench; it does not register a PCI host yet.
+
 config PCIE_GS201
 	tristate "Google gs201 PCIe controller (host mode)"
 	depends on OF && (ARCH_EXYNOS || COMPILE_TEST)

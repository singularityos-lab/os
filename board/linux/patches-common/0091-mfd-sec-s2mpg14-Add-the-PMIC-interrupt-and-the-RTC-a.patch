+	S2MPG14_IRQ_OCP_B8M,
+#define S2MPG14_IRQ_OCP_B1M_MASK	BIT(0)
+#define S2MPG14_IRQ_OCP_B2M_MASK	BIT(1)
+#define S2MPG14_IRQ_OCP_B3M_MASK	BIT(2)
+#define S2MPG14_IRQ_OCP_B4M_MASK	BIT(3)
+#define S2MPG14_IRQ_OCP_B5M_MASK	BIT(4)
+#define S2MPG14_IRQ_OCP_B6M_MASK	BIT(5)
+#define S2MPG14_IRQ_OCP_B7M_MASK	BIT(6)
+#define S2MPG14_IRQ_OCP_B8M_MASK	BIT(7)
+
+	/* PMIC INT5 */
+	S2MPG14_IRQ_OCP_B9M,
+	S2MPG14_IRQ_SMPL_TIMEOUT,
+	S2MPG14_IRQ_WTSR_TIMEOUT,

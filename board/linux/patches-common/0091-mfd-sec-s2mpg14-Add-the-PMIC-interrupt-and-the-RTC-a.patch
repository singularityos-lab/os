@@ -182,6 +183,41 @@ static const struct regmap_irq s2mpg12_pmic_irqs[] = {
 	REGMAP_IRQ_REG(S2MPG12_IRQ_WTSR_TIMEOUT, 4, S2MPG12_IRQ_WTSR_TIMEOUT_MASK),
 };
 

+#define S2MPG14_IRQ_RTCA1_MASK		BIT(1)
+#define S2MPG14_IRQ_RTCA0_MASK		BIT(2)
+#define S2MPG14_IRQ_RTC1S_MASK		BIT(3)
+#define S2MPG14_IRQ_WTSR_COLDRST_MASK	BIT(4)
+#define S2MPG14_IRQ_WTSR_MASK		BIT(5)

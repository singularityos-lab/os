From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Tue, 27 Oct 2026 05:14:55 -0647
Subject: [PATCH] nfc: stop polling before taking the device down on an rfkill
 block

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 net/nfc/core.c | 15 +++++++++++++++
 1 file changed, 15 insertions(+)

diff --git a/net/nfc/core.c b/net/nfc/core.c
index f52166929..56a3cf684 100644
--- a/net/nfc/core.c
+++ b/net/nfc/core.c
@@ -170,12 +170,27 @@ int nfc_dev_down(struct nfc_dev *dev)
 static int nfc_rfkill_set_block(void *data, bool blocked)
 {
 	struct nfc_dev *dev = data;
+	struct nfc_target *target;
+	u32 target_idx;
 
 	pr_debug("%s blocked %d", dev_name(&dev->dev), blocked);
 
 	if (!blocked)
 		return 0;
 
+	/*
+	 * nfc_dev_down() refuses a device that polls or has an active
+	 * target, so a block during discovery left the radio on: stop both
+	 * first.
+	 */
+	device_lock(&dev->dev);
+	target = dev->active_target;
+	target_idx = target ? target->idx : 0;
+	device_unlock(&dev->dev);
+	if (target)
+		nfc_deactivate_target(dev, target_idx, NFC_TARGET_MODE_IDLE);
+	nfc_stop_poll(dev);
+
 	nfc_dev_down(dev);
 
 	return 0;

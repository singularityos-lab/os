From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Fri, 23 Oct 2026 10:14:17 -0647
Subject: [PATCH] dt-bindings: power: supply: Describe MAX77779 fuel gauge

Describe the MAX77779 fuel gauge and its sense resistor using the existing
shunt-resistor-micro-ohms property. This interface retains the initialized
firmware battery model instead of requiring model data or charger policy
from the board description. A separate driver reports measurements only.

The Pixel 9a uses the gauge at address 0x36 and a 2000 micro-ohm sense
resistor. Keep the binding independent of that board; no node is enabled.
Add an owner for the new binding.

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../power/supply/maxim,max77779-fg.yaml       | 49 +++++++++++++++++++
 MAINTAINERS                                   |  6 +++
 2 files changed, 55 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/supply/maxim,max77779-fg.yaml

diff --git a/Documentation/devicetree/bindings/power/supply/maxim,max77779-fg.yaml b/Documentation/devicetree/bindings/power/supply/maxim,max77779-fg.yaml
new file mode 100644
index 000000000..2ad9b1adb
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/supply/maxim,max77779-fg.yaml
@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/supply/maxim,max77779-fg.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Maxim MAX77779 fuel gauge
+
+maintainers:
+  - W4HO <87742609+W4HO-ham@users.noreply.github.com>
+
+description:
+  Fuel-gauge measurements from a MAX77779 with an initialized battery model.
+  Firmware retains responsibility for model programming and charger control.
+
+allOf:
+  - $ref: power-supply.yaml#
+
+properties:
+  compatible:
+    const: maxim,max77779-fg
+
+  reg:
+    maxItems: 1
+
+  shunt-resistor-micro-ohms:
+    description: Resistance of the battery current sense resistor in micro-ohms.
+    minimum: 100
+    maximum: 100000
+
+required:
+  - compatible
+  - reg
+  - shunt-resistor-micro-ohms
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        fuel-gauge@36 {
+            compatible = "maxim,max77779-fg";
+            reg = <0x36>;
+            shunt-resistor-micro-ohms = <2000>;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index bcc42705b..e2435a76a 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS

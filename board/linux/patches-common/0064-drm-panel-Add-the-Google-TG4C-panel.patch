 drivers/gpu/drm/panel/Kconfig             |  12 +
 drivers/gpu/drm/panel/Makefile            |   1 +
 drivers/gpu/drm/panel/panel-google-tg4c.c | 269 ++++++++++++++++++++++
 4 files changed, 288 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-google-tg4c.c


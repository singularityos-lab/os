index 19d0f0e12..bed0ea252 100644
--- a/include/linux/mfd/samsung/irq.h
+++ b/include/linux/mfd/samsung/irq.h
@@ -271,6 +271,86 @@ enum s2mpg11_irq {
 	S2MPG11_IRQ_NR,
 };
 
+enum s2mpg12_irq {
+	/* PMIC INT1 */
+	S2MPG12_IRQ_PWRONF,
+	S2MPG12_IRQ_PWRONR,
+	S2MPG12_IRQ_JIGONBF,
+	S2MPG12_IRQ_JIGONBR,
+	S2MPG12_IRQ_ACOKBF,
+	S2MPG12_IRQ_ACOKBR,
+	S2MPG12_IRQ_PWRON1S,
+	S2MPG12_IRQ_MRB,
+#define S2MPG12_IRQ_PWRONF_MASK		BIT(0)
+#define S2MPG12_IRQ_PWRONR_MASK		BIT(1)
+#define S2MPG12_IRQ_JIGONBF_MASK	BIT(2)
+#define S2MPG12_IRQ_JIGONBR_MASK	BIT(3)
+#define S2MPG12_IRQ_ACOKBF_MASK		BIT(4)
+#define S2MPG12_IRQ_ACOKBR_MASK		BIT(5)
+#define S2MPG12_IRQ_PWRON1S_MASK	BIT(6)
+#define S2MPG12_IRQ_MRB_MASK		BIT(7)
+
+	/* PMIC INT2 */
+	S2MPG12_IRQ_RTC60S,
+	S2MPG12_IRQ_RTCA1,
+	S2MPG12_IRQ_RTCA0,
+	S2MPG12_IRQ_RTC1S,
+	S2MPG12_IRQ_WTSR_COLDRST,
+	S2MPG12_IRQ_WTSR,
+	S2MPG12_IRQ_WRST,
+	S2MPG12_IRQ_SMPL,
+#define S2MPG12_IRQ_RTC60S_MASK		BIT(0)
+#define S2MPG12_IRQ_RTCA1_MASK		BIT(1)
+#define S2MPG12_IRQ_RTCA0_MASK		BIT(2)
+#define S2MPG12_IRQ_RTC1S_MASK		BIT(3)
+#define S2MPG12_IRQ_WTSR_COLDRST_MASK	BIT(4)
+#define S2MPG12_IRQ_WTSR_MASK		BIT(5)
+#define S2MPG12_IRQ_WRST_MASK		BIT(6)
+#define S2MPG12_IRQ_SMPL_MASK		BIT(7)
+
+	/* PMIC INT3 */
+	S2MPG12_IRQ_120C,
+	S2MPG12_IRQ_140C,
+	S2MPG12_IRQ_TSD,
+	S2MPG12_IRQ_SCL_SOFTRST,
+	S2MPG12_IRQ_WLWP_ACC,
+#define S2MPG12_IRQ_INT120C_MASK	BIT(0)
+#define S2MPG12_IRQ_INT140C_MASK	BIT(1)
+#define S2MPG12_IRQ_TSD_MASK		BIT(2)
+#define S2MPG12_IRQ_SCL_SOFTRST_MASK	BIT(3)
+#define S2MPG12_IRQ_WLWP_ACC_MASK	BIT(7)
+
+	/* PMIC INT4 */
+	S2MPG12_IRQ_OCP_B1M,
+	S2MPG12_IRQ_OCP_B2M,
+	S2MPG12_IRQ_OCP_B3M,
+	S2MPG12_IRQ_OCP_B4M,
+	S2MPG12_IRQ_OCP_B5M,
+	S2MPG12_IRQ_OCP_B6M,
+	S2MPG12_IRQ_OCP_B7M,
+	S2MPG12_IRQ_OCP_B8M,
+#define S2MPG12_IRQ_OCP_B1M_MASK	BIT(0)
+#define S2MPG12_IRQ_OCP_B2M_MASK	BIT(1)
+#define S2MPG12_IRQ_OCP_B3M_MASK	BIT(2)

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Mon, 26 Oct 2026 09:22:04 -0647
Subject: [PATCH] rtc: s5m: Add S2MPG14

The S2MPG14 (Pixel 9a main PMIC) keeps its RTC in the S2MPG10 layout,
reached through the "rtc" regmap the sec-acpm driver now provides, so it
takes the S2MPG10 register table. Its alarm flag is STATUS2 bit 2 in the
PMIC regmap, as on the S2MPG12. Without a PMIC interrupt line the device
comes up with the alarm feature cleared, as a time-only clock.

On the Pixel 9a the RTC registers as rtc0 and the system clock is set
from it at boot:

  s5m-rtc s2mpg14-rtc: registered as rtc0
  s5m-rtc s2mpg14-rtc: setting system clock to 2026-10-26T13:28:26 UTC

Tested on the Pixel 9a: rtc0 registers at boot, hwclock reads and sets
the time, systemd-timesyncd writes the synchronized time back, and the
time survives reboots and a power-key reset.

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 drivers/rtc/rtc-s5m.c | 20 ++++++++++++++++++--
 1 file changed, 18 insertions(+), 2 deletions(-)

diff --git a/drivers/rtc/rtc-s5m.c b/drivers/rtc/rtc-s5m.c
index c70384de6..1ac5cda1b 100644
--- a/drivers/rtc/rtc-s5m.c
+++ b/drivers/rtc/rtc-s5m.c
@@ -17,6 +17,7 @@
 #include <linux/mfd/samsung/core.h>
 #include <linux/mfd/samsung/rtc.h>
 #include <linux/mfd/samsung/s2mpg12.h>
+#include <linux/mfd/samsung/s2mpg14.h>
 #include <linux/mfd/samsung/s2mps14.h>
 
 /*
@@ -259,6 +260,11 @@ static int s5m_check_pending_alarm_interrupt(struct s5m_rtc_info *info,
 				  &val);
 		val &= S2MPG12_STATUS2_RTCA0E;
 		break;
+	case S2MPG14:
+		ret = regmap_read(info->s5m87xx->regmap_pmic, S2MPG14_PMIC_STATUS2,
+				  &val);
+		val &= S2MPG14_STATUS2_RTCA0E;
+		break;
 	case S2MPG10:
 	case S2MPS15X:
 	case S2MPS14X:
@@ -309,6 +315,7 @@ static int s5m8767_rtc_set_alarm_reg(struct s5m_rtc_info *info)
 		break;
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -374,6 +381,7 @@ static int s5m_rtc_read_time(struct device *dev, struct rtc_time *tm)
 	case S5M8767X:
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -403,6 +411,7 @@ static int s5m_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	case S5M8767X:
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -442,6 +451,7 @@ static int s5m_rtc_read_alarm(struct device *dev, struct rtc_wkalrm *alrm)
 	case S5M8767X:
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -482,6 +492,7 @@ static int s5m_rtc_stop_alarm(struct s5m_rtc_info *info)
 	case S5M8767X:
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -522,6 +533,7 @@ static int s5m_rtc_start_alarm(struct s5m_rtc_info *info)
 	case S5M8767X:
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -561,6 +573,7 @@ static int s5m_rtc_set_alarm(struct device *dev, struct rtc_wkalrm *alrm)
 	case S5M8767X:
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -643,6 +656,7 @@ static int s5m8767_rtc_init_reg(struct s5m_rtc_info *info)
 
 	case S2MPG10:
 	case S2MPG12:
+	case S2MPG14:
 	case S2MPS15X:
 	case S2MPS14X:
 	case S2MPS13X:
@@ -743,8 +757,9 @@ static int s5m_rtc_probe(struct platform_device *pdev)
 		if (IS_ERR(info->regmap))
 			return dev_err_probe(&pdev->dev, PTR_ERR(info->regmap),
 					     "Failed to allocate regmap\n");
-	} else if (device_type == S2MPG10 || device_type == S2MPG12) {
-		/* S2MPG12's RTC has the same registers as S2MPG10's */
+	} else if (device_type == S2MPG10 || device_type == S2MPG12 ||
+		   device_type == S2MPG14) {
+		/* S2MPG12's and S2MPG14's RTCs have S2MPG10's registers */
 		info->regs = &s2mpg10_rtc_regs;
 	} else {
 		return dev_err_probe(&pdev->dev, -ENODEV,
@@ -842,6 +857,7 @@ static const struct platform_device_id s5m_rtc_id[] = {
 	{ .name = "s5m-rtc",     .driver_data = S5M8767X },
 	{ .name = "s2mpg10-rtc", .driver_data = S2MPG10 },
 	{ .name = "s2mpg12-rtc", .driver_data = S2MPG12 },
+	{ .name = "s2mpg14-rtc", .driver_data = S2MPG14 },
 	{ .name = "s2mps13-rtc", .driver_data = S2MPS13X },
 	{ .name = "s2mps14-rtc", .driver_data = S2MPS14X },
 	{ .name = "s2mps15-rtc", .driver_data = S2MPS15X },

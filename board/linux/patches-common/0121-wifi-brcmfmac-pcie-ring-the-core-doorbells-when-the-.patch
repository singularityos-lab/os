From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 01:35:25 -0400
Subject: [PATCH] wifi: brcmfmac: pcie: ring the core doorbells when the
 firmware has no DAR

For PCIe core revision 64 and later brcmfmac rings the H2D doorbells
through the DAR ("direct access register") copies at 0xa20/0xa24.
Broadcom's own driver uses those only when the firmware offers them
(PCIE_SHARED_DAR, bit 31 of the shared-area flags) and the host
enables them; otherwise it rings the core's own mailbox registers at
0x140 (DB0) and 0x144 (DB1, host ready), whatever the core revision
(bcmdhd dhd_pcie.c dhd_bus_db0_addr_get(), dhd_bus_db1_addr_get(),
dhd_pcie.h DAR_ACTIVE(), pcie_core.h PCIH2D_MailBox/PCIH2D_DB1).

The Pixel 7 Pro's BCM4389 (PCIe core rev 72) firmware does not offer
DAR (shared flags 0x70050107; stock logs "FW supports DAR ? N"). With
the DAR doorbells it never saw a ring update or the host-ready ring:
the rxpost ring stayed unread and the first ioctl timed out.

For the BCM4389 without the DAR flag, switch to the core mailbox
registers once the shared flags are known. Other rev >= 64 chips keep
the DAR doorbells they are known to work with.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 .../broadcom/brcm80211/brcmfmac/pcie.c        | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
index b4f7d9038..7436f67f1 100644
--- a/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
+++ b/drivers/net/wireless/broadcom/brcm80211/brcmfmac/pcie.c
@@ -245,6 +245,7 @@ static const struct brcmf_firmware_mapping brcmf_pcie_fwnames[] = {
 #define BRCMF_PCIE_SHARED_DMA_INDEX		0x10000
 #define BRCMF_PCIE_SHARED_DMA_2B_IDX		0x100000
 #define BRCMF_PCIE_SHARED_HOSTRDY_DB1		0x10000000
+#define BRCMF_PCIE_SHARED_DAR			0x80000000
 
 #define BRCMF_PCIE_FLAGS_HTOD_SPLIT		0x4000
 #define BRCMF_PCIE_FLAGS_DTOH_SPLIT		0x8000
@@ -480,6 +481,19 @@ static const struct brcmf_pcie_reginfo brcmf_reginfo_default = {
 	.int_fn0 = BRCMF_PCIE_MB_INT_FN0,
 };
 
+/* Core rev >= 64 with the doorbells in the PCIe core's own registers, for
+ * firmware that does not offer the DAR doorbells (BRCMF_PCIE_SHARED_DAR).
+ */
+static const struct brcmf_pcie_reginfo brcmf_reginfo_64_nodar = {
+	.intmask = BRCMF_PCIE_64_PCIE2REG_INTMASK,
+	.mailboxint = BRCMF_PCIE_64_PCIE2REG_MAILBOXINT,
+	.mailboxmask = BRCMF_PCIE_64_PCIE2REG_MAILBOXMASK,
+	.h2d_mailbox_0 = BRCMF_PCIE_PCIE2REG_H2D_MAILBOX_0,
+	.h2d_mailbox_1 = BRCMF_PCIE_PCIE2REG_H2D_MAILBOX_1,
+	.int_d2h_db = BRCMF_PCIE_64_MB_INT_D2H_DB,
+	.int_fn0 = 0,
+};
+
 static const struct brcmf_pcie_reginfo brcmf_reginfo_64 = {
 	.intmask = BRCMF_PCIE_64_PCIE2REG_INTMASK,
 	.mailboxint = BRCMF_PCIE_64_PCIE2REG_MAILBOXINT,
@@ -1851,6 +1865,19 @@ brcmf_pcie_init_share_ram_info(struct brcmf_pciedev_info *devinfo,
 	shared->flags = brcmf_pcie_read_tcm32(devinfo, sharedram_addr);
 	shared->version = (u8)(shared->flags & BRCMF_PCIE_SHARED_VERSION_MASK);
 	brcmf_dbg(PCIE, "shared flags 0x%08x\n", shared->flags);
+
+	/* Broadcom's driver rings the DAR doorbells only when the firmware
+	 * offers them, and the core's own H2D mailbox registers otherwise.
+	 * The BCM4389 firmware does not, and ignores the DAR doorbells.
+	 */
+	if (devinfo->reginfo == &brcmf_reginfo_64 &&
+	    devinfo->pdev->device == BRCM_PCIE_4389_DEVICE_ID &&
+	    !(shared->flags & BRCMF_PCIE_SHARED_DAR)) {
+		devinfo->reginfo = &brcmf_reginfo_64_nodar;
+		brcmf_dbg(PCIE, "no DAR: doorbells at 0x%x/0x%x\n",
+			  devinfo->reginfo->h2d_mailbox_0,
+			  devinfo->reginfo->h2d_mailbox_1);
+	}
 	brcmf_dbg(PCIE, "PCIe protocol version %d\n", shared->version);
 	if ((shared->version > BRCMF_PCIE_MAX_SHARED_VERSION) ||
 	    (shared->version < BRCMF_PCIE_MIN_SHARED_VERSION)) {

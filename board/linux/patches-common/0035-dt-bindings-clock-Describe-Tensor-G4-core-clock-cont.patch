+#define CLK_DOUT_PERIC0_NOC	18
+
+#define CLK_MOUT_HSI0_NOC		19
+#define CLK_MOUT_HSI0_PERI	20
+#define CLK_DOUT_HSI0_NOC		21
+#define CLK_DOUT_HSI0_PERI	22
+#define CLK_MOUT_HSI2_PCIE	23
+#define CLK_GOUT_HSI2_PCIE	24
+#define CLK_DOUT_HSI2_PCIE	25
+
+/* CMU_HSI2. */
+#define CLK_MOUT_HSI2_NOC_USER	1
+#define CLK_MOUT_HSI2_UFS_USER	2
+#define CLK_DOUT_HSI2_NOCP	3
+#define CLK_GOUT_UFS_ACLK		4
+#define CLK_GOUT_UFS_UNIPRO	5
+#define CLK_GOUT_UFS_FMP		6
+#define CLK_GOUT_QE_UFS_ACLK	7
+#define CLK_GOUT_QE_UFS_PCLK	8
+#define CLK_GOUT_SYSREG_HSI2	9
+#define CLK_GOUT_GPIO_HSI2UFS	10
+#define CLK_GOUT_GPIO_HSI2		11
+#define CLK_MOUT_HSI2_PCIE_USER	12
+#define CLK_GOUT_PCIE1_CTL_APB	13
+#define CLK_GOUT_PCIE1_DBI_ACLK	14
+#define CLK_GOUT_PCIE1_SLV_ACLK	15
+#define CLK_GOUT_PCIE1_MSTR_ACLK	16
+#define CLK_GOUT_PCIE1_PHY_UDBG_APB	17
+#define CLK_GOUT_PCIE1_PHY_PAL_APB	18
+#define CLK_GOUT_PCIE1_PHY_REF	19
+#define CLK_GOUT_PCIE1_PHY_BRIDGE_APB	20
+#define CLK_GOUT_PCIE1_PHY_TEST_APB	21
+#define CLK_GOUT_PCIE1_IA_CLK	22
+#define CLK_GOUT_PCIE1_SSMT_IA_ACLK	23
+#define CLK_GOUT_PCIE1_SSMT_IA_PCLK	24
+#define CLK_GOUT_PCIE1_SYSMMU_CLK	25
+#define CLK_GOUT_PCIE1_PMMU_CLK	26
+
+/* CMU_PERIC0. */
+#define CLK_MOUT_PERIC0_NOC_USER	1
+#define CLK_GOUT_GPIO_PERIC0	2
+
+#endif /* _DT_BINDINGS_CLOCK_GOOGLE_ZUMAPRO_H */

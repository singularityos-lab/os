+#define CLK_SHARED3_D2		9
+#define CLK_MOUT_HSI2_NOC		10
+#define CLK_MOUT_HSI2_UFS		11
+#define CLK_GOUT_HSI2_NOC		12
+#define CLK_GOUT_HSI2_UFS		13
+#define CLK_DOUT_HSI2_NOC		14
+#define CLK_DOUT_HSI2_UFS		15
+#define CLK_MOUT_PERIC0_NOC	16

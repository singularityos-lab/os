From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Tue, 13 Oct 2026 12:21:25 -0400
Subject: [PATCH] PCI: dwc: gs201-cp: give the modem's function a class

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 drivers/pci/controller/dwc/pcie-gs201-cp.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/drivers/pci/controller/dwc/pcie-gs201-cp.c b/drivers/pci/controller/dwc/pcie-gs201-cp.c
index fd89895b4..14d8861ed 100644
--- a/drivers/pci/controller/dwc/pcie-gs201-cp.c
+++ b/drivers/pci/controller/dwc/pcie-gs201-cp.c
@@ -448,6 +448,15 @@ static int cp_cfg_read(struct pci_bus *bus, unsigned int devfn, int where,
 	ret = pci_generic_config_read(bus, devfn, where, size, val);
 	raw_spin_unlock_irqrestore(&cp->cfg_lock, flags);
 
+	/*
+	 * The modem's ROM and boot loader report class 0, whose BARs the PCI
+	 * core never assigns. Report "other" instead; the modem driver
+	 * matches the device ID only.
+	 */
+	if (ret == PCIBIOS_SUCCESSFUL && !pci_is_root_bus(bus) &&
+	    where == PCI_CLASS_REVISION && size == 4 && !(*val >> 8))
+		*val |= PCI_CLASS_OTHERS << 24;
+
 	return ret;
 }
 

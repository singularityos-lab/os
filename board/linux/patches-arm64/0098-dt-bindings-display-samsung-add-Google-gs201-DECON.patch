@@ -43,6 +43,11 @@ properties:
   power-domains:
     maxItems: 1
 
+  port:
+    $ref: /schemas/graph.yaml#/properties/port
+    description:
+      Input from the DECON.
+
 required:
   - compatible
   - reg
@@ -63,6 +68,12 @@ examples:
         #address-cells = <1>;
         #size-cells = <0>;
 

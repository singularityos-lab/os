From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Sun, 1 Nov 2026 16:49:44 -0500
Subject: [PATCH] soc: google: aoc: send at most one doorbell behind the one in
 flight

A doorbell (a mailbox message with no data) only tells the AoC to look
at its rings, and signal_aoc() rang one after every message written and
every read from a full ring. During AoC start-up the services wrote
faster than the AoC took its interrupts, so doorbells piled up in the
mailbox core's 20-entry queue, which refused the rest with -ENOBUFS and
an error line each.

Count the doorbells sent or queued per channel and skip one when two are
already outstanding: the queued one reaches the AoC after everything
written before it, so it covers the skipped ones. tx_done counts them
back down (data messages from aoc_v1.c are not counted), a refused send
is not counted, and the count is reset when the channel is requested,
since freeing a channel drops its queue without tx_done.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 drivers/soc/google/aoc/aoc.c              |  6 ++++++
 drivers/soc/google/aoc/aoc.h              |  2 ++
 drivers/soc/google/aoc/aoc_service_core.c | 23 +++++++++++++++++------
 3 files changed, 25 insertions(+), 6 deletions(-)

diff --git a/drivers/soc/google/aoc/aoc.c b/drivers/soc/google/aoc/aoc.c
index bd3d6e7c1..8fd393c08 100644
--- a/drivers/soc/google/aoc/aoc.c
+++ b/drivers/soc/google/aoc/aoc.c
@@ -368,6 +368,8 @@ static int allocate_mailbox_channels(struct aoc_prvdata *prv)
 
 	for (i = 0; i < prv->aoc_mbox_channels; i++) {
 		slot = &prv->mbox_channels[i];
+		/* a freed channel drops its queue without tx_done */
+		atomic_set(&slot->doorbells, 0);
 		slot->channel = mbox_request_channel(&slot->client, i);
 		if (IS_ERR(slot->channel)) {
 			rc = PTR_ERR(slot->channel);
@@ -424,6 +426,10 @@ static void aoc_mbox_tx_prepare(struct mbox_client *cl, void *mssg)
 
 static void aoc_mbox_tx_done(struct mbox_client *cl, void *mssg, int r)
 {
+	struct mbox_slot *slot = container_of(cl, struct mbox_slot, client);
+
+	if (!mssg)
+		atomic_dec_if_positive(&slot->doorbells);
 }
 
 
diff --git a/drivers/soc/google/aoc/aoc.h b/drivers/soc/google/aoc/aoc.h
index 944b80a13..8900499bf 100644
--- a/drivers/soc/google/aoc/aoc.h
+++ b/drivers/soc/google/aoc/aoc.h
@@ -65,6 +65,8 @@ struct mbox_slot {
 	struct mbox_chan *channel;
 	void *prvdata;
 	int index;
+	/* doorbells sent or queued and not yet taken by the AoC */
+	atomic_t doorbells;
 };
 
 struct aoc_service_dev {
diff --git a/drivers/soc/google/aoc/aoc_service_core.c b/drivers/soc/google/aoc/aoc_service_core.c
index c1808659e..1fb05f9ee 100644
--- a/drivers/soc/google/aoc/aoc_service_core.c
+++ b/drivers/soc/google/aoc/aoc_service_core.c
@@ -14,7 +14,7 @@
 extern enum AOC_FW_STATE aoc_state;
 extern struct aoc_control_block *aoc_control;
 
-static void signal_aoc(struct mbox_chan *channel);
+static void signal_aoc(struct mbox_slot *slot);
 
 ssize_t aoc_service_read_timeout(struct aoc_service_dev *dev, uint8_t *buffer,
 				 size_t count, long timeout)
@@ -192,7 +192,7 @@ ssize_t aoc_service_write(struct aoc_service_dev *dev, const uint8_t *buffer,
 					buffer, count);
 
 	if (!aoc_service_is_ring(service) || aoc_ring_is_push(service))
-		signal_aoc(prvdata->mbox_channels[interrupt].channel);
+		signal_aoc(&prvdata->mbox_channels[interrupt]);
 err:
 	atomic_dec(&prvdata->aoc_process_active);
 	if (ret < 0)
@@ -274,7 +274,7 @@ ssize_t aoc_service_write_timeout(struct aoc_service_dev *dev, const uint8_t *bu
 					buffer, count);
 
 	if (!aoc_service_is_ring(service) || aoc_ring_is_push(service))
-		signal_aoc(prvdata->mbox_channels[interrupt].channel);
+		signal_aoc(&prvdata->mbox_channels[interrupt]);
 
 err:
 	atomic_dec(&prvdata->aoc_process_active);
@@ -507,7 +507,7 @@ ssize_t aoc_service_read(struct aoc_service_dev *dev, uint8_t *buffer,
 	 * there is now space available to write.
 	 */
 	if (was_full)
-		signal_aoc(prvdata->mbox_channels[interrupt].channel);
+		signal_aoc(&prvdata->mbox_channels[interrupt]);
 err:
 	atomic_dec(&prvdata->aoc_process_active);
 	if (ret < 0)
@@ -557,7 +557,18 @@ wait_queue_head_t *aoc_service_get_write_queue(struct aoc_service_dev *dev)
 }
 EXPORT_SYMBOL_GPL(aoc_service_get_write_queue);
 
-static void signal_aoc(struct mbox_chan *channel)
+/*
+ * A doorbell carries no data: it tells the AoC to look at its rings. One
+ * queued behind the doorbell in flight is read after anything written
+ * before it, so further ones add nothing and would only fill the
+ * mailbox's queue. tx_done (aoc_mbox_tx_done) counts them back down.
+ */
+static void signal_aoc(struct mbox_slot *slot)
 {
-	mbox_send_message(channel, NULL);
+	if (atomic_inc_return(&slot->doorbells) > 2) {
+		atomic_dec(&slot->doorbells);
+		return;
+	}
+	if (mbox_send_message(slot->channel, NULL) < 0)
+		atomic_dec(&slot->doorbells);
 }

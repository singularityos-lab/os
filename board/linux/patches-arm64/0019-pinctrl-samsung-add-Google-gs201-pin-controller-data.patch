+	GS101_PIN_BANK_EINTW(4, 0x40, "gpa2", 0x08, 0x10),
+	GS101_PIN_BANK_EINTW(4, 0x60, "gpa3", 0x0c, 0x14),
+	GS101_PIN_BANK_EINTW(4, 0x80, "gpa4", 0x10, 0x18),

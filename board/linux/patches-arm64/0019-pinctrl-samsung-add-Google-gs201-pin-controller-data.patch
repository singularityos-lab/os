+/* pin banks of gs201 pin-controller (HSI2UFS) */
+static const struct samsung_pin_bank_data gs201_pin_hsi2ufs[] = {
+	GS101_PIN_BANK_EINTG(2, 0x0, "gph3", 0x00, 0x00),

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: saiththerobo <the.tom.sharp@gmail.com>
Date: Tue, 27 Oct 2026 12:11:28 +0000
Subject: [PATCH] arm64: dts: exynos: google: gs101-raven: add the ramoops
 region

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 arch/arm64/boot/dts/exynos/google/gs101-raven.dts | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
index 6a635c30b..7d1de1105 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
@@ -263,3 +263,17 @@ &little_crit {
 &gpu_crit {
 	temperature = <115000>;
 };
+
+&reserved_memory {
+	/*
+	 * Same region and layout as Google's gs101 kernel, so a log written by
+	 * this kernel survives a warm reset and can be read from
+	 * /sys/fs/pstore on the next boot.
+	 */
+	ramoops@fd3ff000 {
+		compatible = "ramoops";
+		reg = <0x0 0xfd3ff000 0x400000>;
+		console-size = <0x200000>;
+		pmsg-size = <0x200000>;
+	};
+};

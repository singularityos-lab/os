From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Thu, 29 Oct 2026 09:04:21 -0647
Subject: [PATCH] spi: s3c64xx: Do not cut a PIO transfer that fills the FIFO

A PIO transfer of fifo_depth bytes or more is cut into pieces of
fifo_depth - 1 bytes, because the RX trigger level of the interrupt
mode stops one short of the FIFO. On the Pixel 9a's GNSS link the
slave hands out one 64-byte block per chip-select cycle, and the cut
loses data at the piece boundary (the channel is reset between the
pieces). On ports that ask for it with the new port-config flag
poll_full_fifo, set only for zumapro, transfer a full FIFO in one
piece, polled, as the vendor driver does; every other board keeps its
transfers exactly as before, the cut having always worked there. For
all ports, keep the pieces of longer transfers a whole number of
words, so a 16- or 32-bit transfer's packet count does not round down
and time out.

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 drivers/spi/spi-s3c64xx.c | 26 +++++++++++++++++++++-----
 1 file changed, 21 insertions(+), 5 deletions(-)

diff --git a/drivers/spi/spi-s3c64xx.c b/drivers/spi/spi-s3c64xx.c
index 827a2439b..870aae659 100644
--- a/drivers/spi/spi-s3c64xx.c
+++ b/drivers/spi/spi-s3c64xx.c
@@ -177,6 +177,7 @@ struct s3c64xx_spi_port_config {
 	bool	manual_native_cs;
 	bool	has_loopback;
 	bool	use_32bit_io;
+	bool	poll_full_fifo;
 };
 
 /**
@@ -832,6 +833,7 @@ static int s3c64xx_spi_transfer_one(struct spi_controller *host,
 	const void *tx_buf = NULL;
 	void *rx_buf = NULL;
 	int target_len = 0, origin_len = 0;
+	unsigned int pio_len;
 	int use_dma = 0;
 	bool use_irq = false;
 	int status;
@@ -856,20 +858,33 @@ static int s3c64xx_spi_transfer_one(struct spi_controller *host,
 			return status;
 	}
 
+	/*
+	 * A PIO piece must stay below the FIFO depth and hold whole words, or
+	 * the packet count rounds down and the transfer times out.
+	 */
+	pio_len = rounddown(fifo_len - 1, DIV_ROUND_UP(bpw, BITS_PER_BYTE));
+
 	if (!is_polling(sdd) && xfer->len >= fifo_len &&
 	    sdd->rx_dma.ch && sdd->tx_dma.ch) {
 		use_dma = 1;
-	} else if (xfer->len >= fifo_len) {
+	} else if (xfer->len > fifo_len ||
+		   (xfer->len == fifo_len && !sdd->port_conf->poll_full_fifo)) {
 		tx_buf = xfer->tx_buf;
 		rx_buf = xfer->rx_buf;
 		origin_len = xfer->len;
 		target_len = xfer->len;
-		xfer->len = fifo_len - 1;
+		xfer->len = pio_len;
 	}
 
 	do {
-		/* transfer size is greater than 32, change to IRQ mode */
-		if (!use_dma && xfer->len > S3C64XX_SPI_POLLING_SIZE)
+		/*
+		 * Transfers above 32 bytes use the RX trigger interrupt. Its
+		 * level field stops one short of the FIFO, so a transfer that
+		 * fills the FIFO exactly (poll_full_fifo ports) is polled
+		 * instead of being cut.
+		 */
+		if (!use_dma && xfer->len > S3C64XX_SPI_POLLING_SIZE &&
+		    xfer->len < fifo_len)
 			use_irq = true;
 
 		if (use_irq) {
@@ -960,7 +975,7 @@ static int s3c64xx_spi_transfer_one(struct spi_controller *host,
 				xfer->rx_buf += xfer->len;
 
 			if (target_len >= fifo_len)
-				xfer->len = fifo_len - 1;
+				xfer->len = pio_len;
 			else
 				xfer->len = target_len;
 		}
@@ -1648,6 +1663,7 @@ static const struct s3c64xx_spi_port_config zumapro_spi_port_config = {
 	.has_loopback	= true,
 	.use_32bit_io	= true,
 	.manual_native_cs = true,
+	.poll_full_fifo	= true,
 };
 
 static const struct platform_device_id s3c64xx_spi_driver_ids[] = {

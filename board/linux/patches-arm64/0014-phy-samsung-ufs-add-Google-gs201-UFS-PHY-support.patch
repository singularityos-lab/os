 	{
 		.compatible = "google,gs101-ufs-phy",
 		.data = &tensor_gs101_ufs_phy,
+	}, {
+		.compatible = "google,gs201-ufs-phy",
+		.data = &tensor_gs201_ufs_phy,
 	}, {
 		.compatible = "samsung,exynos7-ufs-phy",
 		.data = &exynos7_ufs_phy,

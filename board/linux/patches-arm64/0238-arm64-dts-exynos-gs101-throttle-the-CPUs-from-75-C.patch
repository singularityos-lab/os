---
 arch/arm64/boot/dts/exynos/google/gs101.dtsi | 12 ++++++------
 1 file changed, 6 insertions(+), 6 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs101.dtsi b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
index ff9018c20..bf3a00cb4 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101.dtsi
@@ -2111,14 +2111,14 @@ big-thermal {
 
 			trips {
 				big_hot: big-hot {
-					temperature = <85000>;
+					temperature = <75000>;
 					hysteresis = <5000>;
 					type = "passive";
 				};
 
 				/* a fast burst outruns step_wise: throttle deep at once */
 				big_hotter: big-hotter {
-					temperature = <95000>;
+					temperature = <85000>;
 					hysteresis = <5000>;
 					type = "passive";
 				};
@@ -2152,14 +2152,14 @@ mid-thermal {
 
 			trips {
 				mid_hot: mid-hot {
-					temperature = <85000>;
+					temperature = <75000>;
 					hysteresis = <5000>;
 					type = "passive";
 				};
 
 				/* a fast burst outruns step_wise: throttle deep at once */
 				mid_hotter: mid-hotter {
-					temperature = <95000>;
+					temperature = <85000>;
 					hysteresis = <5000>;
 					type = "passive";
 				};
@@ -2193,14 +2193,14 @@ little-thermal {
 
 			trips {
 				little_hot: little-hot {
-					temperature = <85000>;
+					temperature = <75000>;
 					hysteresis = <5000>;
 					type = "passive";
 				};
 
 				/* a fast burst outruns step_wise: throttle deep at once */
 				little_hotter: little-hotter {
-					temperature = <95000>;
+					temperature = <85000>;
 					hysteresis = <5000>;
 					type = "passive";
 				};

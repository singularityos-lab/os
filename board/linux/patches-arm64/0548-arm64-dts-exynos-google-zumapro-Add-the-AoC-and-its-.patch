From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Sat, 31 Oct 2026 11:21:32 -0643
Subject: [PATCH] arm64: dts: exynos: google: zumapro: Add the AoC and its
 mailboxes

Describe the AoC, the audio and sensor DSP, and its three mailboxes
(A32, F1, P6, GIC SPIs 77 to 79). The AoC's power request is at
0x154b0000, its watchdog on SPI 130, and it reads the chip id block at
0x10000000; its 48 doorbells are the mailboxes' 16 each. Its clocks are
the 17 ACPM DVFS domains, all of which the 9a's AoC driver asks ACPM
about before each start. The firmware owns the AoC's memory protection,
so neither its S2MPU nor its System MMU is described. All stay
disabled; the board adds the carve-out, its firmware name, its board
id and the sensor supplies.

Booted on the Pixel 9a:
7.3.0-rc6-omamobile-tegu-s2mpg15-m1-g991042e2eff3-dirty has these nodes
(plus a disabled System MMU node this driver no longer uses), enabled
by overlays at runtime; the AoC starts and reaches its 93 services.

Addresses and interrupts from Google's GPL zumapro device tree.

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../arm64/boot/dts/exynos/google/zumapro.dtsi | 80 +++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
index 4cb1de9c5..be17249e5 100644
--- a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
@@ -1370,6 +1370,30 @@ ap2apm_mailbox: mailbox@15110000 {
 			status = "disabled";
 		};
 
+		aoc_mbox_a32: mailbox@15200000 {
+			compatible = "google,zumapro-aoc-mbox";
+			reg = <0x0 0x15200000 0x1000>;
+			interrupts = <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <1>;
+			status = "disabled";
+		};
+
+		aoc_mbox_f1: mailbox@15220000 {
+			compatible = "google,zumapro-aoc-mbox";
+			reg = <0x0 0x15220000 0x1000>;
+			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <1>;
+			status = "disabled";
+		};
+
+		aoc_mbox_p6: mailbox@15240000 {
+			compatible = "google,zumapro-aoc-mbox";
+			reg = <0x0 0x15240000 0x1000>;
+			interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <1>;
+			status = "disabled";
+		};
+
 		cmu_apm: clock-controller@15400000 {
 			compatible = "google,zumapro-cmu-apm";
 			reg = <0x0 0x15400000 0x8000>;
@@ -1402,6 +1426,62 @@ reboot_mode: reboot-mode {
 			};
 		};
 
+		/*
+		 * The audio and sensor DSP. Its authenticated firmware owns its
+		 * memory protection: Linux touches neither its S2MPU nor its
+		 * System MMU, so neither is described.
+		 */
+		aoc: aoc@154b0000 {
+			compatible = "google,zumapro-aoc";
+			reg = <0x0 0x154b0000 0x1000>, <0x0 0x10000000 0x20>;
+			reg-names = "aoc_req", "chipid";
+			interrupts = <GIC_SPI 130 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "watchdog";
+			clocks = <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_MIF>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_INT>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL0>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL1>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CPUCL2>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_DSU>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_BCI>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_G3D>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_G3DL2>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_TPU>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_INTCAM>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_TNR>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_CAM>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_MFC>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_DISP>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_AOC>,
+				 <&acpm_ipc ZUMAPRO_CLK_ACPM_DVFS_BW>;
+			google,gsa = <&gsa>;
+			mboxes = <&aoc_mbox_a32 0>, <&aoc_mbox_a32 1>,
+				 <&aoc_mbox_a32 2>, <&aoc_mbox_a32 3>,
+				 <&aoc_mbox_a32 4>, <&aoc_mbox_a32 5>,
+				 <&aoc_mbox_a32 6>, <&aoc_mbox_a32 7>,
+				 <&aoc_mbox_a32 8>, <&aoc_mbox_a32 9>,
+				 <&aoc_mbox_a32 10>, <&aoc_mbox_a32 11>,
+				 <&aoc_mbox_a32 12>, <&aoc_mbox_a32 13>,
+				 <&aoc_mbox_a32 14>, <&aoc_mbox_a32 15>,
+				 <&aoc_mbox_f1 0>, <&aoc_mbox_f1 1>,
+				 <&aoc_mbox_f1 2>, <&aoc_mbox_f1 3>,
+				 <&aoc_mbox_f1 4>, <&aoc_mbox_f1 5>,
+				 <&aoc_mbox_f1 6>, <&aoc_mbox_f1 7>,
+				 <&aoc_mbox_f1 8>, <&aoc_mbox_f1 9>,
+				 <&aoc_mbox_f1 10>, <&aoc_mbox_f1 11>,
+				 <&aoc_mbox_f1 12>, <&aoc_mbox_f1 13>,
+				 <&aoc_mbox_f1 14>, <&aoc_mbox_f1 15>,
+				 <&aoc_mbox_p6 0>, <&aoc_mbox_p6 1>,
+				 <&aoc_mbox_p6 2>, <&aoc_mbox_p6 3>,
+				 <&aoc_mbox_p6 4>, <&aoc_mbox_p6 5>,
+				 <&aoc_mbox_p6 6>, <&aoc_mbox_p6 7>,
+				 <&aoc_mbox_p6 8>, <&aoc_mbox_p6 9>,
+				 <&aoc_mbox_p6 10>, <&aoc_mbox_p6 11>,
+				 <&aoc_mbox_p6 12>, <&aoc_mbox_p6 13>,
+				 <&aoc_mbox_p6 14>, <&aoc_mbox_p6 15>;
+			status = "disabled";
+		};
+
 		pinctrl_alive: pinctrl@154d0000 {
 			compatible = "google,zumapro-pinctrl";
 			reg = <0x0 0x154d0000 0x1000>;

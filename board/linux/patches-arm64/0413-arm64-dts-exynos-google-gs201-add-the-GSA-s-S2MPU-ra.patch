From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 12:56:29 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: add the GSA's S2MPU range

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 arch/arm64/boot/dts/exynos/google/gs201.dtsi | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index 8f06a7666..f861f29e6 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -1411,6 +1411,8 @@ ufs_0_phy: phy@14704000 {
 
 		gsa: gsa@17c90000 {
 			compatible = "google,gs201-gsa";
+			reg = <0x17c90000 0x1000>, <0x17c60000 0x10000>;
+			reg-names = "mbox", "s2mpu";
 			interrupts = <GIC_SPI 363 IRQ_TYPE_LEVEL_HIGH>;
 			status = "disabled";
 		};

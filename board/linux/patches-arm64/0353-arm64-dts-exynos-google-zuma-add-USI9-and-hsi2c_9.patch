From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lef <me@lefteros.com>
Date: Sun, 1 Nov 2026 15:00:08 +0200
Subject: [PATCH] arm64: dts: exynos: google: zuma: add USI9 and hsi2c_9

USI9 is at 0x10c900c0 with its SW_CONF at offset 0x4 of the PERIC1
sysreg, and the bus is hsi2c_9 at 0x10c90000 on GIC SPI 657, as in
Google's device tree. It is the I2C bus of the Pixel 8 Pro's battery
pack EEPROM (the wireless charger sits on it too). Add its pins, gpp19-4
and gpp19-5 on function 2 with no pull, as stock has them.

Both nodes are disabled: a board file or a bring-up overlay enables them.
Tested on a Pixel 8 Pro with the board commit on top; a bring-up overlay
enabled cmu_peric1, the sysreg, USI9 and hsi2c_9.

Signed-off-by: Lef <me@lefteros.com>
Assisted-by: LLM
---
 .../boot/dts/exynos/google/zuma-pinctrl.dtsi  |  8 +++++
 arch/arm64/boot/dts/exynos/google/zuma.dtsi   | 30 +++++++++++++++++++
 2 files changed, 38 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zuma-pinctrl.dtsi b/arch/arm64/boot/dts/exynos/google/zuma-pinctrl.dtsi
index dd84a0f1d..2de587797 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/zuma-pinctrl.dtsi
@@ -459,6 +459,14 @@ ts_reset: ts-reset-pins {
 		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
 	};
 
+	/* USI9, the battery pack EEPROM's bus: gpp19-4/5, no pull as in stock. */
+	hsi2c9_bus: hsi2c9-bus-pins {
+		samsung,pins = "gpp19-4", "gpp19-5";
+		samsung,pin-function = <GS101_PIN_FUNC_2>;
+		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+
 	/*
 	 * USI11, the battery bus: stock's board file moves it to gpp21-0/1 and
 	 * sets no pull, then zuma-typec.dtsi, applied after it, sets the
diff --git a/arch/arm64/boot/dts/exynos/google/zuma.dtsi b/arch/arm64/boot/dts/exynos/google/zuma.dtsi
index 05f407446..f46ad29ec 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/zuma.dtsi
@@ -377,6 +377,36 @@ sysreg_peric1: syscon@10c21000 {
 			status = "disabled";
 		};
 
+		usi9: usi@10c900c0 {
+			compatible = "google,zuma-usi", "samsung,exynos850-usi";
+			reg = <0x10c900c0 0x20>;
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI9_PCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_USI9_IPCLK>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_peric1 0x4>;
+			samsung,mode = <USI_MODE_I2C>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges;
+			status = "disabled";
+
+			hsi2c_9: i2c@10c90000 {
+				compatible = "google,zuma-hsi2c",
+					     "samsung,exynosautov9-hsi2c";
+				/* USI control starts at 0xc0; do not claim it twice. */
+				reg = <0x10c90000 0xc0>;
+				interrupts = <GIC_SPI 657 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI9_IPCLK>,
+					 <&cmu_peric1 CLK_GOUT_PERIC1_USI9_PCLK>;
+				clock-names = "hsi2c", "hsi2c_pclk";
+				pinctrl-0 = <&hsi2c9_bus>;
+				pinctrl-names = "default";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+		};
+
 		usi11: usi@10cb00c0 {
 			compatible = "google,zuma-usi", "samsung,exynos850-usi";
 			reg = <0x10cb00c0 0x20>;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Tue, 27 Oct 2026 18:10:12 -0647
Subject: [PATCH] dt-bindings: mfd: samsung: Add the S2MPG15 sub-PMIC

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../bindings/mfd/samsung,s2mpg15-pmic.yaml    | 46 +++++++++++++++++++
 .../regulator/samsung,s2mpg15-regulator.yaml  | 27 +++++++++++
 2 files changed, 73 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/mfd/samsung,s2mpg15-pmic.yaml
 create mode 100644 Documentation/devicetree/bindings/regulator/samsung,s2mpg15-regulator.yaml

diff --git a/Documentation/devicetree/bindings/mfd/samsung,s2mpg15-pmic.yaml b/Documentation/devicetree/bindings/mfd/samsung,s2mpg15-pmic.yaml
new file mode 100644
index 000000000..90d7e8442
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/samsung,s2mpg15-pmic.yaml
@@ -0,0 +1,46 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/samsung,s2mpg15-pmic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPG15 Power Management IC
+
+maintainers:
+  - W4HO <87742609+W4HO-ham@users.noreply.github.com>
+
+description: |
+  S2MPG15 is the sub PMIC paired with Google's Tensor G4 and is reached
+  through ACPM. Its LDOs supply the AoC sensors, the GNSS receiver, the
+  camera sensors and the fingerprint sensor.
+  Interrupt, meter, GPIO and RTC functions are not described here.
+
+properties:
+  compatible:
+    const: samsung,s2mpg15-pmic
+
+  regulators:
+    type: object
+    $ref: /schemas/regulator/samsung,s2mpg15-regulator.yaml
+
+required:
+  - compatible
+  - regulators
+
+additionalProperties: false
+
+examples:
+  - |
+    pmic-2 {
+        compatible = "samsung,s2mpg15-pmic";
+
+        regulators {
+            ldo5s {
+                regulator-name = "sensor-3v3";
+            };
+
+            ldo7s {
+                regulator-name = "sensor-1v8";
+            };
+        };
+    };
diff --git a/Documentation/devicetree/bindings/regulator/samsung,s2mpg15-regulator.yaml b/Documentation/devicetree/bindings/regulator/samsung,s2mpg15-regulator.yaml
new file mode 100644
index 000000000..413415753
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/samsung,s2mpg15-regulator.yaml
@@ -0,0 +1,27 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/samsung,s2mpg15-regulator.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPG15 Power Management IC regulators
+
+maintainers:
+  - W4HO <87742609+W4HO-ham@users.noreply.github.com>
+
+description: |
+  The sub-PMIC paired with Google's Tensor G4. LDO5S and LDO7S supply the
+  AoC sensors, LDO9S, LDO10S and LDO11S the GNSS receiver's core, RF front
+  end and auxiliary supply, LDO12S the camera sensors' 1.8 V and LDO15S the
+  fingerprint sensor's 3.3 V. Enable control and voltage readback are
+  supported; the firmware's voltage selections are preserved.
+
+patternProperties:
+  "^ldo(5|7|9|10|11|12|15)s$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    properties:
+      regulator-ramp-delay: false
+
+additionalProperties: false

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Sun, 1 Nov 2026 11:12:03 -0647
Subject: [PATCH] arm64: dts: exynos: google: zumapro: Add PCIe channel 1 and
 its PHY

Add zumapro's second PCIe controller (stock's pcie_1, ch-num 1, the
Wi-Fi chip's link) and its Gen3 PHY, disabled. Both are zuma's: the same
registers as stock's pcie@13120000 and zuma's nodes, the controller
interrupt on SPI 439 with legacy INTx demultiplexed from it, PERST# on
gph3-0 and CLKREQ# on gph3-1 with stock's pin settings, and the PHY's
isolation at PMU offset 0x3ec8. So both nodes carry zuma's compatible as
a fallback, and the gs201 host and zuma PHY drivers run them on zuma's
data. As on stock and on zuma, the controller runs without the I/A and
is not cache coherent.

Unlike zuma, zumapro has a CMU_HSI2 driver, so the controller lists the
PCIe1 gates it uses, up to the seven the DesignWare binding allows: its
APB, DBI, slave and master clocks, and the PHY's UDBG, PAL and reference
clocks. The PHY bridge and test APB, I/A, SSMT, System MMU and PMMU
gates stay out; all of these gates are CLK_IGNORE_UNUSED, and stock
lists no PCIe clocks at all (pcie-clk-num 0).

Tested on a Pixel 9a with the same description applied as an overlay
(that overlay listed all fourteen PCIe1 gates): the link trained at
Gen2 x1, the limit of the BCM4383 behind it.

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../arm64/boot/dts/exynos/google/zumapro.dtsi | 79 +++++++++++++++++++
 1 file changed, 79 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
index be17249e5..6951189c1 100644
--- a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
@@ -8,6 +8,7 @@
 
 #include <dt-bindings/clock/google,zumapro.h>
 #include <dt-bindings/clock/google,zumapro-acpm.h>
+#include <dt-bindings/gpio/gpio.h>
 #include <dt-bindings/interrupt-controller/arm-gic.h>
 #include <dt-bindings/soc/samsung,exynos-usi.h>
 
@@ -1228,6 +1229,24 @@ gph4: gph4-gpio-bank {
 				gpio-controller;
 				#gpio-cells = <2>;
 			};
+
+			/* Stock's pcie1 pins, the same as zuma's */
+			pcie1_clkreq: pcie1-clkreq-pins {
+				samsung,pins = "gph3-1";
+				samsung,pin-function = <2>;
+				samsung,pin-pud = <3>;
+				samsung,pin-drv = <3>;
+				samsung,pin-con-pdn = <3>;
+				samsung,pin-pud-pdn = <3>;
+			};
+
+			pcie1_perst: pcie1-perst-pins {
+				samsung,pins = "gph3-0";
+				samsung,pin-function = <1>;
+				samsung,pin-pud = <0>;
+				samsung,pin-drv = <3>;
+				samsung,pin-con-pdn = <3>;
+			};
 		};
 
 		pinctrl_hsi2ufs: pinctrl@13060000 {
@@ -1260,6 +1279,66 @@ ufs_refclk: ufs-refclk-pins {
 			};
 		};
 
+		/*
+		 * The Wi-Fi chip's controller (stock's pcie_1, ch-num 1), zuma's
+		 * controller at zuma's addresses: one Gen3 lane, no I/A, not
+		 * cache coherent. Its interrupts are its legacy INTx; stock's
+		 * MSI lines are unused.
+		 */
+		pcie_1: pcie@13120000 {
+			compatible = "google,zumapro-pcie", "google,zuma-pcie";
+			reg = <0x0 0x13120000 0x1400>,
+			      <0x0 0x13400000 0x381000>,
+			      <0x0 0x60ffe000 0x2000>;
+			reg-names = "elbi", "dbi", "config";
+			#address-cells = <3>;
+			#size-cells = <2>;
+			device_type = "pci";
+			ranges = <0x82000000 0x0 0x60000000 0x0 0x60000000 0x0 0xff0000>;
+			bus-range = <0x00 0xff>;
+			interrupts = <GIC_SPI 439 IRQ_TYPE_LEVEL_HIGH>;
+			#interrupt-cells = <1>;
+			interrupt-map-mask = <0 0 0 7>;
+			interrupt-map = <0 0 0 1 &pcie_1_intc 1>,
+					<0 0 0 2 &pcie_1_intc 2>,
+					<0 0 0 3 &pcie_1_intc 3>,
+					<0 0 0 4 &pcie_1_intc 4>;
+			clocks = <&cmu_hsi2 CLK_GOUT_PCIE1_CTL_APB>,
+				 <&cmu_hsi2 CLK_GOUT_PCIE1_DBI_ACLK>,
+				 <&cmu_hsi2 CLK_GOUT_PCIE1_SLV_ACLK>,
+				 <&cmu_hsi2 CLK_GOUT_PCIE1_MSTR_ACLK>,
+				 <&cmu_hsi2 CLK_GOUT_PCIE1_PHY_UDBG_APB>,
+				 <&cmu_hsi2 CLK_GOUT_PCIE1_PHY_PAL_APB>,
+				 <&cmu_hsi2 CLK_GOUT_PCIE1_PHY_REF>;
+			phys = <&pcie_1_phy>;
+			phy-names = "pcie";
+			pinctrl-0 = <&pcie1_clkreq>, <&pcie1_perst>;
+			pinctrl-names = "default";
+			reset-gpios = <&gph3 0 GPIO_ACTIVE_LOW>;
+			num-lanes = <1>;
+			max-link-speed = <3>;
+			status = "disabled";
+
+			pcie_1_intc: legacy-interrupt-controller {
+				#address-cells = <0>;
+				interrupt-controller;
+				#interrupt-cells = <1>;
+			};
+		};
+
+		pcie_1_phy: phy@13160000 {
+			compatible = "google,zumapro-pcie-phy", "google,zuma-pcie-phy";
+			reg = <0x0 0x13160000 0x3000>,
+			      <0x0 0x13140000 0x5000>,
+			      <0x0 0x13121400 0x10>,
+			      <0x0 0x13150000 0xd000>,
+			      <0x0 0x13130000 0x5000>;
+			reg-names = "pma", "pcs", "rst", "udbg", "soc";
+			samsung,pmu-syscon = <&pmu_system_controller 0x3ec8>;
+			#phy-cells = <0>;
+			status = "disabled";
+		};
+
 		ufs: ufs@13200000 {
 			compatible = "google,zumapro-ufs";
 			reg = <0x0 0x13200000 0x200>,

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 16:34:10 -0400
Subject: [PATCH] soc: google: aoc: alsa: unregister the platform drivers on
 unload

aoc_alsa_dev_util registers its PCM, voice, compress, path, no-host,
in-call and VoIP platform drivers at module init, but its exit only
unregistered them once every AoC audio service had probed. Unloading
it while the AoC was not online left those drivers on the platform bus
in freed module memory, and the next deferred probe crashed in
__device_attach_driver:

  Unable to handle kernel paging request at virtual address ffffa64465e54258
  pc : __device_attach_driver+0x14/0x178
  lr : bus_for_each_drv+0xf4/0x14c
  ...
  deferred_probe_work_func+0x88/0xc4

The crashed walk kept the device lock, so every later reboot hung in
device_shutdown.

Unregister them on every unload, unwind a partial registration at init,
and return the init errors instead of ignoring them.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 drivers/soc/google/aoc/alsa/aoc_alsa_drv.c | 66 +++++++++++++++-------
 1 file changed, 45 insertions(+), 21 deletions(-)

diff --git a/drivers/soc/google/aoc/alsa/aoc_alsa_drv.c b/drivers/soc/google/aoc/alsa/aoc_alsa_drv.c
index 23d4154f9..31290e98e 100644
--- a/drivers/soc/google/aoc/alsa/aoc_alsa_drv.c
+++ b/drivers/soc/google/aoc/alsa/aoc_alsa_drv.c
@@ -297,66 +297,83 @@ static int snd_aoc_alsa_probe(void)
 	err = aoc_pcm_init();
 	if (err) {
 		pr_err("ERR:fail to init aoc pcm\n");
-		goto out;
+		return err;
 	}
 
 	err = aoc_voice_init();
 	if (err) {
 		pr_err("ERR: fail to init aoc voice\n");
-		goto out;
+		goto err_voice;
 	}
 
 	err = aoc_compr_init();
 	if (err) {
 		pr_err("ERR:%d failed to init aoc compress offload\n", err);
-		goto out;
+		goto err_compr;
 	}
 
 	err = aoc_path_init();
 	if (err) {
 		pr_err("ERR: fail to init aoc path\n");
-		goto out;
+		goto err_path;
 	}
 
 	err = aoc_nohost_init();
 	if (err) {
 		pr_err("ERR: fail to init aoc nohost driver\n");
-		goto out;
+		goto err_nohost;
 	}
 
 	err = aoc_incall_init();
 	if (err) {
 		pr_err("ERR: fail to init aoc incall driver\n");
-		goto out;
+		goto err_incall;
 	}
 
 	err = aoc_voip_init();
 	if (err) {
 		pr_err("ERR: fail to init aoc voip driver\n");
-		goto out;
+		goto err_voip;
 	}
 
 	err = aoc_usb_init();
 	if (err) {
 		pr_err("ERR: fail to init aoc usb driver\n");
-		goto out;
+		goto err_usb;
 	}
 
 	err = aoc_dp_init();
 	if (err) {
 		pr_err("ERR: fail to init aoc dp driver\n");
-		goto out;
+		goto err_dp;
 	}
 
 	return 0;
 
-out:
+err_dp:
+	aoc_usb_exit();
+err_usb:
+	aoc_voip_exit();
+err_voip:
+	aoc_incall_exit();
+err_incall:
+	aoc_nohost_exit();
+err_nohost:
+	aoc_path_exit();
+err_path:
+	aoc_compr_exit();
+err_compr:
+	aoc_voice_exit();
+err_voice:
+	aoc_pcm_exit();
 	return err;
 }
 
-static int snd_aoc_alsa_remove(void)
+/* Undoes snd_aoc_alsa_probe(): every platform driver it registered. */
+static void snd_aoc_alsa_remove(void)
 {
 	aoc_dp_exit();
+	aoc_usb_exit();
 	aoc_voip_exit();
 	aoc_incall_exit();
 	aoc_nohost_exit();
@@ -364,8 +381,6 @@ static int snd_aoc_alsa_remove(void)
 	aoc_compr_exit();
 	aoc_voice_exit();
 	aoc_pcm_exit();
-
-	return 0;
 }
 
 static int aoc_alsa_probe(struct aoc_service_dev *adev)
@@ -500,7 +515,7 @@ static struct aoc_driver aoc_alsa_driver = {
 
 static int __init aoc_alsa_init(void)
 {
-	int i;
+	int i, err;
 
 	pr_debug("aoc alsa driver init\n");
 
@@ -515,8 +530,15 @@ static int __init aoc_alsa_init(void)
 		init_waitqueue_head(&service_lists[i].wait_head);
 	}
 
-	snd_aoc_alsa_probe();
-	aoc_driver_register(&aoc_alsa_driver);
+	err = snd_aoc_alsa_probe();
+	if (err)
+		return err;
+
+	err = aoc_driver_register(&aoc_alsa_driver);
+	if (err) {
+		snd_aoc_alsa_remove();
+		return err;
+	}
 
 	pr_debug("aoc alsa driver init done\n");
 	return 0;
@@ -526,11 +548,13 @@ static void __exit aoc_alsa_exit(void)
 {
 	pr_debug("aoc alsa driver exit\n");
 
-	if (drv_registered) {
-		snd_aoc_alsa_remove();
-		drv_registered = false;
-	}
-
+	/*
+	 * The platform drivers were registered at init, whether or not the AoC
+	 * services ever came up (drv_registered): always unregister them, or
+	 * the platform bus keeps pointers into this module after it is gone.
+	 */
+	snd_aoc_alsa_remove();
+	drv_registered = false;
 	aoc_driver_unregister(&aoc_alsa_driver);
 	cleanup_resources();
 }

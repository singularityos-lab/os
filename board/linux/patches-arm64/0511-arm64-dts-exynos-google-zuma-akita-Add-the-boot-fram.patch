From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DarekM <149845949+aninmucek@users.noreply.github.com>
Date: Tue, 3 Nov 2026 20:23:02 +0000
Subject: [PATCH] arm64: dts: exynos: google: zuma-akita: Add the boot
 framebuffer

Assisted-by: Claude Opus 5.5
Signed-off-by: DarekM <149845949+aninmucek@users.noreply.github.com>
---
 .../boot/dts/exynos/google/zuma-akita.dts     | 29 +++++++++++++++++++
 1 file changed, 29 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zuma-akita.dts b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
index 8aadf4edc..381ad1e0e 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
+++ b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
@@ -45,6 +45,35 @@ chosen {
 		 * stalls, so that panic=10 resets the phone by itself.
 		 */
 		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init";
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * ABL's splash, still scanned out at handover: DPP0's
+		 * RDMA_BASEADDR_P0 (0x19900040) reads 0xfac00000 on a booted
+		 * phone, as on the Pixel 8 Pro. The panel is DSI command mode,
+		 * so new frames reach it only once DECON0's trigger is unmasked.
+		 */
+		framebuffer0: framebuffer {
+			compatible = "simple-framebuffer";
+			memory-region = <&cont_splash_mem>;
+			width = <1080>;
+			height = <2400>;
+			stride = <(1080 * 4)>;
+			format = "a8r8g8b8";
+		};
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		cont_splash_mem: splash@fac00000 {
+			reg = <0x0 0xfac00000 (1080 * 2400 * 4)>;
+			no-map;
+		};
 	};
 };
 

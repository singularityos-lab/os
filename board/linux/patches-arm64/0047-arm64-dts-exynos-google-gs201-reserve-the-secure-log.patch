From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Sun, 11 Oct 2026 23:33:50 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: reserve the secure log,
 modem, AoC and ECT regions

Stock keeps seclog (written by the secure world at runtime), the modem's
shared memory, AoC's xHCI DMA buffer and the ECT clock tables out of the
kernel. Without them these 45 MB were ordinary System RAM, so the
allocator could hand them out while firmware writes there. Found by
comparing every stock reserved-memory node against /proc/iomem.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/google/gs201.dtsi | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index 5cd1f0832..408611317 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -163,12 +163,24 @@ reserved-memory {
 		#size-cells = <1>;
 		ranges;
 
+		/*
+		 * Regions the stock firmware and Android keep out of the kernel's
+		 * hands. seclog is written by the secure world while Linux runs;
+		 * the modem and AoC regions are DMA targets once those cores run;
+		 * ect holds the bootloader's clock tables. Left as System RAM they
+		 * can be handed out and overwritten under us.
+		 */
+		ect@90000000 { reg = <0x0 0x90000000 0x3a000>; no-map; };
 		gsa@90200000 { reg = <0x0 0x90200000 0x400000>; no-map; };
 		tpu-ctx@91e00000 { reg = <0x0 0x91e00000 0x1200000>; no-map; };
 		tpu-fw@93000000 { reg = <0x0 0x93000000 0x1000000>; no-map; };
 		aoc@94000000 { reg = <0x0 0x94000000 0x3000000>; no-map; };
+		xhci-dma@97000000 { reg = <0x0 0x97000000 0x400000>; no-map; };
 		gxp@98000000 { reg = <0x0 0x98000000 0x500000>; no-map; };
+		seclog@c3000000 { reg = <0x0 0xc3000000 0x80000>; no-map; };
 		dss@d8100000 { reg = <0x0 0xd8100000 0x5f20000>; no-map; };
+		cp-rmem1@e8000000 { reg = <0x0 0xe8000000 0x2000000>; no-map; };
+		cp-rmem@ea400000 { reg = <0x0 0xea400000 0x800000>; no-map; };
 		abl@f8800000 { reg = <0x0 0xf8800000 0x2000000>; no-map; };
 		debug@fd3f0000 { reg = <0x0 0xfd3f0000 0x10000>; no-map; };
 		bldr-log@fd800000 { reg = <0x0 0xfd800000 0x100000>; no-map; };

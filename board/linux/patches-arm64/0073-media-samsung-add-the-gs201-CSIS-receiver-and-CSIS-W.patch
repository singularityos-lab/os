+static int gs201_csis_subscribe_event(struct v4l2_subdev *sd, struct v4l2_fh *fh,
+				      struct v4l2_event_subscription *sub)
+{
+	if (sub->type != V4L2_EVENT_FRAME_SYNC)
+		return -EINVAL;
+
+	return v4l2_event_subscribe(fh, sub, 0, NULL);
+}

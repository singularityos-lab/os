From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lef <me@lefteros.com>
Date: Sat, 7 Nov 2026 11:42:48 +0200
Subject: [PATCH] clk: samsung: clk-zuma: add CMU_HSI0 USI3 clocks

Add the USI3 mux, divider and gates next to USI2's, with the same
shape, parents and flags, so a spi21 node can take its clocks. The
registers are Google's, from the zuma CMU_HSI0 tables: the mux
CLK_CON_MUX_MUX_CLK_HSI0_USI3 at 0x1020, the divider
CLK_CON_DIV_DIV_CLK_HSI0_USI3 at 0x1820, the source gate
CLK_CON_GAT_GATE_CLK_HSI0_USI3 at 0x2124, the IP clock gate at 0x2104
and the PCLK gate at 0x2108, bit 21 as for USI2.

CLK_IGNORE_UNUSED keeps the gates as the bootloader left them until a
spi21 node is enabled; nothing consumes them in the default device
tree. The three gate registers join hsi0_regs, as USI2's did. As for
USI2, the divider is not in that list and the RSTNSYNC gate is not
described.

Built, not booted.

Signed-off-by: Lef <me@lefteros.com>
---
 drivers/clk/samsung/clk-zuma.c | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/samsung/clk-zuma.c b/drivers/clk/samsung/clk-zuma.c
index 833d676e8..03648acdb 100644
--- a/drivers/clk/samsung/clk-zuma.c
+++ b/drivers/clk/samsung/clk-zuma.c
@@ -220,11 +220,15 @@ static const struct samsung_mux_clock hsi0_muxes[] __initconst = {
 	      mout_hsi0_peri_user_parents, 0x680, 4, 1, 0, CLK_MUX_READ_ONLY),
 	MUX_F(CLK_MOUT_HSI0_USI2, "zuma_mout_hsi0_usi2", mout_hsi0_usi2_parents,
 	      0x101c, 0, 1, 0, CLK_MUX_READ_ONLY),
+	MUX_F(CLK_MOUT_HSI0_USI3, "zuma_mout_hsi0_usi3", mout_hsi0_usi2_parents,
+	      0x1020, 0, 1, 0, CLK_MUX_READ_ONLY),
 };
 
 static const struct samsung_div_clock hsi0_dividers[] __initconst = {
 	DIV(CLK_DOUT_HSI0_USI2, "zuma_dout_hsi0_usi2",
 	    "zuma_gout_hsi0_usi2_source", 0x181c, 0, 4),
+	DIV(CLK_DOUT_HSI0_USI3, "zuma_dout_hsi0_usi3",
+	    "zuma_gout_hsi0_usi3_source", 0x1820, 0, 4),
 };
 
 static const struct samsung_gate_clock hsi0_gates[] __initconst = {
@@ -235,6 +239,13 @@ static const struct samsung_gate_clock hsi0_gates[] __initconst = {
 	     CLK_IGNORE_UNUSED | CLK_SET_RATE_PARENT, 0),
 	GATE(CLK_GOUT_HSI0_USI2_PCLK, "zuma_gout_hsi0_usi2_pclk",
 	     "zuma_mout_hsi0_noc_local", 0x2100, 21, CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_HSI0_USI3_SOURCE, "zuma_gout_hsi0_usi3_source",
+	     "zuma_mout_hsi0_usi3", 0x2124, 21, CLK_IGNORE_UNUSED, 0),
+	GATE(CLK_GOUT_HSI0_USI3_IP, "zuma_gout_hsi0_usi3_ip",
+	     "zuma_dout_hsi0_usi3", 0x2104, 21,
+	     CLK_IGNORE_UNUSED | CLK_SET_RATE_PARENT, 0),
+	GATE(CLK_GOUT_HSI0_USI3_PCLK, "zuma_gout_hsi0_usi3_pclk",
+	     "zuma_mout_hsi0_noc_local", 0x2108, 21, CLK_IGNORE_UNUSED, 0),
 };
 
 /* Firmware-owned gates are observed, never switched. */
@@ -243,9 +254,9 @@ static const struct samsung_gate_clock hsi0_ro_gates[] __initconst = {
 	     0x204c, 21, CLK_IGNORE_UNUSED, 0),
 };
 
-/* USI2's gates run in manual mode; the rest of HSI0 is left alone. */
+/* The USI2 and USI3 gates run in manual mode; the rest of HSI0 is left alone. */
 static const unsigned long hsi0_regs[] __initconst = {
-	0x2120, 0x20fc, 0x2100,
+	0x2120, 0x20fc, 0x2100, 0x2124, 0x2104, 0x2108,
 };
 
 static const struct samsung_cmu_info hsi0_cmu __initconst = {
@@ -257,7 +268,7 @@ static const struct samsung_cmu_info hsi0_cmu __initconst = {
 	.nr_gate_clks = ARRAY_SIZE(hsi0_gates),
 	.ro_gate_clks = hsi0_ro_gates,
 	.nr_ro_gate_clks = ARRAY_SIZE(hsi0_ro_gates),
-	.nr_clk_ids = CLK_GOUT_HSI0_USI2_PCLK + 1,
+	.nr_clk_ids = CLK_GOUT_HSI0_USI3_PCLK + 1,
 	.clk_regs = hsi0_regs,
 	.nr_clk_regs = ARRAY_SIZE(hsi0_regs),
 	.clk_name = "bus",

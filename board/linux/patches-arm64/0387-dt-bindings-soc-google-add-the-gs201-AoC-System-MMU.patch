From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 12:56:52 -0400
Subject: [PATCH] dt-bindings: soc: google: add the gs201 AoC System MMU

The AoC (audio and sensor DSP) reaches memory and a few AP peripherals
through its own Samsung System MMU, version 8. Only the AoC is behind
it.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 .../soc/google/google,gs201-aoc-sysmmu.yaml   | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/google/google,gs201-aoc-sysmmu.yaml

diff --git a/Documentation/devicetree/bindings/soc/google/google,gs201-aoc-sysmmu.yaml b/Documentation/devicetree/bindings/soc/google/google,gs201-aoc-sysmmu.yaml
new file mode 100644
index 000000000..6d9f4c2d5
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/google/google,gs201-aoc-sysmmu.yaml
@@ -0,0 +1,43 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/google/google,gs201-aoc-sysmmu.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Google gs201 AoC System MMU
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+description:
+  The Samsung System MMU (version 8) in front of the gs201 AoC, the audio
+  and sensor DSP. Only the AoC is behind it. It is programmed with the fixed
+  translation windows the AoC firmware expects, by the AoC driver, while the
+  AoC block is powered.
+
+properties:
+  compatible:
+    const: google,gs201-aoc-sysmmu
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    description: the non-secure fault interrupt
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    sysmmu@1a090000 {
+        compatible = "google,gs201-aoc-sysmmu";
+        reg = <0x1a090000 0x10000>;
+        interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
+    };

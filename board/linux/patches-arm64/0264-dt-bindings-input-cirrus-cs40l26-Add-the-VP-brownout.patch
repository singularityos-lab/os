From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Tue, 27 Oct 2026 12:35:06 -0647
Subject: [PATCH] dt-bindings: input: cirrus,cs40l26: Add the VP brownout
 threshold

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../devicetree/bindings/input/cirrus,cs40l26.yaml        | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/Documentation/devicetree/bindings/input/cirrus,cs40l26.yaml b/Documentation/devicetree/bindings/input/cirrus,cs40l26.yaml
index d94e34161..577c33386 100644
--- a/Documentation/devicetree/bindings/input/cirrus,cs40l26.yaml
+++ b/Documentation/devicetree/bindings/input/cirrus,cs40l26.yaml
@@ -49,6 +49,15 @@ properties:
     multipleOf: 50000
     default: 11000000
 
+  cirrus,vpbr-threshold-microvolt:
+    description:
+      Enable hardware attenuation when the amplifier and boost input supply
+      falls below this voltage. The attack, hold and release policy uses the
+      Cirrus default settings. If absent, leave VP brownout prevention unchanged.
+    minimum: 2497000
+    maximum: 3874000
+    multipleOf: 47000
+
   cirrus,lra-f0-hz:
     description: Nominal resonant frequency of the actuator.
     minimum: 50

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Sun, 1 Nov 2026 18:40:28 -0647
Subject: [PATCH] soc: google: gnssif_spi: take the core's requests only while
 gnss_ipc is open

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../soc/google/gnssif_spi/gnss_io_device.c    | 11 ++++-
 .../google/gnssif_spi/gnss_keplerctl_device.c | 46 +++++++++++++------
 drivers/soc/google/gnssif_spi/gnss_main.c     | 12 ++---
 drivers/soc/google/gnssif_spi/gnss_prj.h      |  5 ++
 4 files changed, 50 insertions(+), 24 deletions(-)

diff --git a/drivers/soc/google/gnssif_spi/gnss_io_device.c b/drivers/soc/google/gnssif_spi/gnss_io_device.c
index 0bbd224c7..deafeacf2 100644
--- a/drivers/soc/google/gnssif_spi/gnss_io_device.c
+++ b/drivers/soc/google/gnssif_spi/gnss_io_device.c
@@ -60,7 +60,11 @@ static int misc_open(struct inode *inode, struct file *filp)
 
 	filp->private_data = (void *)iod;
 
+	mutex_lock(&iod->open_lock);
 	ref_cnt = atomic_inc_return(&iod->opened);
+	if (ref_cnt == 1)
+		gnss_ctl_irq_on(iod->gc);
+	mutex_unlock(&iod->open_lock);
 
 	gif_info("%s (opened %d)\n", iod->name, ref_cnt);
 
@@ -72,9 +76,13 @@ static int misc_release(struct inode *inode, struct file *filp)
 	struct io_device *iod = (struct io_device *)filp->private_data;
 	int ref_cnt;
 
+	mutex_lock(&iod->open_lock);
 	ref_cnt = atomic_dec_return(&iod->opened);
-	if (ref_cnt == 0)
+	if (ref_cnt == 0) {
+		gnss_ctl_irq_off(iod->gc);
 		skb_queue_purge(&iod->sk_rx_q);
+	}
+	mutex_unlock(&iod->open_lock);
 
 	gif_info("%s (opened %d)\n", iod->name, ref_cnt);
 
@@ -216,6 +224,7 @@ static int init_io_device(struct io_device *iod, struct device *dev)
 
 	init_waitqueue_head(&iod->wq);
 	skb_queue_head_init(&iod->sk_rx_q);
+	mutex_init(&iod->open_lock);
 
 	iod->miscdev.minor = MISC_DYNAMIC_MINOR;
 	iod->miscdev.name = iod->name;
diff --git a/drivers/soc/google/gnssif_spi/gnss_keplerctl_device.c b/drivers/soc/google/gnssif_spi/gnss_keplerctl_device.c
index 0288031b6..a2a216d0d 100644
--- a/drivers/soc/google/gnssif_spi/gnss_keplerctl_device.c
+++ b/drivers/soc/google/gnssif_spi/gnss_keplerctl_device.c
@@ -51,11 +51,39 @@ static int kepler_betp_int_status(struct gnss_ctl *gc)
 	return gpiod_get_value(gc->gpio_ap2gnss_spi.desc);
 }
 
-static void gnss_disable_irq_wake(void *data)
+/*
+ * Take the core's requests only while /dev/gnss_ipc is open: what it
+ * sends with nobody listening is thrown away at the last release anyway,
+ * and a request line that rises while the modem is off or starting can't
+ * set the read work going.
+ */
+void gnss_ctl_irq_on(struct gnss_ctl *gc)
 {
-	struct gnss_ctl *gc = data;
+	int ret;
 
-	disable_irq_wake(gc->irq_gnss2ap_spi.num);
+	/* Without a wake source GNSS still works; it can't wake the AP. */
+	ret = enable_irq_wake(gc->irq_gnss2ap_spi.num);
+	if (ret)
+		gif_err("Failed to enable wakeup_source - enable_irq_wake(%d)\n", ret);
+	else
+		gc->irq_wake = true;
+
+	gif_enable_irq(&gc->irq_gnss2ap_spi);
+}
+
+void gnss_ctl_irq_off(struct gnss_ctl *gc)
+{
+	struct link_device *ld = gc->iod->ld;
+
+	/* The read work enables the interrupt again when it ends. */
+	gif_disable_irq_sync(&gc->irq_gnss2ap_spi);
+	cancel_delayed_work_sync(&ld->rx_dwork);
+	gif_disable_irq_sync(&gc->irq_gnss2ap_spi);
+
+	if (gc->irq_wake) {
+		disable_irq_wake(gc->irq_gnss2ap_spi.num);
+		gc->irq_wake = false;
+	}
 }
 
 static void gnss_set_ops(struct gnss_ctl *gc)
@@ -87,7 +115,7 @@ static int init_ctl_device(struct gnss_ctl *gc, struct gnss_pdata *pdata)
 	}
 	gc->irq_gnss2ap_spi.num = ret;
 
-	/* Disable the interrupt until gnss_main.c probe function finish */
+	/* Disabled until /dev/gnss_ipc is opened */
 	gif_configure_irq(&gc->irq_gnss2ap_spi, gc->irq_gnss2ap_spi.num,
 			"kepler_spi_irq_handler", IRQF_TRIGGER_HIGH | IRQF_NO_AUTOEN);
 
@@ -97,16 +125,6 @@ static int init_ctl_device(struct gnss_ctl *gc, struct gnss_pdata *pdata)
 		return ret;
 	}
 
-	/* Without a wake source GNSS still works; it can't wake the AP. */
-	ret = enable_irq_wake(gc->irq_gnss2ap_spi.num);
-	if (ret) {
-		gif_err("Failed to enable wakeup_source - enable_irq_wake(%d)\n", ret);
-	} else {
-		ret = devm_add_action_or_reset(gc->dev, gnss_disable_irq_wake, gc);
-		if (ret)
-			return ret;
-	}
-
 	/* The line starts low, as Google's driver sets it. */
 	gc->gpio_ap2gnss_spi.label = "AP2GNSS_SPI";
 	gc->gpio_ap2gnss_spi.desc = devm_gpiod_get(gc->dev, "ap2gnss-spi", GPIOD_OUT_LOW);
diff --git a/drivers/soc/google/gnssif_spi/gnss_main.c b/drivers/soc/google/gnssif_spi/gnss_main.c
index f6ac72ec0..5db532baf 100644
--- a/drivers/soc/google/gnssif_spi/gnss_main.c
+++ b/drivers/soc/google/gnssif_spi/gnss_main.c
@@ -122,16 +122,13 @@ static struct gnss_pdata *gnss_if_parse_dt_pdata(struct device *dev)
 static void gnss_remove(struct platform_device *pdev)
 {
 	struct gnss_ctl *gc = platform_get_drvdata(pdev);
-	struct link_device *ld = gc->iod->ld;
 
 	/*
-	 * The read work enables the interrupt again when it ends, so stop it
-	 * before the interrupt is disabled for good. devm then releases the
-	 * device node, the work queue and the interrupt.
+	 * Nobody holds /dev/gnss_ipc open (it pins the module), so the
+	 * interrupt is off already; devm releases the device node, the work
+	 * queue and the interrupt.
 	 */
 	gif_disable_irq_sync(&gc->irq_gnss2ap_spi);
-	cancel_delayed_work_sync(&ld->rx_dwork);
-	gif_disable_irq_sync(&gc->irq_gnss2ap_spi);
 
 	gpiod_set_value(gc->gpio_ap2gnss_spi.desc, 0);
 }
@@ -187,9 +184,6 @@ static int gnss_probe(struct platform_device *pdev)
 
 	platform_set_drvdata(pdev, gc);
 
-	/* wa: to prevent wrong irq handling during probe */
-	gif_enable_irq(&gc->irq_gnss2ap_spi);
-
 	gif_info("%s: ---\n", pdev->name);
 
 	return 0;
diff --git a/drivers/soc/google/gnssif_spi/gnss_prj.h b/drivers/soc/google/gnssif_spi/gnss_prj.h
index 8e51d32d0..2aefdeea9 100644
--- a/drivers/soc/google/gnssif_spi/gnss_prj.h
+++ b/drivers/soc/google/gnssif_spi/gnss_prj.h
@@ -8,6 +8,7 @@
 #define __GNSS_PRJ_H__
 
 #include <linux/miscdevice.h>
+#include <linux/mutex.h>
 #include <linux/skbuff.h>
 #include <linux/interrupt.h>
 #include <linux/spinlock.h>
@@ -22,6 +23,7 @@ struct io_device {
 	struct link_device *ld;
 	struct gnss_ctl *gc;
 	atomic_t opened;
+	struct mutex open_lock;	/* the first open and the last release */
 	wait_queue_head_t wq;
 	struct miscdevice miscdev;
 	struct sk_buff_head sk_rx_q;
@@ -67,9 +69,12 @@ struct gnss_ctl {
 	atomic_t wait_rdy;
 	atomic_t tx_in_progress;
 	atomic_t rx_in_progress;
+	bool irq_wake;
 };
 
 struct gnss_ctl *create_ctl_device(struct platform_device *pdev);
+void gnss_ctl_irq_on(struct gnss_ctl *gc);
+void gnss_ctl_irq_off(struct gnss_ctl *gc);
 struct link_device *create_link_device(struct platform_device *pdev);
 struct io_device *create_io_device(struct platform_device *pdev,
 		struct link_device *ld, struct gnss_ctl *gc, struct gnss_pdata *pdata);

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: saiththerobo <the.tom.sharp@gmail.com>
Date: Thu, 15 Oct 2026 14:28:08 +0100
Subject: [PATCH] dt-bindings: input: touchscreen: samsung,s6sy761: add the
 S6SY792

The touchscreen in the Pixel 6 Pro speaks the S6SY761's command set over
SPI rather than I2C. Add its compatible, the SPI peripheral properties,
and an optional reset GPIO, which Google's sec_ts driver pulses after
power-up.

No public source names the part. The name comes from the chip itself:
its device ID register reads 0x3792, and Google ships one firmware file,
s6sy79x.bin, for the whole S6SY79x line, so the part is taken to be the
S6SY792. Whoever takes this upstream may want to revisit it; an S6SY761
reading 0x3761 from the same register would confirm the pattern. There
is no samsung,s6sy761 fallback: the upstream S6SY761 driver is I2C-only,
so no older driver could bind through it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 .../input/touchscreen/samsung,s6sy761.yaml    | 39 ++++++++++++++++++-
 1 file changed, 37 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml b/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml
index 1ffd17af3..8e175ae14 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/samsung,s6sy761.yaml
@@ -4,17 +4,24 @@
 $id: http://devicetree.org/schemas/input/touchscreen/samsung,s6sy761.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Samsung S6SY761 touchscreen controller
+title: Samsung S6SY761 and S6SY79x touchscreen controllers
+
+description:
+  The S6SY761 is connected over I2C. The S6SY79x speaks the same command
+  set over SPI, with Samsung's framing.
 
 maintainers:
   - Andi Shyti <andi.shyti@kernel.org>
 
 allOf:
   - $ref: touchscreen.yaml#
+  - $ref: /schemas/spi/spi-peripheral-props.yaml#
 
 properties:
   compatible:
-    const: samsung,s6sy761
+    enum:
+      - samsung,s6sy761
+      - samsung,s6sy792
 
   reg:
     maxItems: 1
@@ -22,6 +29,12 @@ properties:
   interrupts:
     maxItems: 1
 
+  reset-gpios:
+    maxItems: 1
+
+  spi-cpha: true
+  spi-cpol: true
+
   avdd-supply: true
   vdd-supply: true
 
@@ -52,3 +65,25 @@ examples:
             touchscreen-size-y = <4096>;
         };
     };
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+    spi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@0 {
+            compatible = "samsung,s6sy792";
+            reg = <0>;
+            spi-max-frequency = <10000000>;
+            spi-cpol;
+            spi-cpha;
+            interrupt-parent = <&gpa9>;
+            interrupts = <0 IRQ_TYPE_LEVEL_LOW>;
+            reset-gpios = <&gpp26 0 GPIO_ACTIVE_LOW>;
+            avdd-supply = <&ldo26m>;
+            vdd-supply = <&ldo25m>;
+            touchscreen-size-x = <1440>;
+            touchscreen-size-y = <3120>;
+        };
+    };

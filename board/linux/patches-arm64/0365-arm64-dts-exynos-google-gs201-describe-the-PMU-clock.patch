From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 17:19:55 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: describe the PMU clock
 outputs

Make the PMU a provider of its two clock output pads (CLKOUT0, CLKOUT1),
fed from the TCXO (oscclk) as mux input 0.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 arch/arm64/boot/dts/exynos/google/gs201.dtsi | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index bc2375a37..a9b4470bd 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -1479,6 +1479,10 @@ sysreg_apm: syscon@18020000 {
 		pmu_system_controller: system-controller@18060000 {
 			compatible = "google,gs201-pmu", "google,gs101-pmu";
 			reg = <0x18060000 0x10000>;
+			/* CLKOUT0/1 pads (PAD_CTRL_CLKOUTn), fed from the TCXO */
+			#clock-cells = <1>;
+			clocks = <&oscclk>;
+			clock-names = "clkout0";
 			google,pmu-intr-gen-syscon = <&pmu_intr_gen>;
 
 			syscon-poweroff {

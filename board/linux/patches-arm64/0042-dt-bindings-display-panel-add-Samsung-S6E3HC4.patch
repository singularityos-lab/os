From: Derek Ross <derekross@gmail.com>
Date: Sun, 11 Oct 2026 22:23:22 -0400
Subject: [PATCH] dt-bindings: display: panel: add Samsung S6E3HC4

Assisted-by: Claude:claude-opus-5-5
---
 .../display/panel/samsung,s6e3hc4.yaml        | 66 +++++++++++++++++++
 1 file changed, 66 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/display/panel/samsung,s6e3hc4.yaml

diff --git a/Documentation/devicetree/bindings/display/panel/samsung,s6e3hc4.yaml b/Documentation/devicetree/bindings/display/panel/samsung,s6e3hc4.yaml
new file mode 100644
index 000000000..39c26ee09
--- /dev/null
+++ b/Documentation/devicetree/bindings/display/panel/samsung,s6e3hc4.yaml
@@ -0,0 +1,66 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/display/panel/samsung,s6e3hc4.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S6E3HC4 AMOLED DSI panel
+
+description:
+  The S6E3HC4 is a display driver IC from Samsung Mobile Display, driving
+  the 1440x3120 command-mode AMOLED panel of the Google Pixel 7 Pro. The
+  panel takes DSC-compressed pixel data over four MIPI DSI lanes and
+  reports its refresh timing on a tearing effect (TE) line.
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+allOf:
+  - $ref: panel-common.yaml#
+
+properties:
+  compatible:
+    const: samsung,s6e3hc4
+
+  reg:
+    maxItems: 1
+
+  reset-gpios: true
+
+  vddi-supply:
+    description: I/O supply (1.8 V)
+
+  vddd-supply:
+    description: Digital core supply (1.125 V)
+
+  vci-supply:
+    description: Analog supply (3.0 V)
+
+required:
+  - compatible
+  - reg
+  - reset-gpios
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    dsi {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        panel@0 {
+            compatible = "samsung,s6e3hc4";
+            reg = <0>;
+            reset-gpios = <&gpa7 1 GPIO_ACTIVE_LOW>;
+            vddi-supply = <&vddi>;
+            vddd-supply = <&vddd>;
+            vci-supply = <&vci>;
+            width-mm = <71>;
+            height-mm = <155>;
+        };
+    };
+
+...

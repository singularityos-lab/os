From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Gray <chrisgray70@gmail.com>
Date: Wed, 11 Nov 2026 12:20:03 -0600
Subject: [PATCH] dt-bindings: input: st,salixp: describe ALIX bus ownership

Add the distinct ALIX compatible and its active-low AP request and
acknowledgment GPIOs. Keep the SALIXP binding unchanged.

Assisted-by: LLM
Signed-off-by: Chris Gray <chrisgray70@gmail.com>
---
 .../bindings/input/touchscreen/st,salixp.yaml | 26 ++++++++++++++++---
 1 file changed, 22 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/input/touchscreen/st,salixp.yaml b/Documentation/devicetree/bindings/input/touchscreen/st,salixp.yaml
index 323299632..848ba9a6f 100644
--- a/Documentation/devicetree/bindings/input/touchscreen/st,salixp.yaml
+++ b/Documentation/devicetree/bindings/input/touchscreen/st,salixp.yaml
@@ -4,23 +4,33 @@
 $id: http://devicetree.org/schemas/input/touchscreen/st,salixp.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: STMicroelectronics SALIXP SPI touch controller
+title: STMicroelectronics SALIXP and ALIX SPI touch controllers
 
 maintainers:
   - David A. Buser <code@booze.dog>
 
 description:
   STMicroelectronics SALIXP touch controller on SPI. SALIXP is the FTS
-  part whose chip id is 36 40. The I2C FingerTip controller is
-  st,stmfts and is a different device.
+  part whose chip id is 36 40; ALIX has chip id 36 48. The I2C
+  FingerTip controller is st,stmfts and is a different device.
 
 allOf:
   - $ref: /schemas/spi/spi-peripheral-props.yaml#
   - $ref: touchscreen.yaml#
+  - if:
+      properties:
+        compatible:
+          const: st,alix
+    then:
+      required:
+        - bus-request-gpios
+        - bus-ack-gpios
 
 properties:
   compatible:
-    const: st,salixp
+    enum:
+      - st,salixp
+      - st,alix
 
   reg:
     maxItems: 1
@@ -36,6 +46,14 @@ properties:
     description: Active-low reset
     maxItems: 1
 
+  bus-request-gpios:
+    description: Active-low AP bus request
+    maxItems: 1
+
+  bus-ack-gpios:
+    description: Active-low acknowledgment of AP bus ownership
+    maxItems: 1
+
   spi-max-frequency: true
 
 required:

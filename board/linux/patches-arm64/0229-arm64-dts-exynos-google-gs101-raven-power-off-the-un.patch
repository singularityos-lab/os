From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: saiththerobo <the.tom.sharp@gmail.com>
Date: Mon, 26 Oct 2026 08:19:45 +0000
Subject: [PATCH] arm64: dts: exynos: google: gs101-raven: power off the unused
 domains

Let genpd power off the blocks nothing on raven uses yet (TPU, BO, MFC,
G2D and the camera pipeline), and drop pd_ignore_unused from bootargs.
About 45 mA less with the screen on (measured with the earlier
direct-regmap driver, the same register writes). The AoC's domain stays
on: the AoC runs, and its driver will own the domain.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 .../boot/dts/exynos/google/gs101-raven.dts    | 55 ++++++++++++++++++-
 1 file changed, 54 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
index 133f470ce..1670a2ec7 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
@@ -26,7 +26,7 @@ chosen {
 		 * panic is silent: panic=10 reboots instead of hanging. init hands
 		 * over to the Arch root on userdata when it finds one.
 		 */
-		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init";
+		bootargs = "console=tty0 panic=10 clk_ignore_unused rdinit=/init";
 	};
 };
 
@@ -68,6 +68,59 @@ bluetooth {
 	};
 };
 
+/* Unused blocks the bootloader leaves powered: genpd turns them off */
+&pd_g2d {
+	status = "okay";
+};
+
+&pd_mfc {
+	status = "okay";
+};
+
+&pd_csis {
+	status = "okay";
+};
+
+&pd_pdp {
+	status = "okay";
+};
+
+&pd_dns {
+	status = "okay";
+};
+
+&pd_g3aa {
+	status = "okay";
+};
+
+&pd_ipp {
+	status = "okay";
+};
+
+&pd_itp {
+	status = "okay";
+};
+
+&pd_mcsc {
+	status = "okay";
+};
+
+&pd_gdc {
+	status = "okay";
+};
+
+&pd_tnr {
+	status = "okay";
+};
+
+&pd_bo {
+	status = "okay";
+};
+
+&pd_tpu {
+	status = "okay";
+};
+
 &cont_splash_mem {
 	reg = <0x0 0xfac00000 (1440 * 3120 * 4)>;
 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Sun, 11 Oct 2026 22:35:55 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201-cheetah: enable the display
 CMUs and DSIM0

Assisted-by: Claude:claude-opus-5-5
---
 arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts b/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
index 550f79923..84bd555f3 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
@@ -121,6 +121,8 @@ &dsi0 {
 	 * mode; simplefb scans out its framebuffer and reads the panel size
 	 * here. Enabled only for display bring-up (DISPLAY-PLAN.md, gate D1).
 	 */
+	status = "okay";
+
 	panel: panel@0 {
 		compatible = "samsung,s6e3hc4";
 		reg = <0>;
@@ -132,6 +134,15 @@ panel: panel@0 {
 	};
 };
 
+/* Display bring-up, gate D1b: the DPU and DISP clock controllers. */
+&cmu_dpu {
+	status = "okay";
+};
+
+&cmu_disp {
+	status = "okay";
+};
+
 &gpu {
 	/* No mali-supply: the G3D rails follow the PMU power domain and ACPM. */
 	status = "okay";

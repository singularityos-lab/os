new file mode 100644
index 000000000..29e63263e
--- /dev/null
+++ b/drivers/soc/google/aoc/aoc_v1.c
@@ -0,0 +1,366 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Google Whitechapel AoC v1 library

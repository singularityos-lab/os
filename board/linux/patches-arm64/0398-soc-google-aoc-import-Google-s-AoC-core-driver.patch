+	kAOCChipProductId = 0x1016,
+	kAOCWifiChip = 0x1017,
+};
+
+#define module_aoc_driver(__aoc_driver)                                        \
+	module_driver(__aoc_driver, aoc_driver_register, aoc_driver_unregister)
+
+#endif /* __KERNEL__ */

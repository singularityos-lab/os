 		/*
 		 * C2: core power-down through PSCI CPU_SUSPEND, with latencies
@@ -154,6 +187,275 @@ hera_cpu_sleep: cpu-hera-sleep {
 		};
 	};
 
+	/*
+	 * CPU levels: the ACPM firmware's own DVFS levels (the ECT the
+	 * bootloader leaves at 0x90000000; the same lists are stock's
+	 * pixel-em table), up to each cluster's max-freq in stock's
+	 * exynos-acme domains (Google's gs201-cpu.dtsi): 1803 MHz little,
+	 * 2348 MHz mid, 2850 MHz big. The firmware sets the rail voltages
+	 * from its fused ASV tables, so there is no opp-microvolt.
+	 *
+	 * Stock caps the mid and big clusters at 1999 and 2252 MHz whenever
+	 * its battery current limiter (BCL) sees the battery voltage droop
+	 * (freq_qos vdroop1/vdroop2/smpl_gm in Google's
+	 * gs201-cloudripper-bcl.dtsi). There is no BCL driver here, so the
+	 * levels above those caps are turbo-mode: off until boost is enabled
+	 * (/sys/devices/system/cpu/cpufreq/boost). opp-suspend is stock's
+	 * resume-freq, the level stock holds through suspend.
+	 */
+	cpucl0_opp_table: opp-table-0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-300000000 {
+			opp-hz = /bits/ 64 <300000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-574000000 {
+			opp-hz = /bits/ 64 <574000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-738000000 {
+			opp-hz = /bits/ 64 <738000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-930000000 {
+			opp-hz = /bits/ 64 <930000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1098000000 {
+			opp-hz = /bits/ 64 <1098000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1197000000 {
+			opp-hz = /bits/ 64 <1197000000>;
+			clock-latency-ns = <500000>;
+			opp-suspend;
+		};
+
+		opp-1328000000 {
+			opp-hz = /bits/ 64 <1328000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1401000000 {
+			opp-hz = /bits/ 64 <1401000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1598000000 {
+			opp-hz = /bits/ 64 <1598000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1704000000 {
+			opp-hz = /bits/ 64 <1704000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1803000000 {
+			opp-hz = /bits/ 64 <1803000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		/* 1950, 2024, 2098 and 2196 MHz stay off, as on stock. */
+	};
+
+	cpucl1_opp_table: opp-table-1 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-400000000 {
+			opp-hz = /bits/ 64 <400000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-553000000 {
+			opp-hz = /bits/ 64 <553000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-696000000 {
+			opp-hz = /bits/ 64 <696000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-799000000 {
+			opp-hz = /bits/ 64 <799000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-910000000 {
+			opp-hz = /bits/ 64 <910000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1024000000 {
+			opp-hz = /bits/ 64 <1024000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1197000000 {
+			opp-hz = /bits/ 64 <1197000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1328000000 {
+			opp-hz = /bits/ 64 <1328000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1491000000 {
+			opp-hz = /bits/ 64 <1491000000>;
+			clock-latency-ns = <500000>;
+			opp-suspend;
+		};
+
+		opp-1663000000 {
+			opp-hz = /bits/ 64 <1663000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1836000000 {
+			opp-hz = /bits/ 64 <1836000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1999000000 {
+			opp-hz = /bits/ 64 <1999000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-2130000000 {
+			opp-hz = /bits/ 64 <2130000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		opp-2253000000 {
+			opp-hz = /bits/ 64 <2253000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		opp-2348000000 {
+			opp-hz = /bits/ 64 <2348000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+

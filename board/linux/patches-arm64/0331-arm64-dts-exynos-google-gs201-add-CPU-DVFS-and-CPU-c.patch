+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-851000000 {
+			opp-hz = /bits/ 64 <851000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-984000000 {
+			opp-hz = /bits/ 64 <984000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1106000000 {
+			opp-hz = /bits/ 64 <1106000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1277000000 {
+			opp-hz = /bits/ 64 <1277000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1426000000 {
+			opp-hz = /bits/ 64 <1426000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1582000000 {
+			opp-hz = /bits/ 64 <1582000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1745000000 {
+			opp-hz = /bits/ 64 <1745000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-1826000000 {
+			opp-hz = /bits/ 64 <1826000000>;
+			clock-latency-ns = <500000>;
+			opp-suspend;
+		};
+
+		opp-2048000000 {
+			opp-hz = /bits/ 64 <2048000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-2188000000 {
+			opp-hz = /bits/ 64 <2188000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-2252000000 {
+			opp-hz = /bits/ 64 <2252000000>;
+			clock-latency-ns = <500000>;
+		};
+
+		opp-2401000000 {
+			opp-hz = /bits/ 64 <2401000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		opp-2507000000 {
+			opp-hz = /bits/ 64 <2507000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		opp-2630000000 {
+			opp-hz = /bits/ 64 <2630000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		opp-2704000000 {
+			opp-hz = /bits/ 64 <2704000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		opp-2802000000 {
+			opp-hz = /bits/ 64 <2802000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		opp-2850000000 {
+			opp-hz = /bits/ 64 <2850000000>;
+			clock-latency-ns = <500000>;
+			turbo-mode;
+		};
+
+		/* 2950, 3097 and 3195 MHz stay off, as on stock. */
+	};
+
 	psci {
 		compatible = "arm,psci-1.0";
 		method = "smc";
@@ -163,6 +465,13 @@ psci {
 	 * Zones on the ACPM TMU sensors (0 big, 1 mid, 2 little, 3 GPU, 4 ISP,
 	 * 5 TPU). Every zone is critical at 110 C, below stock's 120 C "hot"
 	 * trips (Google's gs201-b0.dts).
+	 *
+	 * A CPU zone throttles its cluster from 75 C, as gs101 does: at 75 C
+	 * the mid and big clusters leave their turbo levels at once (states 3
+	 * and 6: 1999 and 2252 MHz), then step down; at 85 C each cluster
+	 * drops to stock's battery-overcurrent caps (BATOILO in Google's
+	 * gs201-cloudripper-bcl.dtsi): 930, 1197 and 1426 MHz, states 7, 8
+	 * and 12. Stock throttles from 100 C.
 	 */
 	thermal-zones {
 		big-thermal {
@@ -171,12 +480,39 @@ big-thermal {
 			thermal-sensors = <&acpm_tmu 0>;
 
 			trips {
+				big_hot: big-hot {
+					temperature = <75000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				/* a fast burst outruns step_wise: throttle deep at once */
+				big_hotter: big-hotter {
+					temperature = <85000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
 				big_crit: big-crit {
 					temperature = <110000>;
 					hysteresis = <0>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&big_hot>;
+					cooling-device = <&cpu6 6 THERMAL_NO_LIMIT>,
+							 <&cpu7 6 THERMAL_NO_LIMIT>;
+				};
+
+				map1 {
+					trip = <&big_hotter>;
+					cooling-device = <&cpu6 12 THERMAL_NO_LIMIT>,
+							 <&cpu7 12 THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		mid-thermal {
@@ -185,12 +521,39 @@ mid-thermal {
 			thermal-sensors = <&acpm_tmu 1>;
 
 			trips {
+				mid_hot: mid-hot {
+					temperature = <75000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				/* a fast burst outruns step_wise: throttle deep at once */
+				mid_hotter: mid-hotter {
+					temperature = <85000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
 				mid_crit: mid-crit {
 					temperature = <110000>;
 					hysteresis = <0>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&mid_hot>;
+					cooling-device = <&cpu4 3 THERMAL_NO_LIMIT>,
+							 <&cpu5 3 THERMAL_NO_LIMIT>;
+				};
+
+				map1 {
+					trip = <&mid_hotter>;
+					cooling-device = <&cpu4 8 THERMAL_NO_LIMIT>,
+							 <&cpu5 8 THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		little-thermal {
@@ -199,12 +562,43 @@ little-thermal {
 			thermal-sensors = <&acpm_tmu 2>;
 
 			trips {
+				little_hot: little-hot {
+					temperature = <75000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				/* a fast burst outruns step_wise: throttle deep at once */
+				little_hotter: little-hotter {
+					temperature = <85000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
 				little_crit: little-crit {
 					temperature = <110000>;
 					hysteresis = <0>;
 					type = "critical";
 				};
 			};
+
+			cooling-maps {
+				map0 {
+					trip = <&little_hot>;
+					cooling-device = <&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
+							 <&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
+				};
+
+				map1 {
+					trip = <&little_hotter>;
+					cooling-device = <&cpu0 7 THERMAL_NO_LIMIT>,
+							 <&cpu1 7 THERMAL_NO_LIMIT>,
+							 <&cpu2 7 THERMAL_NO_LIMIT>,
+							 <&cpu3 7 THERMAL_NO_LIMIT>;
+				};
+			};
 		};
 
 		gpu-thermal {

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=81ngel=20Ren=C3=A9?=
Date: Wed, 4 Nov 2026 19:05:05 +0100
Subject: [PATCH] arm64: dts: exynos: google: gs201-panther: reboot=warm, so
 reboot-to reaches fastboot

Assisted-by: LLM
Signed-off-by: Ángel René <17342133+angelrenefm@users.noreply.github.com>
---
 arch/arm64/boot/dts/exynos/google/gs201-panther.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-panther.dts b/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
index b4a13e17a..7e1640a9b 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
@@ -29,7 +29,7 @@ / {
 
 	chosen {
 		/* ABL requires bootargs to exist; it appends its own after these. */
-		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe mem_sleep_default=s2idle";
+		bootargs = "console=tty0 panic=10 reboot=warm clk_ignore_unused pd_ignore_unused rdinit=/init omamobile.ufs-probe mem_sleep_default=s2idle";
 		#address-cells = <2>;
 		#size-cells = <1>;
 		ranges;

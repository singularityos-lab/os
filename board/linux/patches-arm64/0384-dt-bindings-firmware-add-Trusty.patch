From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 01:33:49 -0400
Subject: [PATCH] dt-bindings: firmware: add Trusty

Trusty is the secure OS that Google's Pixel bootloaders start in the
secure world. Describe the node that tells the kernel it is there, with
its interrupt forwarding (Trusty IPIs mapped onto GIC SGIs), log and
virtio children, as used by the Pixel 7 Pro's stock device tree.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 .../firmware/android,trusty-smc-v1.yaml       | 87 +++++++++++++++++++
 1 file changed, 87 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/firmware/android,trusty-smc-v1.yaml

diff --git a/Documentation/devicetree/bindings/firmware/android,trusty-smc-v1.yaml b/Documentation/devicetree/bindings/firmware/android,trusty-smc-v1.yaml
new file mode 100644
index 000000000..64cc3bbf3
--- /dev/null
+++ b/Documentation/devicetree/bindings/firmware/android,trusty-smc-v1.yaml
@@ -0,0 +1,87 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/firmware/android,trusty-smc-v1.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Trusty secure OS
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+description:
+  Trusty is a secure OS that runs alongside Linux in the secure world and is
+  reached through SMC calls. The node describes the interface to an already
+  running Trusty; its children are the services that ride on it.
+
+properties:
+  compatible:
+    const: android,trusty-smc-v1
+
+  irq:
+    type: object
+    additionalProperties: false
+    description:
+      Forwarding of the interrupts Trusty asks for. Trusty reports the
+      interrupt numbers it uses; those in ipi-range are inter-processor
+      interrupts, mapped onto GIC SGIs.
+    properties:
+      compatible:
+        const: android,trusty-irq-v1
+      ipi-range:
+        $ref: /schemas/types.yaml#/definitions/uint32-array
+        description:
+          First and last Trusty IPI number, and the GIC SGI the first one
+          maps to.
+        items:
+          - description: first Trusty IPI number
+          - description: last Trusty IPI number
+          - description: GIC SGI of the first one
+    required:
+      - compatible
+
+  log:
+    type: object
+    additionalProperties: false
+    description: Trusty's log, copied into the kernel log.
+    properties:
+      compatible:
+        const: android,trusty-log-v1
+    required:
+      - compatible
+
+  virtio:
+    type: object
+    additionalProperties: false
+    description:
+      The virtio devices Trusty exposes, among them the IPC device used to
+      reach trusted applications.
+    properties:
+      compatible:
+        const: android,trusty-virtio-v1
+    required:
+      - compatible
+
+required:
+  - compatible
+
+additionalProperties: false
+
+examples:
+  - |
+    trusty {
+        compatible = "android,trusty-smc-v1";
+
+        irq {
+            compatible = "android,trusty-irq-v1";
+            ipi-range = <8 15 8>;
+        };
+
+        log {
+            compatible = "android,trusty-log-v1";
+        };
+
+        virtio {
+            compatible = "android,trusty-virtio-v1";
+        };
+    };

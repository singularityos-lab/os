From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brett-Michael Green <brett@bmgvisualtech.com>
Date: Sat, 31 Oct 2026 08:15:21 -0400
Subject: [PATCH] dt-bindings: PCI: google,gs201-pcie: Add the zuma controller

Assisted-by: LLM
Signed-off-by: Brett-Michael Green <brett@bmgvisualtech.com>
---
 .../bindings/pci/google,gs201-pcie.yaml       | 26 ++++++++++++++-----
 1 file changed, 20 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml b/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml
index 89e65f2a1..d967492b9 100644
--- a/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml
@@ -4,26 +4,40 @@
 $id: http://devicetree.org/schemas/pci/google,gs201-pcie.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Google gs201 PCIe host controller
+title: Google gs201 and zuma PCIe host controllers
 
 maintainers:
   - Derek Ross <derekross@gmail.com>
 
 description:
-  The PCIe controllers of the Google gs201 (Tensor G2) SoC are Synopsys
-  DesignWare cores (IP version 0x984500) in a Samsung wrapper. The wrapper
+  The PCIe controllers of the Google gs201 (Tensor G2) and zuma (Tensor G3)
+  SoCs are Synopsys DesignWare cores (IP versions 0x984500 and 0x986500) in
+  a Samsung wrapper. The wrapper
   adds a sub-control block (ELBI) with link training control and interrupt
   status, and an I/A sequencer that re-locks the PHY clock-data recovery when
-  the link leaves L1.2. Legacy INTx interrupts are demultiplexed from the
-  controller interrupt by a child interrupt controller.
+  the link leaves L1.2. zuma's Wi-Fi controller runs without the I/A, as on
+  stock. Legacy INTx interrupts are demultiplexed from the controller
+  interrupt by a child interrupt controller.
 
 allOf:
   - $ref: /schemas/pci/pci-host-bridge.yaml#
   - $ref: /schemas/pci/snps,dw-pcie-common.yaml#
+  - if:
+      properties:
+        compatible:
+          const: google,zuma-pcie
+    then:
+      properties:
+        reg:
+          maxItems: 3
+        reg-names:
+          maxItems: 3
 
 properties:
   compatible:
-    const: google,gs201-pcie
+    enum:
+      - google,gs201-pcie
+      - google,zuma-pcie
 
   reg:
     minItems: 3

+
+	/*
+	 * CPU levels: the ACPM firmware's own DVFS levels, from the ECT that the
+	 * bootloader leaves at 0x90000000, up to each cluster's max-freq in
+	 * stock's exynos-acme domains (Google's zuma-cpu.dtsi). The levels
+	 * above, listed in each table, are left out as stock leaves them.
+	 *
+	 * The firmware sets the rail voltages from its fused ASV tables, so
+	 * there is no opp-microvolt, and the energy model can't be computed
+	 * from a power coefficient. opp-microwatt is each level's power in
+	 * stock's default energy model (the pixel-em profile in Google's
+	 * zuma-b0-ipop.dts, the same in the Pixel 8 Pro's own device tree).
+	 *
+	 * Stock caps the mid and big clusters at 1945 and 2294 MHz whenever
+	 * its battery current limiter (BCL) sees the battery voltage droop
+	 * (freq_qos vdroop1/vdroop2/smpl_warn in Google's
+	 * zuma-shusky-bcl.dtsi). There is no BCL driver here, so the levels
+	 * above those caps are turbo-mode: off until boost is enabled
+	 * (/sys/devices/system/cpu/cpufreq/boost).
+	 *
+	 * Those turbo-mode marks are the Pixel 8 Pro's caps, so the CPUs get
+	 * operating-points-v2 in the board file. A board whose BCL caps are
+	 * lower needs tables of its own.
+	 */
+	cpucl0_opp: opp-table-cpucl0 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-324000000 {
+			opp-hz = /bits/ 64 <324000000>;
+			opp-microwatt = <11000>;
+		};
+
+		opp-610000000 {
+			opp-hz = /bits/ 64 <610000000>;
+			opp-microwatt = <12000>;
+		};
+
+		opp-820000000 {
+			opp-hz = /bits/ 64 <820000000>;
+			opp-microwatt = <19000>;
+		};
+
+		opp-955000000 {
+			opp-hz = /bits/ 64 <955000000>;
+			opp-microwatt = <25000>;
+		};
+
+		opp-1098000000 {
+			opp-hz = /bits/ 64 <1098000000>;
+			opp-microwatt = <31000>;
+		};
+
+		opp-1197000000 {
+			opp-hz = /bits/ 64 <1197000000>;
+			opp-microwatt = <37000>;
+		};
+
+		opp-1328000000 {
+			opp-hz = /bits/ 64 <1328000000>;
+			opp-microwatt = <45000>;
+		};
+
+		opp-1425000000 {
+			opp-hz = /bits/ 64 <1425000000>;
+			opp-microwatt = <57000>;
+		};
+
+		opp-1548000000 {
+			opp-hz = /bits/ 64 <1548000000>;
+			opp-microwatt = <155000>;
+		};
+
+		opp-1704000000 {
+			opp-hz = /bits/ 64 <1704000000>;
+			opp-microwatt = <195000>;
+		};
+
+		/* 1785, 1950, 2024, 2098, 2147 and 2253 MHz stay off, as on stock. */
+	};
+
+	cpucl1_opp: opp-table-cpucl1 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-402000000 {
+			opp-hz = /bits/ 64 <402000000>;
+			opp-microwatt = <59000>;
+		};
+
+		opp-578000000 {
+			opp-hz = /bits/ 64 <578000000>;
+			opp-microwatt = <85000>;
+		};
+
+		opp-697000000 {
+			opp-hz = /bits/ 64 <697000000>;
+			opp-microwatt = <106000>;
+		};
+
+		opp-712000000 {
+			opp-hz = /bits/ 64 <712000000>;
+			opp-microwatt = <114000>;
+		};
+
+		opp-910000000 {
+			opp-hz = /bits/ 64 <910000000>;
+			opp-microwatt = <156000>;
+		};
+
+		opp-1065000000 {
+			opp-hz = /bits/ 64 <1065000000>;
+			opp-microwatt = <208000>;
+		};
+
+		opp-1221000000 {
+			opp-hz = /bits/ 64 <1221000000>;
+			opp-microwatt = <266000>;
+		};
+
+		opp-1328000000 {
+			opp-hz = /bits/ 64 <1328000000>;
+			opp-microwatt = <320000>;
+		};
+
+		opp-1418000000 {
+			opp-hz = /bits/ 64 <1418000000>;
+			opp-microwatt = <368000>;
 		};
+
+		opp-1572000000 {
+			opp-hz = /bits/ 64 <1572000000>;
+			opp-microwatt = <449000>;
+		};
+
+		opp-1836000000 {
+			opp-hz = /bits/ 64 <1836000000>;
+			opp-microwatt = <638000>;
+		};
+
+		opp-1945000000 {
+			opp-hz = /bits/ 64 <1945000000>;
+			opp-microwatt = <804000>;
+		};
+
+		opp-2130000000 {
+			opp-hz = /bits/ 64 <2130000000>;
+			opp-microwatt = <1042000>;
+			turbo-mode;
+		};
+
+		opp-2245000000 {
+			opp-hz = /bits/ 64 <2245000000>;
+			opp-microwatt = <1272000>;
+			turbo-mode;
+		};
+
+		opp-2367000000 {
+			opp-hz = /bits/ 64 <2367000000>;
+			opp-microwatt = <1514000>;
+			turbo-mode;
+		};
+
+		/* 2450 and 2600 MHz stay off, as on stock. */
+	};
+
+	cpucl2_opp: opp-table-cpucl2 {
+		compatible = "operating-points-v2";
+		opp-shared;
+
+		opp-500000000 {
+			opp-hz = /bits/ 64 <500000000>;
+			opp-microwatt = <116000>;
+		};
+
+		opp-880000000 {
+			opp-hz = /bits/ 64 <880000000>;
+			opp-microwatt = <213000>;
+		};
+
+		opp-1164000000 {
+			opp-hz = /bits/ 64 <1164000000>;
+			opp-microwatt = <321000>;
+		};
+
+		opp-1298000000 {
+			opp-hz = /bits/ 64 <1298000000>;
+			opp-microwatt = <391000>;
+		};
+
+		opp-1557000000 {
+			opp-hz = /bits/ 64 <1557000000>;
+			opp-microwatt = <535000>;
+		};
+
+		opp-1745000000 {
+			opp-hz = /bits/ 64 <1745000000>;
+			opp-microwatt = <675000>;
+		};
+
+		opp-1885000000 {
+			opp-hz = /bits/ 64 <1885000000>;
+			opp-microwatt = <784000>;
+		};
+
+		opp-2049000000 {
+			opp-hz = /bits/ 64 <2049000000>;
+			opp-microwatt = <1034000>;
+		};
+
+		opp-2147000000 {
+			opp-hz = /bits/ 64 <2147000000>;
+			opp-microwatt = <1145000>;
+		};
+
+		opp-2294000000 {
+			opp-hz = /bits/ 64 <2294000000>;
+			opp-microwatt = <1363000>;
+		};
+
+		opp-2363000000 {
+			opp-hz = /bits/ 64 <2363000000>;
+			opp-microwatt = <1533000>;
+			turbo-mode;
+		};
+
+		opp-2556000000 {
+			opp-hz = /bits/ 64 <2556000000>;
+			opp-microwatt = <1911000>;
+			turbo-mode;
+		};
+
+		opp-2687000000 {
+			opp-hz = /bits/ 64 <2687000000>;
+			opp-microwatt = <2415000>;
+			turbo-mode;
+		};
+
+		opp-2850000000 {
+			opp-hz = /bits/ 64 <2850000000>;
+			opp-microwatt = <3175000>;
+			turbo-mode;
+		};
+
+		opp-2914000000 {
+			opp-hz = /bits/ 64 <2914000000>;
+			opp-microwatt = <3714000>;
+			turbo-mode;
+		};
+
+		/* 2943, 2970 and 3015 MHz stay off, as on stock. */
 	};
 
 	firmware {
@@ -175,6 +446,124 @@ psci {
 	};
 
 	thermal-zones {
+		/*
+		 * The CPU zones throttle their cluster from 80 C and force its
+		 * lowest level from 95 C.
+		 */
+		big-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 0>;
+
+			trips {
+				big_alert: big-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				big_hot: big-hot {
+					temperature = <95000>;
+					hysteresis = <10000>;
+					type = "passive";
+				};
+
+				big_crit: big-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&big_alert>;
+					cooling-device = <&cpu8 0xffffffff 0xffffffff>;
+				};
+
+				map1 {
+					trip = <&big_hot>;
+					cooling-device = <&cpu8 14 0xffffffff>;
+				};
+			};
+		};
+
+		mid-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 1>;
+
+			trips {
+				mid_alert: mid-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				mid_hot: mid-hot {
+					temperature = <95000>;
+					hysteresis = <10000>;
+					type = "passive";
+				};
+
+				mid_crit: mid-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&mid_alert>;
+					cooling-device = <&cpu4 0xffffffff 0xffffffff>;
+				};
+
+				map1 {
+					trip = <&mid_hot>;
+					cooling-device = <&cpu4 14 0xffffffff>;
+				};
+			};
+		};
+
+		little-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 2>;
+
+			trips {
+				little_alert: little-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				little_hot: little-hot {
+					temperature = <95000>;
+					hysteresis = <10000>;
+					type = "passive";
+				};
+
+				little_crit: little-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&little_alert>;
+					cooling-device = <&cpu0 0xffffffff 0xffffffff>;
+				};
+
+				map1 {
+					trip = <&little_hot>;
+					cooling-device = <&cpu0 9 0xffffffff>;
+				};
+			};
+		};
+
 		/*
 		 * Below stock's own GPU trips (passive from 100 C, hot at
 		 * 115 C).

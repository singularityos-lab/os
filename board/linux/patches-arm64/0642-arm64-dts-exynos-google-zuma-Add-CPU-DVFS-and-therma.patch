 	firmware {
@@ -175,6 +446,124 @@ psci {
 	};
 
 	thermal-zones {
+		/*
+		 * The CPU zones throttle their cluster from 80 C and force its
+		 * lowest level from 95 C.
+		 */
+		big-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 0>;
+
+			trips {
+				big_alert: big-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				big_hot: big-hot {
+					temperature = <95000>;
+					hysteresis = <10000>;
+					type = "passive";
+				};
+
+				big_crit: big-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&big_alert>;
+					cooling-device = <&cpu8 0xffffffff 0xffffffff>;
+				};
+
+				map1 {
+					trip = <&big_hot>;
+					cooling-device = <&cpu8 14 0xffffffff>;
+				};
+			};
+		};
+
+		mid-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 1>;
+
+			trips {
+				mid_alert: mid-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				mid_hot: mid-hot {
+					temperature = <95000>;
+					hysteresis = <10000>;
+					type = "passive";
+				};
+
+				mid_crit: mid-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&mid_alert>;
+					cooling-device = <&cpu4 0xffffffff 0xffffffff>;
+				};
+
+				map1 {
+					trip = <&mid_hot>;
+					cooling-device = <&cpu4 14 0xffffffff>;
+				};
+			};
+		};
+
+		little-thermal {
+			polling-delay-passive = <250>;
+			polling-delay = <1000>;
+			thermal-sensors = <&acpm_tmu 2>;
+
+			trips {
+				little_alert: little-alert {
+					temperature = <80000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+
+				little_hot: little-hot {
+					temperature = <95000>;
+					hysteresis = <10000>;
+					type = "passive";
+				};
+
+				little_crit: little-crit {
+					temperature = <105000>;
+					hysteresis = <2000>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&little_alert>;
+					cooling-device = <&cpu0 0xffffffff 0xffffffff>;
+				};
+
+				map1 {
+					trip = <&little_hot>;
+					cooling-device = <&cpu0 9 0xffffffff>;
+				};
+			};
+		};
+
 		/*
 		 * Below stock's own GPU trips (passive from 100 C, hot at
 		 * 115 C).

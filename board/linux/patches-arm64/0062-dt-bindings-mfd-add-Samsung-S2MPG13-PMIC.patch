Subject: [PATCH] dt-bindings: mfd: add Samsung S2MPG13 PMIC

Assisted-by: Claude:claude-opus-5-5
---
 .../firmware/google,gs101-acpm-ipc.yaml       | 13 ++-
 .../bindings/mfd/samsung,s2mpg13-pmic.yaml    | 84 +++++++++++++++++++
 .../regulator/samsung,s2mpg13-regulator.yaml  | 28 +++++++
 3 files changed, 123 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/mfd/samsung,s2mpg13-pmic.yaml
 create mode 100644 Documentation/devicetree/bindings/regulator/samsung,s2mpg13-regulator.yaml

diff --git a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
index bd543b8bf..fba187245 100644
--- a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
+++ b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
@@ -66,7 +66,9 @@ properties:
 
     properties:
       compatible:
-        const: samsung,s2mpg11-pmic
+        enum:
+          - samsung,s2mpg11-pmic
+          - samsung,s2mpg13-pmic
 
   shmem:
     description:
@@ -93,13 +95,20 @@ allOf:
           properties:
             compatible:
               const: samsung,s2mpg12-pmic
-        pmic-2: false
+        pmic-2:

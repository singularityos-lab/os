From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brett-Michael Green <brett@bmgvisualtech.com>
Date: Sat, 31 Oct 2026 08:15:21 -0400
Subject: [PATCH] dt-bindings: phy: Add the Google zuma PCIe Gen3 PHY

zuma's (Tensor G3) second PCIe controller, the Wi-Fi chip's, has a
one-lane Gen3 PHY clocked from an external PLL in the UDBG block and
selected in the controller's SOC block, isolated by the PMU until it is
released. Its registers are the PMA, the PCS, the PHY resets in the
controller's sub-control space, the UDBG and the SOC block, at the
addresses of stock's pcie@13120000.

Assisted-by: LLM
Signed-off-by: Brett-Michael Green <brett@bmgvisualtech.com>
---
 .../bindings/phy/google,zuma-pcie-phy.yaml    | 70 +++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/phy/google,zuma-pcie-phy.yaml

diff --git a/Documentation/devicetree/bindings/phy/google,zuma-pcie-phy.yaml b/Documentation/devicetree/bindings/phy/google,zuma-pcie-phy.yaml
new file mode 100644
index 000000000..8003eb7b5
--- /dev/null
+++ b/Documentation/devicetree/bindings/phy/google,zuma-pcie-phy.yaml
@@ -0,0 +1,70 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/phy/google,zuma-pcie-phy.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Google zuma PCIe Gen3 PHY
+
+maintainers:
+  - Brett-Michael Green <brett@bmgvisualtech.com>
+
+description:
+  The one-lane PCIe Gen3 PHY of the Google zuma (Tensor G3) SoC's second
+  PCIe controller, which connects the Wi-Fi chip on Pixel 8 phones. Its
+  reference clock comes from an external PLL in the UDBG block, selected as
+  the PHY's input clock in the controller's SOC block. The PMU isolates the
+  PHY until it is released.
+
+properties:
+  compatible:
+    const: google,zuma-pcie-phy
+
+  reg:
+    items:
+      - description: PMA registers
+      - description: PCS registers
+      - description: PHY reset registers in the controller's sub-control space
+      - description: UDBG (external PLL) registers
+      - description: SOC (PHY input clock selection) registers
+
+  reg-names:
+    items:
+      - const: pma
+      - const: pcs
+      - const: rst
+      - const: udbg
+      - const: soc
+
+  "#phy-cells":
+    const: 0
+
+  samsung,pmu-syscon:
+    $ref: /schemas/types.yaml#/definitions/phandle-array
+    items:
+      - items:
+          - description: phandle of the PMU system controller
+          - description: offset of this PHY's control (isolation) register
+    description:
+      The PMU and the offset of this PHY's isolation control.
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - "#phy-cells"
+  - samsung,pmu-syscon
+
+additionalProperties: false
+
+examples:
+  - |
+    phy@13160000 {
+        compatible = "google,zuma-pcie-phy";
+        reg = <0x13160000 0x3000>, <0x13140000 0x5000>,
+              <0x13121400 0x10>, <0x13150000 0xd000>,
+              <0x13130000 0x5000>;
+        reg-names = "pma", "pcs", "rst", "udbg", "soc";
+        samsung,pmu-syscon = <&pmu_system_controller 0x3ec8>;
+        #phy-cells = <0>;
+    };

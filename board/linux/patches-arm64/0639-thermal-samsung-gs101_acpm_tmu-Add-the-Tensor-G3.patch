From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brett-Michael Green <brett@bmgvisualtech.com>
Date: Sat, 31 Oct 2026 13:02:24 -0400
Subject: [PATCH] thermal: samsung: gs101_acpm_tmu: Add the Tensor G3

The Tensor G3 (zuma) TMU service is the Tensor G4's: ACPM channel 9 and
seven sensors in the same order, BIG, MID, LITTLE, G3D, ISP, TPU and
AUR, as the Pixel 8 Pro's stock device tree has them (acpm_tmu on
channel 9, tmuctrl_0 to tmuctrl_6). Match google,zuma-acpm-tmu with
zumapro's data.

Assisted-by: LLM
Signed-off-by: Brett-Michael Green <brett@bmgvisualtech.com>
---
 drivers/thermal/samsung/Kconfig          | 2 +-
 drivers/thermal/samsung/gs101_acpm_tmu.c | 6 ++++--
 2 files changed, 5 insertions(+), 3 deletions(-)

diff --git a/drivers/thermal/samsung/Kconfig b/drivers/thermal/samsung/Kconfig
index 74fd91787..e58d85105 100644
--- a/drivers/thermal/samsung/Kconfig
+++ b/drivers/thermal/samsung/Kconfig
@@ -12,7 +12,7 @@ config EXYNOS_THERMAL
 	  data from the supported SoCs.
 
 config GS101_ACPM_THERMAL
-	tristate "Google gs101, Tensor G2 and Tensor G4 thermal sensors through ACPM"
+	tristate "Google gs101, Tensor G2, G3 and G4 thermal sensors through ACPM"
 	depends on THERMAL_OF
 	depends on EXYNOS_ACPM_PROTOCOL
 	help
diff --git a/drivers/thermal/samsung/gs101_acpm_tmu.c b/drivers/thermal/samsung/gs101_acpm_tmu.c
index 7950e9b58..3a6a53899 100644
--- a/drivers/thermal/samsung/gs101_acpm_tmu.c
+++ b/drivers/thermal/samsung/gs101_acpm_tmu.c
@@ -17,8 +17,8 @@
 #include <linux/thermal.h>
 
 /*
- * The sensors: BIG, MID, LITTLE, G3D, ISP, TPU, and on gs201 and zumapro
- * also AUR, in the firmware's order.
+ * The sensors: BIG, MID, LITTLE, G3D, ISP, TPU, and on gs201, zuma and
+ * zumapro also AUR, in the firmware's order.
  */
 #define GS101_ACPM_TMU_MAX_SENSORS	7
 
@@ -115,6 +115,7 @@ static const struct gs101_tmu_data gs201_tmu_data = {
 	.nr_sensors = 7,
 };
 
+/* zuma's TMU service is zumapro's: channel 9, the same seven sensors. */
 static const struct gs101_tmu_data zumapro_tmu_data = {
 	.acpm_chan = 9,
 	.nr_sensors = 7,
@@ -123,6 +124,7 @@ static const struct gs101_tmu_data zumapro_tmu_data = {
 static const struct of_device_id gs101_tmu_of_match[] = {
 	{ .compatible = "google,gs101-acpm-tmu", .data = &gs101_tmu_data },
 	{ .compatible = "google,gs201-acpm-tmu", .data = &gs201_tmu_data },
+	{ .compatible = "google,zuma-acpm-tmu", .data = &zumapro_tmu_data },
 	{ .compatible = "google,zumapro-acpm-tmu", .data = &zumapro_tmu_data },
 	{ }
 };

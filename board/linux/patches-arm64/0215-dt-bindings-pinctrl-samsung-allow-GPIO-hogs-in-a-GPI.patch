Subject: [PATCH] dt-bindings: pinctrl: samsung: allow GPIO hogs in a GPIO bank

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 .../bindings/pinctrl/samsung,pinctrl-gpio-bank.yaml         | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-gpio-bank.yaml b/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-gpio-bank.yaml
index 8cf3c47ab..20bfb3d2b 100644
--- a/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-gpio-bank.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/samsung,pinctrl-gpio-bank.yaml
@@ -45,6 +45,12 @@ properties:
     minItems: 1
     maxItems: 8
 
+patternProperties:
+  '-hog(-[0-9]+)?$':
+    type: object
+    required:
+      - gpio-hog
+
 required:
   - '#gpio-cells'
   - gpio-controller

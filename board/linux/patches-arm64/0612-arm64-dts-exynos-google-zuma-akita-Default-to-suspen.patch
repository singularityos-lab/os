From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: DarekM <149845949+aninmucek@users.noreply.github.com>
Date: Tue, 10 Nov 2026 15:57:46 +0000
Subject: [PATCH] arm64: dts: exynos: google: zuma-akita: Default to
 suspend-to-idle

Assisted-by: Claude Opus 5.5
Signed-off-by: DarekM <149845949+aninmucek@users.noreply.github.com>
---
 arch/arm64/boot/dts/exynos/google/zuma-akita.dts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/google/zuma-akita.dts b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
index aad383858..bd1822f00 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
+++ b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
@@ -56,8 +56,11 @@ chosen {
 		 * hang that never panics lasts until someone resets the phone
 		 * with its buttons: panic on soft and hard lockups and on RCU
 		 * stalls, so that panic=10 resets the phone by itself.
+		 * mem_sleep_default=s2idle: the firmware offers PSCI system
+		 * suspend, so "mem" would otherwise mean "deep", which needs a
+		 * PMU sleep sequence the kernel doesn't have yet.
 		 */
-		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init";
+		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init mem_sleep_default=s2idle";
 		#address-cells = <2>;
 		#size-cells = <1>;
 		ranges;

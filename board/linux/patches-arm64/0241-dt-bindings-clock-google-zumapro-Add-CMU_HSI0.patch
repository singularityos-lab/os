From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Tue, 27 Oct 2026 01:06:08 -0647
Subject: [PATCH] dt-bindings: clock: google,zumapro: Add CMU_HSI0

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../bindings/clock/google,zumapro-clock.yaml  | 42 ++++++++++++++++++-
 include/dt-bindings/clock/google,zumapro.h    | 26 ++++++++++++
 2 files changed, 66 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/clock/google,zumapro-clock.yaml b/Documentation/devicetree/bindings/clock/google,zumapro-clock.yaml
index b883f14e2..88938509f 100644
--- a/Documentation/devicetree/bindings/clock/google,zumapro-clock.yaml
+++ b/Documentation/devicetree/bindings/clock/google,zumapro-clock.yaml
@@ -13,6 +13,8 @@ description: |
   CMU_TOP supplies the NoC and UFS clock paths to CMU_HSI2 and the supply-GPIO
   path in CMU_PERIC0. CMU_TOP also provides the HSI0 parent rate paths.
   CMU_MISC supplies the firmware-owned watchdog bus clock paths.
+  CMU_HSI0 supplies the USB, eUSB2 PHY and touchscreen USI2 clocks; its
+  ALT and TCXO inputs are board-level fixed clocks.
   The external oscillator supplies the PLL reference and oscillator mux
   paths.
   Clock identifiers are defined in dt-bindings/clock/google,zumapro.h.
@@ -21,6 +23,7 @@ properties:
   compatible:
     enum:
       - google,zumapro-cmu-top
+      - google,zumapro-cmu-hsi0
       - google,zumapro-cmu-hsi2
       - google,zumapro-cmu-peric0
       - google,zumapro-cmu-misc
@@ -33,11 +36,14 @@ properties:
 
   clocks:
     minItems: 1
-    maxItems: 4
+    maxItems: 5
 
   clock-names:
     minItems: 1
-    maxItems: 4
+    maxItems: 5
+
+  power-domains:
+    maxItems: 1
 
 required:
   - compatible
@@ -59,6 +65,29 @@ allOf:
         clock-names:
           items:
             - const: oscclk
+  - if:
+      properties:
+        compatible:
+          const: google,zumapro-cmu-hsi0
+    then:
+      properties:
+        clocks:
+          items:
+            - description: External oscillator reference clock
+            - description: HSI0 NoC clock from CMU_TOP
+            - description: HSI0 peripheral clock from CMU_TOP
+            - description: HSI0 ALT input clock
+            - description: HSI0 TCXO input clock
+        clock-names:
+          items:
+            - const: oscclk
+            - const: bus
+            - const: peri
+            - const: alt
+            - const: tcxo
+    else:
+      properties:
+        power-domains: false
   - if:
       properties:
         compatible:
@@ -108,6 +137,15 @@ examples:
         clock-names = "oscclk";
     };
 
+    clock-controller@11000000 {
+        compatible = "google,zumapro-cmu-hsi0";
+        reg = <0x11000000 0x8000>;
+        #clock-cells = <1>;
+        clocks = <&oscclk>, <&cmu_top CLK_DOUT_HSI0_NOC>,
+                 <&cmu_top CLK_DOUT_HSI0_PERI>, <&hsi0_alt>, <&hsi0_tcxo>;
+        clock-names = "oscclk", "bus", "peri", "alt", "tcxo";
+    };
+
     clock-controller@13000000 {
         compatible = "google,zumapro-cmu-hsi2";
         reg = <0x13000000 0x8000>;
diff --git a/include/dt-bindings/clock/google,zumapro.h b/include/dt-bindings/clock/google,zumapro.h
index 38997c823..875b3ed74 100644
--- a/include/dt-bindings/clock/google,zumapro.h
+++ b/include/dt-bindings/clock/google,zumapro.h
@@ -32,6 +32,32 @@
 #define CLK_MOUT_MISC_NOC		26
 #define CLK_GOUT_MISC_NOC		27
 #define CLK_DOUT_MISC_NOC		28
+#define CLK_GOUT_HSI0_NOC		29
+#define CLK_GOUT_HSI0_PERI	30
+
+/* CMU_HSI0. */
+#define CLK_FOUT_HSI0_USB		1
+#define CLK_MOUT_HSI0_TCXO_USER		2
+#define CLK_DOUT_HSI0_USB		3
+#define CLK_MOUT_HSI0_USB20_REF		4
+#define CLK_MOUT_HSI0_NOC_USER		5
+#define CLK_MOUT_HSI0_ALT_USER		6
+#define CLK_GOUT_HSI0_ALT		7
+#define CLK_MOUT_HSI0_NOC_LOCAL		8
+#define CLK_DOUT_HSI0_EUSB		9
+#define CLK_GOUT_HSI0_EUSB_REF		10
+#define CLK_GOUT_HSI0_EUSB_BUS		11
+#define CLK_GOUT_HSI0_EUSB_CTRL		12
+#define CLK_MOUT_HSI0_PERI_USER		13
+#define CLK_MOUT_HSI0_USI2_LOCAL	14
+#define CLK_GOUT_HSI0_USI2_SOURCE	15
+#define CLK_DOUT_HSI0_USI2		16
+#define CLK_GOUT_HSI0_USI2_IP		17
+#define CLK_GOUT_HSI0_USI2_PCLK		18
+#define CLK_GOUT_HSI0_SYSREG		19
+#define CLK_GOUT_HSI0_USB_SUBCTL	20
+#define CLK_GOUT_HSI0_USB_LINK		21
+#define CLK_GOUT_HSI0_USB_SUSPEND	22
 
 /* CMU_HSI2. */
 #define CLK_MOUT_HSI2_NOC_USER	1

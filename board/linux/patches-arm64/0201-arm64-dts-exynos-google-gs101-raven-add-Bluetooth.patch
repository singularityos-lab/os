From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: saiththerobo <the.tom.sharp@gmail.com>
Date: Thu, 15 Oct 2026 14:33:38 +0100
Subject: [PATCH] arm64: dts: exynos: google: gs101-raven: add Bluetooth

Raven's BCM4389 sits on the APM USI1 UART: BT_REG_ON gpp16-2, device
wake gpp14-3, host wake gpa6-6, as in Google's
gs101-common-bluetooth.dtsi.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 .../boot/dts/exynos/google/gs101-raven.dts     | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
index 80cbaea5f..fc7a80fb3 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
@@ -48,6 +48,24 @@ ldo14s {
 	};
 };
 
+/* Bluetooth: the BCM4389 on the APM USI1 UART (Google's gs101-common-bluetooth) */
+&usi_apm1 {
+	status = "okay";
+};
+
+&serial_apm1 {
+	status = "okay";
+
+	bluetooth {
+		compatible = "brcm,bcm4389-bt";
+		shutdown-gpios = <&gpp16 2 GPIO_ACTIVE_HIGH>;
+		device-wakeup-gpios = <&gpp14 3 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&gpa6 6 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "host-wakeup";
+		max-speed = <3000000>;
+	};
+};
+
 &cont_splash_mem {
 	reg = <0x0 0xfac00000 (1440 * 3120 * 4)>;
 

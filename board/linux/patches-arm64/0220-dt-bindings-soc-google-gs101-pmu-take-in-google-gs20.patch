From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: saiththerobo <the.tom.sharp@gmail.com>
Date: Tue, 27 Oct 2026 08:01:14 +0000
Subject: [PATCH] dt-bindings: soc: google: gs101-pmu: take in google,gs201-pmu

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 .../bindings/soc/google/google,gs101-pmu.yaml | 21 +++++++++++++++----
 .../bindings/soc/samsung/exynos-pmu.yaml      |  3 ---
 2 files changed, 17 insertions(+), 7 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/google/google,gs101-pmu.yaml b/Documentation/devicetree/bindings/soc/google/google,gs101-pmu.yaml
index 0cdb9d2a4..b88a04ae3 100644
--- a/Documentation/devicetree/bindings/soc/google/google,gs101-pmu.yaml
+++ b/Documentation/devicetree/bindings/soc/google/google,gs101-pmu.yaml
@@ -11,7 +11,11 @@ maintainers:
 
 properties:
   compatible:
-    const: google,gs101-pmu
+    oneOf:
+      - const: google,gs101-pmu
+      - items:
+          - const: google,gs201-pmu
+          - const: google,gs101-pmu
 
   reg:
     maxItems: 1
@@ -65,11 +69,20 @@ patternProperties:
 required:
   - compatible
   - reg
-  - "#address-cells"
-  - "#size-cells"
-  - ranges
   - google,pmu-intr-gen-syscon
 
+allOf:
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: google,gs201-pmu
+    else:
+      required:
+        - "#address-cells"
+        - "#size-cells"
+        - ranges
+
 additionalProperties: false
 
 examples:
diff --git a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
index 99a9471bd..2f273e9e5 100644
--- a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
+++ b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
@@ -13,9 +13,6 @@ properties:
   compatible:
     oneOf:
       - const: google,zuma-pmu
-      - items:
-          - const: google,gs201-pmu
-          - const: google,gs101-pmu
       - items:
           - const: google,zumapro-pmu
           - const: google,zuma-pmu

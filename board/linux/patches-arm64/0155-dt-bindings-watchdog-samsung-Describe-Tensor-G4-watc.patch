From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Thu, 22 Oct 2026 20:10:33 -0700
Subject: [PATCH] dt-bindings: watchdog: samsung: Describe Tensor G4 watchdog

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../devicetree/bindings/watchdog/samsung-wdt.yaml          | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/watchdog/samsung-wdt.yaml b/Documentation/devicetree/bindings/watchdog/samsung-wdt.yaml
index 69bf55ff0..bd653717f 100644
--- a/Documentation/devicetree/bindings/watchdog/samsung-wdt.yaml
+++ b/Documentation/devicetree/bindings/watchdog/samsung-wdt.yaml
@@ -28,6 +28,9 @@ properties:
           - samsung,exynos990-wdt                 # for Exynos990
           - samsung,exynosautov9-wdt              # for Exynosautov9
           - samsung,exynosautov920-wdt            # for Exynosautov920
+      - items:
+          - const: google,zumapro-wdt
+          - const: google,zuma-wdt
       - items:
           - enum:
               - tesla,fsd-wdt
@@ -52,13 +55,13 @@ properties:
     enum: [0, 1, 2]
     description:
       Index of CPU cluster on which watchdog is running (in case of Exynos850,
-      Exynos990, Google gs101 or Google zuma).
+      Exynos990, Google gs101, zuma or zumapro).
 
   samsung,syscon-phandle:
     $ref: /schemas/types.yaml#/definitions/phandle
     description:
       Phandle to the PMU system controller node (in case of Exynos5250,
-      Exynos5420, Exynos7, Exynos850, Exynos990, gs101 and zuma).
+      Exynos5420, Exynos7, Exynos850, Exynos990, gs101, zuma and zumapro).
 
 required:
   - compatible

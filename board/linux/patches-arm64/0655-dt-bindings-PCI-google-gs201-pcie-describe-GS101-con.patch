From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Gray <chrisgray70@gmail.com>
Date: Wed, 11 Nov 2026 12:20:02 -0600
Subject: [PATCH] dt-bindings: PCI: google,gs201-pcie: describe GS101
 controller and PHY

Assisted-by: LLM
Signed-off-by: Chris Gray <chrisgray70@gmail.com>
---
 .../bindings/pci/google,gs201-pcie.yaml       | 24 +++++++++++++++++--
 .../bindings/phy/google,gs201-pcie-phy.yaml   |  6 +++--
 2 files changed, 26 insertions(+), 4 deletions(-)

diff --git a/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml b/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml
index 19181b143..2031a9e8a 100644
--- a/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml
+++ b/Documentation/devicetree/bindings/pci/google,gs201-pcie.yaml
@@ -4,13 +4,13 @@
 $id: http://devicetree.org/schemas/pci/google,gs201-pcie.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Google gs201 and zuma PCIe host controllers
+title: Google gs101, gs201 and zuma PCIe host controllers
 
 maintainers:
   - Derek Ross <derekross@gmail.com>
 
 description:
-  The PCIe controllers of the Google gs201 (Tensor G2) and zuma (Tensor G3)
+  The PCIe controllers of Google gs101 (Tensor G1), gs201 (Tensor G2) and zuma (Tensor G3)
   SoCs are Synopsys DesignWare cores (IP versions 0x984500 and 0x986500) in
   a Samsung wrapper. The wrapper
   adds a sub-control block (ELBI) with link training control and interrupt
@@ -36,10 +36,24 @@ allOf:
         reg-names:
           maxItems: 3
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: google,gs101-pcie
+    then:
+      properties:
+        dma-coherent: false
+        samsung,cmu: false
+      required:
+        - vpcie0v85-supply
+        - vpcie1v8-supply
+
 properties:
   compatible:
     oneOf:
       - enum:
+          - google,gs101-pcie
           - google,gs201-pcie
           - google,zuma-pcie
       - items:
@@ -95,6 +109,12 @@ properties:
     description:
       Needed with dma-coherent, to make the controller's DMA shareable.
 
+  vpcie0v85-supply:
+    description: PCIe analog 0.85 V supply.
+
+  vpcie1v8-supply:
+    description: PCIe analog 1.8 V supply.
+
   num-lanes:
     maximum: 2
 
diff --git a/Documentation/devicetree/bindings/phy/google,gs201-pcie-phy.yaml b/Documentation/devicetree/bindings/phy/google,gs201-pcie-phy.yaml
index d0292e6f6..8ff12364b 100644
--- a/Documentation/devicetree/bindings/phy/google,gs201-pcie-phy.yaml
+++ b/Documentation/devicetree/bindings/phy/google,gs201-pcie-phy.yaml
@@ -4,7 +4,7 @@
 $id: http://devicetree.org/schemas/phy/google,gs201-pcie-phy.yaml#
 $schema: http://devicetree.org/meta-schemas/core.yaml#
 
-title: Google gs201 PCIe PHY
+title: Google gs101 / gs201 PCIe PHY
 
 maintainers:
   - Derek Ross <derekross@gmail.com>
@@ -18,7 +18,9 @@ description:
 
 properties:
   compatible:
-    const: google,gs201-pcie-phy
+    enum:
+      - google,gs101-pcie-phy
+      - google,gs201-pcie-phy
 
   reg:
     items:

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Sat, 31 Oct 2026 11:21:32 -0643
Subject: [PATCH] arm64: dts: exynos: google: zumapro: Add the GSA

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 arch/arm64/boot/dts/exynos/google/zumapro.dtsi | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
index 3ba0b68c0..4cb1de9c5 100644
--- a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
@@ -1533,6 +1533,14 @@ firmware-sram@0 {
 			};
 		};
 
+		gsa: gsa@16490000 {
+			compatible = "google,zumapro-gsa";
+			reg = <0x0 0x16490000 0x1000>;
+			reg-names = "mbox";
+			interrupts = <GIC_SPI 375 IRQ_TYPE_LEVEL_HIGH>;
+			status = "disabled";
+		};
+
 		dsi0: dsi@19440000 {
 			compatible = "google,zumapro-dsim", "google,gs201-dsim";
 			reg = <0x0 0x19440000 0x300>,

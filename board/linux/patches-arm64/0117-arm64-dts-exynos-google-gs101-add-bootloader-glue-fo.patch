From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: saiththerobo <the.tom.sharp@gmail.com>
Date: Sat, 17 Oct 2026 05:46:12 +0100
Subject: [PATCH] arm64: dts: exynos: google: gs101: add bootloader glue for
 ABL

Booting a gs101 Pixel from its own slot B images needs what cheetah's
board file already carries for the same bootloader (ABL). Oriole and
raven share it, so it goes in gs101-pixel-common.dtsi:

- the dpm node and label stubs that ABL's debug-policy overlay targets,
  and symbols (-@) for both boards so the overlays apply;
- watchdog_cl1 next to watchdog_cl0. Cheetah's ABL leaves both cluster
  watchdogs running; raven's leaves them off (both report "inactive" at
  probe, and raven stayed up past 180 s without watchdog_cl1). Linux
  runs both either way.

Raven also gets its soc_id, which ABL matches the base DTB on (the
factory vendor_boot ships one DTB per silicon revision, 0x9845000 and
0x9845001; the image tooling writes the A0 copy from this B0 one, as for
cheetah), and /chosen/bootargs with panic=10, since ABL appends
console=null and a panic would otherwise hang silently.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 arch/arm64/boot/dts/exynos/google/Makefile    |  2 ++
 .../dts/exynos/google/gs101-pixel-common.dtsi | 20 +++++++++++++++++++
 .../boot/dts/exynos/google/gs101-raven.dts    | 15 ++++++++++++++
 3 files changed, 37 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/Makefile b/arch/arm64/boot/dts/exynos/google/Makefile
index be122327f..813411f51 100644
--- a/arch/arm64/boot/dts/exynos/google/Makefile
+++ b/arch/arm64/boot/dts/exynos/google/Makefile
@@ -7,5 +7,7 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	gs201-felix.dtb
 
 # ABL applies board overlays, so keep symbols for labels
+DTC_FLAGS_gs101-oriole += -@
+DTC_FLAGS_gs101-raven += -@
 DTC_FLAGS_gs201-cheetah += -@
 DTC_FLAGS_gs201-felix += -@
diff --git a/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi b/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
index a12f2b88d..a1ea429f9 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs101-pixel-common.dtsi
@@ -20,6 +20,16 @@ aliases {
 		serial0 = &serial_0;
 	};
 
+	/* Target of the debug-policy overlay ABL applies from the dpm partition. */
+	dpm: dpm { };
+
+	/* Label stubs so that overlay applies (it only sets their status). */
+	dpm-stubs {
+		log_arrdumppanic: log-arrdumppanic { status = "disabled"; };
+		log_preslcdump: log-preslcdump { status = "disabled"; };
+		log_slcdump: log-slcdump { status = "disabled"; };
+	};
+
 	chosen {
 		/* Bootloader expects bootargs specified otherwise it crashes */
 		bootargs = "";
@@ -931,3 +941,13 @@ &watchdog_cl0 {
 
 	status = "okay";
 };
+
+/*
+ * Linux runs both cluster watchdogs: some ABLs leave them running, and
+ * a running one nobody feeds resets the phone at about 60 s.
+ */
+&watchdog_cl1 {
+	timeout-sec = <30>;
+
+	status = "okay";
+};
diff --git a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
index 7c4273796..219c0ab7d 100644
--- a/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs101-raven.dts
@@ -13,6 +13,21 @@
 / {
 	model = "Raven";
 	compatible = "google,gs101-raven", "google,gs101";
+
+	/*
+	 * ABL picks the base DTB by soc_id (product id 0x09845000 | major
+	 * revision); the factory vendor_boot carries one per revision. B0 = 1.
+	 */
+	soc_id = <0x09845001 0x0>;
+
+	chosen {
+		/*
+		 * ABL appends its own arguments (console=null among them), so a
+		 * panic is silent: panic=10 reboots instead of hanging. init hands
+		 * over to the Arch root on userdata when it finds one.
+		 */
+		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init";
+	};
 };
 
 &acpm_ipc {

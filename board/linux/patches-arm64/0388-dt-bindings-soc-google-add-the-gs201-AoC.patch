From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 12:56:52 -0400
Subject: [PATCH] dt-bindings: soc: google: add the gs201 AoC

The AoC (Always-on Compute) is the gs201 audio and sensor DSP. The AP
loads its firmware into a reserved carve-out, the GSA authenticates and
starts it, and it reaches memory through its own System MMU. Describe
the power request register, the AoC's S2MPU, the chip id block read for
the firmware's boot parameters, and the links to the GSA, the System MMU
and the carve-out.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 .../bindings/soc/google/google,gs201-aoc.yaml | 78 +++++++++++++++++++
 1 file changed, 78 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/google/google,gs201-aoc.yaml

diff --git a/Documentation/devicetree/bindings/soc/google/google,gs201-aoc.yaml b/Documentation/devicetree/bindings/soc/google/google,gs201-aoc.yaml
new file mode 100644
index 000000000..1c09f6112
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/google/google,gs201-aoc.yaml
@@ -0,0 +1,78 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/google/google,gs201-aoc.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Google gs201 AoC (Always-on Compute)
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+description:
+  The AoC is the audio and sensor DSP of gs201. The AP loads its firmware
+  into a reserved carve-out, the GSA authenticates and starts it, and the
+  AoC reaches memory through its own System MMU.
+
+properties:
+  compatible:
+    const: google,gs201-aoc
+
+  reg:
+    items:
+      - description: the AoC power request register (aoc_req) and its
+          acknowledge at +0x40
+      - description: the AoC's stage-2 MPU
+      - description: the chip id block, read for the firmware's boot
+          parameters
+
+  reg-names:
+    items:
+      - const: aoc_req
+      - const: s2mpu
+      - const: chipid
+
+  memory-region:
+    maxItems: 1
+    description: the carve-out the firmware runs from
+
+  google,gsa:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: the GSA that authenticates and starts the firmware
+
+  google,sysmmu:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description: the AoC's System MMU
+
+  google,board-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: board id passed to the firmware
+
+  google,board-rev:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: board revision passed to the firmware
+
+required:
+  - compatible
+  - reg
+  - reg-names
+  - memory-region
+  - google,gsa
+  - google,sysmmu
+  - google,board-id
+  - google,board-rev
+
+additionalProperties: false
+
+examples:
+  - |
+    aoc@181d0000 {
+        compatible = "google,gs201-aoc";
+        reg = <0x181d0000 0x1000>, <0x1a0b0000 0x1000>, <0x10000000 0x100>;
+        reg-names = "aoc_req", "s2mpu", "chipid";
+        memory-region = <&aoc_carveout>;
+        google,gsa = <&gsa>;
+        google,sysmmu = <&aoc_sysmmu>;
+        google,board-id = <0x30301>;
+        google,board-rev = <0x10000>;
+    };

 drivers/soc/google/cpif/Makefile           |   5 +-
 drivers/soc/google/cpif/link_device.c      |  12 +-
 drivers/soc/google/cpif/link_rx_pktproc.c  | 126 +++++++++++++--------
 drivers/soc/google/cpif/link_rx_pktproc.h  |  31 ++++-
 drivers/soc/google/cpif/link_tx_pktproc.c  | 121 +++++++++++++-------
 drivers/soc/google/cpif/modem_ctrl_s5100.c |   3 +-
 drivers/soc/google/cpif/modem_io_device.c  |   3 +-

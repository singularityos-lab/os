From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Wed, 14 Oct 2026 21:05:11 -0400
Subject: [PATCH] dt-bindings: media: i2c: add SEMCO SEM1215SA

The SEM1215SA drives a camera module's focus and optical image
stabilisation actuators and holds its calibration memory, over I2C with
16-bit register addresses. The Pixel 7 Pro's folded telephoto module has
one, powered from a board supply, the camera I/O rail, an actuator
supply and a switched module supply.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../bindings/media/i2c/semco,sem1215sa.yaml   | 58 +++++++++++++++++++
 1 file changed, 58 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/semco,sem1215sa.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/semco,sem1215sa.yaml b/Documentation/devicetree/bindings/media/i2c/semco,sem1215sa.yaml
new file mode 100644
index 000000000..41b3af950
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/semco,sem1215sa.yaml
@@ -0,0 +1,58 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/semco,sem1215sa.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SEMCO SEM1215SA camera lens autofocus and stabilisation controller
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+description:
+  Samsung Electro-Mechanics' SEM1215SA drives a camera module's focus and
+  optical image stabilisation actuators and holds the module's calibration
+  memory, controlled over I2C with 16-bit register addresses. It is the
+  controller of the Google Pixel 7 Pro's folded telephoto module.
+
+properties:
+  compatible:
+    const: semco,sem1215sa
+
+  reg:
+    maxItems: 1
+
+  vbb-supply:
+    description: Board supply feeding the module's regulators, switched on first.
+
+  vio-supply:
+    description: Interface (1.8 V) supply.
+
+  vdd-supply:
+    description: Actuator supply.
+
+  vsw-supply:
+    description: A switched module supply, on after vdd-supply.
+
+required:
+  - compatible
+  - reg
+  - vio-supply
+  - vdd-supply
+
+additionalProperties: false
+
+examples:
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        lens@34 {
+            compatible = "semco,sem1215sa";
+            reg = <0x34>;
+            vio-supply = <&vddio_cam>;
+            vdd-supply = <&tele_module>;
+            vsw-supply = <&tele_sw>;
+        };
+    };

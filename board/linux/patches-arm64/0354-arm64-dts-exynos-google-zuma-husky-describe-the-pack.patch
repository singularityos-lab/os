From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lef <me@lefteros.com>
Date: Sun, 1 Nov 2026 15:00:12 +0200
Subject: [PATCH] arm64: dts: exynos: google: zuma-husky: describe the pack
 EEPROM on hsi2c_9

Signed-off-by: Lef <me@lefteros.com>
Assisted-by: LLM
---
 .../boot/dts/exynos/google/zuma-husky.dts     | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zuma-husky.dts b/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
index 7a520b985..f9d30456a 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
+++ b/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
@@ -311,3 +311,22 @@ gpio {
 		};
 	};
 };
+
+/*
+ * The battery pack's EEPROM on USI9 / hsi2c_9 (stock: "at,24c08" at 0x50 on
+ * a 400 kHz bus, in the pack and powered by it). Byte 0x17 is the battery ID
+ * that Google's driver matches against the gauge models; the rest is the
+ * pack's part number, dates and history, so it is read-only here. The bus
+ * and USI9 stay disabled; a bring-up overlay enables them. Nothing reads the
+ * ID into the gauge yet.
+ */
+&hsi2c_9 {
+	clock-frequency = <400000>;
+
+	eeprom@50 {
+		compatible = "atmel,24c08";
+		reg = <0x50>;
+		pagesize = <16>;
+		read-only;
+	};
+};

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 12:04:03 -0400
Subject: [PATCH] dt-bindings: soc: google: add the gs201 GSA mailbox

The GSA is the security core of Google Tensor SoCs. It authenticates and
loads the firmware of other cores, such as the AoC audio and sensor DSP,
and the application processor reaches it through a mailbox of shared
command and response registers with one response interrupt.

Describe that mailbox for gs201.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 .../bindings/soc/google/google,gs201-gsa.yaml | 42 +++++++++++++++++++
 1 file changed, 42 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/google/google,gs201-gsa.yaml

diff --git a/Documentation/devicetree/bindings/soc/google/google,gs201-gsa.yaml b/Documentation/devicetree/bindings/soc/google/google,gs201-gsa.yaml
new file mode 100644
index 000000000..69200f837
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/google/google,gs201-gsa.yaml
@@ -0,0 +1,42 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/google/google,gs201-gsa.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Google gs201 GSA mailbox
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+description:
+  The GSA is the security core of Google Tensor SoCs. It authenticates and
+  loads the firmware of other cores, such as the AoC audio and sensor DSP.
+  The application processor sends it commands through a mailbox of shared
+  command and response registers, with one interrupt for responses.
+
+properties:
+  compatible:
+    const: google,gs201-gsa
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+required:
+  - compatible
+  - reg
+  - interrupts
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    gsa@17c90000 {
+        compatible = "google,gs201-gsa";
+        reg = <0x17c90000 0x1000>;
+        interrupts = <GIC_SPI 363 IRQ_TYPE_LEVEL_HIGH>;
+    };

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Mon, 2 Nov 2026 13:18:57 -0647
Subject: [PATCH] soc: google: cpif: s51xx: ring the doorbell under the link
 driver's lock

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 drivers/soc/google/cpif/pcie-gs201-compat.c |  6 ++++++
 drivers/soc/google/cpif/s51xx_pcie.c        | 18 +++++++++++++++---
 drivers/soc/google/cpif/s51xx_pcie.h        |  1 +
 3 files changed, 22 insertions(+), 3 deletions(-)

diff --git a/drivers/soc/google/cpif/pcie-gs201-compat.c b/drivers/soc/google/cpif/pcie-gs201-compat.c
index b580059a4..1cbef16cb 100644
--- a/drivers/soc/google/cpif/pcie-gs201-compat.c
+++ b/drivers/soc/google/cpif/pcie-gs201-compat.c
@@ -115,6 +115,12 @@ void exynos_pcie_rc_force_linkdown_work(int ch_num)
 	gs201_pcie_cp_force_linkdown();
 }
 
+/* The doorbell write under the controller's link lock (see gs201_pcie_cp_doorbell()) */
+int exynos_pcie_rc_doorbell(int ch_num, void __iomem *addr, u32 val, u32 *readback)
+{
+	return cp_ch_ok(ch_num) ? gs201_pcie_cp_doorbell(addr, val, readback) : -ENODEV;
+}
+
 int exynos_pcie_rc_chk_link_status(int ch_num)
 {
 	return cp_ch_ok(ch_num) && gs201_pcie_cp_link_ok();
diff --git a/drivers/soc/google/cpif/s51xx_pcie.c b/drivers/soc/google/cpif/s51xx_pcie.c
index 8608a63e4..b84e12031 100644
--- a/drivers/soc/google/cpif/s51xx_pcie.c
+++ b/drivers/soc/google/cpif/s51xx_pcie.c
@@ -114,9 +114,21 @@ inline int s51xx_pcie_send_doorbell_int(struct pci_dev *pdev, int int_num)
 	}
 
 send_doorbell_again:
-	iowrite32(int_num, s51xx_pcie->doorbell_addr);
-
-	reg = ioread32(s51xx_pcie->doorbell_addr);
+	/*
+	 * The write and its read-back go through the link driver, under the
+	 * lock its link-down takes, so that a power-off the modem asked for
+	 * can't take the link down between the check above and the access:
+	 * an access to the modem's window with the link down can hang the
+	 * SoC. When the link went down meanwhile, the doorbell is kept for
+	 * the next link up, as pcie_send_ap2cp_irq() does when the link is
+	 * already down.
+	 */
+	if (exynos_pcie_rc_doorbell(s51xx_pcie->pcie_channel_num,
+				    s51xx_pcie->doorbell_addr, int_num, &reg)) {
+		mif_info_limited("Reserve doorbell interrupt: link went down\n");
+		mc->reserve_doorbell_int = true;
+		return 0;
+	}
 
 	/* debugging:
 	 * mif_info("s51xx_pcie.doorbell_addr = 0x%p -
diff --git a/drivers/soc/google/cpif/s51xx_pcie.h b/drivers/soc/google/cpif/s51xx_pcie.h
index d8b3b92c2..81c7dcccb 100644
--- a/drivers/soc/google/cpif/s51xx_pcie.h
+++ b/drivers/soc/google/cpif/s51xx_pcie.h
@@ -48,6 +48,7 @@ struct s51xx_pcie {
 //extern struct s51xx_pcie s5100pcie;
 
 extern int exynos_pcie_rc_chk_link_status(int ch_num);
+extern int exynos_pcie_rc_doorbell(int ch_num, void __iomem *addr, u32 val, u32 *readback);
 extern int exynos_pcie_rc_l1ss_ctrl(int enable, int id, int ch_num);
 
 extern int exynos_pcie_poweron(int ch_num, int spd, int width);

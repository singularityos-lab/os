diff --git a/arch/arm64/boot/dts/exynos/google/zumapro-reserved-memory.dtsi b/arch/arm64/boot/dts/exynos/google/zumapro-reserved-memory.dtsi
new file mode 100644
index 000000000..66157671c
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/google/zumapro-reserved-memory.dtsi
@@ -0,0 +1,196 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Google Tensor G4 firmware memory reservations.
+ *
+ * Copyright 2023 Google LLC.
+ *
+ * Fixed ranges from Google's GPL zumapro tree, plus two gaps next to them
+ * that stay reserved until they're shown to be unused. The bootloader adds
+ * its own secure ranges; the board file adds the splash screen.
+ */
+
+/ {
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		xhci_dma_buffer: xhci-dma-buffer@17bb5000 {
+			reg = <0x0 0x17bb5000 0x0000b000>;
+			no-map;
+		};
+
+		xhci_dma: xhci-dma@17bc0000 {
+			reg = <0x0 0x17bc0000 0x00040000>;
+			no-map;
+		};
+
+		cp_aoc_rmem: cp-aoc@197fd000 {
+			reg = <0x0 0x197fd000 0x00003000>;
+			no-map;
+		};
+
+		ect_binary: ect@90000000 {
+			reg = <0x0 0x90000000 0x00060000>;
+			no-map;
+		};
+
+		gsa_reserved_protected: gsa@90200000 {
+			reg = <0x0 0x90200000 0x003ff000>;
+			no-map;
+		};
+
+		gsa_reserved_log: gsa-log@905ff000 {
+			reg = <0x0 0x905ff000 0x00001000>;
+			no-map;
+		};
+
+		gxp_scratchpad_reserved: gxp-scratchpad@91300000 {
+			reg = <0x0 0x91300000 0x00060000>;
+			no-map;
+		};
+
+		iif_wait_table_reserved: iif-wait-table@91360000 {
+			reg = <0x0 0x91360000 0x00020000>;
+			no-map;
+		};
+
+		iif_signal_table_reserved: iif-signal-table@91380000 {
+			reg = <0x0 0x91380000 0x00020000>;
+			no-map;
+		};
+
+		/* Not in Google's list; kept reserved until shown unused. */
+		gxp_gap_reserved: gxp-gap@913a0000 {
+			reg = <0x0 0x913a0000 0x00060000>;
+			no-map;
+		};
+
+		gxp_secure_data_reserved: gxp-secure-data@91400000 {
+			reg = <0x0 0x91400000 0x00900000>;
+			no-map;
+		};
+
+		gxp_fw_reserved: gxp-fw@91d00000 {
+			reg = <0x0 0x91d00000 0x00300000>;
+			no-map;
+		};
+
+		gxp_mcu_fw_reserved: gxp-mcu-fw@92000000 {
+			reg = <0x0 0x92000000 0x00400000>;
+			no-map;
+		};
+
+		tpu_fw_reserved: tpu-fw@92e00000 {
+			reg = <0x0 0x92e00000 0x01200000>;
+			no-map;
+		};
+
+		aoc_reserved: aoc@94000000 {
+			reg = <0x0 0x94000000 0x03000000>;
+			no-map;
+		};
+
+		xhci_dma_dram: xhci-dma-dram@97000000 {
+			reg = <0x0 0x97000000 0x00400000>;
+			no-map;
+		};
+
+		seclog_reserved: seclog@c3000000 {
+			reg = <0x0 0xc3000000 0x00080000>;
+			no-map;
+		};
+
+		dss_header: dss-header@d8100000 {
+			reg = <0x0 0xd8100000 0x00010000>;
+			no-map;
+		};
+
+		dss_kevents: dss-kevents@d8110000 {
+			reg = <0x0 0xd8110000 0x00700000>;
+			no-map;
+		};
+
+		dss_s2d: dss-s2d@d8810000 {
+			reg = <0x0 0xd8810000 0x01800000>;
+			no-map;
+		};
+
+		dss_array_reset: dss-array-reset@da010000 {
+			reg = <0x0 0xda010000 0x00a00000>;
+			no-map;
+		};
+
+		dss_array_panic: dss-array-panic@daa10000 {
+			reg = <0x0 0xdaa10000 0x00a00000>;
+			no-map;
+		};
+
+		dss_slcdump: dss-slcdump@db410000 {
+			reg = <0x0 0xdb410000 0x01100000>;
+			no-map;
+		};
+
+		dss_preslcdump: dss-preslcdump@dc510000 {
+			reg = <0x0 0xdc510000 0x01100000>;
+			no-map;
+		};
+
+		dss_bcm: dss-bcm@dd610000 {
+			reg = <0x0 0xdd610000 0x00400000>;
+			no-map;
+		};
+
+		dss_itmon: dss-itmon@dda10000 {
+			reg = <0x0 0xdda10000 0x00010000>;
+			no-map;
+		};
+
+		dss_s2d_extract: dss-s2d-extract@dda20000 {
+			reg = <0x0 0xdda20000 0x00600000>;
+			no-map;
+		};
+
+		cp_rmem_1: cp-extra@e8000000 {
+			reg = <0x0 0xe8000000 0x02000000>;
+			no-map;
+		};
+
+		cp_rmem: cp@ea400000 {
+			reg = <0x0 0xea400000 0x00c00000>;
+			no-map;
+		};
+
+		cp_msi_rmem: cp-msi@f6200000 {
+			reg = <0x0 0xf6200000 0x00001000>;
+			no-map;
+		};
+
+		dss_log_reserved: dss-log@fd3f0000 {
+			reg = <0x0 0xfd3f0000 0x0000e000>;
+			no-map;
+		};
+
+		debug_kinfo_reserved: debug_kinfo_reserved@fd3fe000 {
+			reg = <0x0 0xfd3fe000 0x00001000>;
+			no-map;
+		};
+
+		/* Reserve only; the pstore consumer is not enabled yet. */
+		ramoops_reserved: ramoops@fd3ff000 {
+			reg = <0x0 0xfd3ff000 0x00400000>;
+			no-map;
+		};
+
+		/* Not in Google's list; kept reserved until shown unused. */
+		debug_tail_reserved: debug-tail@fd7ff000 {
+			reg = <0x0 0xfd7ff000 0x00001000>;
+			no-map;
+		};
+
+		bldr_log_reserved: bldr-log@fd800000 {
+			reg = <0x0 0xfd800000 0x00100000>;
+			no-map;
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
new file mode 100644
index 000000000..10b018b18
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
@@ -0,0 +1,1130 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Google Tensor G4 (Zumapro) core description.
+ *
+ * Copyright 2022-2023 Google LLC.
+ * Copyright (C) 2022 Samsung Electronics Co., Ltd.
+ */
+
+#include <dt-bindings/clock/google,zumapro.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+#include <dt-bindings/soc/samsung,exynos-usi.h>
+
+/ {
+	compatible = "google,zumapro";
+	#address-cells = <2>;
+	#size-cells = <1>;
+	interrupt-parent = <&gic>;
+
+	aliases {
+		pinctrl0 = &pinctrl_alive;
+		pinctrl1 = &pinctrl_custom_alive;
+		pinctrl2 = &pinctrl_far_alive;
+		pinctrl8 = &pinctrl_hsi1;
+		pinctrl9 = &pinctrl_hsi2;
+		pinctrl10 = &pinctrl_hsi2ufs;
+		pinctrl11 = &pinctrl_peric0;
+		pinctrl12 = &pinctrl_peric1;
+	};
+
+	/* ABL applies its debug-policy overlay to these nodes. */
+	ect { };
+
+	dpm: dpm { };
+
+	/*
+	 * Targets of ABL's debug-policy overlay. Keep these driverless and
+	 * separate from reserved-memory: disabling a log consumer must not
+	 * release its firmware-owned memory to the allocator.
+	 */
+	dpm-stubs {
+		itmon: itmon {
+			status = "disabled";
+		};
+
+		log_arrdumppanic: log-array-panic {
+			status = "disabled";
+		};
+
+		log_bcm: log-bcm {
+			status = "disabled";
+		};
+
+		log_preslcdump: log-preslcdump {
+			status = "disabled";
+		};
+
+		log_slcdump: log-slcdump {
+			status = "disabled";
+		};
+	};
+
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu-map {
+			cluster0 {
+				core0 {
+					cpu = <&cpu0>;
+				};
+
+				core1 {
+					cpu = <&cpu1>;
+				};
+
+				core2 {
+					cpu = <&cpu2>;
+				};
+
+				core3 {
+					cpu = <&cpu3>;
+				};
+
+				core4 {
+					cpu = <&cpu4>;
+				};
+
+				core5 {
+					cpu = <&cpu5>;
+				};
+
+				core6 {
+					cpu = <&cpu6>;
+				};
+
+				core7 {
+					cpu = <&cpu7>;
+				};
+			};
+		};
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a520";
+			reg = <0x000>;
+			enable-method = "psci";
+		};
+
+		cpu1: cpu@100 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a520";
+			reg = <0x100>;
+			enable-method = "psci";
+		};
+
+		cpu2: cpu@200 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a520";
+			reg = <0x200>;
+			enable-method = "psci";
+		};
+
+		cpu3: cpu@300 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a520";
+			reg = <0x300>;
+			enable-method = "psci";
+		};
+
+		cpu4: cpu@400 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a720";
+			reg = <0x400>;
+			enable-method = "psci";
+		};
+
+		cpu5: cpu@500 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a720";
+			reg = <0x500>;
+			enable-method = "psci";
+		};
+
+		cpu6: cpu@600 {
+			device_type = "cpu";
+			compatible = "arm,cortex-a720";
+			reg = <0x600>;
+			enable-method = "psci";
+		};
+
+		cpu7: cpu@700 {
+			device_type = "cpu";
+			compatible = "arm,cortex-x4";
+			reg = <0x700>;
+			enable-method = "psci";
+		};
+	};
+
+	oscclk: clock-oscclk {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <24576000>;
+		clock-output-names = "oscclk";
+	};
+
+	/* The GPL PHY calibration uses a 38.4 MHz reference configuration. */
+	ufs_ref_clk: clock-ufs-ref {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <38400000>;
+		clock-output-names = "ufs-ref";
+	};
+
+	/* The CAL's nominal rates for HSI0's two board inputs. */
+	hsi0_alt: clock-hsi0-alt {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <213000000>;
+		clock-output-names = "hsi0-alt";
+	};
+
+	hsi0_tcxo: clock-hsi0-tcxo {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <26000000>;
+		clock-output-names = "hsi0-tcxo";
+	};
+
+	/* The CAL's nominal I_CLK_HSI1_ALT rate. */
+	hsi1_alt: clock-hsi1-alt {
+		compatible = "fixed-clock";
+		#clock-cells = <0>;
+		clock-frequency = <400000000>;
+		clock-output-names = "hsi1-alt";
+	};
+
+	psci {
+		compatible = "arm,psci-1.0";
+		method = "smc";
+	};
+
+	timer {
+		compatible = "arm,armv8-timer";
+		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
+			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
+	};
+
+	firmware {
+		acpm_ipc: power-management {
+			compatible = "google,zumapro-acpm-ipc";
+			#clock-cells = <1>;
+			mboxes = <&ap2apm_mailbox>;
+			shmem = <&apm_sram>;
+			status = "disabled";
+		};
+	};
+
+	soc: soc {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		cmu_misc: clock-controller@10010000 {
+			compatible = "google,zumapro-cmu-misc";
+			reg = <0x0 0x10010000 0x8000>;
+			#clock-cells = <1>;
+			clocks = <&oscclk>, <&cmu_top CLK_DOUT_MISC_NOC>;
+			clock-names = "oscclk", "bus";
+			status = "disabled";
+		};
+
+		watchdog_cl0: watchdog@10060000 {
+			compatible = "google,zumapro-wdt", "google,zuma-wdt";
+			reg = <0x0 0x10060000 0x100>;
+			interrupts = <GIC_SPI 767 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_misc CLK_GOUT_WDT_CLUSTER0>, <&oscclk>;
+			clock-names = "watchdog", "watchdog_src";
+			timeout-sec = <30>;
+			samsung,syscon-phandle = <&pmu_system_controller>;
+			samsung,cluster-index = <0>;
+			status = "disabled";
+		};
+
+		watchdog_cl1: watchdog@10070000 {
+			compatible = "google,zumapro-wdt", "google,zuma-wdt";
+			reg = <0x0 0x10070000 0x100>;
+			interrupts = <GIC_SPI 768 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_misc CLK_GOUT_WDT_CLUSTER1>, <&oscclk>;
+			clock-names = "watchdog", "watchdog_src";
+			timeout-sec = <30>;
+			samsung,syscon-phandle = <&pmu_system_controller>;
+			samsung,cluster-index = <1>;
+			status = "disabled";
+		};
+
+		gic: interrupt-controller@10400000 {
+			compatible = "arm,gic-v3";
+			#interrupt-cells = <3>;
+			#address-cells = <0>;
+			interrupt-controller;
+			reg = <0x0 0x10400000 0x10000>,
+			      <0x0 0x10440000 0x200000>;
+			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
+		cmu_peric0: clock-controller@10800000 {
+			compatible = "google,zumapro-cmu-peric0";
+			reg = <0x0 0x10800000 0x8000>;
+			#clock-cells = <1>;
+			clocks = <&oscclk>, <&cmu_top CLK_DOUT_PERIC0_NOC>,
+				 <&cmu_top CLK_DOUT_PERIC0_IP>;
+			clock-names = "oscclk", "bus", "ip";
+			status = "disabled";
+		};
+
+		sysreg_peric0: syscon@10821000 {
+			compatible = "google,zumapro-peric0-sysreg", "syscon";
+			reg = <0x0 0x10821000 0x1000>;
+			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_SYSREG>;
+			status = "disabled";
+		};
+
+		pinctrl_peric0: pinctrl@10840000 {
+			compatible = "google,zumapro-pinctrl";
+			reg = <0x0 0x10840000 0x1000>;
+			clocks = <&cmu_peric0 CLK_GOUT_GPIO_PERIC0>;
+			clock-names = "pclk";
+			status = "disabled";
+
+			gpp0: gpp0-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp1: gpp1-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp2: gpp2-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp3: gpp3-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp4: gpp4-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp5: gpp5-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp6: gpp6-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp7: gpp7-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp8: gpp8-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp9: gpp9-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp10: gpp10-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp11: gpp11-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp12: gpp12-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp13: gpp13-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp14: gpp14-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp15: gpp15-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp17: gpp17-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+
+			gpp16: gpp16-gpio-bank {
+				gpio-controller;
+				#gpio-cells = <2>;
+			};
+		};
+
+		usi2: usi@108900c0 {
+			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
+			reg = <0x0 0x108900c0 0x20>;
+			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI2_PCLK>,
+				 <&cmu_peric0 CLK_GOUT_PERIC0_USI2_IPCLK>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_peric0 0x4>;
+			samsung,mode = <USI_MODE_I2C>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0x10890000 0x0 0x10890000 0x1000>;
+			status = "disabled";
+
+			hsi2c2: i2c@10890000 {
+				compatible = "google,zumapro-hsi2c",
+					     "samsung,exynosautov9-hsi2c";
+				reg = <0x10890000 0xc0>;
+				interrupts = <GIC_SPI 643 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI2_IPCLK>,
+					 <&cmu_peric0 CLK_GOUT_PERIC0_USI2_PCLK>;
+				clock-names = "hsi2c", "hsi2c_pclk";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+		};
+
+		usi3: usi@108a00c0 {
+			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
+			reg = <0x0 0x108a00c0 0x20>;
+			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI3_PCLK>,
+				 <&cmu_peric0 CLK_GOUT_PERIC0_USI3_IPCLK>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_peric0 0x8>;
+			samsung,mode = <USI_MODE_I2C>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0x108a0000 0x0 0x108a0000 0x1000>;
+			status = "disabled";
+
+			hsi2c3: i2c@108a0000 {
+				compatible = "google,zumapro-hsi2c",
+					     "samsung,exynosautov9-hsi2c";
+				reg = <0x108a0000 0xc0>;
+				interrupts = <GIC_SPI 644 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI3_IPCLK>,
+					 <&cmu_peric0 CLK_GOUT_PERIC0_USI3_PCLK>;
+				clock-names = "hsi2c", "hsi2c_pclk";
+				#address-cells = <1>;

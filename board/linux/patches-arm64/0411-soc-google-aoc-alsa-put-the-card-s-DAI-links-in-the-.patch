From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 17:18:53 -0400
Subject: [PATCH] soc: google: aoc: alsa: put the card's DAI links in the stock
 order

ASoC numbers a card's PCMs in DAI link order, and the AoC PCM drivers
take the AoC entry point (and the capture use case) from the PCM
number, so the links have to be in the order of Google's cheetah device
tree: EPn playback PCM n - 1, EPn capture PCM 8 + n - 1, and so on.
The card took the order of its device tree nodes, which a card added by
an overlay does not keep reliably; there EP6 playback became PCM 47 and
the AoC rejected the stream ("Mode Playback is not supported by
Entrypoint 47").

Sort the parsed links by their id into the stock order: the known front
ends first, in Google's order, then any other front end, then the back
ends, each in device tree order.

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 drivers/soc/google/aoc/alsa/aoc_alsa_card.c | 72 +++++++++++++++++++++
 1 file changed, 72 insertions(+)

diff --git a/drivers/soc/google/aoc/alsa/aoc_alsa_card.c b/drivers/soc/google/aoc/alsa/aoc_alsa_card.c
index b79a3f14e..16ee45d97 100644
--- a/drivers/soc/google/aoc/alsa/aoc_alsa_card.c
+++ b/drivers/soc/google/aoc/alsa/aoc_alsa_card.c
@@ -1274,6 +1274,77 @@ static int of_parse_one_dai(struct device_node *node, struct device *dev,
 	return ret;
 }
 
+/*
+ * ASoC numbers a card's PCMs in DAI link order, and the PCM drivers take the
+ * AoC entry point (and the capture use case) from the PCM number, so the
+ * links must be in the order of Google's device tree for cheetah. Do not
+ * rely on the device tree's node order (a card added by an overlay can come
+ * out in another order): sort the front ends by link id into that order;
+ * front ends not in the list follow, then the back ends, each in device
+ * tree order.
+ */
+static const u32 aoc_stock_fe_order[] = {
+	0x00, 0x01, 0x02, 0x03, 0x04, 0x05, 0x06, 0x07,	/* EP1-EP8 playback: PCM 0-7 */
+	0x40000000, 0x40000001, 0x40000002,		/* EP1-EP6 capture: PCM 8-13 */
+	0x40000003, 0x40000004, 0x40000005,
+	0x20000008, 0x60000008,				/* no-host 1 */
+	0x0a, 0x4000000a,				/* VoIP */
+	0x0b, 0x0c, 0x4000000d, 0x4000000e, 0x4000000f,	/* in-call */
+	0x09,						/* raw */
+	0x20000011,					/* haptics no-host */
+	0x10, 0x40000010,				/* HiFi out, in */
+	0x40000012,					/* Android AEC */
+	0x13,						/* ultrasonic */
+	0x14,						/* in-call playback 2 */
+	0x15,						/* immersive */
+	0x16,						/* capture inject */
+	0x40000017,					/* hotword tap */
+};
+
+static unsigned int aoc_link_rank(const struct snd_soc_dai_link *link, unsigned int pos)
+{
+	unsigned int i;
+
+	if (link->id & AOC_BE)
+		return 0x20000 + pos;
+	for (i = 0; i < ARRAY_SIZE(aoc_stock_fe_order); i++)
+		if (link->id == aoc_stock_fe_order[i])
+			return i;
+	return 0x10000 + pos;
+}
+
+static int aoc_sort_dai_links(struct device *dev, struct snd_soc_card *card)
+{
+	struct snd_soc_dai_link *sorted;
+	unsigned int *rank;
+	unsigned int i, j, n = card->num_links;
+
+	sorted = devm_kcalloc(dev, n, sizeof(*sorted), GFP_KERNEL);
+	rank = kcalloc(n, sizeof(*rank), GFP_KERNEL);
+	if (!sorted || !rank) {
+		kfree(rank);
+		return -ENOMEM;
+	}
+	for (i = 0; i < n; i++)
+		rank[i] = aoc_link_rank(&card->dai_link[i], i);
+	/* n is small (about 50): a selection by rank keeps it simple */
+	for (j = 0; j < n; j++) {
+		unsigned int best = UINT_MAX, bi = 0;
+
+		for (i = 0; i < n; i++) {
+			if (rank[i] < best) {
+				best = rank[i];
+				bi = i;
+			}
+		}
+		sorted[j] = card->dai_link[bi];
+		rank[bi] = UINT_MAX;
+	}
+	kfree(rank);
+	card->dai_link = sorted;
+	return 0;
+}
+
 static int aoc_of_parse_dai_link(struct device_node *node,
 				 struct snd_soc_card *card)
 {
@@ -1345,6 +1416,7 @@ static int aoc_of_parse_dai_link(struct device_node *node,
 		goto err;
 
 	card->num_links = count;
+	ret = aoc_sort_dai_links(dev, card);
 	of_node_put(np_dai);
 	return ret;
 

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: boozedog <code@booze.dog>
Date: Sat, 17 Oct 2026 08:07:45 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201-felix: enable UFS

The Pixel Fold's UFS controller is the same gs201 block as the Pixel 7
Pro. Describe VCC as an always-on fixed regulator, the way the
bootloader leaves it, and enable ufs_0 and ufs_0_phy.

On the 2026-10-16 boot
(7.3.0-rc6-omandroid-push1-g056bfe463354-dirty, built 2026-10-13) the
link came up FAST series_B G_4 L_2. The device is a Micron
MT256GAXAT4U31. Four LUNs attached: sda (256 GB, 31 partitions), sdb
and sdc (32 MiB, 10 partitions each), and sdd (4 MiB, 4 partitions).

Signed-off-by: boozedog <code@booze.dog>
---
 .../boot/dts/exynos/google/gs201-felix.dts    | 38 ++++++++++++++-----
 1 file changed, 29 insertions(+), 9 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-felix.dts b/arch/arm64/boot/dts/exynos/google/gs201-felix.dts
index 3faea3592..19275f2b2 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-felix.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-felix.dts
@@ -2,10 +2,10 @@
 /*
  * Google Pixel Fold (felix).
  *
- * Same GS201 silicon as the Pixel 7 Pro. This board file brings up USB
- * and the cover framebuffer the bootloader is already scanning. It does
- * not describe either panel or either touch controller. The inner panel
- * has no node that could drive it.
+ * Same GS201 silicon as the Pixel 7 Pro. This board file brings up USB,
+ * the cover framebuffer the bootloader is already scanning, and UFS.
+ * It does not describe either panel or either touch controller. The
+ * inner panel has no node that could drive it.
  */
 
 /dts-v1/;
@@ -26,11 +26,10 @@ / {
 	chosen {
 		/*
 		 * ABL requires bootargs and appends its own, including
-		 * console=null. No UFS probe: storage stays off until this
-		 * phone's guard has been checked. Nothing here writes a
-		 * display register. The framebuffer below is the cover plane
-		 * read from DPP2 on the first boot (1080x2092 at 0xfc000000).
-		 * The inner plane, DPP0 at 0xfac00000, is not described.
+		 * console=null. Nothing here writes a display register. The
+		 * framebuffer below is the cover plane read from DPP2 on the
+		 * first boot (1080x2092 at 0xfc000000). The inner plane, DPP0
+		 * at 0xfac00000, is not described.
 		 */
 		bootargs = "console=tty0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init";
 		#address-cells = <2>;
@@ -61,6 +60,18 @@ cont_splash_mem: splash@fc000000 {
 			no-map;
 		};
 	};
+
+	/*
+	 * UFS VCC. The bootloader leaves this rail on. There is no gs201
+	 * GPIO driver yet, so describe it as an always-on fixed regulator,
+	 * as on the Pixel 7 Pro.
+	 */
+	ufs_0_fixed_vcc_reg: regulator-ufs-vcc {
+		compatible = "regulator-fixed";
+		regulator-name = "ufs-vcc";
+		regulator-always-on;
+		regulator-boot-on;
+	};
 };
 
 &usbdrd31_phy {
@@ -70,3 +81,12 @@ &usbdrd31_phy {
 &usb_dwc3 {
 	status = "okay";
 };
+
+&ufs_0 {
+	vcc-supply = <&ufs_0_fixed_vcc_reg>;
+	status = "okay";
+};
+
+&ufs_0_phy {
+	status = "okay";
+};

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Wed, 28 Oct 2026 16:22:42 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: add the HSI2 pin
 controller

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 .../boot/dts/exynos/google/gs201-pinctrl.dtsi    | 16 ++++++++++++++++
 arch/arm64/boot/dts/exynos/google/gs201.dtsi     | 10 ++++++++++
 2 files changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi b/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
index 3ebafd39c..774de1b8f 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
@@ -497,3 +497,19 @@ ts_reset: ts-reset-pins {
 		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
 	};
 };
+
+&pinctrl_hsi2 {
+	gph2: gph2-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+
+	gph4: gph4-gpio-bank {
+		gpio-controller;
+		#gpio-cells = <2>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+};
diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index 01c1dcfdb..e1e6508ec 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -21,6 +21,7 @@ aliases {
 		pinctrl1 = &pinctrl_far_alive;
 		pinctrl4 = &pinctrl_peric0;
 		pinctrl5 = &pinctrl_peric1;
+		pinctrl7 = &pinctrl_hsi2;
 	};
 
 	/* Required by the Pixel bootloader (ABL). */
@@ -868,6 +869,15 @@ sysreg_hsi2: syscon@14420000 {
 			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_SYSREG_HSI2_PCLK>;
 		};
 
+		pinctrl_hsi2: pinctrl@14440000 {
+			compatible = "google,gs201-pinctrl";
+			reg = <0x14440000 0x1000>;
+			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_GPIO_HSI2_PCLK>;
+			clock-names = "pclk";
+			interrupts = <GIC_SPI 421 IRQ_TYPE_LEVEL_HIGH>;
+			status = "disabled";
+		};
+
 		/*
 		 * No gs201 pinctrl driver yet: the UFS reset (gph3-1) and
 		 * reference clock output (gph3-0) pins on the HSI2UFS pin

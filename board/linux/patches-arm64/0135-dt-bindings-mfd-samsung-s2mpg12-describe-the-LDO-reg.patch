From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: boozedog <code@booze.dog>
Date: Thu, 22 Oct 2026 21:34:48 -0400
Subject: [PATCH] dt-bindings: mfd: samsung,s2mpg12: describe the LDO
 regulators

Signed-off-by: boozedog <code@booze.dog>
---
 .../bindings/mfd/samsung,s2mpg12-pmic.yaml    |  7 +++++
 .../regulator/samsung,s2mpg12-regulator.yaml  | 29 +++++++++++++++++++
 2 files changed, 36 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/regulator/samsung,s2mpg12-regulator.yaml

diff --git a/Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml b/Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml
index 26255b354..5e2756675 100644
--- a/Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml
+++ b/Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml
@@ -33,6 +33,13 @@ properties:
 
   wakeup-source: true
 
+  regulators:
+    type: object
+    $ref: /schemas/regulator/samsung,s2mpg12-regulator.yaml
+    description:
+      LDO regulators. A rail with no child node has no constraints and
+      is left as the bootloader set it.
+
 required:
   - compatible
   - interrupts
diff --git a/Documentation/devicetree/bindings/regulator/samsung,s2mpg12-regulator.yaml b/Documentation/devicetree/bindings/regulator/samsung,s2mpg12-regulator.yaml
new file mode 100644
index 000000000..a634bcb52
--- /dev/null
+++ b/Documentation/devicetree/bindings/regulator/samsung,s2mpg12-regulator.yaml
@@ -0,0 +1,29 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/regulator/samsung,s2mpg12-regulator.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPG12 Power Management IC regulators
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+description: |
+  This is part of the device tree bindings for the S2MPG12 Power Management
+  IC (PMIC). Only its 28 LDO regulators are described so far. The buck
+  converters are not.
+
+  See also Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml.
+
+patternProperties:
+  "^ldo([1-9]|1[0-9]|2[0-8])m$":
+    type: object
+    $ref: regulator.yaml#
+    unevaluatedProperties: false
+    description:
+      Properties for a single LDO regulator.
+    properties:
+      regulator-ramp-delay: false
+
+additionalProperties: false

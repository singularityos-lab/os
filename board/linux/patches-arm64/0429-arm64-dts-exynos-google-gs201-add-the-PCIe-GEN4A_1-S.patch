From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 10:27:01 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: add the PCIe GEN4A_1
 System MMU

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts |  4 ++++
 arch/arm64/boot/dts/exynos/google/gs201.dtsi        | 11 +++++++++++
 2 files changed, 15 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts b/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
index 70bd76790..161c0575c 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
@@ -852,6 +852,10 @@ &pcie_1_phy {
  * UFS masters share its VID 0, so it cannot confine the Wi-Fi chip without
  * also confining storage.
  */
+&pcie_1_sysmmu {
+	google,dma-window = <&wifi_dma_pool>;
+};
+
 &pinctrl_far_alive {
 	wlan_host_wake: wlan-host-wake-pins {
 		samsung,pins = "gpa6-1";
diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index b8553497b..6e8a9a38d 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -1474,6 +1474,17 @@ pcie_1_intc: legacy-interrupt-controller {
 			};
 		};
 
+		/* PCIe GEN4A_1 System MMU, used as a DMA window (W4) */
+		pcie_1_sysmmu: sysmmu@145c0000 {
+			compatible = "google,gs201-pcie-sysmmu";
+			reg = <0x145c0000 0x10000>;
+			interrupts = <GIC_SPI 446 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_hsi2 CLK_GOUT_HSI2_SYSMMU_HSI2_CLK_S1>,
+				 <&cmu_hsi2 CLK_GOUT_HSI2_SYSMMU_HSI2_CLK_S2>;
+			google,vid = <1>;
+			status = "disabled";
+		};
+
 		pcie_1_phy: phy@14550000 {
 			compatible = "google,gs201-pcie-phy";
 			reg = <0x14550000 0x2000>,

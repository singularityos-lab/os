From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 12:56:53 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: add the AoC and its System
 MMU

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 arch/arm64/boot/dts/exynos/google/gs201.dtsi | 56 ++++++++++++++++++++
 1 file changed, 56 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index 87882e481..402ceaa00 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -1441,6 +1441,62 @@ gsa: gsa@17c90000 {
 			status = "disabled";
 		};
 
+		aoc_sysmmu: sysmmu@1a090000 {
+			compatible = "google,gs201-aoc-sysmmu";
+			reg = <0x1a090000 0x10000>;
+			interrupts = <GIC_SPI 118 IRQ_TYPE_LEVEL_HIGH>;
+			status = "disabled";
+		};
+
+		aoc: aoc@181d0000 {
+			compatible = "google,gs201-aoc";
+			reg = <0x181d0000 0x1000>, <0x1a0b0000 0x1000>,
+			      <0x10000000 0x100>, <0x19a00000 0x10000>;
+			reg-names = "aoc_req", "s2mpu", "chipid", "pcu";
+			interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "watchdog";
+			memory-region = <&{/reserved-memory/aoc@94000000}>;
+			google,gsa = <&gsa>;
+			google,sysmmu = <&aoc_sysmmu>;
+			mboxes = <&aoc_mbox_a32 0>, <&aoc_mbox_a32 1>, <&aoc_mbox_a32 2>, <&aoc_mbox_a32 3>,
+				 <&aoc_mbox_a32 4>, <&aoc_mbox_a32 5>, <&aoc_mbox_a32 6>, <&aoc_mbox_a32 7>,
+				 <&aoc_mbox_a32 8>, <&aoc_mbox_a32 9>, <&aoc_mbox_a32 10>, <&aoc_mbox_a32 11>,
+				 <&aoc_mbox_a32 12>, <&aoc_mbox_a32 13>, <&aoc_mbox_a32 14>, <&aoc_mbox_a32 15>,
+				 <&aoc_mbox_f1 0>, <&aoc_mbox_f1 1>, <&aoc_mbox_f1 2>, <&aoc_mbox_f1 3>,
+				 <&aoc_mbox_f1 4>, <&aoc_mbox_f1 5>, <&aoc_mbox_f1 6>, <&aoc_mbox_f1 7>,
+				 <&aoc_mbox_f1 8>, <&aoc_mbox_f1 9>, <&aoc_mbox_f1 10>, <&aoc_mbox_f1 11>,
+				 <&aoc_mbox_f1 12>, <&aoc_mbox_f1 13>, <&aoc_mbox_f1 14>, <&aoc_mbox_f1 15>,
+				 <&aoc_mbox_p6 0>, <&aoc_mbox_p6 1>, <&aoc_mbox_p6 2>, <&aoc_mbox_p6 3>,
+				 <&aoc_mbox_p6 4>, <&aoc_mbox_p6 5>, <&aoc_mbox_p6 6>, <&aoc_mbox_p6 7>,
+				 <&aoc_mbox_p6 8>, <&aoc_mbox_p6 9>, <&aoc_mbox_p6 10>, <&aoc_mbox_p6 11>,
+				 <&aoc_mbox_p6 12>, <&aoc_mbox_p6 13>, <&aoc_mbox_p6 14>, <&aoc_mbox_p6 15>;
+			status = "disabled";
+		};
+
+		aoc_mbox_a32: mailbox@18300000 {
+			compatible = "google,gs201-aoc-mbox";
+			reg = <0x18300000 0x1000>;
+			interrupts = <GIC_SPI 75 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <1>;
+			status = "disabled";
+		};
+
+		aoc_mbox_f1: mailbox@18320000 {
+			compatible = "google,gs201-aoc-mbox";
+			reg = <0x18320000 0x1000>;
+			interrupts = <GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <1>;
+			status = "disabled";
+		};
+
+		aoc_mbox_p6: mailbox@18340000 {
+			compatible = "google,gs201-aoc-mbox";
+			reg = <0x18340000 0x1000>;
+			interrupts = <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>;
+			#mbox-cells = <1>;
+			status = "disabled";
+		};
+
 		/*
 		 * Multi-core timer. Gives the kernel a broadcast clock event
 		 * device that keeps running while cores are powered down in C2.

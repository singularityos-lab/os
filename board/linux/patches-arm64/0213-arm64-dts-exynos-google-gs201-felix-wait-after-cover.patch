From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: boozedog <code@booze.dog>
Date: Mon, 26 Oct 2026 12:01:42 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201-felix: wait after cover
 chip select

Signed-off-by: boozedog <code@booze.dog>
Assisted-by: LLM
---
 arch/arm64/boot/dts/exynos/google/gs201-felix.dts | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-felix.dts b/arch/arm64/boot/dts/exynos/google/gs201-felix.dts
index 3d56c7a25..fc9dfd1d7 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-felix.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-felix.dts
@@ -232,6 +232,8 @@ cover_touch: touchscreen@0 {
 		compatible = "st,salixp";
 		reg = <0>;
 		spi-max-frequency = <10000000>;
+		/* 2 µs from chip select asserted to the first clock. */
+		spi-cs-setup-delay-ns = <2000>;
 		interrupt-parent = <&gpa6>;
 		interrupts = <7 IRQ_TYPE_LEVEL_LOW>;
 		vdd-supply = <&ldo25m>;

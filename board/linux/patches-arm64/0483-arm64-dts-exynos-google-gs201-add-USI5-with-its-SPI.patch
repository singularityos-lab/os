From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 13:26:46 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: add USI5 with its SPI

Assisted-by: LLM
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 .../boot/dts/exynos/google/gs201-pinctrl.dtsi | 14 ++++++++++
 arch/arm64/boot/dts/exynos/google/gs201.dtsi  | 27 +++++++++++++++++++
 2 files changed, 41 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi b/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
index 9d0b0536d..ee39db4e3 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
@@ -404,6 +404,20 @@ hsi2c8_bus: hsi2c8-bus-pins {
 		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
 	};
 
+	spi5_bus: spi5-bus-pins {
+		samsung,pins = "gpp10-0", "gpp10-1", "gpp10-2";
+		samsung,pin-function = <GS101_PIN_FUNC_3>;
+		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+
+	spi5_cs_gpio: spi5-cs-gpio-pins {
+		samsung,pins = "gpp10-3";
+		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
+		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+
 	spi6_bus: spi6-bus-pins {
 		samsung,pins = "gpp12-0", "gpp12-1", "gpp12-2";
 		samsung,pin-function = <GS101_PIN_FUNC_3>;
diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index 9050c0ea5..ce2fefa62 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -995,6 +995,33 @@ hsi2c_4: i2c@10930000 {
 			};
 		};
 
+		usi5: usi@109400c0 {
+			compatible = "google,gs201-usi", "samsung,exynos850-usi";
+			reg = <0x109400c0 0x20>;
+			ranges;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI5_USI_PCLK>,
+				 <&cmu_peric0 CLK_GOUT_PERIC0_USI5_USI_IPCLK>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_peric0 0x1010>;
+			status = "disabled";
+
+			spi_5: spi@10940000 {
+				compatible = "google,gs201-spi", "google,gs101-spi";
+				reg = <0x10940000 0x30>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clocks = <&cmu_peric0 CLK_GOUT_PERIC0_USI5_USI_PCLK>,
+					 <&cmu_peric0 CLK_GOUT_PERIC0_USI5_USI_IPCLK>;
+				clock-names = "spi", "spi_busclk0";
+				interrupts = <GIC_SPI 678 IRQ_TYPE_LEVEL_HIGH>;
+				pinctrl-0 = <&spi5_bus>;
+				pinctrl-names = "default";
+				status = "disabled";
+			};
+		};
+
 		usi6: usi@109500c0 {
 			compatible = "google,gs201-usi", "samsung,exynos850-usi";
 			reg = <0x109500c0 0x20>;

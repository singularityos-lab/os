From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Wed, 14 Oct 2026 21:05:17 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: add the C2 CPU idle states

Add one PSCI idle state per core type: core power-down ("c2"),
power_state 0x10000, with the entry/exit latencies and minimum residencies
of Google's gs201 device tree (also in the tree the bootloader hands over
on a Pixel 7 Pro): Cortex-A55 70/160/2000 us, Cortex-A78 150/190/2500 us,
Cortex-X1 235/220/3500 us. All cores get them together: cpuidle-psci
tears down every CPU if one of them has no idle state.

The firmware only powers a core down when the CPU_INFORM hint and the PMU
interrupt-generator wake-up bits have been programmed; the exynos-pmu
driver already does that from its CPU PM notifier for gs201, through the
pmu-intr-gen syscon. The per-core generic timer stops in C2, hence
local-timer-stop: the MCT provides the broadcast timer.

Tested on a Pixel 7 Pro: psci_idle registers C2 on all eight CPUs, idle
CPUs spend about 85-90% of the time in C2, the firmware rejects 1-7% of
the entries, and an all-core load followed by idle shows no RCU stall,
lockup or secure PMU write failure.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/google/gs201.dtsi | 49 ++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index 5688a35e5..0b5761370 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -50,6 +50,7 @@ cpu0: cpu@0 {
 			compatible = "arm,cortex-a55";
 			reg = <0x000>;
 			enable-method = "psci";
+			cpu-idle-states = <&ananke_cpu_sleep>;
 			capacity-dmips-mhz = <250>;
 		};
 		cpu1: cpu@100 {
@@ -57,6 +58,7 @@ cpu1: cpu@100 {
 			compatible = "arm,cortex-a55";
 			reg = <0x100>;
 			enable-method = "psci";
+			cpu-idle-states = <&ananke_cpu_sleep>;
 			capacity-dmips-mhz = <250>;
 		};
 		cpu2: cpu@200 {
@@ -64,6 +66,7 @@ cpu2: cpu@200 {
 			compatible = "arm,cortex-a55";
 			reg = <0x200>;
 			enable-method = "psci";
+			cpu-idle-states = <&ananke_cpu_sleep>;
 			capacity-dmips-mhz = <250>;
 		};
 		cpu3: cpu@300 {
@@ -71,6 +74,7 @@ cpu3: cpu@300 {
 			compatible = "arm,cortex-a55";
 			reg = <0x300>;
 			enable-method = "psci";
+			cpu-idle-states = <&ananke_cpu_sleep>;
 			capacity-dmips-mhz = <250>;
 		};
 		cpu4: cpu@400 {
@@ -78,6 +82,7 @@ cpu4: cpu@400 {
 			compatible = "arm,cortex-a78";
 			reg = <0x400>;
 			enable-method = "psci";
+			cpu-idle-states = <&hercules_cpu_sleep>;
 			capacity-dmips-mhz = <927>;
 		};
 		cpu5: cpu@500 {
@@ -85,6 +90,7 @@ cpu5: cpu@500 {
 			compatible = "arm,cortex-a78";
 			reg = <0x500>;
 			enable-method = "psci";
+			cpu-idle-states = <&hercules_cpu_sleep>;
 			capacity-dmips-mhz = <927>;
 		};
 		cpu6: cpu@600 {
@@ -92,6 +98,7 @@ cpu6: cpu@600 {
 			compatible = "arm,cortex-x1";
 			reg = <0x600>;
 			enable-method = "psci";
+			cpu-idle-states = <&hera_cpu_sleep>;
 			capacity-dmips-mhz = <1024>;
 		};
 		cpu7: cpu@700 {
@@ -99,8 +106,50 @@ cpu7: cpu@700 {
 			compatible = "arm,cortex-x1";
 			reg = <0x700>;
 			enable-method = "psci";
+			cpu-idle-states = <&hera_cpu_sleep>;
 			capacity-dmips-mhz = <1024>;
 		};
+		/*
+		 * C2: core power-down through PSCI CPU_SUSPEND, with latencies
+		 * from Google's gs201 device tree. The exynos-pmu driver writes
+		 * the CPU_INFORM hint and the PMU interrupt-generator wake-up
+		 * bits that the firmware expects on every entry. The per-core
+		 * generic timer stops in C2, so this needs the MCT as broadcast
+		 * timer.
+		 */
+		idle-states {
+			entry-method = "psci";
+
+			ananke_cpu_sleep: cpu-ananke-sleep {
+				compatible = "arm,idle-state";
+				idle-state-name = "c2";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <70>;
+				exit-latency-us = <160>;
+				min-residency-us = <2000>;
+			};
+
+			hercules_cpu_sleep: cpu-hercules-sleep {
+				compatible = "arm,idle-state";
+				idle-state-name = "c2";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <150>;
+				exit-latency-us = <190>;
+				min-residency-us = <2500>;
+			};
+
+			hera_cpu_sleep: cpu-hera-sleep {
+				compatible = "arm,idle-state";
+				idle-state-name = "c2";
+				arm,psci-suspend-param = <0x0010000>;
+				local-timer-stop;
+				entry-latency-us = <235>;
+				exit-latency-us = <220>;
+				min-residency-us = <3500>;
+			};
+		};
 	};
 
 	psci {

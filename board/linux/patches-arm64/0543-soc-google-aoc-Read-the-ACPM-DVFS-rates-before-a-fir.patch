From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Sat, 31 Oct 2026 11:19:48 -0643
Subject: [PATCH] soc: google: aoc: Read the ACPM DVFS rates before a firmware
 start

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 drivers/soc/google/aoc/aoc.c | 22 ++++++++++++++++++++++
 drivers/soc/google/aoc/aoc.h |  2 ++
 2 files changed, 24 insertions(+)

diff --git a/drivers/soc/google/aoc/aoc.c b/drivers/soc/google/aoc/aoc.c
index 264ecaa5d..6e8ae5144 100644
--- a/drivers/soc/google/aoc/aoc.c
+++ b/drivers/soc/google/aoc/aoc.c
@@ -22,6 +22,7 @@
 #include <linux/io.h>
 #include <linux/jiffies.h>
 #include <linux/list.h>
+#include <linux/clk.h>
 #include <linux/module.h>
 #include <linux/moduleparam.h>
 #include <linux/of.h>
@@ -539,6 +540,22 @@ static int aoc_fw_authenticate(struct aoc_prvdata *prvdata,
 	return rc;
 }
 
+/*
+ * Ask ACPM for the current rate of each DVFS domain in "clocks" (ACPM
+ * clocks don't cache their rate). On zumapro the firmware faulted at every
+ * start until the AP had made this query once before it.
+ */
+static void aoc_read_dvfs_rates(struct aoc_prvdata *prvdata)
+{
+	unsigned long rate;
+	int i;
+
+	for (i = 0; i < prvdata->num_dvfs_clks; i++) {
+		rate = clk_get_rate(prvdata->dvfs_clks[i].clk);
+		dev_dbg(prvdata->dev, "DVFS %d: %lu Hz\n", i, rate);
+	}
+}
+
 static void aoc_fw_callback(const struct firmware *fw, void *ctx)
 {
 	static bool first_load_prevented = false;
@@ -630,6 +647,7 @@ static void aoc_fw_callback(const struct firmware *fw, void *ctx)
 			fw_data[i].value = board_rev;
 	}
 
+	aoc_read_dvfs_rates(prvdata);
 	request_aoc_on(prvdata, true);
 
 	if (!fw->data) {
@@ -2688,6 +2706,10 @@ static int aoc_platform_probe(struct platform_device *pdev)
 		if (rc)
 			return rc;
 	}
+	rc = devm_clk_bulk_get_all(dev, &prvdata->dvfs_clks);
+	if (rc < 0)
+		return dev_err_probe(dev, rc, "failed to get the DVFS clocks\n");
+	prvdata->num_dvfs_clks = rc;
 	aoc_platform_device = pdev;
 	mem_node = of_parse_phandle(aoc_node, "memory-region", 0);
 	platform_set_drvdata(pdev, prvdata);
diff --git a/drivers/soc/google/aoc/aoc.h b/drivers/soc/google/aoc/aoc.h
index 0d09b3d08..47359799f 100644
--- a/drivers/soc/google/aoc/aoc.h
+++ b/drivers/soc/google/aoc/aoc.h
@@ -116,6 +116,8 @@ struct aoc_prvdata {
 	bool firmware_submitted;
 	void *auth_header_virt;
 	dma_addr_t auth_header_dma;
+	struct clk_bulk_data *dvfs_clks;
+	int num_dvfs_clks;
 	struct mbox_slot *mbox_channels;
 	struct dentry *debugfs;
 	struct aoc_service_dev **services;

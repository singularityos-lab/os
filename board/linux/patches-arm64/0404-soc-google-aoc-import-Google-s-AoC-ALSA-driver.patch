+	/* Bind/ubind - source 11 and sink 0 */
+	err = aoc_audio_path_bind(src, dest, cmd, chip);
+	if (err < 0)
+		pr_err("ERR=%d, sidestone %s fail in binding src:%d - dest:%d\n", err,
+		       (enable) ? "START" : "STOP", src, dest);

+		     sizeof(source));
+
+	/* source on/off */
+	source.source = src;
+	switch (cmd) {
+	case START:
+		source.on = 1;
+		break;
+	case STOP:
+		source.on = 0;
+		break;
+	default:
+		pr_err("Invalid source operation (only On/Off allowed)\n");
+		return -EINVAL;
+	}
+
+	err = aoc_audio_control(CMD_OUTPUT_CHANNEL, (uint8_t *)&source,
+				sizeof(source), NULL, alsa_stream->chip);
+
+	pr_debug("Source %d %s !\n", alsa_stream->idx,
+		 cmd == START ? "on" : "off");
+
+	return err;
+}

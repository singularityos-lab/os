+	err = aoc_audio_control_simple_cmd(CMD_OUTPUT_CHANNEL,
+		CMD_AUDIO_OUTPUT_DECODER_GAPLESS_PARTIAL_DRAIN_ID, alsa_stream->chip);
+	if (err < 0)

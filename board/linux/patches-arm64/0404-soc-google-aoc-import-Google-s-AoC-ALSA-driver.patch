+		(struct aoc_chip *)snd_soc_card_get_drvdata(component->card);
+
+	int enable = 0;
+
+	mutex_lock(&chip->audio_mutex);
+	enable = chip->mic_loopback_enabled;
+	mutex_unlock(&chip->audio_mutex);
+	ucontrol->value.integer.value[0] = enable;

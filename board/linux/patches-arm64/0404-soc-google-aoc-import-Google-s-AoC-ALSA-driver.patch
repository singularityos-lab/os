+int aoc_audio_capture_runtime_trigger(struct aoc_chip *chip, int ep_id, int dst, bool on)
+{
+	struct aoc_alsa_stream *alsa_stream;
+
+	alsa_stream = find_alsa_stream_by_ep_id(chip, ep_id);
+	if (!alsa_stream)

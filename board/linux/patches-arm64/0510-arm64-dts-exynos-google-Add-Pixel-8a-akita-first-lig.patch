Subject: [PATCH] arm64: dts: exynos: google: Add Pixel 8a (akita) first-light
 board

Assisted-by: Claude Opus 5.5
Signed-off-by: DarekM <149845949+aninmucek@users.noreply.github.com>
---
 arch/arm64/boot/dts/exynos/google/Makefile    |  2 +
 .../boot/dts/exynos/google/zuma-akita.dts     | 61 +++++++++++++++++++
 2 files changed, 63 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/google/zuma-akita.dts

diff --git a/arch/arm64/boot/dts/exynos/google/Makefile b/arch/arm64/boot/dts/exynos/google/Makefile
index 8e651de7d..3f8e377c7 100644
--- a/arch/arm64/boot/dts/exynos/google/Makefile
+++ b/arch/arm64/boot/dts/exynos/google/Makefile
@@ -8,6 +8,7 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	gs201-felix.dtb \
 	gs201-lynx.dtb \
 	gs201-panther.dtb \
+	zuma-akita.dtb \
 	zuma-husky.dtb \
 	zumapro-tegu.dtb
 
@@ -19,5 +20,6 @@ DTC_FLAGS_gs201-cheetah += -@
 DTC_FLAGS_gs201-felix += -@
 DTC_FLAGS_gs201-lynx += -@
 DTC_FLAGS_gs201-panther += -@
+DTC_FLAGS_zuma-akita += -@
 DTC_FLAGS_zuma-husky += -@
 DTC_FLAGS_zumapro-tegu += -@
diff --git a/arch/arm64/boot/dts/exynos/google/zuma-akita.dts b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
new file mode 100644
index 000000000..8aadf4edc
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Google Pixel 8a (akita) - first-light board file.
+ */
+
+/dts-v1/;
+
+#include "zuma.dtsi"
+
+/ {
+	model = "Google Pixel 8a";
+	compatible = "google,zuma-akita", "google,zuma";
+
+	/*
+	 * zuma's ABL picks the base DTB by matching these children against
+	 * the SoC's product id, revision and package; there is no /soc_id.
+	 * A retail akita has a B0/B1 IPOP part (stock base DTB 3, which
+	 * carries exactly these two), where husky's is FOPLP.
+	 */
+	soc_compatible {
+		B0_IPOP {
+			product_id = <0x9865>;
+			major = <1>;
+			minor = <0>;
+			pkg_mode = <1>;
+		};
+
+		B1_IPOP {
+			product_id = <0x9865>;
+			major = <1>;
+			minor = <1>;
+			pkg_mode = <1>;
+		};
+	};
+
+	chosen {
+		/*
+		 * ABL requires bootargs to exist; it appends its own after these.
+		 * reboot=warm: a cold PSCI reset clears the reboot reason in
+		 * SYSIP_DAT0 before ABL reads it, so "reboot bootloader" would
+		 * only boot the slot again.
+		 * The watchdog driver stops the bootloader's watchdogs, so a
+		 * hang that never panics lasts until someone resets the phone
+		 * with its buttons: panic on soft and hard lockups and on RCU
+		 * stalls, so that panic=10 resets the phone by itself.
+		 */
+		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init";
+	};
+};
+
+&usb_dwc3 {
+	status = "okay";
+};
+
+&usb_hsphy {
+	status = "okay";
+};
+
+&usbdrd_phy {
+	status = "okay";
+};

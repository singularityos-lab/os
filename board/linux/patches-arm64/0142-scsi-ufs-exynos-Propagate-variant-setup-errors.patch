From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Thu, 22 Oct 2026 16:15:17 -0700
Subject: [PATCH] scsi: ufs: exynos: Propagate variant setup errors

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 drivers/ufs/host/ufs-exynos.c | 21 +++++++++++++++------
 1 file changed, 15 insertions(+), 6 deletions(-)

diff --git a/drivers/ufs/host/ufs-exynos.c b/drivers/ufs/host/ufs-exynos.c
index 15a2c9091..0239b525b 100644
--- a/drivers/ufs/host/ufs-exynos.c
+++ b/drivers/ufs/host/ufs-exynos.c
@@ -938,8 +938,11 @@ static int exynos_ufs_pre_pwr_mode(struct ufs_hba *hba,
 		goto out;
 	}
 
-	if (ufs->drv_data->pre_pwr_change)
-		ufs->drv_data->pre_pwr_change(ufs, dev_req_params);
+	if (ufs->drv_data->pre_pwr_change) {
+		ret = ufs->drv_data->pre_pwr_change(ufs, dev_req_params);
+		if (ret)
+			return ret;
+	}
 
 	if (ufshcd_is_hs_mode(dev_req_params)) {
 		exynos_ufs_config_sync_pattern_mask(ufs, dev_req_params);
@@ -1147,6 +1150,7 @@ static int exynos_ufs_setup_clocks(struct ufs_hba *hba, bool on,
 static int exynos_ufs_pre_link(struct ufs_hba *hba)
 {
 	struct exynos_ufs *ufs = ufshcd_get_variant(hba);
+	int ret;
 
 	/* hci */
 	exynos_ufs_config_intr(ufs, DFES_DEF_L2_ERRS, UNIPRO_L2);
@@ -1159,11 +1163,16 @@ static int exynos_ufs_pre_link(struct ufs_hba *hba)
 	/* unipro */
 	exynos_ufs_config_unipro(ufs);
 
-	if (ufs->drv_data->pre_link)
-		ufs->drv_data->pre_link(ufs);
+	if (ufs->drv_data->pre_link) {
+		ret = ufs->drv_data->pre_link(ufs);
+		if (ret)
+			return ret;
+	}
 
 	/* m-phy */
-	exynos_ufs_phy_init(ufs);
+	ret = exynos_ufs_phy_init(ufs);
+	if (ret)
+		return ret;
 	if (!(ufs->opts & EXYNOS_UFS_OPT_SKIP_CONFIG_PHY_ATTR)) {
 		exynos_ufs_config_phy_time_attr(ufs);
 		exynos_ufs_config_phy_cap_attr(ufs);
@@ -1252,7 +1261,7 @@ static int exynos_ufs_post_link(struct ufs_hba *hba)
 	phy_calibrate(generic_phy);
 
 	if (ufs->drv_data->post_link)
-		ufs->drv_data->post_link(ufs);
+		return ufs->drv_data->post_link(ufs);
 
 	return 0;
 }

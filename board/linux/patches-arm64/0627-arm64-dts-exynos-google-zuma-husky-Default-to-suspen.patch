From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Colin Lundholm <265166644+gitColinX@users.noreply.github.com>
Date: Wed, 11 Nov 2026 12:07:28 -0700
Subject: [PATCH] arm64: dts: exynos: google: zuma-husky: Default to
 suspend-to-idle

Assisted-by: Claude:claude-fable-5-2
Signed-off-by: Colin Lundholm <265166644+gitColinX@users.noreply.github.com>
---
 arch/arm64/boot/dts/exynos/google/zuma-husky.dts | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/google/zuma-husky.dts b/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
index 130fe8683..1cc364743 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
+++ b/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
@@ -93,8 +93,11 @@ chosen {
 		 * hang that never panics lasts until someone holds Power and
 		 * Volume Up: panic on soft and hard lockups and on RCU stalls,
 		 * so that panic=10 resets the phone by itself.
+		 * mem_sleep_default=s2idle: the firmware offers PSCI system
+		 * suspend, so "mem" would otherwise mean "deep", which needs a
+		 * PMU sleep sequence the kernel doesn't have yet.
 		 */
-		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init";
+		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init mem_sleep_default=s2idle";
 		#address-cells = <2>;
 		#size-cells = <1>;
 		ranges;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Sun, 11 Oct 2026 20:18:40 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201: add USI13 with its HSI2C

Add PERIC1 USI13 and its HSI2C controller at 0x10d60000 (GIC SPI 695),
with the gpp25-0/gpp25-1 bus pins. On the Pixel 7 and 7 Pro this bus
carries the MAX77759 charger, Type-C port controller and fuel gauge.

The register layout, sysreg offset and pin function match gs101's USI13;
the interrupt number and clocks are gs201's, from Google's GPL device
tree.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../boot/dts/exynos/google/gs201-pinctrl.dtsi |  7 +++++
 arch/arm64/boot/dts/exynos/google/gs201.dtsi  | 28 +++++++++++++++++++
 2 files changed, 35 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi b/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
index ffee2af1e..a5217ec5f 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201-pinctrl.dtsi
@@ -281,6 +281,13 @@ spi0_cs_gpio: spi0-cs-gpio-pins {
 		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
 	};
 
+	hsi2c13_bus: hsi2c13-bus-pins {
+		samsung,pins = "gpp25-0", "gpp25-1";
+		samsung,pin-function = <GS101_PIN_FUNC_2>;
+		samsung,pin-pud = <GS101_PIN_PULL_NONE>;
+		samsung,pin-drv = <GS101_PIN_DRV_2_5_MA>;
+	};
+
 	ts_reset: ts-reset-pins {
 		samsung,pins = "gpp23-2";
 		samsung,pin-function = <GS101_PIN_FUNC_OUTPUT>;
diff --git a/arch/arm64/boot/dts/exynos/google/gs201.dtsi b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
index f6be6f864..001dc2879 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/gs201.dtsi
@@ -272,6 +272,34 @@ spi_0: spi@10d10000 {
 			};
 		};
 
+		usi13: usi@10d600c0 {
+			compatible = "google,gs201-usi", "samsung,exynos850-usi";
+			reg = <0x10d600c0 0x20>;
+			ranges;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI13_USI_PCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_USI13_USI_IPCLK>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_peric1 0x1014>;
+			status = "disabled";
+
+			hsi2c_13: i2c@10d60000 {
+				compatible = "google,gs201-hsi2c",
+					     "samsung,exynosautov9-hsi2c";
+				reg = <0x10d60000 0xc0>;
+				#address-cells = <1>;
+				#size-cells = <0>;
+				clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI13_USI_IPCLK>,
+					 <&cmu_peric1 CLK_GOUT_PERIC1_USI13_USI_PCLK>;
+				clock-names = "hsi2c", "hsi2c_pclk";
+				interrupts = <GIC_SPI 695 IRQ_TYPE_LEVEL_HIGH>;
+				pinctrl-0 = <&hsi2c13_bus>;
+				pinctrl-names = "default";
+				status = "disabled";
+			};
+		};
+
 		cmu_hsi0: clock-controller@11000000 {
 			compatible = "google,gs201-cmu-hsi0";
 			reg = <0x11000000 0x10000>;

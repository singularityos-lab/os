From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lef <me@lefteros.com>
Date: Sat, 7 Nov 2026 07:04:51 +0200
Subject: [PATCH] dt-bindings: soc: samsung: exynos-pmu: NFC pad clock on
 Tensor G3

Signed-off-by: Lef <me@lefteros.com>
---
 .../devicetree/bindings/soc/samsung/exynos-pmu.yaml         | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
index 9cec4a137..63dd32273 100644
--- a/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
+++ b/Documentation/devicetree/bindings/soc/samsung/exynos-pmu.yaml
@@ -64,9 +64,9 @@ properties:
   '#clock-cells':
     const: 1
     description:
-      On the Exynos SoCs, one clock per CLKOUT mux input. On the Tensor G4
-      PMU (google,zumapro-pmu), clock 0 is the NFC controller's reference
-      clock pad.
+      On the Exynos SoCs, one clock per CLKOUT mux input. On the Tensor G3
+      and G4 PMUs (google,zuma-pmu, google,zumapro-pmu), clock 0 is the NFC
+      controller's reference clock pad.
 
   clock-names:
     description:

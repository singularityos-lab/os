+void mif_add_timer(struct timer_list *timer, unsigned long expire,
+			void (*function)(struct timer_list *))
+{
+	if (timer_pending(timer))
+		return;
+
+	timer_setup(timer, function, 0);
+	timer->expires = get_jiffies_64() + expire;
+
+	add_timer(timer);
+}

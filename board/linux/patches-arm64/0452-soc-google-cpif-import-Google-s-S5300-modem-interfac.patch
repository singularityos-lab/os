+irqreturn_t shmem_irq_handler(int irq, void *data)
+{
+	struct mem_link_device *mld = data;
+
+	mld->rx_int_count++;
+	if (napi_schedule_prep(&mld->mld_napi)) {
+		struct link_device *ld = &mld->link_dev;
+
+		ld->disable_rx_int(ld);
+		__napi_schedule(&mld->mld_napi);
+	}
+
+	return IRQ_HANDLED;
+}

+static inline void ts642utc(struct timespec64 *ts, struct utc_time *utc)
+{
+	struct tm tm;
+
+	time64_to_tm((ts->tv_sec - (sys_tz.tz_minuteswest * 60)), 0, &tm);
+	utc->year = 1900 + (u32)tm.tm_year;
+	utc->mon = 1 + tm.tm_mon;
+	utc->day = tm.tm_mday;
+	utc->hour = tm.tm_hour;
+	utc->min = tm.tm_min;
+	utc->sec = tm.tm_sec;
+	utc->us = (u32)ns2us(ts->tv_nsec);
+}

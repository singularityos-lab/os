--- /dev/null
+++ b/drivers/soc/google/aoc/aoc_sensor_power.h
@@ -0,0 +1,23 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef AOC_SENSOR_POWER_H
+#define AOC_SENSOR_POWER_H
+
+#include <linux/mutex.h>
+
+struct device;
+struct regulator;
+
+#define AOC_SENSOR_SUPPLIES 2
+
+struct aoc_sensor_power {
+	struct device *dev;
+	struct regulator *supplies[AOC_SENSOR_SUPPLIES];
+	/* Serializes the consumer votes and their power sequence. */
+	struct mutex lock;
+	unsigned long enabled;
+};
+
+int aoc_sensor_power_init(struct device *dev, struct aoc_sensor_power *power);
+int aoc_sensor_power_set(struct aoc_sensor_power *power, bool enable);
+
+#endif
diff --git a/drivers/soc/google/aoc/aoc_v1.c b/drivers/soc/google/aoc/aoc_v1.c
index f45f91f4d..c3470208e 100644
--- a/drivers/soc/google/aoc/aoc_v1.c
+++ b/drivers/soc/google/aoc/aoc_v1.c
@@ -253,6 +253,18 @@ EXPORT_SYMBOL_GPL(trigger_aoc_ramdump);
 
 static irqreturn_t watchdog_int_handler(int irq, void *dev)
 {
+	struct aoc_prvdata *prvdata = dev_get_drvdata(dev);
+
+	/*
+	 * Firmware-managed AoCs (zumapro) are not restarted: keep the fault
+	 * for the watchdog work and don't take the interrupt again.
+	 */
+	if (prvdata->soc->firmware_managed_mmu) {
+		disable_irq_nosync(irq);
+		dev_err(dev, "AoC watchdog interrupt\n");
+		schedule_work(&prvdata->watchdog_work);
+		return IRQ_HANDLED;
+	}
 	trigger_aoc_ssr(false, NULL);
 	return IRQ_HANDLED;
 }

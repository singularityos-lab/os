From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Wed, 28 Oct 2026 20:12:10 -0647
Subject: [PATCH] arm64: dts: exynos: google: zumapro: Add USI10 and its I2C
 controller

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 .../arm64/boot/dts/exynos/google/zumapro.dtsi | 27 +++++++++++++++++++
 1 file changed, 27 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
index cb99ace06..5ad4107f8 100644
--- a/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
+++ b/arch/arm64/boot/dts/exynos/google/zumapro.dtsi
@@ -975,6 +975,33 @@ hsi2c9: i2c@10c90000 {
 			};
 		};
 
+		usi10: usi@10ca00c0 {
+			compatible = "google,zumapro-usi", "samsung,exynos850-usi";
+			reg = <0x0 0x10ca00c0 0x20>;
+			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI10_PCLK>,
+				 <&cmu_peric1 CLK_GOUT_PERIC1_USI10_IPCLK>;
+			clock-names = "pclk", "ipclk";
+			samsung,sysreg = <&sysreg_peric1 0x8>;
+			samsung,mode = <USI_MODE_I2C>;
+			#address-cells = <1>;
+			#size-cells = <1>;
+			ranges = <0x10ca0000 0x0 0x10ca0000 0x1000>;
+			status = "disabled";
+
+			hsi2c10: i2c@10ca0000 {
+				compatible = "google,zumapro-hsi2c",
+					     "samsung,exynosautov9-hsi2c";
+				reg = <0x10ca0000 0xc0>;
+				interrupts = <GIC_SPI 658 IRQ_TYPE_LEVEL_HIGH>;
+				clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI10_IPCLK>,
+					 <&cmu_peric1 CLK_GOUT_PERIC1_USI10_PCLK>;
+				clock-names = "hsi2c", "hsi2c_pclk";
+				#address-cells = <1>;
+				#size-cells = <0>;
+				status = "disabled";
+			};
+		};
+
 		cmu_hsi0: clock-controller@11000000 {
 			compatible = "google,zumapro-cmu-hsi0";
 			reg = <0x0 0x11000000 0x8000>;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Sun, 11 Oct 2026 20:14:48 -0400
Subject: [PATCH] dt-bindings: net: wireless: brcm,bcm4329-fmac: add BCM4389
 PCI ID

Add the PCI ID of the BCM4389, used in Google's Pixel 7 and Pixel 7 Pro.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml      | 1 +
 1 file changed, 1 insertion(+)

diff --git a/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml b/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml
index 81fd3e374..38e9a0444 100644
--- a/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml
+++ b/Documentation/devicetree/bindings/net/wireless/brcm,bcm4329-fmac.yaml
@@ -55,6 +55,7 @@ properties:
           - pci14e4,4425  # BCM4378
           - pci14e4,4433  # BCM4387
           - pci14e4,4434  # BCM4388
+          - pci14e4,4441  # BCM4389
           - pci14e4,449d  # BCM43752
 
   reg:

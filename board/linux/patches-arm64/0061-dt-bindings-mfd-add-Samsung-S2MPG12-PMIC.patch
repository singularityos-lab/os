From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 12:04:01 -0400
Subject: [PATCH] dt-bindings: mfd: add Samsung S2MPG12 PMIC

S2MPG12 is the main PMIC of Google's gs201 phones, reached through the
ACPM firmware like S2MPG10 on gs101. It has no interrupt line of its
own: its events arrive in-band and the SoC's VGPIO2AP registers raise
them as one level interrupt, so the node refers to those registers.

Allow it as the main PMIC under the gs201 ACPM node.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../firmware/google,gs101-acpm-ipc.yaml       | 15 +++++-
 .../bindings/mfd/samsung,s2mpg12-pmic.yaml    | 53 +++++++++++++++++++
 2 files changed, 66 insertions(+), 2 deletions(-)
 create mode 100644 Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml

diff --git a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
index 8b45d0752..bd543b8bf 100644
--- a/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
+++ b/Documentation/devicetree/bindings/firmware/google,gs101-acpm-ipc.yaml
@@ -55,7 +55,9 @@ properties:
 
     properties:
       compatible:
-        const: samsung,s2mpg10-pmic
+        enum:
+          - samsung,s2mpg10-pmic
+          - samsung,s2mpg12-pmic
 
   pmic-2:
     description: Child node describing the sub PMIC.
@@ -87,8 +89,17 @@ allOf:
     then:
       properties:
         pmic: false
-        pmic-1: false
+        pmic-1:
+          properties:
+            compatible:
+              const: samsung,s2mpg12-pmic
         pmic-2: false
+    else:
+      properties:
+        pmic-1:
+          properties:
+            compatible:
+              const: samsung,s2mpg10-pmic
 
 additionalProperties: false
 
diff --git a/Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml b/Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml
new file mode 100644
index 000000000..26255b354
--- /dev/null
+++ b/Documentation/devicetree/bindings/mfd/samsung,s2mpg12-pmic.yaml
@@ -0,0 +1,53 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/mfd/samsung,s2mpg12-pmic.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Samsung S2MPG12 Power Management IC
+
+maintainers:
+  - Derek Ross <derekross@gmail.com>
+
+description: |
+  The Samsung S2MPG12 is the main Power Management IC paired with Google's
+  gs201 SoC, with buck converters, LDOs, power meters and a real-time clock.
+  It is reached through the ACPM firmware.
+
+  Unlike S2MPG10, it has no interrupt line of its own: it reports events
+  in-band, and the SoC's VGPIO2AP system registers turn them into one level
+  interrupt with a pending latch that the host acknowledges.
+
+properties:
+  compatible:
+    const: samsung,s2mpg12-pmic
+
+  interrupts:
+    maxItems: 1
+
+  google,vgpio2ap-sysreg:
+    $ref: /schemas/types.yaml#/definitions/phandle
+    description:
+      Phandle to the VGPIO2AP system registers, which latch the PMIC's
+      in-band interrupt.
+
+  wakeup-source: true
+
+required:
+  - compatible
+  - interrupts
+  - google,vgpio2ap-sysreg
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    pmic {
+        compatible = "samsung,s2mpg12-pmic";
+        interrupts = <GIC_SPI 72 IRQ_TYPE_LEVEL_HIGH>;
+        google,vgpio2ap-sysreg = <&sysreg_vgpio2ap>;
+        wakeup-source;
+    };

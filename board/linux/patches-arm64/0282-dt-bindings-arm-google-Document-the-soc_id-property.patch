From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Wed, 28 Oct 2026 10:52:20 -0400
Subject: [PATCH] dt-bindings: arm: google: Document the soc_id property

Assisted-by: Claude Opus 5.5
Signed-off-by: Derek Ross <derekross@gmail.com>
---
 Documentation/devicetree/bindings/arm/google.yaml | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/Documentation/devicetree/bindings/arm/google.yaml b/Documentation/devicetree/bindings/arm/google.yaml
index a05273275..988cf3de0 100644
--- a/Documentation/devicetree/bindings/arm/google.yaml
+++ b/Documentation/devicetree/bindings/arm/google.yaml
@@ -74,6 +74,18 @@ properties:
         $ref: /schemas/types.yaml#/definitions/uint32
         description: Size of the ECT in bytes.
 
+  soc_id:
+    $ref: /schemas/types.yaml#/definitions/uint32-array
+    description:
+      Bootloaders that match on this property rather than /soc_compatible
+      (gs101's and gs201's) pick the base DTB whose first cell equals the
+      SoC's product id combined with its major revision.
+    items:
+      - description:
+          The SoC's product id ORed with its major revision, for example
+          0x09855001 for gs201 B0.
+      - description: Reserved, zero in the vendor's device trees.
+
   soc_compatible:
     type: object
     description:

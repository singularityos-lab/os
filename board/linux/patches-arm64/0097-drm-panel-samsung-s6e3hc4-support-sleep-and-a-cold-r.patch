From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Mon, 12 Oct 2026 13:37:06 -0400
Subject: [PATCH] drm/panel: samsung-s6e3hc4: support sleep and a cold restart
 from KMS

Assisted-by: Claude:claude-opus-5-5
---
 drivers/gpu/drm/panel/panel-samsung-s6e3hc4.c | 32 ++++++++++++++++++-
 1 file changed, 31 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3hc4.c b/drivers/gpu/drm/panel/panel-samsung-s6e3hc4.c
index 59d82c0bd..71be1595e 100644
--- a/drivers/gpu/drm/panel/panel-samsung-s6e3hc4.c
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3hc4.c
@@ -42,6 +42,8 @@ struct s6e3hc4 {
 	struct drm_dsc_config dsc;
 	/* keeps multi-command sequences (0xb0 offsets) from interleaving */
 	struct mutex lock;
+	/* out of reset and sleep: commands reach the panel */
+	bool prepared;
 	bool display_off;
 	bool pixel_off;
 };
@@ -258,6 +260,7 @@ static int s6e3hc4_prepare(struct drm_panel *panel)
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 	int ret;
 
+	guard(mutex)(&ctx->lock);
 	ret = regulator_bulk_enable(ARRAY_SIZE(s6e3hc4_supplies), ctx->supplies);
 	if (ret < 0)
 		return ret;
@@ -279,9 +282,15 @@ static int s6e3hc4_prepare(struct drm_panel *panel)
 	if (dsi_ctx.accum_err) {
 		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 		regulator_bulk_disable(ARRAY_SIZE(s6e3hc4_supplies), ctx->supplies);
+		return dsi_ctx.accum_err;
 	}
 
-	return dsi_ctx.accum_err;
+	/* the reset cleared these; display on comes with enable */
+	ctx->prepared = true;
+	ctx->display_off = true;
+	ctx->pixel_off = false;
+
+	return 0;
 }
 
 static int s6e3hc4_enable(struct drm_panel *panel)
@@ -289,6 +298,7 @@ static int s6e3hc4_enable(struct drm_panel *panel)
 	struct s6e3hc4 *ctx = to_s6e3hc4(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
+	guard(mutex)(&ctx->lock);
 	s6e3hc4_display_on(&dsi_ctx);
 	if (!dsi_ctx.accum_err)
 		ctx->display_off = false;
@@ -301,6 +311,7 @@ static int s6e3hc4_disable(struct drm_panel *panel)
 	struct s6e3hc4 *ctx = to_s6e3hc4(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
+	guard(mutex)(&ctx->lock);
 	s6e3hc4_display_off(&dsi_ctx);
 	if (!dsi_ctx.accum_err)
 		ctx->display_off = true;
@@ -313,11 +324,14 @@ static int s6e3hc4_unprepare(struct drm_panel *panel)
 	struct s6e3hc4 *ctx = to_s6e3hc4(panel);
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 
+	guard(mutex)(&ctx->lock);
 	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 10);
 	mipi_dsi_dcs_nop_multi(&dsi_ctx);
 	mipi_dsi_msleep(&dsi_ctx, 100);
 
+	/* the panel loses its registers: only prepare() brings it back */
+	ctx->prepared = false;
 	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
 	regulator_bulk_disable(ARRAY_SIZE(s6e3hc4_supplies), ctx->supplies);
 
@@ -338,6 +352,8 @@ static int s6e3hc4_set_refresh_rate(struct drm_panel *panel, unsigned int hz)
 
 	/* always sent in full: the caller may not know the panel's state */
 	guard(mutex)(&ctx->lock);
+	if (!ctx->prepared)
+		return -ENODEV;
 	s6e3hc4_write_rate(&dsi_ctx, hz);
 
 	return dsi_ctx.accum_err;
@@ -406,6 +422,13 @@ static int s6e3hc4_bl_update_locked(struct backlight_device *bl)
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
 	u16 brightness = backlight_get_brightness(bl);
 
+	/*
+	 * In reset or asleep: keep the new state, enable() applies it
+	 * through backlight_enable().
+	 */
+	if (!ctx->prepared)
+		return 0;
+
 	if (backlight_is_blank(bl)) {
 		if (!ctx->display_off) {
 			s6e3hc4_display_off(&dsi_ctx);
@@ -504,6 +527,13 @@ static int s6e3hc4_probe(struct mipi_dsi_device *dsi)
 		if (ret < 0)
 			return dev_err_probe(dev, ret, "failed to enable regulators\n");
 		ret = gpiod_direction_output(ctx->reset_gpio, 0);
+		/*
+		 * The bootloader left it prepared and enabled: let a display
+		 * driver's drm_panel_disable()/unprepare() reach it.
+		 */
+		ctx->prepared = true;
+		ctx->panel.prepared = true;
+		ctx->panel.enabled = true;
 	} else {
 		ret = gpiod_direction_output(ctx->reset_gpio, 1);
 	}

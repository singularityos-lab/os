From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Alejandro Garcia <skipper.pelygro@gmail.com>
Date: Wed, 28 Oct 2026 14:02:30 -0700
Subject: [PATCH] arm64: dts: exynos: google: gs201-panther: enable the GPU

Assisted-by: Claude Opus 5.5
Signed-off-by: Alejandro Garcia <skipper.pelygro@gmail.com>
---
 arch/arm64/boot/dts/exynos/google/gs201-panther.dts | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-panther.dts b/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
index d3e061a5b..36dd97b49 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
@@ -4,8 +4,8 @@
  *
  * USB (NCM + ACM), the cluster watchdogs from gs201.dtsi, a
  * simple-framebuffer on the buffer ABL leaves DPP0 scanning out, UFS, the
- * three keys, and the touch rails on the main PMIC. The panel driver,
- * touch and the GPU stay disabled.
+ * three keys, the touch rails on the main PMIC, and the GPU. The panel
+ * driver and touch stay disabled.
  */
 
 /dts-v1/;
@@ -149,6 +149,11 @@ ldo26m: ldo26m {
 	};
 };
 
+&gpu {
+	/* No mali-supply: the G3D rails follow the PMU power domain and ACPM. */
+	status = "okay";
+};
+
 &usbdrd31_phy {
 	status = "okay";
 };

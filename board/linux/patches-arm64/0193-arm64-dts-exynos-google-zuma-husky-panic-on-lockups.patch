From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Brett-Michael Green <brett@bmgvisualtech.com>
Date: Thu, 22 Oct 2026 16:07:02 -0400
Subject: [PATCH] arm64: dts: exynos: google: zuma-husky: panic on lockups

Assisted-by: LLM
Signed-off-by: Brett-Michael Green <brett@bmgvisualtech.com>
---
 arch/arm64/boot/dts/exynos/google/zuma-husky.dts | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/google/zuma-husky.dts b/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
index b7bf7e4bf..449094128 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
+++ b/arch/arm64/boot/dts/exynos/google/zuma-husky.dts
@@ -41,8 +41,12 @@ chosen {
 		 * reboot=warm: a cold PSCI reset clears the reboot reason in
 		 * SYSIP_DAT0 before ABL reads it, so "reboot bootloader" would
 		 * only boot the slot again.
+		 * The watchdog driver stops the bootloader's watchdogs, so a
+		 * hang that never panics lasts until someone holds Power and
+		 * Volume Up: panic on soft and hard lockups and on RCU stalls,
+		 * so that panic=10 resets the phone by itself.
 		 */
-		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init";
+		bootargs = "console=tty0 fbcon=font:TER16x32 reboot=warm panic=10 softlockup_panic=1 nmi_watchdog=panic sysctl.kernel.panic_on_rcu_stall=1 clk_ignore_unused pd_ignore_unused rdinit=/init";
 		#address-cells = <2>;
 		#size-cells = <1>;
 		ranges;

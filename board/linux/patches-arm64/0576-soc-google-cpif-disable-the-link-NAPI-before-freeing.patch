From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: W4HO <87742609+W4HO-ham@users.noreply.github.com>
Date: Mon, 2 Nov 2026 16:16:02 -0647
Subject: [PATCH] soc: google: cpif: disable the link NAPI before freeing its
 netdev on error

Signed-off-by: W4HO <87742609+W4HO-ham@users.noreply.github.com>
---
 drivers/soc/google/cpif/link_device.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/soc/google/cpif/link_device.c b/drivers/soc/google/cpif/link_device.c
index 86dfab96c..01d7fd80f 100644
--- a/drivers/soc/google/cpif/link_device.c
+++ b/drivers/soc/google/cpif/link_device.c
@@ -4415,8 +4415,10 @@ struct link_device *create_link_device(struct platform_device *pdev, u32 link_ty
 	return ld;
 
 error:
-	if (mld->dummy_net)
+	if (mld->dummy_net) {
+		napi_disable(&mld->mld_napi);
 		free_netdev(mld->dummy_net);
+	}
 	kfree(mld);
 	mif_err("xxx\n");
 	return NULL;

From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?=C3=81ngel=20Ren=C3=A9?=
Date: Wed, 4 Nov 2026 18:55:13 +0100
Subject: [PATCH] arm64: dts: exynos: google: gs201-panther: add the rear flash
 LED

Signed-off-by: Ángel René <17342133+angelrenefm@users.noreply.github.com>
---
 .../boot/dts/exynos/google/gs201-panther.dts  | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-panther.dts b/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
index ead243b11..b4a13e17a 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-panther.dts
@@ -13,6 +13,7 @@
 /dts-v1/;
 
 #include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
 #include <dt-bindings/soc/samsung,exynos-usi.h>
 #include "gs201.dtsi"
 
@@ -436,3 +437,33 @@ touchscreen@0 {
 		touchscreen-size-y = <2400>;
 	};
 };
+
+/*
+ * Rear flash LED: TI LM3644 at 0x63 on PERIC1 USI15 (Google's I2C bus 15,
+ * shared with the camera EEPROM at 0x50 and the wireless charger at 0x3c),
+ * HWEN on gpp8-2, as on the Pixel 7 Pro: the stock panther dtbo's hsi2c_15
+ * fragments, flash-en pin and LWIS flash-lm3644 node match cheetah's. The
+ * chip on this phone reads ID 0x02 (LM3644; cheetah's reads 0x04,
+ * LM3644TT), which the driver also handles. Torch only, with cheetah's
+ * bring-up cap. Disabled until the torch overlay.
+ */
+&usi15 {
+	samsung,mode = <USI_MODE_I2C>;
+};
+
+&hsi2c_15 {
+	clock-frequency = <400000>;
+
+	led-controller@63 {
+		compatible = "ti,lm3644";
+		reg = <0x63>;
+		enable-gpios = <&gpp8 2 GPIO_ACTIVE_HIGH>;
+
+		led {
+			function = LED_FUNCTION_TORCH;
+			color = <LED_COLOR_ID_WHITE>;
+			led-sources = <1 2>;
+			led-max-microamp = <50000>;
+		};
+	};
+};

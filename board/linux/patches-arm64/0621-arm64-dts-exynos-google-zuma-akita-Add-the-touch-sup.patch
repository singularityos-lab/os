From: DarekM <149845949+aninmucek@users.noreply.github.com>
Date: Tue, 10 Nov 2026 16:08:23 +0000
Subject: [PATCH] arm64: dts: exynos: google: zuma-akita: Add the touch
 supplies

Assisted-by: Claude Opus 5.5
Signed-off-by: DarekM <149845949+aninmucek@users.noreply.github.com>
---
 .../boot/dts/exynos/google/zuma-akita.dts     | 26 +++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/google/zuma-akita.dts b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
index bd1822f00..c7c1b3358 100644
--- a/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
+++ b/arch/arm64/boot/dts/exynos/google/zuma-akita.dts
@@ -120,6 +120,32 @@ cont_splash_mem: splash@fac00000 {
 	};
 };
 
+/*
+ * The main PMIC, behind the ACPM firmware. Its regulators are described
+ * with their consumers, which run them through the firmware. The touch
+ * controller's avdd is 3.0 V here (the stock phone's LDO4M), not the
+ * Pixel 8 Pro's 3.3 V.
+ */
+&acpm_ipc {
+	pmic-1 {
+		compatible = "samsung,s2mpg14-pmic";
+
+		regulators {
+			touch_avdd: ldo4m {
+				regulator-name = "touch-avdd";
+				regulator-min-microvolt = <3000000>;
+				regulator-max-microvolt = <3000000>;
+			};
+
+			touch_vdd: ldo25m {
+				regulator-name = "touch-vdd";
+				regulator-min-microvolt = <1800000>;
+				regulator-max-microvolt = <1800000>;
+			};
+		};
+	};
+};
+
 /*
  * Behind the init's storage guard (only slot B's boot images and userdata
  * writable), which sets every partition read-only before anything mounts

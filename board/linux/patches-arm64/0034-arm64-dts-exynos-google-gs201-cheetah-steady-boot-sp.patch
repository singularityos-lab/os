From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Sun, 11 Oct 2026 20:36:23 -0400
Subject: [PATCH] arm64: dts: exynos: google: gs201-cheetah: steady boot splash

Pin Plymouth to scale 1 (the 800 px Omarchy logo would not fit at the
scale 2 it picks for a 515 dpi panel), and hide the console cursor so it
does not blink over the splash the initramfs draws.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts b/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
index b970dbafc..f635eb19b 100644
--- a/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
+++ b/arch/arm64/boot/dts/exynos/google/gs201-cheetah.dts
@@ -25,7 +25,7 @@ aliases {
 
 	chosen {
 		/* ABL requires bootargs to exist; it appends its own after these. */
-		bootargs = "console=tty0 fbcon=font:TER16x32 quiet splash panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omandroid.ufs-probe";
+		bootargs = "console=tty0 fbcon=font:TER16x32 quiet splash plymouth.force-scale=1 vt.global_cursor_default=0 panic=10 clk_ignore_unused pd_ignore_unused rdinit=/init omandroid.ufs-probe";
 		#address-cells = <2>;
 		#size-cells = <1>;
 		ranges;

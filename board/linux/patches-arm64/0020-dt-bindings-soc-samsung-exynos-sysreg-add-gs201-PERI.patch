From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Derek Ross <derekross@gmail.com>
Date: Sun, 11 Oct 2026 19:04:23 -0400
Subject: [PATCH] dt-bindings: soc: samsung: exynos-sysreg: add gs201 PERIC1
 sysreg

Document the PERIC1 system register block of the Google gs201 (Tensor G2)
SoC. As on gs101, it holds the USI mode registers of the PERIC1 serial
blocks and is clocked by a CMU_PERIC1 gate, so the clock is required.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../devicetree/bindings/soc/samsung/samsung,exynos-sysreg.yaml  | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Documentation/devicetree/bindings/soc/samsung/samsung,exynos-sysreg.yaml b/Documentation/devicetree/bindings/soc/samsung/samsung,exynos-sysreg.yaml
index 824aa58e4..0fb2197f8 100644
--- a/Documentation/devicetree/bindings/soc/samsung/samsung,exynos-sysreg.yaml
+++ b/Documentation/devicetree/bindings/soc/samsung/samsung,exynos-sysreg.yaml
@@ -22,6 +22,7 @@ properties:
               - google,gs101-peric0-sysreg
               - google,gs101-peric1-sysreg
               - google,gs201-hsi2-sysreg
+              - google,gs201-peric1-sysreg
               - samsung,exynos2200-cmgp-sysreg
               - samsung,exynos2200-peric0-sysreg
               - samsung,exynos2200-peric1-sysreg
@@ -102,6 +103,7 @@ allOf:
               - google,gs101-peric0-sysreg
               - google,gs101-peric1-sysreg
               - google,gs201-hsi2-sysreg
+              - google,gs201-peric1-sysreg
               - samsung,exynos850-cmgp-sysreg
               - samsung,exynos850-peri-sysreg
               - samsung,exynos850-sysreg

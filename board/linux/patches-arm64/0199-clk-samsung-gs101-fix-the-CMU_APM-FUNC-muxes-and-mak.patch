From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: saiththerobo <the.tom.sharp@gmail.com>
Date: Mon, 26 Oct 2026 07:47:49 +0000
Subject: [PATCH] clk: samsung: gs101: fix the CMU_APM FUNC muxes and make them
 read-only

clk-gs101 describes MUX_CLKCMU_APM_FUNC as a 1-bit select at bit 4 and
MUX_CLKCMU_APM_FUNCSRC as a 1-bit select at bit 3. Google's GPL gs101
CMUCAL (cal-if/gs101/cmucal-sfr.c) puts SELECT at bits [1:0] of both
registers, with BUSY at 16 and automatic clock gating at 28, and gives
FUNCSRC a fourth parent, PLL_ALV/8. Reading bit 4, Linux saw FUNC on the
oscillator whatever the hardware selected, and every rate below it,
the APM UART's baud clock among them, came out 16 times too low; an
assigned-clock-parents written through the old field would set a
reserved bit and leave the real select alone.

Describe both selects as [1:0] with all four parents. CMU_APM is shared
with the ACPM firmware, which runs the PMIC interface, its mailboxes
and its own buses from these muxes, so register them read-only, as
gs201's CMU_APM subset does: Linux reports what the firmware set up and
never changes it. PLL_ALV/8 has no fixed-rate clock here; the mux,
being read-only, can't move to it, and would show it as an orphan
parent only if the firmware had selected it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Signed-off-by: saiththerobo <the.tom.sharp@gmail.com>
---
 drivers/clk/samsung/clk-gs101.c | 14 +++++++++-----
 1 file changed, 9 insertions(+), 5 deletions(-)

diff --git a/drivers/clk/samsung/clk-gs101.c b/drivers/clk/samsung/clk-gs101.c
index 9a42b44f4..914d5c549 100644
--- a/drivers/clk/samsung/clk-gs101.c
+++ b/drivers/clk/samsung/clk-gs101.c
@@ -1653,7 +1653,7 @@ static const unsigned long apm_clk_regs[] __initconst = {
 PNAME(mout_apm_func_p)		= { "oscclk", "mout_apm_funcsrc",
 				    "pad_clk_apm", "oscclk" };
 PNAME(mout_apm_funcsrc_p)	= { "pll_alv_div2_apm", "pll_alv_div4_apm",
-				    "pll_alv_div16_apm" };
+				    "pll_alv_div16_apm", "pll_alv_div8_apm" };
 
 static const struct samsung_fixed_rate_clock apm_fixed_clks[] __initconst = {
 	FRATE(CLK_APM_PLL_DIV2_APM, "pll_alv_div2_apm", NULL, 0, 393216000),
@@ -1661,11 +1661,15 @@ static const struct samsung_fixed_rate_clock apm_fixed_clks[] __initconst = {
 	FRATE(CLK_APM_PLL_DIV16_APM, "pll_alv_div16_apm", NULL, 0, 49152000),
 };
 
+/*
+ * The ACPM firmware runs its own buses from these muxes and sets them up:
+ * read them, never write them.
+ */
 static const struct samsung_mux_clock apm_mux_clks[] __initconst = {
-	MUX(CLK_MOUT_APM_FUNC, "mout_apm_func", mout_apm_func_p,
-	    CLK_CON_MUX_MUX_CLKCMU_APM_FUNC, 4, 1),
-	MUX(CLK_MOUT_APM_FUNCSRC, "mout_apm_funcsrc", mout_apm_funcsrc_p,
-	    CLK_CON_MUX_MUX_CLKCMU_APM_FUNCSRC, 3, 1),
+	MUX_F(CLK_MOUT_APM_FUNC, "mout_apm_func", mout_apm_func_p,
+	      CLK_CON_MUX_MUX_CLKCMU_APM_FUNC, 0, 2, 0, CLK_MUX_READ_ONLY),
+	MUX_F(CLK_MOUT_APM_FUNCSRC, "mout_apm_funcsrc", mout_apm_funcsrc_p,
+	      CLK_CON_MUX_MUX_CLKCMU_APM_FUNCSRC, 0, 2, 0, CLK_MUX_READ_ONLY),
 };
 
 static const struct samsung_div_clock apm_div_clks[] __initconst = {

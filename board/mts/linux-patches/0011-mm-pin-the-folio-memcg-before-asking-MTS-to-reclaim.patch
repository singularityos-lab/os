Subject: [PATCH 11/11] mm: pin the folio memcg before asking MTS to reclaim


---
 mm/vmscan.c | 19 ++++++++++++++++++-
 1 file changed, 18 insertions(+), 1 deletion(-)

diff --git a/mm/vmscan.c b/mm/vmscan.c
index a7181819b..880c0c0e2 100644
--- a/mm/vmscan.c
+++ b/mm/vmscan.c
@@ -370,10 +370,27 @@ static inline bool can_reclaim_anon_pages(struct mem_cgroup *memcg,
 	return can_demote(nid, sc, memcg);
 }
 
+static bool mts_folio_can_reclaim(struct folio *folio)
+{
+	struct mem_cgroup *memcg;
+	bool ok;
+
+	rcu_read_lock();
+	memcg = folio_memcg(folio);
+	if (memcg && !mem_cgroup_tryget(memcg)) {
+		rcu_read_unlock();
+		return false;
+	}
+	rcu_read_unlock();
+	ok = mts_can_reclaim(memcg);
+	mem_cgroup_put(memcg);
+	return ok;
+}
+
 static bool mts_try_demote_folio(struct folio *folio)
 {
 	if (folio_test_large(folio) || folio_mapcount(folio) != 1 ||
-	    !mts_can_reclaim(folio_memcg(folio)))
+	    !mts_folio_can_reclaim(folio))
 		return false;
 	/*
 	 * Migration entries freeze the only mapping before the provider

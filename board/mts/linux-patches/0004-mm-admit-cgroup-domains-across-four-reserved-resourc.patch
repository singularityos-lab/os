 #include <linux/uaccess.h>
 #include <linux/xarray.h>
+#include <trace/events/mts.h>
 #include <uapi/linux/mts.h>
 
 #define MTS_REFCOUNT_FREEZE	0x00fffffeU
@@ -46,11 +50,32 @@ struct mts_tier {
 	enum mts_tier_state state;
 	u8 slot;
 	u32 next_slot;
+	u64 reserved_capacity;
+	u64 reserved_read_bw;
+	u64 reserved_write_bw;
+	u32 reserved_queue_slots;
+};
+
+struct mts_domain_tier {
+	struct mts_tier *tier;
+	struct mts_tier_reservation_v2 request;
+};
+
+struct mts_domain {
+	struct list_head node;
+	struct cgroup *cgroup;
+	u64 stable_id;
+	u64 fault_service_p99_ns;
+	u64 reuse_horizon_us;
+	u32 status;
+	u32 tier_count;
+	struct mts_domain_tier tiers[MTS_MAX_DOMAIN_TIERS];
 };
 
 static DEFINE_XARRAY(mts_tiers);
 static DEFINE_IDA(mts_tier_ids);
 static DEFINE_MUTEX(mts_registry_lock);
+static LIST_HEAD(mts_domains);
 
 static struct mts_tier *mts_tier_lookup(u8 tier_slot)
 {
@@ -307,6 +332,31 @@ static int mts_validate_registration(const struct mts_register_tier_v2 *request)
 	return 0;
 }
 
+static bool mts_domain_uses_tier(const struct mts_domain *domain,
+				 const struct mts_tier *tier)
+{
+	u32 index;
+
+	for (index = 0; index < domain->tier_count; index++)
+		if (domain->tiers[index].tier == tier)
+			return true;
+	return false;
+}
+
+static void mts_mark_tier_domains_at_risk(struct mts_tier *tier, u32 cause)
+{
+	struct mts_domain *domain;
+
+	list_for_each_entry(domain, &mts_domains, node)
+		if (domain->status == MTS_SLO_ADMITTED &&
+		    mts_domain_uses_tier(domain, tier)) {
+			domain->status = MTS_SLO_AT_RISK;
+			trace_slo_transition(domain->stable_id, MTS_SLO_ADMITTED,
+					     MTS_SLO_AT_RISK, cause,
+					     tier->desc.uuid);
+		}
+}
+
 static int mts_tier_fd_release(struct inode *inode, struct file *file)
 {
 	struct mts_tier *tier = file->private_data;
@@ -316,6 +366,8 @@ static int mts_tier_fd_release(struct inode *inode, struct file *file)
 		mutex_lock(&tier->lock);
 		tier->state = MTS_TIER_DRAINING;
 		mutex_unlock(&tier->lock);
+		mts_mark_tier_domains_at_risk(tier,
+					      MTS_CAUSE_PROVIDER_FD_CLOSED);
 		xa_erase(&mts_tiers, tier->slot);
 		mutex_unlock(&mts_registry_lock);
 		synchronize_rcu();
@@ -333,6 +385,198 @@ static const struct file_operations mts_tier_fops = {
 	.llseek = noop_llseek,
 };
 
+static int mts_add_headroom(u64 value, u64 *result)
+{
+	if (check_mul_overflow(value, 6ULL, result))
+		return -EOVERFLOW;
+	*result = DIV_ROUND_UP_ULL(*result, 5);
+	return 0;
+}
+
+static int mts_domain_fd_release(struct inode *inode, struct file *file)
+{
+	struct mts_domain *domain = file->private_data;
+	u32 index;
+
+	mutex_lock(&mts_registry_lock);
+	list_del(&domain->node);
+	for (index = 0; index < domain->tier_count; index++) {
+		struct mts_domain_tier *binding = &domain->tiers[index];
+		struct mts_tier *tier = binding->tier;
+
+		mutex_lock(&tier->lock);
+		tier->reserved_capacity -= binding->request.capacity_bytes;
+		tier->reserved_read_bw -= binding->request.read_bandwidth_bytes_s;
+		tier->reserved_write_bw -= binding->request.write_bandwidth_bytes_s;
+		tier->reserved_queue_slots -= binding->request.queue_slots;
+		mutex_unlock(&tier->lock);
+	}
+	mutex_unlock(&mts_registry_lock);
+	for (index = 0; index < domain->tier_count; index++)
+		mts_tier_put(domain->tiers[index].tier);
+	cgroup_put(domain->cgroup);
+	kfree(domain);
+	return 0;
+}
+
+static const struct file_operations mts_domain_fops = {
+	.owner = THIS_MODULE,
+	.release = mts_domain_fd_release,
+	.llseek = noop_llseek,
+};
+
+static int mts_charge_reservation(struct mts_tier *tier,
+				  struct mts_tier_reservation_v2 *reservation)
+{
+	u64 capacity;
+	u64 read_bw;
+	u64 write_bw;
+	u64 queue;
+	int err;
+
+	err = mts_add_headroom(reservation->capacity_bytes, &capacity);
+	err = err ?: mts_add_headroom(reservation->read_bandwidth_bytes_s,
+				      &read_bw);
+	err = err ?: mts_add_headroom(reservation->write_bandwidth_bytes_s,
+				      &write_bw);
+	err = err ?: mts_add_headroom(reservation->queue_slots, &queue);
+	if (err)
+		return err;
+	if (capacity > tier->desc.capacity_bytes - tier->reserved_capacity ||
+	    !tier->desc.read_bandwidth_bytes_s ||
+	    read_bw > tier->desc.read_bandwidth_bytes_s - tier->reserved_read_bw ||
+	    !tier->desc.write_bandwidth_bytes_s ||
+	    write_bw > tier->desc.write_bandwidth_bytes_s - tier->reserved_write_bw ||
+	    !tier->desc.max_inflight_batches ||
+	    queue > tier->desc.max_inflight_batches - tier->reserved_queue_slots)
+		return -ENOSPC;
+	tier->reserved_capacity += capacity;
+	tier->reserved_read_bw += read_bw;
+	tier->reserved_write_bw += write_bw;
+	tier->reserved_queue_slots += queue;
+	reservation->capacity_bytes = capacity;
+	reservation->read_bandwidth_bytes_s = read_bw;
+	reservation->write_bandwidth_bytes_s = write_bw;
+	reservation->queue_slots = queue;
+	return 0;
+}
+
+static void mts_uncharge_bindings(struct mts_domain *domain, u32 count)
+{
+	u32 index;
+
+	for (index = 0; index < count; index++) {
+		struct mts_domain_tier *binding = &domain->tiers[index];
+		struct mts_tier *tier = binding->tier;
+
+		mutex_lock(&tier->lock);
+		tier->reserved_capacity -= binding->request.capacity_bytes;
+		tier->reserved_read_bw -= binding->request.read_bandwidth_bytes_s;
+		tier->reserved_write_bw -= binding->request.write_bandwidth_bytes_s;
+		tier->reserved_queue_slots -= binding->request.queue_slots;
+		mutex_unlock(&tier->lock);
+		mts_tier_put(tier);
+	}
+}
+
+static int mts_admit_domain(struct mts_admit_domain_v2 *request)
+{
+	struct mts_tier_reservation_v2 reservations[MTS_MAX_DOMAIN_TIERS];
+	struct mts_domain *domain;
+	struct fd descriptor;
+	u32 charged = 0;
+	u32 index;
+	int fd;
+	int err;
+
+	if (request->version != MTS_UAPI_VERSION ||
+	    request->size != sizeof(*request) || !request->fault_service_p99_ns ||
+	    !request->reuse_horizon_us || !request->reservation_count ||
+	    request->reservation_count > MTS_MAX_DOMAIN_TIERS)
+		return -EINVAL;
+	if (copy_from_user(reservations,
+			   u64_to_user_ptr(request->reservations_ptr),
+			   array_size(request->reservation_count,
+				      sizeof(reservations[0]))))
+		return -EFAULT;
+	domain = kzalloc_obj(*domain);
+	if (!domain)
+		return -ENOMEM;
+	domain->cgroup = cgroup_get_from_fd(request->cgroup_fd);
+	if (IS_ERR(domain->cgroup)) {
+		err = PTR_ERR(domain->cgroup);
+		goto free_domain;
+	}
+	domain->stable_id = cgroup_id(domain->cgroup);
+	domain->fault_service_p99_ns = request->fault_service_p99_ns;
+	domain->reuse_horizon_us = request->reuse_horizon_us;
+	domain->status = MTS_SLO_UNADMITTED;
+	domain->tier_count = request->reservation_count;
+	INIT_LIST_HEAD(&domain->node);
+
+	mutex_lock(&mts_registry_lock);
+	for (index = 0; index < request->reservation_count; index++) {
+		struct mts_tier_reservation_v2 *tier_request;
+		struct mts_tier *tier;
+
+		descriptor = fdget(reservations[index].tier_fd);
+		if (!fd_file(descriptor) ||
+		    fd_file(descriptor)->f_op != &mts_tier_fops) {
+			err = -EBADF;
+			if (fd_file(descriptor))
+				fdput(descriptor);
+			goto rollback;
+		}
+		tier = fd_file(descriptor)->private_data;
+		kref_get(&tier->kref);
+		fdput(descriptor);
+		domain->tiers[index].tier = tier;
+		domain->tiers[index].request = reservations[index];
+		tier_request = &domain->tiers[index].request;
+		mutex_lock(&tier->lock);
+		if (tier->state == MTS_TIER_ACTIVE)
+			err = mts_charge_reservation(tier, tier_request);
+		else
+			err = -ESHUTDOWN;
+		mutex_unlock(&tier->lock);
+		if (err) {
+			mts_tier_put(tier);
+			goto rollback;
+		}
+		charged++;
+	}
+	domain->status = MTS_SLO_ADMITTED;
+	list_add_tail(&domain->node, &mts_domains);
+	trace_slo_transition(domain->stable_id, MTS_SLO_UNADMITTED,
+			     MTS_SLO_ADMITTED, MTS_CAUSE_NONE,
+			     domain->tiers[0].tier->desc.uuid);
+	mutex_unlock(&mts_registry_lock);
+
+	fd = anon_inode_getfd("mts-domain", &mts_domain_fops, domain,
+			      O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		mutex_lock(&mts_registry_lock);
+		list_del(&domain->node);
+		mts_uncharge_bindings(domain, charged);
+		mutex_unlock(&mts_registry_lock);
+		err = fd;
+		goto put_cgroup;
+	}
+	request->domain_fd = fd;
+	request->status = domain->status;
+	request->stable_cgroup_id = domain->stable_id;
+	return 0;
+
+rollback:
+	mts_uncharge_bindings(domain, charged);
+	mutex_unlock(&mts_registry_lock);
+put_cgroup:
+	cgroup_put(domain->cgroup);
+free_domain:
+	kfree(domain);
+	return err;
+}
+
 static int mts_unregister_tier(void __user *argument)
 {
 	u8 uuid[MTS_UUID_BYTES];
@@ -353,6 +597,8 @@ static int mts_unregister_tier(void __user *argument)
 		mutex_lock(&tier->lock);
 		tier->state = MTS_TIER_DRAINING;
 		mutex_unlock(&tier->lock);
+		mts_mark_tier_domains_at_risk(tier,
+					      MTS_CAUSE_RESERVATION_REVOKED);
 		xa_erase(&mts_tiers, index);
 		err = 0;
 		break;
@@ -368,12 +614,27 @@ static int mts_unregister_tier(void __user *argument)
 static long mts_control_ioctl(struct file *file, unsigned int command,
 			      unsigned long argument)
 {
+	struct mts_admit_domain_v2 admission;
 	struct mts_register_tier_v2 request;
 	struct mts_tier *tier;
 	int fd;
 	int slot;
 	int err;
 
+	if (command == MTS_IOC_ADMIT_DOMAIN) {
+		if (copy_from_user(&admission, (void __user *)argument,
+				   sizeof(admission)))
+			return -EFAULT;
+		err = mts_admit_domain(&admission);
+		if (err)
+			return err;
+		if (copy_to_user((void __user *)argument, &admission,
+				 sizeof(admission))) {
+			close_fd(admission.domain_fd);
+			return -EFAULT;
+		}
+		return 0;
+	}
 	if (command == MTS_IOC_UNREGISTER_TIER)
 		return mts_unregister_tier((void __user *)argument);
 	if (command != MTS_IOC_REGISTER_TIER)

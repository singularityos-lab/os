--- a/mm/mts_tier.c
+++ b/mm/mts_tier.c
@@ -1,20 +1,24 @@
 // SPDX-License-Identifier: GPL-2.0-only
 #include <linux/anon_inodes.h>
+#include <linux/cgroup.h>

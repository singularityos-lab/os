+		__field(u32, cause)
+		__array(u8, tier_uuid, 16)
+	),
+	TP_fast_assign(
+		__entry->cgroup_id = cgroup_id;
+		__entry->old_status = old_status;
+		__entry->new_status = new_status;
+		__entry->cause = cause;
+		memcpy(__entry->tier_uuid, tier_uuid, 16);
+	),
+	TP_printk("cgroup=%llu old=%u new=%u cause=%u",

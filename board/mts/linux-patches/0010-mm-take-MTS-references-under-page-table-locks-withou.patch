 		pte_t *dst_pte, pte_t *src_pte, struct vm_area_struct *dst_vma,
-		struct vm_area_struct *src_vma, unsigned long addr, int *rss)
+		struct vm_area_struct *src_vma, unsigned long addr, int *rss,
+		swp_entry_t *mts_clone)
 {
 	pte_t orig_pte = ptep_get(src_pte);
 	softleaf_t entry = softleaf_from_pte(orig_pte);
@@ -1024,18 +1025,17 @@ copy_nonpresent_pte(struct mm_struct *dst_mm, struct mm_struct *src_mm,
 		int err = mts_entry_dup(entry);
 
 		if (err == -EOVERFLOW) {
-			swp_entry_t clone;
-
-			if (mts_entry_clone(entry, &clone))
-				return -EIO;
-			pte = swp_entry_to_pte(clone);
+			if (!mts_clone->val)
+				return -EOVERFLOW;
+			pte = swp_entry_to_pte(*mts_clone);
+			mts_clone->val = 0;
 			pte = pte_swp_mkexclusive(pte);
 			if (pte_swp_soft_dirty(orig_pte))
 				pte = pte_swp_mksoft_dirty(pte);
 			if (pte_swp_uffd(orig_pte))
 				pte = pte_swp_mkuffd(pte);
 		} else if (err) {
-			return -EIO;
+			return -ESTALE;
 		} else if (pte_swp_exclusive(orig_pte)) {
 			pte = pte_swp_clear_exclusive(orig_pte);
 			set_pte_at(src_mm, addr, src_pte, pte);
@@ -1343,6 +1343,7 @@ copy_pte_range(struct vm_area_struct *dst_vma, struct vm_area_struct *src_vma,
 	int progress, max_nr, ret = 0;
 	int rss[NR_MM_COUNTERS];
 	softleaf_t entry = softleaf_mk_none();
+	swp_entry_t mts_clone = { .val = 0 };
 	struct folio *prealloc = NULL;
 	int nr;
 
@@ -1404,11 +1405,11 @@ copy_pte_range(struct vm_area_struct *dst_vma, struct vm_area_struct *src_vma,
 			ret = copy_nonpresent_pte(dst_mm, src_mm,
 						  dst_pte, src_pte,
 						  dst_vma, src_vma,
-						  addr, rss);
-			if (ret == -EIO) {
+						  addr, rss, &mts_clone);
+			if (ret == -EIO || ret == -EOVERFLOW) {
 				entry = softleaf_from_pte(ptep_get(src_pte));
 				break;
-			} else if (ret == -EBUSY) {
+			} else if (ret == -EBUSY || ret == -ESTALE) {
 				break;
 			} else if (!ret) {
 				progress += 8;
@@ -1462,6 +1463,18 @@ copy_pte_range(struct vm_area_struct *dst_vma, struct vm_area_struct *src_vma,
 			goto out;
 		}
 		entry.val = 0;
+	} else if (ret == -EOVERFLOW) {
+		if (mts_clone.val)
+			mts_entry_put(mts_clone);
+		mts_clone.val = 0;
+		if (mts_entry_clone(entry, &mts_clone)) {
+			ret = -ENOMEM;
+			goto out;
+		}
+		entry.val = 0;
+	} else if (ret == -ESTALE) {
+		ret = -ENOMEM;
+		goto out;
 	} else if (ret == -EBUSY || unlikely(ret == -EHWPOISON)) {
 		goto out;
 	} else if (ret ==  -EAGAIN) {
@@ -1480,6 +1493,8 @@ copy_pte_range(struct vm_area_struct *dst_vma, struct vm_area_struct *src_vma,
 out:
 	if (unlikely(prealloc))
 		folio_put(prealloc);
+	if (mts_clone.val)
+		mts_entry_put(mts_clone);
 	return ret;
 }
 

+static vm_fault_t do_mts_page(struct vm_fault *vmf, softleaf_t entry)
+{
+	struct vm_area_struct *vma = vmf->vma;
+	struct mts_object_id object_id;
+	struct mem_cgroup *memcg;
+	struct folio *folio;
+	u8 tier_uuid[16];
+	u64 cgroup = 0;
+	u64 start_ns;
+	vm_fault_t ret;
+	int err;
+
+	ret = vmf_anon_prepare(vmf);
+	if (ret)
+		return ret;
+	folio = folio_prealloc(vma->vm_mm, vma, vmf->address, false);
+	if (!folio)
+		return VM_FAULT_OOM;
+	memcg = folio_memcg(folio);
+	if (memcg)
+		cgroup = cgroup_id(memcg->css.cgroup);
+	start_ns = ktime_get_ns();
+	memset(tier_uuid, 0, sizeof(tier_uuid));
+	trace_fault_begin(cgroup, vmf->address, swp_offset(entry), 0,
+			  tier_uuid, 0, start_ns, 0);
+	err = mts_entry_read(entry, &folio->page, &object_id, tier_uuid);
+	if (err) {
+		trace_fault_end(cgroup, vmf->address, swp_offset(entry), 0,
+				tier_uuid, 0, ktime_get_ns(), err);
+		folio_put(folio);
+		return err == -ENOMEM ? VM_FAULT_OOM : VM_FAULT_SIGBUS;
+	}
+	__folio_mark_uptodate(folio);
+	vmf->pte = pte_offset_map_lock(vma->vm_mm, vmf->pmd, vmf->address,
+				       &vmf->ptl);
+	if (!vmf->pte)
+		goto release;
+	if (!pte_same(ptep_get(vmf->pte), vmf->orig_pte)) {
+		update_mmu_tlb(vma, vmf->address, vmf->pte);
+		pte_unmap_unlock(vmf->pte, vmf->ptl);
+		goto release;
+	}
+	map_anon_folio_pte_pf(folio, vmf->pte, vma, vmf->address,
+			      vmf_orig_pte_uffd_wp(vmf));
+	dec_mm_counter(vma->vm_mm, MM_SWAPENTS);
+	pte_unmap_unlock(vmf->pte, vmf->ptl);
+	mts_entry_put(entry);
+	count_vm_event(PGMAJFAULT);
+	count_memcg_event_mm(vma->vm_mm, PGMAJFAULT);
+	trace_fault_end(cgroup, vmf->address, object_id.slot,
+			object_id.generation, tier_uuid, 0, ktime_get_ns(), 0);
+	return VM_FAULT_MAJOR;
+
+release:
+	folio_put(folio);
+	return 0;
+}

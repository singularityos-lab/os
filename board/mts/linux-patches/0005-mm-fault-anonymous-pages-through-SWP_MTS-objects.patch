 #include <trace/events/mts.h>
@@ -72,10 +75,21 @@ struct mts_domain {
 	struct mts_domain_tier tiers[MTS_MAX_DOMAIN_TIERS];
 };
 
+struct mts_pte_object {
+	struct kref kref;
+	struct mts_tier *tier;
+	struct mts_object_id id;
+	u32 cookie;
+	u32 pte_refs;
+};
+
 static DEFINE_XARRAY(mts_tiers);
 static DEFINE_IDA(mts_tier_ids);
 static DEFINE_MUTEX(mts_registry_lock);
 static LIST_HEAD(mts_domains);
+static DEFINE_XARRAY_ALLOC1(mts_pte_objects);
+static DEFINE_XARRAY(mts_prepared_pages);
+static DEFINE_MUTEX(mts_pte_lock);
 
 static struct mts_tier *mts_tier_lookup(u8 tier_slot)
 {
@@ -184,9 +198,11 @@ static int mts_allocate_object(struct mts_tier *tier,
 	}
 
 found:
+	mutex_lock(&object->lock);
 	if (object->generation == U32_MAX) {
 		object->retired = true;
 		err = -EOVERFLOW;
+		mutex_unlock(&object->lock);
 		goto out_unlock;
 	}
 	object->generation++;
@@ -195,6 +211,7 @@ found:
 	id->slot = slot;
 	id->generation = object->generation;
 	*result = object;
+	mutex_unlock(&object->lock);
 	mutex_unlock(&tier->lock);
 	return 0;
 
@@ -313,6 +330,271 @@ int mts_tier_put_ref(u8 tier_slot, const struct mts_object_id *id)
 }
 EXPORT_SYMBOL_GPL(mts_tier_put_ref);
 
+static struct mts_tier *mts_select_tier(struct mem_cgroup *memcg)
+{
+	struct mts_domain *domain;
+	struct mts_tier *tier = NULL;
+
+	if (!memcg)
+		return NULL;
+	mutex_lock(&mts_registry_lock);
+	list_for_each_entry(domain, &mts_domains, node) {
+		if (domain->status != MTS_SLO_ADMITTED || !domain->tier_count)
+			continue;
+		if (domain->cgroup != memcg->css.cgroup)
+			continue;
+		tier = domain->tiers[0].tier;
+		kref_get(&tier->kref);
+		break;
+	}
+	mutex_unlock(&mts_registry_lock);
+	return tier;
+}
+
+bool mts_can_reclaim(struct mem_cgroup *memcg)
+{
+	struct mts_domain *domain;
+	struct mts_tier *tier;
+
+	if (!memcg) {
+		bool available = false;
+
+		mutex_lock(&mts_registry_lock);
+		list_for_each_entry(domain, &mts_domains, node)
+			if (domain->status == MTS_SLO_ADMITTED) {
+				available = true;
+				break;
+			}
+		mutex_unlock(&mts_registry_lock);
+		return available;
+	}
+	tier = mts_select_tier(memcg);
+
+	if (!tier)
+		return false;
+	mts_tier_put(tier);
+	return true;
+}
+EXPORT_SYMBOL_GPL(mts_can_reclaim);
+
+static void mts_pte_object_release(struct kref *kref)
+{
+	struct mts_pte_object *pte_object =
+		container_of(kref, struct mts_pte_object, kref);
+
+	mts_tier_put(pte_object->tier);
+	kfree(pte_object);
+}
+
+static int mts_object_get_ref_locked(struct mts_tier *tier,
+				     const struct mts_object_id *id)
+{
+	struct mts_object *object = mts_object_lookup(tier, id);
+
+	if (IS_ERR(object))
+		return PTR_ERR(object);
+	if (object->frozen || object->refs == MTS_REFCOUNT_FREEZE) {
+		object->frozen = true;
+		return -EOVERFLOW;
+	}
+	object->refs++;
+	if (object->refs == MTS_REFCOUNT_FREEZE)
+		object->frozen = true;
+	return 0;
+}
+
+static int mts_object_put_ref_locked(struct mts_tier *tier,
+				     const struct mts_object_id *id)
+{
+	struct mts_object *object = mts_object_lookup(tier, id);
+
+	if (IS_ERR(object))
+		return PTR_ERR(object);
+	object->refs--;
+	return 0;
+}
+
+int mts_prepare_folio(struct folio *folio)
+{
+	struct mts_pte_object *pte_object;
+	struct mts_tier *tier;
+	unsigned long pfn;
+	u32 cookie;
+	int err;
+
+	if (folio_test_large(folio) || folio_mapped(folio))
+		return -EAGAIN;
+	tier = mts_select_tier(folio_memcg(folio));
+	if (!tier)
+		return -ENODEV;
+	pte_object = kzalloc_obj(*pte_object);
+	if (!pte_object) {
+		err = -ENOMEM;
+		goto put_tier;
+	}
+	kref_init(&pte_object->kref);
+	pte_object->tier = tier;
+	err = mts_tier_put_page(tier->slot, &folio->page, &pte_object->id);
+	if (err)
+		goto free_object;
+
+	mutex_lock(&mts_pte_lock);
+	err = xa_alloc(&mts_pte_objects, &cookie, pte_object,
+		       XA_LIMIT(1, U32_MAX), GFP_NOWAIT);
+	if (err)
+		goto unlock_put_object;
+	pte_object->cookie = cookie;
+	pfn = folio_pfn(folio);
+	err = xa_insert(&mts_prepared_pages, pfn, pte_object, GFP_NOWAIT);
+	if (err) {
+		xa_erase(&mts_pte_objects, cookie);
+		goto unlock_put_object;
+	}
+	mutex_unlock(&mts_pte_lock);
+	return 0;
+
+unlock_put_object:
+	mutex_unlock(&mts_pte_lock);
+	mutex_lock(&tier->lock);
+	mts_object_put_ref_locked(tier, &pte_object->id);
+	mutex_unlock(&tier->lock);
+free_object:
+	kref_put(&pte_object->kref, mts_pte_object_release);
+	return err;
+put_tier:
+	mts_tier_put(tier);
+	return err;
+}
+EXPORT_SYMBOL_GPL(mts_prepare_folio);
+
+bool mts_folio_entry(struct page *page, swp_entry_t *entry)
+{
+	struct mts_pte_object *pte_object;
+	bool found = false;
+
+	mutex_lock(&mts_pte_lock);
+	pte_object = xa_load(&mts_prepared_pages, page_to_pfn(page));
+	if (!pte_object)
+		goto unlock;
+	if (pte_object->pte_refs) {
+		mutex_lock(&pte_object->tier->lock);
+		if (mts_object_get_ref_locked(pte_object->tier,
+					      &pte_object->id)) {
+			mutex_unlock(&pte_object->tier->lock);
+			goto unlock;
+		}
+		mutex_unlock(&pte_object->tier->lock);
+	}
+	pte_object->pte_refs++;
+	*entry = swp_entry(SWP_MTS, pte_object->cookie);
+	found = true;
+unlock:
+	mutex_unlock(&mts_pte_lock);
+	return found;
+}
+EXPORT_SYMBOL_GPL(mts_folio_entry);
+
+bool mts_finish_folio(struct folio *folio)
+{
+	struct mts_pte_object *pte_object;
+	unsigned long pfn = folio_pfn(folio);
+
+	mutex_lock(&mts_pte_lock);
+	pte_object = xa_erase(&mts_prepared_pages, pfn);
+	if (!pte_object) {
+		mutex_unlock(&mts_pte_lock);
+		return false;
+	}
+	if (!pte_object->pte_refs) {
+		xa_erase(&mts_pte_objects, pte_object->cookie);
+		mutex_lock(&pte_object->tier->lock);
+		mts_object_put_ref_locked(pte_object->tier, &pte_object->id);
+		mutex_unlock(&pte_object->tier->lock);
+		kref_put(&pte_object->kref, mts_pte_object_release);
+	}
+	mutex_unlock(&mts_pte_lock);
+	return true;
+}
+EXPORT_SYMBOL_GPL(mts_finish_folio);
+
+int mts_entry_dup(swp_entry_t entry)
+{
+	struct mts_pte_object *pte_object;
+	int err = -ESTALE;
+
+	mutex_lock(&mts_pte_lock);
+	pte_object = xa_load(&mts_pte_objects, swp_offset(entry));
+	if (!pte_object)
+		goto unlock;
+	mutex_lock(&pte_object->tier->lock);
+	err = mts_object_get_ref_locked(pte_object->tier, &pte_object->id);
+	mutex_unlock(&pte_object->tier->lock);
+	if (!err)
+		pte_object->pte_refs++;
+unlock:
+	mutex_unlock(&mts_pte_lock);
+	return err;
+}
+EXPORT_SYMBOL_GPL(mts_entry_dup);
+
+void mts_entry_put(swp_entry_t entry)
+{
+	struct mts_pte_object *pte_object;
+
+	mutex_lock(&mts_pte_lock);
+	pte_object = xa_load(&mts_pte_objects, swp_offset(entry));
+	if (!pte_object || !pte_object->pte_refs)
+		goto unlock;
+	mutex_lock(&pte_object->tier->lock);
+	mts_object_put_ref_locked(pte_object->tier, &pte_object->id);
+	mutex_unlock(&pte_object->tier->lock);
+	pte_object->pte_refs--;
+	if (!pte_object->pte_refs) {
+		xa_erase(&mts_pte_objects, pte_object->cookie);
+		kref_put(&pte_object->kref, mts_pte_object_release);
+	}
+unlock:
+	mutex_unlock(&mts_pte_lock);
+}
+EXPORT_SYMBOL_GPL(mts_entry_put);
+
+int mts_entry_read(swp_entry_t entry, struct page *page,
+		   struct mts_object_id *id, u8 uuid[16])
+{
+	struct mts_pte_object *pte_object;
+	struct mts_object *object;
+	int err = -ESTALE;
+
+	mutex_lock(&mts_pte_lock);
+	pte_object = xa_load(&mts_pte_objects, swp_offset(entry));
+	if (pte_object)
+		kref_get(&pte_object->kref);
+	mutex_unlock(&mts_pte_lock);
+	if (!pte_object)
+		return err;
+
+	mutex_lock(&pte_object->tier->lock);
+	object = mts_object_lookup(pte_object->tier, &pte_object->id);
+	if (IS_ERR(object)) {
+		err = PTR_ERR(object);
+		mutex_unlock(&pte_object->tier->lock);
+		goto put_object;
+	}
+	mutex_lock(&object->lock);
+	mutex_unlock(&pte_object->tier->lock);
+	err = mts_provider_read(pte_object->tier, pte_object->id.slot, page,
+				object->checksum);
+	mutex_unlock(&object->lock);
+	if (!err) {
+		*id = pte_object->id;
+		memcpy(uuid, pte_object->tier->desc.uuid, MTS_UUID_BYTES);
+	}
+put_object:
+	kref_put(&pte_object->kref, mts_pte_object_release);
+	return err;

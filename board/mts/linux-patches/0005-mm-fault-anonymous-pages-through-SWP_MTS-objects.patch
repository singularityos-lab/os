+struct mts_install_arg {
+	bool installed;
+	bool failed;
+};
+
+static bool install_mts_pte(struct folio *folio, struct vm_area_struct *vma,
+			    unsigned long addr, void *arg)
+{
+	struct mts_install_arg *install = arg;
+	DEFINE_FOLIO_VMA_WALK(pvmw, folio, vma, addr,
+			      PVMW_SYNC | PVMW_MIGRATION);
+
+	while (page_vma_mapped_walk(&pvmw)) {
+		softleaf_t migration;
+		swp_entry_t mts_entry;
+		pte_t old_pte;
+		pte_t new_pte;
+
+		if (!pvmw.pte)
+			continue;
+		old_pte = ptep_get(pvmw.pte);
+		migration = softleaf_from_pte(old_pte);
+		if (!softleaf_is_migration(migration) ||
+		    softleaf_to_pfn(migration) != folio_pfn(folio))
+			continue;
+		if (!mts_folio_entry(&folio->page, &mts_entry)) {
+			install->failed = true;
+			return false;
+		}
+		new_pte = swp_entry_to_pte(mts_entry);
+		if (softleaf_is_migration_read_exclusive(migration))
+			new_pte = pte_swp_mkexclusive(new_pte);
+		if (pte_swp_soft_dirty(old_pte))
+			new_pte = pte_swp_mksoft_dirty(new_pte);
+		if (pte_swp_uffd_wp(old_pte))
+			new_pte = pte_swp_mkuffd_wp(new_pte);
+		set_pte_at(vma->vm_mm, pvmw.address, pvmw.pte, new_pte);
+		dec_mm_counter(vma->vm_mm, MM_ANONPAGES);
+		inc_mm_counter(vma->vm_mm, MM_SWAPENTS);
+		update_mmu_cache(vma, pvmw.address, pvmw.pte);
+		install->installed = true;
+	}
+	return true;
+}
+
+bool mts_install_folio_ptes(struct folio *folio)
+{
+	struct mts_install_arg install = {};
+	struct rmap_walk_control rwc = {
+		.rmap_one = install_mts_pte,
+		.arg = &install,
+		.anon_lock = folio_lock_anon_vma_read,
+	};
+
+	rmap_walk(folio, &rwc);
+	return install.installed && !install.failed;
+}
+EXPORT_SYMBOL_GPL(mts_install_folio_ptes);

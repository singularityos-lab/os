diff --git a/mm/mts.c b/mm/mts.c
new file mode 100644
index 0000000..b4e1bdf
--- /dev/null
+++ b/mm/mts.c
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#define CREATE_TRACE_POINTS
+#include <trace/events/mts.h>
+
+#include <linux/atomic.h>
+#include <linux/debugfs.h>
+#include <linux/hash.h>
+#include <linux/jiffies.h>
+#include <linux/mm.h>
+#include <linux/mts.h>
+#include <linux/page_ext.h>
+#include <linux/seq_file.h>
+#include <linux/workqueue.h>
+
+#define MTS_ISO_BUCKETS	16
+#define MTS_Q12_MAX	4095
+#define MTS_SAMPLE_BITS	12
+#define MTS_SAMPLE_COUNT	BIT(MTS_SAMPLE_BITS)
+#define MTS_SAMPLE_RESERVED	LONG_MIN
+
+#define MTS_ATTR_VERSION_SHIFT	0
+#define MTS_ATTR_STATE_SHIFT	4
+#define MTS_ATTR_REUSE_SHIFT	8
+#define MTS_ATTR_AGE_SHIFT	56
+#define MTS_ATTR_VERSION_MASK	GENMASK_ULL(3, 0)
+#define MTS_ATTR_STATE_MASK	GENMASK_ULL(7, 4)
+#define MTS_ATTR_REUSE_MASK	GENMASK_ULL(19, 8)
+#define MTS_ATTR_AGE_MASK	GENMASK_ULL(63, 56)
+
+#define MTS_SAMPLE_EXPIRY_MASK	GENMASK_ULL(31, 0)
+#define MTS_SAMPLE_PRED_SHIFT	32
+#define MTS_SAMPLE_PRED_MASK	GENMASK_ULL(43, 32)
+#define MTS_SAMPLE_BUCKET_SHIFT	44
+#define MTS_SAMPLE_BUCKET_MASK	GENMASK_ULL(47, 44)
+#define MTS_SAMPLE_REUSED	BIT_ULL(48)
+
+struct mts_page_ext {
+	atomic64_t attr;
+};
+
+struct mts_sample {
+	atomic_long_t key;
+	atomic64_t meta;
+};
+
+static struct mts_sample mts_samples[MTS_SAMPLE_COUNT];
+static atomic64_t mts_positive[MTS_ISO_BUCKETS];
+static atomic64_t mts_total[MTS_ISO_BUCKETS];
+static atomic_t mts_probability_q12[MTS_ISO_BUCKETS];
+static atomic64_t mts_brier_sum_q32;
+static atomic64_t mts_labeled_samples;
+static atomic64_t mts_sample_attempts;
+static atomic64_t mts_sample_collisions;
+static atomic64_t mts_access_events;
+static atomic64_t mts_consider_events;
+static struct delayed_work mts_label_work;
+
+static unsigned int mts_reuse_horizon_ms = 1000;
+static unsigned int mts_sample_shift = 10;
+
+static bool mts_need_page_ext(void)
+{
+	return true;
+}
+
+struct page_ext_operations mts_page_ext_ops = {
+	.size = sizeof(struct mts_page_ext),
+	.need = mts_need_page_ext,
+};
+
+static u8 mts_attr_age(u64 attr)
+{
+	return min_t(u8, (attr & MTS_ATTR_AGE_MASK) >> MTS_ATTR_AGE_SHIFT, 15);
+}
+
+static u64 mts_attr_update(u64 old, u8 age, u16 probability)
+{
+	old &= ~(MTS_ATTR_VERSION_MASK | MTS_ATTR_STATE_MASK |
+		 MTS_ATTR_REUSE_MASK | MTS_ATTR_AGE_MASK);
+	old |= 2ULL << MTS_ATTR_VERSION_SHIFT;
+	old |= (u64)probability << MTS_ATTR_REUSE_SHIFT;
+	old |= (u64)age << MTS_ATTR_AGE_SHIFT;
+	return old;
+}
+
+static u64 mts_update_page(struct page *page, bool accessed)
+{
+	struct page_ext *page_ext = page_ext_get(page);
+	struct mts_page_ext *data;
+	u64 old, new;
+	u8 age;
+	u16 probability;
+
+	if (!page_ext)
+		return 0;
+	data = page_ext_data(page_ext, &mts_page_ext_ops);
+	do {
+		old = atomic64_read(&data->attr);
+		age = accessed ? 0 : min_t(u8, mts_attr_age(old) + 1, 15);
+		probability = atomic_read(&mts_probability_q12[age]);
+		new = mts_attr_update(old, age, probability);
+	} while (atomic64_cmpxchg(&data->attr, old, new) != old);
+	page_ext_put(page_ext);
+	return new;
+}
+
+static void mts_mark_reused(unsigned long pfn)
+{
+	struct mts_sample *sample = &mts_samples[hash_long(pfn, MTS_SAMPLE_BITS)];
+	unsigned long key = atomic_long_read_acquire(&sample->key);
+
+	if (key == pfn + 1)
+		atomic64_or(MTS_SAMPLE_REUSED, &sample->meta);
+}
+
+void mts_observe_access(struct folio *folio)
+{
+	unsigned int i;
+
+	if (!folio_test_anon(folio))
+		return;
+	atomic64_add(folio_nr_pages(folio), &mts_access_events);
+	for (i = 0; i < folio_nr_pages(folio); i++) {
+		struct page *page = folio_page(folio, i);
+
+		mts_update_page(page, true);
+		mts_mark_reused(page_to_pfn(page));
+	}
+}
+
+static bool mts_should_sample(unsigned long pfn)
+{
+	u64 epoch = get_jiffies_64() / max_t(unsigned long, 1,
+		msecs_to_jiffies(mts_reuse_horizon_ms));
+
+	if (!mts_sample_shift)
+		return true;
+	return hash_long(pfn ^ epoch, mts_sample_shift) == 0;
+}
+
+static void mts_start_sample(struct page *page, u64 attr)
+{
+	unsigned long pfn = page_to_pfn(page);
+	struct mts_sample *sample;
+	unsigned long old;
+	u64 meta;
+	u8 age;
+	u16 prediction;
+
+	if (!mts_should_sample(pfn))
+		return;
+	atomic64_inc(&mts_sample_attempts);
+	sample = &mts_samples[hash_long(pfn, MTS_SAMPLE_BITS)];
+	old = atomic_long_cmpxchg(&sample->key, 0, MTS_SAMPLE_RESERVED);
+	if (old) {
+		atomic64_inc(&mts_sample_collisions);
+		return;
+	}
+
+	age = mts_attr_age(attr);
+	prediction = (attr & MTS_ATTR_REUSE_MASK) >> MTS_ATTR_REUSE_SHIFT;
+	meta = (u32)(jiffies + msecs_to_jiffies(mts_reuse_horizon_ms));
+	meta |= (u64)prediction << MTS_SAMPLE_PRED_SHIFT;
+	meta |= (u64)age << MTS_SAMPLE_BUCKET_SHIFT;
+	atomic64_set(&sample->meta, meta);
+	atomic_long_set_release(&sample->key, pfn + 1);
+	trace_mts_observe_sample(pfn, age, prediction);
+}
+
+void mts_observe_consider(struct folio *folio, bool referenced)
+{
+	unsigned int i;
+
+	if (!folio_test_anon(folio))
+		return;
+	atomic64_add(folio_nr_pages(folio), &mts_consider_events);
+	for (i = 0; i < folio_nr_pages(folio); i++) {
+		struct page *page = folio_page(folio, i);
+		u64 attr = mts_update_page(page, referenced);
+
+		mts_start_sample(page, attr);
+	}
+}
+
+static void mts_recalibrate(void)
+{
+	u64 positive[MTS_ISO_BUCKETS], total[MTS_ISO_BUCKETS];
+	u64 block_positive[MTS_ISO_BUCKETS], block_total[MTS_ISO_BUCKETS];
+	u8 first[MTS_ISO_BUCKETS], last[MTS_ISO_BUCKETS];
+	int blocks = 0, i, g;
+
+	for (g = 0; g < MTS_ISO_BUCKETS; g++) {
+		positive[g] = atomic64_read(&mts_positive[g]) + 1;
+		total[g] = atomic64_read(&mts_total[g]) + 2;
+		block_positive[blocks] = positive[g];
+		block_total[blocks] = total[g];
+		first[blocks] = g;
+		last[blocks] = g;
+		blocks++;
+
+		while (blocks >= 2 &&
+		       block_positive[blocks - 2] * block_total[blocks - 1] <
+		       block_positive[blocks - 1] * block_total[blocks - 2]) {
+			block_positive[blocks - 2] += block_positive[blocks - 1];
+			block_total[blocks - 2] += block_total[blocks - 1];
+			last[blocks - 2] = last[blocks - 1];
+			blocks--;
+		}
+	}
+
+	for (i = 0; i < blocks; i++) {
+		u16 q12 = div64_u64(block_positive[i] * MTS_Q12_MAX +
+				     block_total[i] / 2, block_total[i]);
+
+		for (g = first[i]; g <= last[i]; g++)
+			atomic_set(&mts_probability_q12[g], q12);
+	}
+}
+
+static void mts_finish_sample(struct mts_sample *sample, unsigned long pfn, u64 meta)
+{
+	u16 prediction = (meta & MTS_SAMPLE_PRED_MASK) >> MTS_SAMPLE_PRED_SHIFT;
+	u8 age = (meta & MTS_SAMPLE_BUCKET_MASK) >> MTS_SAMPLE_BUCKET_SHIFT;
+	bool reused = meta & MTS_SAMPLE_REUSED;
+	s64 error = (s64)prediction - (reused ? MTS_Q12_MAX : 0);
+	u64 squared_q32 = div64_u64((u64)(error * error) << 32,
+				     (u64)MTS_Q12_MAX * MTS_Q12_MAX);
+
+	atomic64_inc(&mts_total[age]);
+	if (reused)
+		atomic64_inc(&mts_positive[age]);
+	atomic64_add(squared_q32, &mts_brier_sum_q32);
+	atomic64_inc(&mts_labeled_samples);
+	trace_mts_prediction_label(pfn, age, prediction, reused);
+}
+
+static void mts_label_worker(struct work_struct *work)
+{
+	u32 now = (u32)jiffies;
+	unsigned int i;
+
+	for (i = 0; i < MTS_SAMPLE_COUNT; i++) {
+		struct mts_sample *sample = &mts_samples[i];
+		unsigned long key = atomic_long_read_acquire(&sample->key);
+		u64 meta;
+
+		if (!key || key == MTS_SAMPLE_RESERVED)
+			continue;
+		meta = atomic64_read(&sample->meta);
+		if ((s32)(now - (u32)(meta & MTS_SAMPLE_EXPIRY_MASK)) < 0)
+			continue;
+		if (atomic_long_cmpxchg(&sample->key, key, 0) != key)
+			continue;
+		mts_finish_sample(sample, key - 1, meta);
+	}
+
+	mts_recalibrate();
+	schedule_delayed_work(&mts_label_work,
+			      max_t(unsigned long, 1,
+				    msecs_to_jiffies(mts_reuse_horizon_ms / 16)));
+}
+
+static int mts_observe_show(struct seq_file *m, void *unused)
+{
+	u64 labels = atomic64_read(&mts_labeled_samples);
+	int g;
+
+	seq_printf(m, "version 2\nlabels %llu\nbrier_sum_q32 %llu\n",
+		   labels, atomic64_read(&mts_brier_sum_q32));
+	seq_printf(m, "sample_attempts %llu\nsample_collisions %llu\n",
+		   atomic64_read(&mts_sample_attempts),
+		   atomic64_read(&mts_sample_collisions));
+	seq_printf(m, "access_events %llu\nconsider_events %llu\n",
+		   atomic64_read(&mts_access_events),
+		   atomic64_read(&mts_consider_events));
+	for (g = 0; g < MTS_ISO_BUCKETS; g++)
+		seq_printf(m, "bucket %d probability_q12 %d positive %llu total %llu\n",
+			   g, atomic_read(&mts_probability_q12[g]),
+			   atomic64_read(&mts_positive[g]),
+			   atomic64_read(&mts_total[g]));
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(mts_observe);
+
+static int __init mts_observe_init(void)
+{
+	struct dentry *dir;
+	int g;
+
+	for (g = 0; g < MTS_ISO_BUCKETS; g++)
+		atomic_set(&mts_probability_q12[g], MTS_Q12_MAX / 2);
+	INIT_DELAYED_WORK(&mts_label_work, mts_label_worker);
+	schedule_delayed_work(&mts_label_work,
+			      max_t(unsigned long, 1,
+				    msecs_to_jiffies(mts_reuse_horizon_ms / 16)));
+	dir = debugfs_create_dir("mts", NULL);
+	debugfs_create_file("observe", 0444, dir, NULL, &mts_observe_fops);
+	return 0;
+}
+late_initcall(mts_observe_init);
+
+static int __init mts_horizon_setup(char *value)
+{
+	return kstrtouint(value, 0, &mts_reuse_horizon_ms) ? 0 : 1;
+}
+__setup("mts.reuse_horizon_ms=", mts_horizon_setup);
+
+static int __init mts_sample_shift_setup(char *value)
+{
+	int ret = kstrtouint(value, 0, &mts_sample_shift);
+
+	if (ret || mts_sample_shift > 20)
+		return 0;
+	return 1;
+}
+__setup("mts.sample_shift=", mts_sample_shift_setup);

diff --git a/include/trace/events/mts.h b/include/trace/events/mts.h
new file mode 100644
index 0000000..bc95234
--- /dev/null
+++ b/include/trace/events/mts.h
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM mts
+
+#if !defined(_TRACE_MTS_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_MTS_H
+
+#include <linux/tracepoint.h>
+
+TRACE_EVENT(mts_observe_sample,
+	TP_PROTO(unsigned long pfn, u8 age, u16 reuse_q12),
+	TP_ARGS(pfn, age, reuse_q12),
+	TP_STRUCT__entry(
+		__field(unsigned long, pfn)
+		__field(u8, age)
+		__field(u16, reuse_q12)
+	),
+	TP_fast_assign(
+		__entry->pfn = pfn;
+		__entry->age = age;
+		__entry->reuse_q12 = reuse_q12;
+	),
+	TP_printk("pfn=%lu age=%u reuse_q12=%u",
+		  __entry->pfn, __entry->age, __entry->reuse_q12)
+);
+
+TRACE_EVENT(mts_prediction_label,
+	TP_PROTO(unsigned long pfn, u8 age, u16 reuse_q12, bool reused),
+	TP_ARGS(pfn, age, reuse_q12, reused),
+	TP_STRUCT__entry(
+		__field(unsigned long, pfn)
+		__field(u8, age)
+		__field(u16, reuse_q12)
+		__field(bool, reused)
+	),
+	TP_fast_assign(
+		__entry->pfn = pfn;
+		__entry->age = age;
+		__entry->reuse_q12 = reuse_q12;
+		__entry->reused = reused;
+	),
+	TP_printk("pfn=%lu age=%u reuse_q12=%u reused=%d",
+		  __entry->pfn, __entry->age, __entry->reuse_q12,
+		  __entry->reused)
+);
+
+#endif /* _TRACE_MTS_H */
+
+#include <trace/define_trace.h>

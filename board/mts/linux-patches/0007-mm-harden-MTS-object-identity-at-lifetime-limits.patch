From 839f6b73c480afd669fc8ab9ff25c53d13247690 Mon Sep 17 00:00:00 2001
From: Mirko Brombin <9479903+mirkobrombin@users.noreply.github.com>
Date: Sat, 18 Jul 2026 20:13:53 +0100
Subject: [PATCH 7/7] mm: harden MTS object identity at lifetime limits

Reject duplicate provider UUIDs in the kernel registry and retire exhausted generation slots while continuing allocation from remaining capacity.

Honor the sticky 24-bit reference freeze during fork by cloning the immutable provider object for the child. Keep source and destination generations independent and preserve soft-dirty, uffd-wp, and exclusive PTE state.

Evidence: Linux 7.1.3 CONFIG_MTS_TIER=y make -j4 mm/; checkpatch.pl --strict (clean).
Signed-off-by: Mirko Brombin <9479903+mirkobrombin@users.noreply.github.com>
---
 include/linux/mts.h |   5 +++
 mm/memory.c         |  19 +++++++-
 mm/mts_tier.c       | 104 +++++++++++++++++++++++++++++++++++++++++---
 3 files changed, 120 insertions(+), 8 deletions(-)

diff --git a/include/linux/mts.h b/include/linux/mts.h
index 5b83394..335e437 100644
--- a/include/linux/mts.h
+++ b/include/linux/mts.h
@@ -42,6 +42,7 @@ bool mts_folio_entry(struct page *page, swp_entry_t *entry);
 bool mts_finish_folio(struct folio *folio);
 bool mts_install_folio_ptes(struct folio *folio);
 int mts_entry_dup(swp_entry_t entry);
+int mts_entry_clone(swp_entry_t entry, swp_entry_t *clone);
 void mts_entry_put(swp_entry_t entry);
 int mts_entry_read(swp_entry_t entry, struct page *page,
 		   struct mts_object_id *id, u8 uuid[16]);
@@ -81,6 +82,10 @@ static inline bool mts_folio_entry(struct page *page, swp_entry_t *entry)
 static inline bool mts_finish_folio(struct folio *folio) { return false; }
 static inline bool mts_install_folio_ptes(struct folio *folio) { return false; }
 static inline int mts_entry_dup(swp_entry_t entry) { return -EOPNOTSUPP; }
+static inline int mts_entry_clone(swp_entry_t entry, swp_entry_t *clone)
+{
+	return -EOPNOTSUPP;
+}
 static inline void mts_entry_put(swp_entry_t entry) { }
 static inline int mts_entry_read(swp_entry_t entry, struct page *page,
 				 struct mts_object_id *id,
diff --git a/mm/memory.c b/mm/memory.c
index d082f15..737bc0f 100644
--- a/mm/memory.c
+++ b/mm/memory.c
@@ -955,8 +955,25 @@ copy_nonpresent_pte(struct mm_struct *dst_mm, struct mm_struct *src_mm,
 	struct page *page;
 
 	if (softleaf_is_mts(entry)) {
-		if (mts_entry_dup(entry) < 0)
+		int err = mts_entry_dup(entry);
+
+		if (err == -EOVERFLOW) {
+			swp_entry_t clone;
+
+			if (mts_entry_clone(entry, &clone))
+				return -EIO;
+			pte = swp_entry_to_pte(clone);
+			pte = pte_swp_mkexclusive(pte);
+			if (pte_swp_soft_dirty(orig_pte))
+				pte = pte_swp_mksoft_dirty(pte);
+			if (pte_swp_uffd_wp(orig_pte))
+				pte = pte_swp_mkuffd_wp(pte);
+		} else if (err) {
 			return -EIO;
+		} else if (pte_swp_exclusive(orig_pte)) {
+			pte = pte_swp_clear_exclusive(orig_pte);
+			set_pte_at(src_mm, addr, src_pte, pte);
+		}
 		rss[MM_SWAPENTS]++;
 	} else if (likely(softleaf_is_swap(entry))) {
 		if (swap_dup_entry_direct(entry) < 0)
diff --git a/mm/mts_tier.c b/mm/mts_tier.c
index 350b6fc..59d78da 100644
--- a/mm/mts_tier.c
+++ b/mm/mts_tier.c
@@ -184,6 +184,10 @@ static int mts_allocate_object(struct mts_tier *tier,
 		object = xa_load(&tier->objects, slot);
 		if (!object || object->refs || object->retired)
 			continue;
+		if (object->generation == U32_MAX) {
+			object->retired = true;
+			continue;
+		}
 		goto found;
 	}
 	if ((u64)tier->next_slot * PAGE_SIZE >= tier->desc.capacity_bytes) {
@@ -205,12 +209,6 @@ static int mts_allocate_object(struct mts_tier *tier,
 
 found:
 	mutex_lock(&object->lock);
-	if (object->generation == U32_MAX) {
-		object->retired = true;
-		err = -EOVERFLOW;
-		mutex_unlock(&object->lock);
-		goto out_unlock;
-	}
 	object->generation++;
 	object->refs = 1;
 	object->frozen = false;
@@ -595,6 +593,84 @@ unlock:
 }
 EXPORT_SYMBOL_GPL(mts_entry_dup);
 
+int mts_entry_clone(swp_entry_t entry, swp_entry_t *clone)
+{
+	struct mts_pte_object *source;
+	struct mts_pte_object *copy;
+	struct mts_object *source_object;
+	struct mts_object *copy_object;
+	struct page *page;
+	u32 checksum;
+	u32 cookie;
+	int err = -ESTALE;
+
+	page = alloc_page(GFP_HIGHUSER_MOVABLE);
+	if (!page)
+		return -ENOMEM;
+	mutex_lock(&mts_pte_lock);
+	source = xa_load(&mts_pte_objects, swp_offset(entry));
+	if (source)
+		kref_get(&source->kref);
+	mutex_unlock(&mts_pte_lock);
+	if (!source)
+		goto free_page;
+
+	mutex_lock(&source->tier->lock);
+	source_object = mts_object_lookup(source->tier, &source->id);
+	if (IS_ERR(source_object)) {
+		err = PTR_ERR(source_object);
+		mutex_unlock(&source->tier->lock);
+		goto put_source;
+	}
+	mutex_lock(&source_object->lock);
+	checksum = source_object->checksum;
+	mutex_unlock(&source->tier->lock);
+	err = mts_provider_read(source->tier, source->id.slot, page, checksum);
+	mutex_unlock(&source_object->lock);
+	if (err)
+		goto put_source;
+
+	copy = kzalloc_obj(*copy);
+	if (!copy) {
+		err = -ENOMEM;
+		goto put_source;
+	}
+	kref_init(&copy->kref);
+	kref_get(&source->tier->kref);
+	copy->tier = source->tier;
+	err = mts_allocate_object(copy->tier, &copy->id, &copy_object);
+	if (err)
+		goto put_copy;
+	err = mts_provider_write(copy->tier, copy->id.slot, page,
+				 &copy_object->checksum);
+	if (err)
+		goto put_copy_object;
+	copy->pte_refs = 1;
+	mutex_lock(&mts_pte_lock);
+	err = xa_alloc(&mts_pte_objects, &cookie, copy,
+		       XA_LIMIT(1, U32_MAX), GFP_KERNEL);
+	if (!err) {
+		copy->cookie = cookie;
+		*clone = swp_entry(SWP_MTS, cookie);
+	}
+	mutex_unlock(&mts_pte_lock);
+	if (!err)
+		goto put_source;
+
+put_copy_object:
+	mutex_lock(&copy->tier->lock);
+	mts_object_put_ref_locked(copy->tier, &copy->id);
+	mutex_unlock(&copy->tier->lock);
+put_copy:
+	kref_put(&copy->kref, mts_pte_object_release);
+put_source:
+	kref_put(&source->kref, mts_pte_object_release);
+free_page:
+	__free_page(page);
+	return err;
+}
+EXPORT_SYMBOL_GPL(mts_entry_clone);
+
 void mts_entry_put(swp_entry_t entry)
 {
 	struct mts_pte_object *pte_object;
@@ -672,6 +748,17 @@ static int mts_validate_registration(const struct mts_register_tier_v2 *request)
 	return 0;
 }
 
+static bool mts_uuid_exists_locked(const u8 uuid[MTS_UUID_BYTES])
+{
+	struct mts_tier *tier;
+	unsigned long index;
+
+	xa_for_each(&mts_tiers, index, tier)
+		if (!memcmp(uuid, tier->desc.uuid, MTS_UUID_BYTES))
+			return true;
+	return false;
+}
+
 static bool mts_domain_uses_tier(const struct mts_domain *domain,
 				 const struct mts_tier *tier)
 {
@@ -1046,7 +1133,10 @@ static long mts_control_ioctl(struct file *file, unsigned int command,
 	}
 	tier->slot = slot;
 	mutex_lock(&mts_registry_lock);
-	err = xa_err(xa_store(&mts_tiers, slot, tier, GFP_KERNEL));
+	if (mts_uuid_exists_locked(tier->desc.uuid))
+		err = -EEXIST;
+	else
+		err = xa_err(xa_store(&mts_tiers, slot, tier, GFP_KERNEL));
 	mutex_unlock(&mts_registry_lock);
 	if (err)
 		goto free_slot;

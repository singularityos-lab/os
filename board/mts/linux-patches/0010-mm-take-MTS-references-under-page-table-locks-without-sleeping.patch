+static struct mts_object *mts_object_lock_io(struct mts_tier *tier,
+					     const struct mts_object_id *id,
+					     u32 *checksum)
+{
+	struct mts_object *object;
+
+	spin_lock(&tier->lock);
+	object = mts_object_lookup(tier, id);
+	spin_unlock(&tier->lock);
+	if (IS_ERR(object))
+		return object;
+	mutex_lock(&object->lock);
+	spin_lock(&tier->lock);
+	if (mts_object_lookup(tier, id) != object) {
+		spin_unlock(&tier->lock);
+		mutex_unlock(&object->lock);
+		return ERR_PTR(-ESTALE);
+	}
+	*checksum = object->checksum;
+	spin_unlock(&tier->lock);
+	return object;
+}

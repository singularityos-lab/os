BR2_x86_64=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_TARGET_GENERIC_HOSTNAME="sinty"
BR2_TARGET_GENERIC_ISSUE="Sinty OS 1.0 (Event Horizon)"
BR2_INIT_NONE=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_ROOTFS_MERGED_USR=y
BR2_ROOTFS_MERGED_BIN=y
BR2_ENABLE_LOCALE_WHITELIST="C en_US it_IT es_ES fr_FR de_DE pt_BR"

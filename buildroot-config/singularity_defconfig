BR2_ROOTFS_USERS_TABLES="$(BR2_EXTERNAL_SINGULARITY_PATH)/board/users.txt"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_SINGULARITY_PATH)/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_SINGULARITY_PATH)/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_SINGULARITY_PATH)/scripts/post-image.sh"
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="7.1.3"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_SINGULARITY_PATH)/buildroot-config/kernel.config"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_SINGULARITY_PATH)/board/mts/linux-mts.fragment"
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_SINGULARITY_PATH)/board/mts/linux-patches"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_PACKAGE_ATOM_FIRSTBOOT=y
BR2_PACKAGE_PAM_RUNDIR=y
BR2_PACKAGE_MTS=y
# Toolchain kernel-headers are pinned to 6.19 (the newest Buildroot 2026.02.2
# knows) instead of tracking the 7.1.3 kernel image: Buildroot has no
# headers-version mapping for 7.1.x, so AS_KERNEL leaves BR2_TOOLCHAIN_HEADERS_AT_LEAST
# at the 2.6 floor and check-kernel-headers.sh aborts ("expected 2.6.x, got 7.1.x").
# 6.19 userspace headers run fine on a 7.1.3 kernel (backward compatible).
BR2_KERNEL_HEADERS_6_19=y

config BR2_PACKAGE_SINGULARITY_TASKS
	bool "singularity-tasks"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBPEAS2
	help
	  Singularity Tasks: plan what to do today and later.

	  https://github.com/singularityos-lab/singularity-tasks

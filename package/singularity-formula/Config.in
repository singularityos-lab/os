config BR2_PACKAGE_SINGULARITY_FORMULA
	bool "singularity-formula"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_FREETYPE
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_HARFBUZZ
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_ZLIB
	help
	  Singularity Formula: write equations for documents, slides and the web.

	  https://github.com/singularityos-lab/singularity-formula

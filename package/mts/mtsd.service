[Unit]
Description=Memory Tiering Standard manager (mtsd)
Documentation=man:mts.conf(5)
After=local-fs.target
# Start once the system is up; MTS enforce tiering is experimental, so keep it
# off the critical early-boot path. A failure restarts mtsd, it never hangs boot.

[Service]
Type=simple
ExecStartPre=/usr/libexec/mts-prepare
ExecStart=/bin/sh -c 'if [ -f /var/lib/mts/mts.conf ]; then exec /usr/sbin/mtsd run /var/lib/mts/mts.conf; fi; exec /usr/sbin/mtsd run /etc/mts/mts.conf'
Restart=on-failure
RestartSec=3s

[Install]
WantedBy=graphical.target

config BR2_PACKAGE_SINTY_VENDOR_FIRMWARE
	bool "sinty-vendor-firmware"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	help
	  Installs the firmware a device profile takes from the Android
	  vendor partition still on the device, such as the Wi-Fi, audio
	  and amplifier firmware of a Pixel, read through a read-only
	  mapping of its super partition.

	  https://github.com/singularityos-lab/sinty-devices

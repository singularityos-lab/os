config BR2_PACKAGE_SINGULARITY_HELP
	bool "singularity-help"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_PANGO
	help
	  Singularity Help: guides for the desktop, your apps and your system.

	  https://github.com/singularityos-lab/singularity-help

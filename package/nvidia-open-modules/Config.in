config BR2_PACKAGE_NVIDIA_OPEN_MODULES
	bool "nvidia-open-modules"
	depends on BR2_LINUX_KERNEL
	depends on BR2_x86_64
	help
	  NVIDIA open GPU kernel modules for Turing and newer GPUs,
	  built against the shipped kernel so the build signs them.
	  They only load when the NVIDIA driver bundle of the same
	  version provides the user space libraries and the GSP
	  firmware.

	  https://github.com/NVIDIA/open-gpu-kernel-modules

comment "nvidia-open-modules needs a Linux kernel to be built"
	depends on BR2_x86_64
	depends on !BR2_LINUX_KERNEL

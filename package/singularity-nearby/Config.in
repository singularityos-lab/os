config BR2_PACKAGE_SINGULARITY_NEARBY
	bool "singularity-nearby"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_GNUTLS
	help
	  Singularity Nearby: discovery and pairing of nearby devices.

	  https://github.com/singularityos-lab/singularity-nearby

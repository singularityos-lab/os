config BR2_PACKAGE_SINTY_NMD
	bool "sinty-nmd"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	help
	  sinty-nmd: the Sinty OS network manager daemon, built from the
	  sinty-nm sources against the Sinty system core. Installs
	  /usr/bin/sinty-nmd.

	  https://github.com/singularityos-lab/sinty-nm

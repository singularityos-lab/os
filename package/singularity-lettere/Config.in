config BR2_PACKAGE_SINGULARITY_LETTERE
	bool "singularity-lettere"
	depends on BR2_PACKAGE_LIBGTK4
	depends on BR2_PACKAGE_WEBKITGTK || BR2_PACKAGE_WEBKITGTK_PREBUILT
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_GSTREAMER1
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBSECRET
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_POPPLER
	select BR2_PACKAGE_SQLITE
	help
	  Singularity Lettere: read and write email.

	  https://github.com/singularityos-lab/singularity-lettere

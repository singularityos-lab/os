diff --git a/backend/wayland/output.c b/backend/wayland/output.c
index fb4d1f91..d57f6769 100644
--- a/backend/wayland/output.c
+++ b/backend/wayland/output.c
@@ -22,6 +22,7 @@
 
 #include "linux-dmabuf-v1-client-protocol.h"
 #include "linux-drm-syncobj-v1-client-protocol.h"
+#include "pointer-constraints-unstable-v1-client-protocol.h"
 #include "presentation-time-client-protocol.h"
 #include "viewporter-client-protocol.h"
 #include "xdg-activation-v1-client-protocol.h"
@@ -1272,3 +1273,42 @@ struct wl_surface *wlr_wl_output_get_surface(struct wlr_output *output) {
 	struct wlr_wl_output *wl_output = get_wl_output_from_output(output);
 	return wl_output->surface;
 }
+
+void wlr_wl_output_lock_pointer(struct wlr_output *output, bool locked) {
+	struct wlr_wl_output *wl_output = get_wl_output_from_output(output);
+	struct wlr_wl_backend *backend = wl_output->backend;
+	struct wlr_wl_seat *seat;
+	wl_list_for_each(seat, &backend->seats, link) {
+		if (seat->locked_pointer != NULL) {
+			zwp_locked_pointer_v1_destroy(seat->locked_pointer);
+			seat->locked_pointer = NULL;
+		}
+		if (locked && backend->zwp_pointer_constraints_v1 != NULL &&
+				seat->wl_pointer != NULL) {
+			seat->locked_pointer = zwp_pointer_constraints_v1_lock_pointer(
+				backend->zwp_pointer_constraints_v1, wl_output->surface,
+				seat->wl_pointer, NULL,
+				ZWP_POINTER_CONSTRAINTS_V1_LIFETIME_PERSISTENT);
+		}
+	}
+	wl_display_flush(backend->remote_display);
+}
+
+void wlr_wl_output_unlock_pointer_at(struct wlr_output *output,
+		double sx, double sy) {
+	struct wlr_wl_output *wl_output = get_wl_output_from_output(output);
+	struct wlr_wl_backend *backend = wl_output->backend;
+	bool hinted = false;
+	struct wlr_wl_seat *seat;
+	wl_list_for_each(seat, &backend->seats, link) {
+		if (seat->locked_pointer != NULL) {
+			zwp_locked_pointer_v1_set_cursor_position_hint(seat->locked_pointer,
+				wl_fixed_from_double(sx), wl_fixed_from_double(sy));
+			hinted = true;
+		}
+	}
+	if (hinted) {
+		wl_surface_commit(wl_output->surface);
+	}
+	wlr_wl_output_lock_pointer(output, false);
+}

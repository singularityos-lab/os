config BR2_PACKAGE_SINGULARITY_MEDIA_PLUGINS
	bool "singularity-media-plugins"
	depends on BR2_PACKAGE_LIBGTK4
	depends on BR2_PACKAGE_WEBKITGTK || BR2_PACKAGE_WEBKITGTK_PREBUILT
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBPEAS2
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_LIBXML2
	help
	  Singularity Media Plugins.

	  https://github.com/singularityos-lab/singularity-media-plugins

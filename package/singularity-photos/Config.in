config BR2_PACKAGE_SINGULARITY_PHOTOS
	bool "singularity-photos"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_LIBGPHOTO2
	select BR2_PACKAGE_WEBP
	select BR2_PACKAGE_WEBP_MUX
	select BR2_PACKAGE_TIFF
	help
	  Singularity Photos: the image viewer.

	  https://github.com/singularityos-lab/singularity-photos

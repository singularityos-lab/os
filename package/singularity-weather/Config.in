config BR2_PACKAGE_SINGULARITY_WEATHER
	bool "singularity-weather"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBSOUP3
	help
	  Singularity Weather: forecasts, sunrise and sunset for any place.

	  https://github.com/singularityos-lab/singularity-weather

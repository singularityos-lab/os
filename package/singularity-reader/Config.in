config BR2_PACKAGE_SINGULARITY_READER
	bool "singularity-reader"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_GDK_PIXBUF
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_GNUTLS
	select BR2_PACKAGE_LIBPEAS2
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_POPPLER
	select BR2_PACKAGE_ZLIB
	help
	  Singularity Reader: read, annotate and sign PDF documents.

	  https://github.com/singularityos-lab/singularity-reader

config BR2_PACKAGE_SINGULARITY_MAPS
	bool "singularity-maps"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBSOUP3
	help
	  Singularity Maps: find places and plan routes.

	  https://github.com/singularityos-lab/singularity-maps

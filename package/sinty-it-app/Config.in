config BR2_PACKAGE_SINTY_IT_APP
	bool "sinty-it-app"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBSOUP3
	help
	  Sinty IT: manage the organisation's devices from the desktop
	  with the organisation account added in Settings.

	  https://github.com/singularityos-lab/sinty-it

config BR2_PACKAGE_SINGULARITY_SPREADSHEET
	bool "singularity-spreadsheet"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_ZLIB
	help
	  Singularity Spreadsheet: work with numbers, formulas and charts.

	  https://github.com/singularityos-lab/singularity-spreadsheet

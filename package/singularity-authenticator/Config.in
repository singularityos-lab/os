config BR2_PACKAGE_SINGULARITY_AUTHENTICATOR
	bool "singularity-authenticator"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_GDK_PIXBUF
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBGCRYPT
	select BR2_PACKAGE_LIBSECRET
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_ZBAR
	help
	  Singularity Authenticator: two-factor sign-in codes for your accounts.

	  https://github.com/singularityos-lab/singularity-authenticator

config BR2_PACKAGE_SINGULARITY_NOTES
	bool "singularity-notes"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_GNUTLS
	select BR2_PACKAGE_GSTREAMER1
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBSOUP3
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_POPPLER
	select BR2_PACKAGE_ZLIB
	help
	  Singularity Notes: notebooks with pages, drawings, tables, tags and recordings, synced with your accounts.

	  https://github.com/singularityos-lab/singularity-notes

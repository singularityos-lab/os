[Unit]
Description=Sinty Debug Bridge daemon
ConditionPathExists=/var/lib/sinty-sdb/enabled
After=network.target sinty-usb-link.service
Wants=network.target sinty-usb-link.service

[Service]
Type=simple
Group=singularity-session
StateDirectory=sinty-sdb
ExecStart=/usr/bin/sdbd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

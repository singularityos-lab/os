config BR2_PACKAGE_SINTY_SDB
	bool "sinty-sdb"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
	help
	  The Sinty Debug Bridge: sdbd (daemon) and sdb (client), a
	  TLS 1.3 ed25519 bridge with reciprocal pinning that replaces
	  the USB cable for development devices.

	  The daemon is off by default. It starts only after the owner
	  enables the bridge in Settings, which creates the persistent
	  device-policy marker /var/lib/sinty-sdb/enabled. Release images
	  expose the control but carry no network listener until opt-in.

	  https://github.com/singularityos-lab/sinty-sdb

config BR2_PACKAGE_SINTY_SDB
	bool "sinty-sdb"
	depends on BR2_PACKAGE_HOST_GO_TARGET_ARCH_SUPPORTS
	depends on BR2_PACKAGE_HOST_GO_TARGET_CGO_LINKING_SUPPORTS
	help
	  The Sinty Debug Bridge: sdbd (daemon) and sdb (client), a
	  TLS 1.3 ed25519 bridge with reciprocal pinning that replaces
	  the USB cable for development devices.

	  The daemon is gated twice: it needs both a development image
	  (/etc/atom/dev.enabled) and an explicit opt-in for the bridge
	  itself (/var/lib/sinty-sdb/enabled). The two markers are kept
	  separate on purpose, so turning the bridge off cannot also
	  turn off development mode and disable its own switch. Absent
	  markers mean the bridge is off.

	  https://github.com/singularityos-lab/sinty-sdb

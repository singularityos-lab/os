config BR2_PACKAGE_SINGULARITY_BACKUPS
	bool "singularity-backups"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LIBPEAS2
	select BR2_PACKAGE_LIBSECRET
	help
	  Singularity Backups: runs scheduled backups in the background.

	  https://github.com/singularityos-lab/singularity-backups

config BR2_PACKAGE_FOTONE_PREBUILT
	bool "fotone (prebuilt)"
	depends on BR2_x86_64
	depends on BR2_PACKAGE_WEBKITGTK_PREBUILT
	help
	  Fotone web engine: WPE WebKit with the Sinty patches and the

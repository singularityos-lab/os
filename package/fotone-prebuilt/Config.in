config BR2_PACKAGE_FOTONE_PREBUILT
	bool "fotone (prebuilt)"
	depends on BR2_x86_64 || BR2_aarch64
	depends on BR2_PACKAGE_WEBKITGTK_PREBUILT || BR2_PACKAGE_WEBKITGTK
	depends on !BR2_PACKAGE_FOTONE
	select BR2_PACKAGE_DAV1D
	select BR2_PACKAGE_LIBJXL
	select BR2_PACKAGE_HOST_PATCHELF
	select BR2_PACKAGE_AT_SPI2_CORE if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_ENCHANT if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_EXPAT if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_FONTCONFIG if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_FREETYPE if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_GNUTLS if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_GSTREAMER1 if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_GST1_PLUGINS_BASE if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL if BR2_PACKAGE_HAS_LIBEGL && BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_GST1_PLUGINS_BAD if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_HARFBUZZ if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_ICU if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_JPEG if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LCMS2 if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBAVIF if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBDRM if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBEPOXY if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBGCRYPT if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBINPUT if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBPNG if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBSECRET if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBSOUP3 if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBTASN1 if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBXKBCOMMON if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBXML2 if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_LIBXSLT if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_SQLITE if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_WAYLAND if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_WAYLAND_PROTOCOLS if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_WEBP if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_WEBP_DEMUX if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_WEBP_MUX if BR2_PACKAGE_WEBKITGTK
	select BR2_PACKAGE_WOFF2 if BR2_PACKAGE_WEBKITGTK
	help
	  Fotone web engine: WPE WebKit with the Sinty patches and the
	  WebKitGTK compatible libraries that apps load in its place.

	  https://github.com/singularityos-lab/fotone

config BR2_PACKAGE_SINGULARITY_PHONE
	bool "singularity-phone"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	help
	  Singularity Phone: voice calls through ModemManager.

	  https://github.com/singularityos-lab/singularity-phone

config BR2_PACKAGE_POWER_PROFILES_DAEMON
	bool "power-profiles-daemon"
	depends on BR2_USE_WCHAR # libglib2
	depends on BR2_TOOLCHAIN_HAS_THREADS # libglib2
	depends on BR2_USE_MMU # libglib2
	depends on BR2_PACKAGE_HAS_UDEV # libgudev
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBGUDEV
	help
	  power-profiles-daemon offers to modify system behaviour
	  based upon user-selected power profiles (power-saver,
	  balanced, performance) over the net.hadess.PowerProfiles
	  D-Bus interface, driving intel_pstate EPP and ACPI
	  platform_profile backends.

	  https://gitlab.freedesktop.org/upower/power-profiles-daemon

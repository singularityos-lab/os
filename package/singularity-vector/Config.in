config BR2_PACKAGE_SINGULARITY_VECTOR
	bool "singularity-vector"
	depends on BR2_PACKAGE_LIBGTK4
	select BR2_PACKAGE_SINGULARITY_DRAW
	select BR2_PACKAGE_LIBSINGULARITY
	select BR2_PACKAGE_LIBGEE
	select BR2_PACKAGE_JSON_GLIB
	select BR2_PACKAGE_LCMS2
	select BR2_PACKAGE_LIBPEAS2
	select BR2_PACKAGE_TIFF
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_ZLIB
	help
	  Singularity Vector: create illustrations, icons, and scalable graphics.

	  https://github.com/singularityos-lab/singularity-vector

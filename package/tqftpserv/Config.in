config BR2_PACKAGE_TQFTPSERV
	bool "tqftpserv"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_QRTR
	help
	  TFTP server over the Qualcomm IPC Router. The modem fetches
	  its runtime firmware files, such as the wifi firmware, from
	  it.

	  https://github.com/linux-msm/tqftpserv

comment "tqftpserv needs a toolchain w/ threads"
	depends on !BR2_TOOLCHAIN_HAS_THREADS

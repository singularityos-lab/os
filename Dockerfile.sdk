# Singularity OS SDK image.
#
# Wraps the buildroot SDK (the cross toolchain plus the target staging sysroot)
# as a reusable build environment. Every component CI (sinit, sinty-nm,
# sinty-sdb, ...) runs inside this image and cross-builds against the SAME
# toolchain and libraries the OS itself uses, so a release binary is bit-for-bit
# what the image would build. No component ever needs the buildroot tree or a
# host Go; they get /opt/sdk.
#
# The tarball is produced by .github/workflows/sdk.yml on the runner, reusing the
# buildroot caches the main build fills, and handed here as the whole build
# context. Compiling it in this Dockerfile instead meant building `world` from a
# cold tree inside the image, which does not fit a runner's 6h job limit.

FROM debian:trixie-slim
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
	bash build-essential ca-certificates file git rsync python3 \
	&& rm -rf /var/lib/apt/lists/*

# Unpack the SDK to /opt/sdk and relocate it to that prefix.
COPY sdk.tar.gz /tmp/sdk.tar.gz
RUN mkdir -p /opt/sdk \
	&& tar xf /tmp/sdk.tar.gz -C /opt/sdk --strip-components=1 \
	&& rm /tmp/sdk.tar.gz \
	&& /opt/sdk/relocate-sdk.sh

# The cross toolchain (and the bundled Go) live in /opt/sdk/bin. A component CI
# builds with, for example:
#   go build -trimpath -o out/binary ./cmd/binary
# using the SDK Go and CC=/opt/sdk/bin/*-linux-*-gcc for cgo packages.
ENV PATH=/opt/sdk/bin:$PATH
ENV SDK_DIR=/opt/sdk

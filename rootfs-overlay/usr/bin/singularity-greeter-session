#!/bin/sh
. /usr/bin/singularity-session-common

export XDG_RUNTIME_DIR=/run/user/102 HOME=/run/user/102
export XDG_CACHE_HOME=/run/user/102/.cache XDG_CONFIG_HOME=/run/user/102/.config
sscommon_xdg_dirs
sscommon_locale
sscommon_softrender_backstop

mkdir -p /run/singularity; rm -f /run/singularity/greeter-ready 2>/dev/null
sscommon_wait_splash 50
sscommon_mark_greeter_ready
sleep 0.3
: > /run/singularity/compositor-taking-over 2>/dev/null || true

sscommon_exec_labwc -C /usr/share/singularity/labwc-locked -s /usr/bin/singularity-greeter-startup

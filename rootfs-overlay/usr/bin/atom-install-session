#!/bin/sh
set -eu

. /usr/bin/singularity-session-common

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
export HOME="$XDG_RUNTIME_DIR"
sscommon_xdg_dirs

command -v singularity-render-setup >/dev/null 2>&1 && singularity-render-setup 2>/dev/null || true
if [ -r /etc/environment ]; then set -a; . /etc/environment; set +a; fi
sscommon_softrender_backstop

sscommon_mark_greeter_ready chmod
export LIBSEAT_BACKEND=builtin
sscommon_log "LIBSEAT_BACKEND=builtin (installer only: seatd may be absent at install time)"

sscommon_exec_labwc -s "atom-installer-launch"

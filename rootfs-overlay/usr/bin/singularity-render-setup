#!/bin/sh
hwdrv() {
    case "$1" in
        i915|xe|amdgpu|radeon|nouveau|nova*|msm|panfrost|panthor|v3d|lima|etnaviv|tegra) return 0 ;;
    esac
    return 1
}
gpus=""
for p in /sys/bus/pci/devices/*; do
    case "$(cat "$p/class" 2>/dev/null)" in
        0x03*) gpus="$gpus $p" ;;
    esac
done
hw=0
i=0
while :; do
    pending=0
    for p in $gpus; do
        if [ -e "$p/driver" ] && ls "$p"/drm/card[0-9]* >/dev/null 2>&1; then
            hwdrv "$(basename "$(readlink "$p/driver")")" && hw=1
        else
            pending=1
        fi
    done
    for c in /sys/class/drm/card[0-9]*; do
        [ -e "$c/device/uevent" ] || continue
        hwdrv "$(sed -n 's/^DRIVER=//p' "$c/device/uevent")" && hw=1
    done
    [ "$hw" = 1 ] || [ "$pending" = 0 ] || [ "$i" -ge 150 ] && break
    sleep 0.1
    i=$((i + 1))
done
if [ "$hw" = 0 ] && ! grep -q '^WLR_RENDERER=pixman$' /etc/environment 2>/dev/null; then
    {
        echo "GSK_RENDERER=cairo"
        echo "WLR_RENDERER=pixman"
        echo "WLR_RENDERER_ALLOW_SOFTWARE=1"
        echo "LIBGL_ALWAYS_SOFTWARE=1"
        echo "GALLIUM_DRIVER=llvmpipe"
    } >> /etc/environment
fi

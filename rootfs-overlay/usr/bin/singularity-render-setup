#!/bin/sh
hwdrv() {
    case "$1" in
        i915|xe|amdgpu|radeon|nouveau|nova*|msm*|panfrost|panthor|v3d|lima|etnaviv|tegra*|nvidia*) return 0 ;;
    esac
    return 1
}
gpus=""
for p in /sys/bus/pci/devices/*; do
    case "$(cat "$p/class" 2>/dev/null)" in
        0x03*) gpus="$gpus $p" ;;
    esac
done
hw=0
i=0
while :; do
    pending=0
    for p in $gpus; do
        if [ -e "$p/driver" ] && ls "$p"/drm/card[0-9]* >/dev/null 2>&1; then
            hwdrv "$(basename "$(readlink "$p/driver")")" && hw=1
        else
            pending=1
        fi
    done
    for c in /sys/class/drm/card[0-9]*; do
        [ -e "$c/device/uevent" ] || continue
        hwdrv "$(sed -n 's/^DRIVER=//p' "$c/device/uevent")" && hw=1
    done
    [ "$hw" = 1 ] || [ "$pending" = 0 ] || [ "$i" -ge 150 ] && break
    sleep 0.1
    i=$((i + 1))
done
env=/etc/environment
if [ -f "$env" ] && grep -qxE 'GSK_RENDERER=cairo|WLR_RENDERER=pixman|LIBGL_ALWAYS_SOFTWARE=1|GALLIUM_DRIVER=llvmpipe' "$env"; then
    grep -vxE 'GSK_RENDERER=cairo|WLR_RENDERER=pixman|LIBGL_ALWAYS_SOFTWARE=1|GALLIUM_DRIVER=llvmpipe' "$env" > "$env.new"
    chmod 644 "$env.new"
    mv -f "$env.new" "$env"
fi
if [ "$hw" = 0 ]; then
    {
        echo "GSK_RENDERER=cairo"
        echo "WLR_RENDERER=pixman"
        echo "LIBGL_ALWAYS_SOFTWARE=1"
        echo "GALLIUM_DRIVER=llvmpipe"
    } >> "$env"
fi

#!/bin/sh
# labwc runs this as its startup command, so it is the first thing inside the
# greeter's Wayland session. The splash is a layer-shell client: starting it here
# means labwc's first composite already carries the logo instead of black, which
# is what covers the compositor's cold start until the greeter itself paints.
[ -x /usr/bin/singularity-splash ] && /usr/bin/singularity-splash >/dev/null 2>&1 &
exec /usr/bin/singularity-greeter "$@"

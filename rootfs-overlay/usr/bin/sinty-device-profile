#!/bin/sh
set -u
DEVICES=/usr/share/sinty/devices

profiles() {
	[ -r /proc/device-tree/compatible ] || return 0
	tr '\0' '\n' < /proc/device-tree/compatible | while read -r c; do
		[ -n "$c" ] && [ -d "$DEVICES/$c" ] && echo "$DEVICES/$c"
	done
}

apply() {
	for p in $(profiles); do
		name="$(basename "$p")"
		if [ -f "$p/modprobe.conf" ]; then
			mkdir -p /run/modprobe.d
			cp "$p/modprobe.conf" "/run/modprobe.d/50-$name.conf"
		fi
		if [ -f "$p/udev.rules" ]; then
			mkdir -p /run/udev/rules.d
			cp "$p/udev.rules" "/run/udev/rules.d/60-$name.rules"
		fi
		echo "device profile $name applied"
	done
}

setup() {
	for p in $(profiles); do
		[ -x "$p/setup" ] || continue
		echo "device profile $(basename "$p"): running setup"
		"$p/setup" || echo "device profile $(basename "$p"): setup failed ($?)"
	done
}

case "${1:-}" in
apply) apply ;;
setup) setup ;;
*) echo "usage: sinty-device-profile apply|setup" >&2; exit 2 ;;
esac

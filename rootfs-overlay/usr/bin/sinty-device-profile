#!/bin/sh
set -u
DEVICES=/usr/share/sinty/devices

profiles() {
	[ -r /proc/device-tree/compatible ] || return 0
	tr '\0' '\n' < /proc/device-tree/compatible | while read -r c; do
		[ -n "$c" ] && [ -d "$DEVICES/$c" ] && echo "$DEVICES/$c"
	done
}

link_dir() {
	src="$1"
	dst="$2"
	mkdir -p "$dst"
	for f in "$dst"/sinty-profile-*.json; do
		[ -L "$f" ] && rm -f "$f"
	done
	for p in $(profiles); do
		for j in "$p/$src"/*.json; do
			[ -f "$j" ] && ln -sf "$j" "$dst/sinty-profile-$(basename "$j")"
		done
	done
}

apply() {
	link_dir egl_vendor.d /etc/glvnd/egl_vendor.d
	link_dir vulkan/icd.d /etc/vulkan/icd.d
	for p in $(profiles); do
		name="$(basename "$p")"
		if [ -f "$p/modprobe.conf" ]; then
			mkdir -p /run/modprobe.d
			cp "$p/modprobe.conf" "/run/modprobe.d/50-$name.conf"
		fi
		if [ -f "$p/modem.conf" ]; then
			mkdir -p /run/sinty
			cp "$p/modem.conf" /run/sinty/modem.conf
		fi
		if [ -f "$p/udev.rules" ]; then
			mkdir -p /run/udev/rules.d
			cp "$p/udev.rules" "/run/udev/rules.d/60-$name.rules"
		fi
		echo "device profile $name applied"
	done
}

setup() {
	for p in $(profiles); do
		[ -x "$p/setup" ] || continue
		echo "device profile $(basename "$p"): running setup"
		"$p/setup" || echo "device profile $(basename "$p"): setup failed ($?)"
	done
}

late() {
	scripts=
	for p in $(profiles); do
		[ -x "$p/late" ] && scripts="$scripts $p"
	done
	[ -n "$scripts" ] || return 0
	sleep "${SINTY_DEVICE_LATE_DELAY:-40}"
	for p in $scripts; do
		echo "device profile $(basename "$p"): running late setup"
		"$p/late" || echo "device profile $(basename "$p"): late setup failed ($?)"
	done
}

case "${1:-}" in
apply) apply ;;
setup) setup ;;
late) late ;;
*) echo "usage: sinty-device-profile apply|setup|late" >&2; exit 2 ;;
esac

#!/bin/sh
# Continuously mirror this boot's logs to a removable SINTYLOGS partition (the test
# USB), so the full early+late boot (and the post-install boot, as long as the USB
# stays plugged) can be read back off-device. One file per boot_id.
DEV=""
i=0
while [ "$i" -lt 40 ]; do
    DEV="$(blkid -L SINTYLOGS 2>/dev/null || true)"
    [ -n "$DEV" ] && break
    i=$((i + 1)); sleep 1
done
[ -n "$DEV" ] || exit 0
M=/run/sintylogs
mkdir -p "$M"
mount "$DEV" "$M" 2>/dev/null || exit 0
BOOT="$(tr -d '-' < /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)"
OUT="$M/boot-$BOOT.log"
if [ -f "$M/SINTYRESCUE.txt" ]; then
    cp "$M/SINTYRESCUE.txt" "$M/rescue-$BOOT.txt" 2>/dev/null && chmod 0644 "$M/rescue-$BOOT.txt"
fi
if grep -qw sing.live=1 /proc/cmdline 2>/dev/null; then
    I=/run/sintyinst
    {
        echo "===== INSTALLED DISK  uptime=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)s ====="
        lsblk -o NAME,SIZE,TYPE,FSTYPE,PARTLABEL,LABEL,MOUNTPOINTS 2>/dev/null
        echo "-- mounts --"; grep -E '^/dev/' /proc/mounts 2>/dev/null
        pdisk() { basename "$(readlink -f "/sys/class/block/${1##*/}/..")"; }
        LOGDISK="$(pdisk "$DEV")"
        for lab in esp atom-data; do
            d=""
            for c in $(lsblk -nrpo NAME,PARTLABEL 2>/dev/null | awk -v l="$lab" 'tolower($2) == l { print $1 }'); do
                [ "$(pdisk "$c")" = "$LOGDISK" ] && continue
                d="$c"; break
            done
            echo "-- $lab: ${d:-absent} --"
            [ -b "$d" ] || continue
            mkdir -p "$I/$lab"
            if mount -o ro "$d" "$I/$lab" 2>&1 || mount -o ro,norecovery "$d" "$I/$lab" 2>&1; then
                echo "mounted $d on $I/$lab: $(grep " $I/$lab " /proc/mounts)"
            fi
        done
        if mountpoint -q "$I/esp"; then
            ls -lR "$I/esp/EFI" 2>/dev/null | head -80
            for f in "$I"/esp/EFI/atom/boot-state "$I"/esp/EFI/atom/deployment.json "$I"/esp/EFI/atom/state/*; do
                [ -f "$f" ] || continue
                echo "== ${f#"$I"/esp/} =="; cat "$f" 2>/dev/null
            done
        fi
        if mountpoint -q "$I/atom-data"; then
            ls -la "$I/atom-data" "$I/atom-data/boot" "$I/atom-data/boot/rootfs" 2>&1
            df -h "$I/atom-data" 2>/dev/null
            find "$I/atom-data" -maxdepth 4 \( -name messages -o -name '*.log' -o -name boot-state \) -type f 2>/dev/null | head -20 |
            while read -r f; do
                echo "== $f =="; tail -n 300 "$f" 2>/dev/null
            done
        fi
        for lab in esp atom-data; do
            umount "$I/$lab" 2>/dev/null || true
        done
    } > "$M/installed-$BOOT.log" 2>&1
    sync
fi
while :; do
    {
        echo "===== SINTY LOGCOLLECT  uptime=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)s ====="
        echo "### /proc/cmdline"; cat /proc/cmdline 2>/dev/null
        echo; echo "### hostname / os-release"; cat /etc/hostname /etc/os-release 2>/dev/null
        echo; echo "### failed units"; systemctl --failed --no-legend --no-pager 2>/dev/null || echo "(systemctl n/a under sinit)"
        echo; echo "### input udev tags"
        for e in /dev/input/event*; do
            [ -e "$e" ] || continue
            echo "== $e =="
            udevadm info --query=property --name="$e" 2>/dev/null | grep -iE "ID_INPUT|ID_SEAT|^NAME="
        done
        echo; echo "### session logs"
        for f in /root/.local/state/singularity/*.log /home/*/.local/state/singularity/*.log; do
            [ -f "$f" ] || continue
            echo "== $f =="; tail -n 300 "$f"
        done
        echo; echo "### runtime logs"
        for f in /run/singularity/*.log /run/user/*/*.log /run/atom/boot.log /var/log/messages; do
            [ -f "$f" ] || continue
            echo "== $f =="; tail -n 300 "$f"
        done
        echo; echo "### environment"; cat /etc/environment 2>/dev/null
        echo; echo "### drm"
        ls -l /dev/dri 2>/dev/null
        for c in /sys/class/drm/card*; do
            echo "$c $(sed -n 's/^DRIVER=//p' "$c/device/uevent" 2>/dev/null) $(cat "$c/status" 2>/dev/null) boot_vga=$(cat "$c/device/boot_vga" 2>/dev/null)"
        done
        echo; echo "### processes"
        ps -eo pid,ppid,user,stat,etime,pcpu,rss,args 2>/dev/null || ps 2>/dev/null
        echo; echo "### NETWORK/WIFI DIAG"
        echo "-- ip link --"; ip link 2>/dev/null
        echo "-- ip addr --"; ip addr 2>/dev/null
        echo "-- /sys/class/net --"; ls /sys/class/net 2>/dev/null
        echo "-- /sys/class/ieee80211 (wifi PHY) --"; ls -l /sys/class/ieee80211/ 2>/dev/null
        echo "-- lspci -nnk --"; lspci -nnk 2>/dev/null
        echo "-- iwlwifi PCI uevent (exact chip id) --"; cat /sys/bus/pci/drivers/iwlwifi/0000:*/uevent 2>/dev/null
        echo "-- lsmod wifi --"; lsmod 2>/dev/null | grep -iE "iwl|cfg80211|mac80211|rfkill"
        echo "-- rfkill --"; rfkill list 2>/dev/null
        echo "-- lsusb --"; lsusb 2>/dev/null
        echo "-- modinfo iwlwifi firmware --"; modinfo iwlwifi 2>/dev/null | grep -i firmware
        echo "-- /lib/firmware/iwlwifi* present --"; ls -1 /lib/firmware/iwlwifi* 2>/dev/null
        echo "-- dmesg iwlwifi/firmware lines --"; dmesg 2>/dev/null | grep -iE "iwlwifi|firmware|wlan|cfg80211|rndis|cdc_ether|cdc_ncm|usb.*net"
        echo; echo "### dmesg"; dmesg 2>/dev/null
        echo; echo "### journalctl -b"; journalctl -b --no-pager 2>/dev/null || echo "(journal n/a)"
    } > "$OUT.tmp" 2>&1
    mv "$OUT.tmp" "$OUT" 2>/dev/null
    sync
    sleep 12
done

sscommon_log() {
    # Log ONLY to a file, never to stderr/tty: during the boot handoff the session
    # runs on the console before the compositor takes the display, so a stderr write
    # leaks text (e.g. "launching labwc") onto the seamless one-continuous-surface boot.
    _msg="[session-common] $*"
    _logdir="${XDG_RUNTIME_DIR:-/tmp}"
    # 2>/dev/null MUST come before >>file: redirections apply left-to-right, so if the file
    # open fails (e.g. the greeter's XDG_RUNTIME_DIR=/run/singularity is not writable by it),
    # the shell must already have stderr on /dev/null, or busybox ash prints the open error to
    # the tty before 2>/dev/null takes effect -- which would leak onto the seamless boot. The
    # log stays best-effort (|| true): no file, no message, ever, on the console.
    printf '%s %s\n' "$(date '+%H:%M:%S' 2>/dev/null || echo '--:--:--')" "$_msg" \
        2>/dev/null >>"$_logdir/session-common.log" || true
}

sscommon_xdg_dirs() {
    : "${XDG_RUNTIME_DIR:?sscommon_xdg_dirs: XDG_RUNTIME_DIR must be set by the caller}"
    mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true
    export XDG_CONFIG_HOME="$XDG_RUNTIME_DIR/.config"
    export XDG_CACHE_HOME="$XDG_RUNTIME_DIR/.cache"
    mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" 2>/dev/null || true
    case "$XDG_CACHE_HOME" in
        /run/*) sscommon_log "XDG_CACHE_HOME=$XDG_CACHE_HOME (tmpfs, stateless: prebake any needed cache into the image)";;
        *) sscommon_log "XDG_CACHE_HOME=$XDG_CACHE_HOME";;
    esac
    sscommon_log "XDG_CONFIG_HOME=$XDG_CONFIG_HOME HOME=${HOME:-unset}"
}

sscommon_locale() {
    [ -r /var/lib/singularity/vconsole.conf ] && . /var/lib/singularity/vconsole.conf
    [ -r /var/lib/singularity/locale.conf ] && . /var/lib/singularity/locale.conf
    [ -n "${XKBLAYOUT:-}" ] && export XKB_DEFAULT_LAYOUT="$XKBLAYOUT"
    [ -n "${XKBVARIANT:-}" ] && export XKB_DEFAULT_VARIANT="$XKBVARIANT"
    export LANG="${LANG:-C.UTF-8}"
    sscommon_log "locale LANG=$LANG XKB_DEFAULT_LAYOUT=${XKB_DEFAULT_LAYOUT:-unset} XKB_DEFAULT_VARIANT=${XKB_DEFAULT_VARIANT:-}"
}

sscommon_wait_splash() {
    _limit="${1:-50}"
    _i=0
    while [ ! -e /run/singularity/boot-splash-up ] && [ "$_i" -lt "$_limit" ]; do
        sleep 0.1
        _i=$((_i + 1))
    done
    if [ -e /run/singularity/boot-splash-up ]; then
        sscommon_log "boot-splash-up seen after ${_i} ticks"
    else
        sscommon_log "boot-splash-up not seen within ${_limit} ticks, proceeding"
    fi
}

sscommon_mark_greeter_ready() {
    mkdir -p /run/singularity 2>/dev/null || true
    if : >/run/singularity/greeter-ready 2>/dev/null; then
        [ "${1:-}" = chmod ] && chmod 666 /run/singularity/greeter-ready 2>/dev/null || true
        sscommon_log "greeter-ready written"
    else
        sscommon_log "greeter-ready write failed"
    fi
}

sscommon_hw_gpu_driver() {
    case "$1" in
        # DEVICE-FIX(msm): on the UNO Q the GPU driver is msm_dpu; without msm* the session forces software render
        i915|xe|amdgpu|radeon|nouveau|nova*|msm*|panfrost|panthor|v3d|lima|etnaviv) return 0 ;;
    esac
    return 1
}

sscommon_force_software() {
    export GSK_RENDERER=cairo WLR_RENDERER=pixman WLR_RENDERER_ALLOW_SOFTWARE=1
    export LIBGL_ALWAYS_SOFTWARE=1 GALLIUM_DRIVER=llvmpipe WLR_NO_HARDWARE_CURSORS=1
    if ls /dev/dri/renderD* >/dev/null 2>&1; then
        export MESA_LOADER_DRIVER_OVERRIDE=kms_swrast WLR_DRM_NO_ATOMIC=1
    fi
}

sscommon_softrender_backstop() {
    if command -v udevadm >/dev/null 2>&1; then
        udevadm settle --timeout=20 2>/dev/null || sscommon_log "udev still busy after 20 s, deciding the renderer anyway"
    fi
    _hwgpu=0
    _nvegl=0
    _rendernode=0
    for _c in /sys/class/drm/card[0-9]*/device/uevent; do
        [ -e "$_c" ] || continue
        for _r in "${_c%/uevent}"/drm/renderD*; do
            [ -e "$_r" ] && _rendernode=1
        done
        _drv="$(sed -n 's/^DRIVER=//p' "$_c")"
        case "$_drv" in
            nvidia*|tegra*) _hwgpu=1 _nvegl=1 ;;
            *) sscommon_hw_gpu_driver "$_drv" && _hwgpu=1 ;;
        esac
    done
    # DEVICE-FIX(arm64): aarch64 images ship the NVIDIA L4T EGL vendor for Jetson; without pinning Mesa, other arm GPUs pick it and labwc fails to render
    if [ "$_nvegl" = 0 ] && [ -e /usr/share/glvnd/egl_vendor.d/50_mesa.json ]; then
        export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
    fi
    if [ "$_hwgpu" = 0 ]; then
        sscommon_force_software
        sscommon_log "no HW GPU driver: forcing software render (llvmpipe/pixman/cairo)"
    else
        unset LIBGL_ALWAYS_SOFTWARE GALLIUM_DRIVER WLR_RENDERER WLR_RENDERER_ALLOW_SOFTWARE
        [ "${GSK_RENDERER:-}" = cairo ] && unset GSK_RENDERER
        sscommon_log "HW GPU driver present: native render"
    fi
}

sscommon_drm_devices() {
    _boot=""
    for _p in /sys/bus/pci/devices/*; do
        if [ "$(cat "$_p/boot_vga" 2>/dev/null)" = 1 ]; then
            _boot="$_p"
            break
        fi
    done
    _i=0
    while [ "$_i" -lt 150 ]; do
        if [ -n "$_boot" ]; then
            if ls "$_boot"/drm/card[0-9]* >/dev/null 2>&1; then break; fi
        elif ls -d /sys/class/drm/card[0-9]* >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
        _i=$((_i + 1))
    done
    _bootcard=""
    if [ -n "$_boot" ]; then
        for _c in "$_boot"/drm/card[0-9]*; do
            if [ -e "$_c" ]; then
                _bootcard="${_c##*/}"
                break
            fi
        done
    fi
    _list=""
    _add() {
        case ":$_list:" in *":/dev/dri/$1:"*) return 0 ;; esac
        _list="${_list:+$_list:}/dev/dri/$1"
    }
    _connected() {
        for _s in /sys/class/drm/"$1"-*/status; do
            case "$(cat "$_s" 2>/dev/null)" in connected|unknown) return 0 ;; esac
        done
        return 1
    }
    if [ -n "$_bootcard" ] && _connected "$_bootcard"; then _add "$_bootcard"; fi
    for _c in /sys/class/drm/card[0-9]*; do
        _n="${_c##*/}"
        case "$_n" in *-*) continue ;; esac
        case "$(sed -n 's/^DRIVER=//p' "$_c/device/uevent" 2>/dev/null)" in
            simple-framebuffer|simpledrm|efidrm|vesadrm|ofdrm) continue ;;
        esac
        if _connected "$_n"; then _add "$_n"; fi
    done
    if [ -z "$_list" ] && [ -n "$_bootcard" ]; then _add "$_bootcard"; fi
    # DEVICE-FIX(msm): on the UNO Q the GPU binds after its firmware loads, about when the compositor starts; without waiting for udev to set the node permissions labwc gets EACCES on the render node and renders in software for the whole session
    _j=0
    while [ -n "$_list" ] && [ "$_j" -lt 100 ]; do
        _ready=1
        for _d in $(printf '%s' "$_list" | tr ':' ' '); do
            { [ -r "$_d" ] && [ -w "$_d" ]; } || _ready=0
            for _r in /sys/class/drm/"${_d##*/}"/device/drm/renderD*; do
                [ -e "$_r" ] || continue
                { [ -r "/dev/dri/${_r##*/}" ] && [ -w "/dev/dri/${_r##*/}" ]; } || _ready=0
            done
        done
        [ "$_ready" = 1 ] && break
        sleep 0.1
        _j=$((_j + 1))
    done
    if [ -n "$_list" ]; then
        export WLR_DRM_DEVICES="$_list"
        sscommon_log "WLR_DRM_DEVICES=$_list (boot_vga=${_bootcard:-none} after ${_i} ticks, nodes accessible after ${_j} ticks)"
    else
        sscommon_log "no display GPU found after ${_i} ticks, letting wlroots choose"
    fi
    sscommon_render_device
    return 0
}

sscommon_render_device() {
    [ -z "${WLR_RENDER_DRM_DEVICE:-}" ] || return 0
    [ "${WLR_RENDERER:-}" != pixman ] || return 0
    for _c in /sys/class/drm/card[0-9]*; do
        case "${_c##*/}" in *-*) continue ;; esac
        ls -d "$_c"-*/status >/dev/null 2>&1 || continue
        ls -d "$_c"/device/drm/renderD* >/dev/null 2>&1 && return 0
    done
    for _r in /sys/class/drm/renderD*; do
        [ -e "$_r" ] || continue
        if sscommon_hw_gpu_driver "$(sed -n 's/^DRIVER=//p' "$_r/device/uevent" 2>/dev/null)"; then
            export WLR_RENDER_DRM_DEVICE="/dev/dri/${_r##*/}"
            sscommon_log "display has no render node, rendering on $WLR_RENDER_DRM_DEVICE"
            return 0
        fi
    done
    return 0
}

sscommon_touchscreen() {
    for _dev in /run/udev/data/c13:*; do
        grep -qs '^E:ID_INPUT_TOUCHSCREEN=1$' "$_dev" && return 0
    done
    return 1
}

sscommon_exec_labwc() {
    _labwclog="${XDG_RUNTIME_DIR:-/tmp}/labwc.log"
    if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && [ -z "${GDM_SESSION_DBUS_ADDRESS:-}" ] \
       && command -v dbus-run-session >/dev/null 2>&1; then
        sscommon_log "launching labwc under dbus-run-session: $*"
        exec dbus-run-session -- labwc "$@" 2>>"$_labwclog"
    fi
    sscommon_log "launching labwc without a new session bus: $*"
    exec labwc "$@" 2>>"$_labwclog"
}

#!/bin/sh

set -eu

MARKER=/var/lib/sinty/.oobe-done
if [ -f "${MARKER}" ]; then
    exit 0
fi

export ATOM_OOBE_APPLY=1
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/0}"
mkdir -p "${XDG_RUNTIME_DIR}"
# OOBE runs as root, whose HOME is /root on the read-only erofs. Point HOME and the
# XDG config/cache dirs at a writable tmpfs so GTK/GLib do not warn-storm trying to
# write /root/.config (glib settings, gtk accent css, etc.).
export HOME="$XDG_RUNTIME_DIR"
export XDG_CONFIG_HOME="$XDG_RUNTIME_DIR/.config"
export XDG_CACHE_HOME="$XDG_RUNTIME_DIR/.cache"
mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME"

mkdir -p /run/singularity && : > /run/singularity/greeter-ready && chmod 666 /run/singularity/greeter-ready
# Run under a session bus so the installer (GTK) does not try dbus-launch --autolaunch
# for the a11y bus and warn "Unable to acquire session bus" during the OOBE handoff.
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session -- labwc -s "atom-installer-launch --oobe"
fi
exec labwc -s "atom-installer-launch --oobe"

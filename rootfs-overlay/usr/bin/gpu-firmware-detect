#!/bin/sh
# Prints, one per line, the GPU firmware/driver add-on bundle(s) this machine needs,
# by scanning PCI display-class devices in sysfs (no lspci dependency). The updater
# feeds the output to the OTA feed to fetch the matching kernel-bound bundle.
#
#   vendor 0x10de = NVIDIA -> "nvidia"  (proprietary driver add-on, kernel-bound)
#   vendor 0x1002 = AMD     -> "amd"     (firmware add-on; also already in the base)
#
# Intel (0x8086) and anything else are covered by the base image, so nothing prints.
# SYSFS_ROOT overrides /sys for testing. Always exits 0 (absence of a GPU is not an error).
set -u
ROOT="${SYSFS_ROOT:-/sys}"
seen_nvidia=0
seen_amd=0
for d in "$ROOT"/bus/pci/devices/*/; do
	[ -d "$d" ] || continue
	cls=$(cat "$d/class" 2>/dev/null) || continue
	case "$cls" in 0x03*) ;; *) continue ;; esac   # PCI class 0x03xxxx = display controller
	ven=$(cat "$d/vendor" 2>/dev/null)
	case "$ven" in
		0x10de) seen_nvidia=1 ;;
		0x1002) seen_amd=1 ;;
	esac
done
[ "$seen_nvidia" = 1 ] && echo nvidia
[ "$seen_amd" = 1 ] && echo amd
exit 0

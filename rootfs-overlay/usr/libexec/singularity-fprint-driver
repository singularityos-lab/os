#!/bin/sh
set -eu

BASE=/var/lib/singularity/fprint
UDEV_RULES=/etc/udev/rules.d
EXTENSION_NAME=singularity-fprint-drivers
MAX_BYTES=67108864

if [ -n "${SINGULARITY_FPRINT_ROOT:-}" ] && [ "$(id -u)" -ne 0 ]; then
    BASE="$SINGULARITY_FPRINT_ROOT$BASE"
    UDEV_RULES="$SINGULARITY_FPRINT_ROOT$UDEV_RULES"
    TEST_ROOT=1
else
    TEST_ROOT=0
fi

TOD_DIR="$BASE/tod-1"
EXTENSION="$BASE/$EXTENSION_NAME"
INSTALLED="$BASE/installed"

fail() {
    echo "singularity-fprint-driver: $*" >&2
    exit 1
}

catalog() {
    DRIVER_ARCH=""
    case "$1" in
    10a5:9800)
        DRIVER_VENDOR="Fingerprint Cards (FPC)"
        DRIVER_NAME="FPC MOH fingerprint driver"
        DRIVER_VERSION="27.23.44.2"
        DRIVER_LICENSE="Proprietary, Fingerprint Cards AB"
        DRIVER_SOURCE="Ubuntu OEM driver archive (libfprint-2-tod1-fpc)"
        DRIVER_URL="https://ppa.launchpadcontent.net/libfprint-tod1-group/ppa/ubuntu/pool/main/libf/libfprint-2-tod1-fpc/libfprint-2-tod1-fpc_27.23.44.2+2404-0ubuntu1_amd64.deb"
        DRIVER_SHA256="5eea3bdfbcc84b56f8cb92d2705a647a8830a0dd13a498723b8752476d5b12d7"
        DRIVER_SIZE=1050274
        DRIVER_ARCH=x86_64
        DRIVER_FILES="
tod ./usr/lib/x86_64-linux-gnu/libfprint-2/tod-1/libfprint-2-tod1-fpc-9800-27.23.44.2.so 7d06ae4f4936b91a12b7fda9e64368b4c25c91a65d4acb990a198faf86488300
usr ./usr/lib/x86_64-linux-gnu/libfprint-tod-fpcbep-9800-27.23.44.2.so 7087b4115db8fcb5c36ea7e5d42e062958406d65d9ee82e197fb3d2c285242e2
udev ./lib/udev/rules.d/60-libfprint-2-tod1-fpc.rules 2185177b8e737d89a6ad71820bef0e2c5f85ba8d183dd434022771147242cee6
"
        ;;
    *)
        return 1
        ;;
    esac
}

check_id() {
    printf '%s' "$1" | grep -qE '^[0-9a-f]{4}:[0-9a-f]{4}$' || fail "invalid device id '$1'"
    catalog "$1" || fail "no driver is known for $1"
    [ -z "$DRIVER_ARCH" ] || [ "$(uname -m)" = "$DRIVER_ARCH" ] || fail "this driver only runs on $DRIVER_ARCH"
}

require_root() {
    [ "$TEST_ROOT" = 1 ] || [ "$(id -u)" -eq 0 ] || fail "must run as root"
}

manifest() {
    printf '%s/%s.list' "$INSTALLED" "$(printf '%s' "$1" | tr ':' '-')"
}

udev_rule() {
    printf '%s/60-singularity-fprint-%s.rules' "$UDEV_RULES" "$(printf '%s' "$1" | tr ':' '-')"
}

download() {
    if command -v curl >/dev/null 2>&1; then
        curl --proto '=https' --tlsv1.2 -fsSL --max-time 300 --max-filesize "$MAX_BYTES" -o "$2" "$1"
    elif command -v wget >/dev/null 2>&1; then
        wget -q --https-only -T 300 -O "$2" "$1"
    else
        fail "neither curl nor wget is available"
    fi
}

unpack() {
    if command -v dpkg-deb >/dev/null 2>&1; then
        dpkg-deb --fsys-tarfile "$1" > "$2/data.tar"
        return
    fi
    command -v ar >/dev/null 2>&1 || fail "cannot unpack the driver package (ar is missing)"
    member=$(ar t "$1" | grep '^data\.tar' | head -n 1)
    case "$member" in
    data.tar.zst) ar p "$1" "$member" | zstd -dc > "$2/data.tar" ;;
    data.tar.xz) ar p "$1" "$member" | xz -dc > "$2/data.tar" ;;
    data.tar.gz) ar p "$1" "$member" | gzip -dc > "$2/data.tar" ;;
    data.tar) ar p "$1" "$member" > "$2/data.tar" ;;
    *) fail "unsupported driver package format" ;;
    esac
}

place() {
    src="$1"
    dest="$2"
    mkdir -p "$(dirname "$dest")"
    cp "$src" "$dest.new"
    chmod "$3" "$dest.new"
    mv -f "$dest.new" "$dest"
    printf '%s\n' "$dest" >> "$4"
}

restart_fprintd() {
    [ "$TEST_ROOT" = 0 ] || return 0
    if command -v udevadm >/dev/null 2>&1; then
        udevadm control --reload 2>/dev/null || true
        udevadm trigger --subsystem-match=usb --attr-match=idVendor="${1%%:*}" --attr-match=idProduct="${1##*:}" 2>/dev/null || true
    fi
    if command -v systemctl >/dev/null 2>&1 && systemctl cat fprintd.service >/dev/null 2>&1; then
        systemctl try-restart fprintd.service 2>/dev/null || true
    else
        stop_fprintd_bus_owner
    fi
}

stop_fprintd_bus_owner() {
    command -v gdbus >/dev/null 2>&1 || return 0
    reply=$(gdbus call --system --dest org.freedesktop.DBus \
        --object-path /org/freedesktop/DBus \
        --method org.freedesktop.DBus.GetConnectionUnixProcessID \
        net.reactivated.Fprint 2>/dev/null) || return 0
    pid=$(printf '%s\n' "$reply" | sed -n 's/^(uint32 \([0-9][0-9]*\),)$/\1/p')
    [ -n "$pid" ] && [ "$pid" -gt 1 ] || return 0
    exe=$(readlink "/proc/$pid/exe" 2>/dev/null) || return 0
    [ "$(basename "${exe% (deleted)}")" = fprintd ] || return 0
    kill -TERM "$pid" 2>/dev/null || true
}

cmd_info() {
    check_id "$1"
    printf 'id=%s\nvendor=%s\nname=%s\nversion=%s\nlicense=%s\nsource=%s\nurl=%s\nsize=%s\n' \
        "$1" "$DRIVER_VENDOR" "$DRIVER_NAME" "$DRIVER_VERSION" "$DRIVER_LICENSE" \
        "$DRIVER_SOURCE" "$DRIVER_URL" "$DRIVER_SIZE"
    if [ -f "$(manifest "$1")" ]; then
        echo "installed=true"
    else
        echo "installed=false"
    fi
}

cmd_install() {
    check_id "$1"
    require_root
    umask 022
    mkdir -p "$BASE" "$INSTALLED" "$TOD_DIR"
    work=$(mktemp -d "$BASE/.download.XXXXXX")
    trap 'rm -rf "$work"' EXIT
    echo "Downloading $DRIVER_URL"
    download "$DRIVER_URL" "$work/package" || fail "the driver could not be downloaded"
    [ "$(wc -c < "$work/package")" -eq "$DRIVER_SIZE" ] || fail "the downloaded driver has an unexpected size"
    echo "$DRIVER_SHA256  $work/package" | sha256sum -c - >/dev/null 2>&1 || fail "the downloaded driver failed the checksum"
    unpack "$work/package" "$work"
    mkdir -p "$work/root"
    members=$(printf '%s\n' "$DRIVER_FILES" | awk 'NF == 3 { print $2 }')
    tar -xf "$work/data.tar" -C "$work/root" $members || fail "the driver package is missing expected files"
    list="$work/manifest"
    : > "$list"
    while read -r kind member sum; do
        [ -n "$kind" ] || continue
        file="$work/root/$member"
        [ -f "$file" ] && [ ! -L "$file" ] || fail "the driver package is missing $member"
        echo "$sum  $file" | sha256sum -c - >/dev/null 2>&1 || fail "$member failed the checksum"
        case "$kind" in
        tod) place "$file" "$TOD_DIR/$(basename "$member")" 0644 "$list" ;;
        usr) place "$file" "$EXTENSION/${member#./}" 0644 "$list" ;;
        udev) place "$file" "$(udev_rule "$1")" 0644 "$list" ;;
        *) fail "unknown file kind $kind" ;;
        esac
    done <<FILES
$DRIVER_FILES
FILES
    release="$EXTENSION/usr/lib/extension-release.d/extension-release.$EXTENSION_NAME"
    mkdir -p "$(dirname "$release")"
    printf 'ID=_any\n' > "$release"
    mv -f "$list" "$(manifest "$1")"
    rm -rf "$work"
    trap - EXIT
    restart_fprintd "$1"
    echo "Installed $DRIVER_NAME $DRIVER_VERSION"
}

cmd_uninstall() {
    check_id "$1"
    require_root
    list=$(manifest "$1")
    [ -f "$list" ] || fail "the driver for $1 is not installed"
    while read -r path; do
        case "$path" in
        "$BASE"/*|"$UDEV_RULES"/60-singularity-fprint-*) rm -f "$path" ;;
        esac
    done < "$list"
    rm -f "$list"
    restart_fprintd "$1"
    echo "Removed $DRIVER_NAME"
}

case "${1:-}" in
info) cmd_info "${2:-}" ;;
install) cmd_install "${2:-}" ;;
uninstall) cmd_uninstall "${2:-}" ;;
*) fail "usage: singularity-fprint-driver info|install|uninstall VENDOR:PRODUCT" ;;
esac

[Unit]
Description=D-Bus System Message Bus
Before=basic.target
After=sinty-rundir.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /run/dbus'
RuntimeDirectory=dbus
ExecStart=/usr/bin/dbus-daemon --config-file=/usr/share/dbus-1/system.conf --nofork --nopidfile --syslog-only
Restart=on-failure

[Install]
WantedBy=sysinit.target

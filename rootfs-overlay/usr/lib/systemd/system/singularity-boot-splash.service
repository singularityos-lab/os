[Unit]
Description=Singularity boot splash
DefaultDependencies=no
Wants=systemd-udevd.service modules-load.service
After=systemd-udevd.service modules-load.service
Before=greetd.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/bin/sh -c 'exec /usr/bin/singularity-boot-splash --max-life 8 >/run/boot-splash.log 2>&1'
StandardOutput=journal
StandardError=journal
KillMode=mixed

[Install]
WantedBy=sysinit.target

[Unit]
Description=Singularity boot splash
DefaultDependencies=no
After=sinty-devd.service sinty-logind.service
Wants=sinty-logind.service

[Service]
Type=simple
ExecStart=/usr/bin/singularity-boot-splash-launch
Restart=no
StandardOutput=journal
StandardError=journal
KillMode=mixed

[Install]
WantedBy=sysinit.target

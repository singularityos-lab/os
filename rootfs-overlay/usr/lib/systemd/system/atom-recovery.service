[Unit]
Description=Sinty recovery agent (local API on /run/atom-recovery.sock)
DefaultDependencies=no
After=systemd-udevd.service
Before=basic.target
ConditionPathExists=/usr/bin/atom-recovery

[Service]
Type=simple
ExecStart=/usr/bin/atom-recovery --mode serve
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

[Unit]
Description=Sinty recovery agent (local API on /run/atom-recovery.sock)
After=atom-fscrypt-de.service
ConditionPathExists=/usr/bin/atom-recovery
ConditionPathExists=/var/.atom-var

[Service]
Type=simple
ExecStartPre=/usr/libexec/sinty-policy-setup
ExecStart=/usr/bin/atom-recovery --mode serve --runtime --socket-group sinty-policy --root-pub /etc/atom-fw-root.pub
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

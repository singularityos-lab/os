[Unit]
Description=Sinty Network Manager (NetworkManager-compatible)
Documentation=https://github.com/mirkobrombin/sinty-nm
After=dbus.service
Wants=iwd.service
After=iwd.service

[Service]
Type=dbus
Environment=DBUS_SYSTEM_BUS_ADDRESS=unix:path=/run/dbus/system_bus_socket
BusName=org.freedesktop.NetworkManager
ExecStart=/usr/bin/sinty-nmd
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target

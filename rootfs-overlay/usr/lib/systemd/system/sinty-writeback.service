[Unit]
Description=Limit pending disk writes
DefaultDependencies=no
Before=sysinit.target
ConditionPathExists=/proc/sys/vm/dirty_bytes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo 33554432 > /proc/sys/vm/dirty_background_bytes; echo 134217728 > /proc/sys/vm/dirty_bytes'

[Install]
WantedBy=sysinit.target

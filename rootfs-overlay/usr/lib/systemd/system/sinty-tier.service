[Unit]
Description=Publish whether login secrets are a TPM PIN or a passphrase
DefaultDependencies=no
After=local-fs.target sinty-rundir.service
Before=sysinit.target sinty-logind.service
RequiresMountsFor=/var

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/sintykey tier

[Install]
WantedBy=sysinit.target

[Unit]
Description=Keep the kernel and compositor logs of the last boots on disk
DefaultDependencies=no
After=sealedlogd.service atom-fscrypt-de.service
Before=singularity-compositor.service

[Service]
Type=simple
ExecStart=/usr/lib/sinit/sinit logkeep
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target

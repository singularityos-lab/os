--- a/package/mesa3d/mesa3d.mk
+++ b/package/mesa3d/mesa3d.mk
@@ -79,6 +79,27 @@
 MESA3D_CONF_OPTS += -Dgallium-rusticl=false
 endif
 
+MESA3D_NVK_CRATES = paste/1.0.14 syn/2.0.87 rustc-hash/2.1.1 proc-macro2/1.0.86 quote/1.0.35 unicode-ident/1.0.12
+
+ifeq ($(BR2_PACKAGE_MESA3D_VULKAN_DRIVER_NOUVEAU),y)
+MESA3D_DEPENDENCIES += host-rustc host-rust-bindgen host-cbindgen
+MESA3D_EXTRA_DOWNLOADS += $(foreach c,$(MESA3D_NVK_CRATES),\
+	https://static.crates.io/crates/$(firstword $(subst /, ,$(c)))/$(subst /,-,$(c)).crate)
+ifneq ($(BR2_PACKAGE_MESA3D_RUSTICL),y)
+MESA3D_CONF_OPTS += -Drust_std=2021
+MESA3D_MESON_EXTRA_BINARIES += \
+	rust=['$(HOST_DIR)/bin/rustc','--target=$(RUSTC_TARGET_NAME)'] \
+	rust_ld='$(TARGET_CROSS)gcc'
+endif
+define MESA3D_NVK_CRATE_CACHE
+	mkdir -p $(@D)/subprojects/packagecache
+	$(foreach c,$(MESA3D_NVK_CRATES),\
+		cp $(MESA3D_DL_DIR)/$(subst /,-,$(c)).crate \
+			$(@D)/subprojects/packagecache/$(subst /,-,$(c)).tar.gz$(sep))
+endef
+MESA3D_POST_EXTRACT_HOOKS += MESA3D_NVK_CRATE_CACHE
+endif
+
 ifeq ($(BR2_PACKAGE_MESA3D_NEEDS_ELFUTILS),y)
 MESA3D_DEPENDENCIES += elfutils
 endif

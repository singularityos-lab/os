@@ -400,6 +400,18 @@
 	help
 	  Vulkan VirtIO (venus) driver.
 
+config BR2_PACKAGE_MESA3D_VULKAN_DRIVER_NOUVEAU
+	bool "Vulkan NVIDIA driver (NVK)"
+	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
+	depends on BR2_PACKAGE_MESA3D_LLVM
+	select BR2_PACKAGE_HOST_RUSTC
+	select BR2_PACKAGE_LIBDRM_NOUVEAU
+	select BR2_PACKAGE_MESA3D_NEEDS_PRECOMP_COMPILER
+	select BR2_PACKAGE_MESA3D_VULKAN_DRIVER
+	help
+	  Vulkan driver for NVIDIA GPUs from Turing onwards, running on
+	  the nouveau kernel driver with the GSP firmware.
+
 if BR2_PACKAGE_MESA3D_DRIVER
 

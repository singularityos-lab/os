+define LIBRSVG_DROP_STAGING_LA
+	rm -f $(STAGING_DIR)/usr/lib/librsvg-2.la
+endef
+LIBRSVG_POST_INSTALL_STAGING_HOOKS += LIBRSVG_DROP_STAGING_LA
+
+LIBRSVG_LOADERS_DIR = lib/gdk-pixbuf-2.0/2.10.0/loaders
+
+define HOST_LIBRSVG_DROP_AUTOTOOLS_FILES
+	rm -f $(HOST_DIR)/lib/librsvg-2.la \
+		$(HOST_DIR)/$(LIBRSVG_LOADERS_DIR)/libpixbufloader-svg.so \
+		$(HOST_DIR)/$(LIBRSVG_LOADERS_DIR)/libpixbufloader-svg.la
+endef
+HOST_LIBRSVG_POST_INSTALL_HOOKS += HOST_LIBRSVG_DROP_AUTOTOOLS_FILES
+
+define LIBRSVG_UPDATE_LOADERS_CACHE
+	GDK_PIXBUF_MODULEDIR=$(HOST_DIR)/$(LIBRSVG_LOADERS_DIR) \
+		$(HOST_DIR)/bin/gdk-pixbuf-query-loaders \
+		> $(TARGET_DIR)/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache
+	$(SED) 's,^"[^"]*/\(lib[^/"]*\.so\)","/usr/$(LIBRSVG_LOADERS_DIR)/\1",' \
+		$(TARGET_DIR)/usr/lib/gdk-pixbuf-2.0/2.10.0/loaders.cache
+endef
+LIBRSVG_TARGET_FINALIZE_HOOKS += LIBRSVG_UPDATE_LOADERS_CACHE
+
+$(eval $(meson-package))
+$(eval $(host-meson-package))

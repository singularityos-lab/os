diff --git a/package/libglib2/0004-gsettings-reload-the-keyfile-under-a-lock-before-writing.patch b/package/libglib2/0004-gsettings-reload-the-keyfile-under-a-lock-before-writing.patch
new file mode 100644
--- /dev/null
+++ b/package/libglib2/0004-gsettings-reload-the-keyfile-under-a-lock-before-writing.patch
@@ -0,0 +1,120 @@
+From: Sinty OS <dev@sinty.dev>
+Subject: [PATCH] gsettings: reload the keyfile under a lock before writing
+
+Each process kept its own copy of the keyfile and rewrote the whole file
+from it, so a write from a process that had not yet seen another
+process's change silently reverted that change. Take an exclusive lock
+on a sidecar file, reload the keyfile from disk, then apply and write.
+---
+--- a/gio/gkeyfilesettingsbackend.c
++++ b/gio/gkeyfilesettingsbackend.c
+@@ -26,8 +26,12 @@
+ #include <glib.h>
+ #include <glibintl.h>
+ 
++#include <errno.h>
++#include <fcntl.h>
+ #include <stdio.h>
+ #include <string.h>
++#include <sys/file.h>
++#include <unistd.h>
+ 
+ #include "gfile.h"
+ #include "gfileinfo.h"
+@@ -107,6 +111,33 @@
+   g_assert (len == 32);
+ }
+ 
++static void g_keyfile_settings_backend_keyfile_reload (GKeyfileSettingsBackend *kfsb);
++
++static int
++keyfile_lock (GKeyfileSettingsBackend *kfsb)
++{
++  const gchar *path = g_file_peek_path (kfsb->file);
++  gchar *lock_path;
++  int fd;
++
++  if (path == NULL)
++    return -1;
++  lock_path = g_strconcat (path, ".lock", NULL);
++  fd = open (lock_path, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
++  g_free (lock_path);
++  if (fd >= 0)
++    while (flock (fd, LOCK_EX) < 0 && errno == EINTR);
++  g_keyfile_settings_backend_keyfile_reload (kfsb);
++  return fd;
++}
++
++static void
++keyfile_unlock (int fd)
++{
++  if (fd >= 0)
++    close (fd);
++}
++
+ static gboolean
+ g_keyfile_settings_backend_keyfile_write (GKeyfileSettingsBackend  *kfsb,
+                                           GError                  **error)
+@@ -378,6 +409,7 @@
+ {
+   WriteManyData data = { G_KEYFILE_SETTINGS_BACKEND (backend), 0 };
+   gboolean success;
++  int lock_fd;
+   GError *error = NULL;
+ 
+   if (!data.kfsb->writable)
+@@ -388,8 +420,10 @@
+   if (data.failed)
+     return FALSE;
+ 
++  lock_fd = keyfile_lock (data.kfsb);
+   g_tree_foreach (tree, g_keyfile_settings_backend_write_one, &data);
+   success = g_keyfile_settings_backend_keyfile_write (data.kfsb, &error);
++  keyfile_unlock (lock_fd);
+   if (error)
+     {
+       g_warning ("Failed to write keyfile to %s: %s", g_file_peek_path (data.kfsb->file), error->message);
+@@ -411,21 +445,27 @@
+   gboolean success;
+   GError *error = NULL;
+ 
++  int lock_fd;
++
+   if (!kfsb->writable)
+     return FALSE;
+ 
++  lock_fd = keyfile_lock (kfsb);
+   success = set_to_keyfile (kfsb, key, value);
+ 
+   if (success)
+     {
+       g_settings_backend_changed (backend, key, origin_tag);
+       success = g_keyfile_settings_backend_keyfile_write (kfsb, &error);
++      keyfile_unlock (lock_fd);
++      lock_fd = -1;
+       if (error)
+         {
+           g_warning ("Failed to write keyfile to %s: %s", g_file_peek_path (kfsb->file), error->message);
+           g_error_free (error);
+         }
+     }
++  keyfile_unlock (lock_fd);
+ 
+   return success;
+ }
+@@ -437,6 +477,7 @@
+ {
+   GKeyfileSettingsBackend *kfsb = G_KEYFILE_SETTINGS_BACKEND (backend);
+   GError *error = NULL;
++  int lock_fd = keyfile_lock (kfsb);
+ 
+   if (set_to_keyfile (kfsb, key, NULL))
+     {
+@@ -447,6 +488,7 @@
+           g_error_free (error);
+         }
+     }
++  keyfile_unlock (lock_fd);
+ 
+   g_settings_backend_changed (backend, key, origin_tag);
+ }

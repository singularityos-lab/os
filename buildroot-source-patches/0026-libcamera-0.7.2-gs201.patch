diff --git a/package/libcamera/0039-ipa-simple-Hand-tune-the-Pixel-7-Pro-s-Samsung-senso.patch b/package/libcamera/0039-ipa-simple-Hand-tune-the-Pixel-7-Pro-s-Samsung-senso.patch

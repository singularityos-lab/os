+index 12a8bd5..fad9578 100644
+--- a/src/libcamera/software_isp/swstats_cpu.cpp
++++ b/src/libcamera/software_isp/swstats_cpu.cpp
+@@ -11,6 +11,8 @@
+ 
+ #include "libcamera/internal/software_isp/swstats_cpu.h"
+ 
++#include <algorithm>
++
+ #include <libcamera/base/log.h>
+ 
+ #include <libcamera/stream.h>
+@@ -189,6 +191,7 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
+ #define SWSTATS_START_LINE_STATS(pixel_t) \
+ 	pixel_t r, g, g2, b;              \
+ 	uint64_t yVal;                    \
++	uint64_t yBin;                    \
+                                           \
+ 	uint64_t sumR = 0;                \
+ 	uint64_t sumG = 0;                \
+@@ -207,9 +210,11 @@ static constexpr unsigned int kBlueYMul = 29; /* 0.114 * 256 */
+ 	yVal = r * kRedYMul;                                                          \
+ 	yVal += g * kGreenYMul;                                                       \
+ 	yVal += b * kBlueYMul;                                                        \
+-	stats.yHistogram[yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div))]++; \
++	yBin = yVal * SwIspStats::kYHistogramSize / (256 * 256 * (div));             \
++	stats.yHistogram[yBin]++;                                                     \
+ 	if (focusLine && sample >= focusSampleStart_ &&                               \
+ 	    sample < focusSampleEnd_) {                                               \
++		stats.windowHistogram[yBin]++;                                        \
+ 		if (havePreviousG) {                                                  \
+ 			const int64_t delta = static_cast<int64_t>(g) - previousG;    \
+ 			sharpness += static_cast<uint64_t>(delta * delta);            \
+@@ -425,6 +430,7 @@ void SwStatsCpu::startFrame(uint32_t frame)
+ 	for (auto &s : stats_) {
+ 		s.sum_ = RGB<uint64_t>({ 0, 0, 0 });
+ 		s.yHistogram.fill(0);
++		s.windowHistogram.fill(0);
+ 		s.sharpness = 0;
+ 		s.focusGreen = 0;
+ 	}
+@@ -444,14 +450,17 @@ void SwStatsCpu::finishFrame(uint32_t frame, uint32_t bufferId)
+ 	if (valid) {
+ 		sharedStats_->sum_ = RGB<uint64_t>({ 0, 0, 0 });
+ 		sharedStats_->yHistogram.fill(0);
++		sharedStats_->windowHistogram.fill(0);
+ 		uint64_t sharpness = 0;
+ 		uint64_t green = 0;
+ 		for (const auto &s : stats_) {
+ 			sharedStats_->sum_ += s.sum_;
+ 			sharpness += s.sharpness;
+ 			green += s.focusGreen;
+-			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++)
++			for (unsigned int j = 0; j < SwIspStats::kYHistogramSize; j++) {
+ 				sharedStats_->yHistogram[j] += s.yHistogram[j];
++				sharedStats_->windowHistogram[j] += s.windowHistogram[j];
++			}
+ 		}
+ 
+ 		sharedStats_->sum_ >>= sumShift_;
+@@ -616,13 +625,38 @@ void SwStatsCpu::setWindow(const Rectangle &window)
+ 	window_.width &= ~(patternSize_.width - 1);
+ 	window_.height &= ~(patternSize_.height - 1);
+ 
++	setFocusWindow(focusWindow_);
++}
++
++/**
++ * \brief Set the window for autofocus and spot metering statistics
++ * \param[in] window The x, y, width and height of the window, in fractions
++ * of the statistics window
++ *
++ * The sharpness and the window histogram are gathered over this part of the
++ * statistics window set by setWindow(). The default is its centre half.
++ */
++void SwStatsCpu::setFocusWindow(const std::array<float, 4> &window)
++{
++	focusWindow_ = window;
++
++	const float x = std::clamp(window[0], 0.0f, 1.0f);
++	const float y = std::clamp(window[1], 0.0f, 1.0f);
++	const float w = std::clamp(window[2], 0.0f, 1.0f - x);
++	const float h = std::clamp(window[3], 0.0f, 1.0f - y);
++
+ 	/*
+ 	 * Every line function takes one sample per other 2x2 block, so about
+-	 * width / 4 samples per line. Autofocus uses the centre half of them.
++	 * width / 4 samples per line.
+ 	 */
+ 	const unsigned int samples = window_.width / 4;
+-	focusSampleStart_ = samples / 4;
+-	focusSampleEnd_ = samples * 3 / 4;
++	focusSampleStart_ = static_cast<unsigned int>(samples * x);
++	focusSampleEnd_ = std::max(focusSampleStart_ + 2,
++				   static_cast<unsigned int>(samples * (x + w)));
++	focusLineStart_ = static_cast<unsigned int>(window_.height * y);
++	/* Lines are sampled in pairs, every other pair. */
++	focusLineEnd_ = std::max(focusLineStart_ + 4,
++				 static_cast<unsigned int>(window_.height * (y + h)));
+ }
+ 
+ void SwStatsCpu::processBayerFrame2(MappedFrameBuffer &in)

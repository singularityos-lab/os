diff --git a/package/libcamera/0033-ipa-simple-agc-Protect-the-highlights.patch b/package/libcamera/0033-ipa-simple-agc-Protect-the-highlights.patch
new file mode 100644
index 0000000..1b6e3a7
--- /dev/null
+++ b/package/libcamera/0033-ipa-simple-agc-Protect-the-highlights.patch
@@ -0,0 +1,153 @@
+From d86706f63c6f0eaf844cf33ef3b5fa6751a05164 Mon Sep 17 00:00:00 2001
+From: Derek Ross <derekross@gmail.com>
+Date: Thu, 15 Oct 2026 13:58:35 -0400
+Subject: [PATCH 33/35] ipa: simple: agc: Protect the highlights
+
+The AGC aims the mean of a linear histogram at its middle, which in a
+sunlit scene leaves the sky and bright surfaces clipped: daylight stills
+on the Google Pixel 7 Pro had 15-32% of their pixels at the top.
+
+Count the samples that come out clipped (in the top two of the
+histogram's bins after the digital gain). With more than 2% of the
+picture clipped (by half again), cut the exposure towards it whatever
+the mean says, by up to half a step at a time; near the limit, don't
+let the mean raise the exposure further. A subject against the light,
+with at least half of the picture in the darkest 15% of the range, may
+clip 10% instead, and positive exposure compensation scales the limit.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ src/ipa/simple/algorithms/agc.cpp | 56 ++++++++++++++++++++++++++++---
+ src/ipa/simple/algorithms/agc.h   |  2 +-
+ 2 files changed, 53 insertions(+), 5 deletions(-)
+
+diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
+index 8ea3f9919..16bb45c41 100644
+--- a/src/ipa/simple/algorithms/agc.cpp
++++ b/src/ipa/simple/algorithms/agc.cpp
+@@ -94,6 +94,18 @@ static constexpr double kExpPinnedDown = 1.0 / 16.0;
+  */
+ static constexpr unsigned int kExpSettleFrames = 1;
+ 
++/*
++ * Highlight protection: the share of the picture that may clip (in the top
++ * kHighlightBins of the histogram), and a more lenient one when at least
++ * kBacklitDarkShare of the picture is in its darkest kDarkShare, a subject
++ * against the light.
++ */
++static constexpr double kHighlightMax = 0.02;
++static constexpr double kHighlightMaxBacklit = 0.10;
++static constexpr unsigned int kHighlightBins = 2;
++static constexpr double kDarkShare = 0.15;
++static constexpr double kBacklitDarkShare = 0.5;
++
+ /*
+  * A request that hasn't shown after this many frames (the sensor clamped
+  * it, or rounded the gain to a code further off than the tolerance) is
+@@ -241,7 +253,7 @@ void Agc::queueRequest(typename Module::Context &context,
+ }
+ 
+ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+-			 double exposureMSV)
++			 double exposureMSV, double highlights, bool backlit)
+ {
+ 	int32_t &exposure = frameContext.sensor.exposure;
+ 	double &again = frameContext.sensor.gain;
+@@ -280,7 +292,20 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ 	}
+ 
+ 	double error = kExposureOptimal - exposureMSV;
+-	if (std::abs(error) <= kExposureSatisfactory) {
++
++	/*
++	 * Highlight protection: no more than kHighlightMax of the picture
++	 * clipped, or kHighlightMaxBacklit when most of it is dark (a subject
++	 * against a bright sky keeps its exposure, the sky blows). Too many
++	 * clipped samples cut the exposure whatever the mean says; close to
++	 * the limit, the mean may no longer raise it.
++	 */
++	const double allowed = (backlit ? kHighlightMaxBacklit : kHighlightMax) *
++			       std::exp2(std::max(0.0f, agc.exposureValue));
++	const bool tooBright = highlights > allowed * 1.5;
++	const bool atLimit = highlights > allowed * 0.75;
++	if (!tooBright && (std::abs(error) <= kExposureSatisfactory ||
++			   (atLimit && error > 0))) {
+ 		agc.state = controls::AeStateConverged;
+ 		return false;
+ 	}
+@@ -301,6 +326,9 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ 		factor = 1.0 + std::clamp(static_cast<float>(error) * gain * 2,
+ 					  -kExpMaxStep * 2, kExpMaxStep * 2);
+ 	}
++	if (tooBright && exposureMSV < kExposurePinnedBright)
++		factor = std::min(factor, std::clamp(std::sqrt(allowed / highlights),
++						     0.5, 0.9));
+ 
+ 	/*
+ 	 * Distribute it: exposure time first (up to its limit), then the
+@@ -328,6 +356,7 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ 
+ 	LOG(IPASoftExposure, Debug)
+ 		<< "exposureMSV " << exposureMSV
++		<< " highlights " << highlights << (backlit ? " (backlit)" : "")
+ 		<< " error " << error << " factor " << factor
+ 		<< " exp " << exposure << " again " << again
+ 		<< " dgain " << dgain;
+@@ -446,12 +475,30 @@ void Agc::process(IPAContext &context,
+ 	 */
+ 	const double scale = context.activeState.agc.digitalGain *
+ 			     std::exp2(-context.activeState.agc.exposureValue);
++	/*
++	 * Highlights: the samples that come out clipped (within
++	 * kHighlightBins of the top after the digital gain), and the dark
++	 * ones (the bottom kDarkShare of the range), which tell a backlit
++	 * subject.
++	 */
++	const double dgainNow = context.activeState.agc.digitalGain;
++	uint64_t clipped = 0, dark = 0, all = 0;
+ 	for (unsigned int i = 0; i < histogramSize; i++) {
+ 		const unsigned int gained = std::min<unsigned int>(
+ 			histogramSize - 1, static_cast<unsigned int>(std::lround(i * scale)));
+ 		unsigned int idx = (gained - (gained / yHistValsPerBinMod)) / yHistValsPerBin;
+-		exposureBins[idx] += histogram[blackLevelHistIdx + i];
++		const uint32_t n = histogram[blackLevelHistIdx + i];
++		exposureBins[idx] += n;
++
++		const double out = i * dgainNow;
++		if (out >= histogramSize - kHighlightBins)
++			clipped += n;
++		if (out < histogramSize * kDarkShare)
++			dark += n;
++		all += n;
+ 	}
++	const double highlights = all ? static_cast<double>(clipped) / all : 0.0;
++	const bool backlit = all && static_cast<double>(dark) / all >= kBacklitDarkShare;
+ 
+ 	for (unsigned int i = 0; i < kExposureBinsCount; i++) {
+ 		LOG(IPASoftExposure, Debug) << i << ": " << exposureBins[i];
+@@ -460,7 +507,8 @@ void Agc::process(IPAContext &context,
+ 	}
+ 
+ 	float exposureMSV = (denom == 0 ? 0 : static_cast<float>(num) / denom);
+-	const bool adjusted = updateExposure(context, frameContext, exposureMSV);
++	const bool adjusted = updateExposure(context, frameContext, exposureMSV,
++					     highlights, backlit);
+ 	if (adjusted)
+ 		context.activeState.agc.stableSamples = 0;
+ 	else
+diff --git a/src/ipa/simple/algorithms/agc.h b/src/ipa/simple/algorithms/agc.h
+index 040acda44..f79bf8842 100644
+--- a/src/ipa/simple/algorithms/agc.h
++++ b/src/ipa/simple/algorithms/agc.h
+@@ -32,7 +32,7 @@ public:
+ 
+ private:
+ 	bool updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+-			    double exposureMSV);
++			    double exposureMSV, double highlights, bool backlit);
+ };
+ 
+ } /* namespace ipa::soft::algorithms */
+-- 
+2.55.0
+
diff --git a/package/libcamera/0034-software_isp-debayer_egl-Clip-highlights-to-neutral.patch b/package/libcamera/0034-software_isp-debayer_egl-Clip-highlights-to-neutral.patch
new file mode 100644
index 0000000..805f8dc
--- /dev/null
+++ b/package/libcamera/0034-software_isp-debayer_egl-Clip-highlights-to-neutral.patch
@@ -0,0 +1,88 @@
+From 70d0e5d013b5649bb7181ee800bd1868d6a2ada3 Mon Sep 17 00:00:00 2001
+From: Derek Ross <derekross@gmail.com>
+Date: Thu, 15 Oct 2026 13:59:04 -0400
+Subject: [PATCH 34/35] software_isp: debayer_egl: Clip highlights to neutral
+
+The GPU debayer applies the white balance gains and clamps each colour
+on its own. Where the sensor's green clips first, or one gain pushes a
+colour past full scale, the clipped areas take a tint: daylight skies
+on the Google Pixel 7 Pro came out cyan.
+
+Fade towards neutral (each colour to the largest) as the brightest raw
+colour nears the sensor's full scale, from 85%, or as a colour goes past
+full scale after the gains, from 95% to 125%. Saturated colours that
+don't clip keep their colour.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ src/libcamera/shaders/bayer_1x_packed.frag | 14 +++++++++++++-
+ src/libcamera/shaders/bayer_unpacked.frag  | 14 +++++++++++++-
+ 2 files changed, 26 insertions(+), 2 deletions(-)
+
+diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
+index 4a800dc85..fde90c710 100644
+--- a/src/libcamera/shaders/bayer_1x_packed.frag
++++ b/src/libcamera/shaders/bayer_1x_packed.frag
+@@ -236,6 +236,7 @@ void main(void)
+ 	 * reworked into a single multiplication.
+ 	 */
+ 	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
++	vec3 sensor = rgb;
+ 
+ 	/* Lens shading: a radial gain from the centre of the sensor */
+ 	vec2 lsc_p = (center_pixel + 0.5) / tex_size - 0.5;
+@@ -243,7 +244,18 @@ void main(void)
+ 	rgb *= 1.0 + lsc_r2 * (lsc_k1 + lsc_r2 * lsc_k2);
+ 
+ 	/* Apply AWB gains, and saturate each channel at sensor range */
+-	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
++	rgb *= awb;
++
++	/*
++	 * Highlights: as any colour nears clipping, at the sensor or after
++	 * the gains, fade towards neutral, so that a clipped channel doesn't
++	 * tint the brightest parts (cyan skies, green-white clouds).
++	 */
++	float hl_in = max(max(sensor.r, sensor.g), sensor.b);
++	float hl_out = max(max(rgb.r, rgb.g), rgb.b);
++	float hl = max(smoothstep(0.85, 1.0, hl_in), smoothstep(0.95, 1.25, hl_out));
++	rgb = clamp(rgb, vec3(0.0), vec3(1.0));
++	rgb = mix(rgb, vec3(max(max(rgb.r, rgb.g), rgb.b)), hl);
+ 
+ 	/* Colour Correction Matrix */
+ 	rgb = ccm * rgb;
+diff --git a/src/libcamera/shaders/bayer_unpacked.frag b/src/libcamera/shaders/bayer_unpacked.frag
+index cc3d47dd3..bf7282215 100644
+--- a/src/libcamera/shaders/bayer_unpacked.frag
++++ b/src/libcamera/shaders/bayer_unpacked.frag
+@@ -140,6 +140,7 @@ void main(void) {
+      * reworked into a single multiplication.
+      */
+     rgb = (rgb - blacklevel) / (1.0 - blacklevel);
++    vec3 sensor = rgb;
+ 
+     /* Lens shading: a radial gain from the centre of the sensor */
+     vec2 lsc_p = (center.zw - tex_bayer_first_red + 0.5) / tex_size - 0.5;
+@@ -147,7 +148,18 @@ void main(void) {
+     rgb *= 1.0 + lsc_r2 * (lsc_k1 + lsc_r2 * lsc_k2);
+ 
+     /* Apply AWB gains, and saturate each channel at sensor range */
+-    rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
++    rgb *= awb;
++
++    /*
++     * Highlights: as any colour nears clipping, at the sensor or after
++     * the gains, fade towards neutral, so that a clipped channel doesn't
++     * tint the brightest parts (cyan skies, green-white clouds).
++     */
++    float hl_in = max(max(sensor.r, sensor.g), sensor.b);
++    float hl_out = max(max(rgb.r, rgb.g), rgb.b);
++    float hl = max(smoothstep(0.85, 1.0, hl_in), smoothstep(0.95, 1.25, hl_out));
++    rgb = clamp(rgb, vec3(0.0), vec3(1.0));
++    rgb = mix(rgb, vec3(max(max(rgb.r, rgb.g), rgb.b)), hl);
+ 
+     /* Colour Correction Matrix */
+     rgb = ccm * rgb;
+-- 
+2.55.0
+
diff --git a/package/libcamera/0035-ipa-simple-af-Scan-less.patch b/package/libcamera/0035-ipa-simple-af-Scan-less.patch
new file mode 100644
index 0000000..77af5a5
--- /dev/null
+++ b/package/libcamera/0035-ipa-simple-af-Scan-less.patch
@@ -0,0 +1,263 @@
+From 79b10278fb00d81256886f931b17fe8df90e1a6b Mon Sep 17 00:00:00 2001
+From: Derek Ross <derekross@gmail.com>
+Date: Thu, 15 Oct 2026 14:00:11 -0400
+Subject: [PATCH 35/35] ipa: simple: af: Scan less
+
+A full contrast scan takes about a hundred frames on the main camera
+of the Google Pixel 7 Pro (nine coarse and nine fine samples, each
+four frames apart for the lens and the requests in flight): over
+three seconds at 30 fps, and continuous focus ran one whenever the
+picture softened.
+
+- Stop the coarse scan once two samples past the best have fallen
+  below 70% of it: the peak is behind. The lens starts at infinity,
+  where most scenes are, so that ends most scans after three samples.
+- Centre the fine scan on the parabola through the coarse samples'
+  peak and cover half a coarse step either side of it, not a whole
+  step (five samples instead of nine).
+- Continuous focus that lost sharpness first scans a coarse step
+  either side of the lens, and scans the whole range only if the best
+  sample is at the edge of that.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ src/ipa/simple/algorithms/af.cpp | 130 +++++++++++++++++++++++--------
+ src/ipa/simple/algorithms/af.h   |  18 ++++-
+ 2 files changed, 114 insertions(+), 34 deletions(-)
+
+diff --git a/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
+index 20b127ad3..c71690c7e 100644
+--- a/src/ipa/simple/algorithms/af.cpp
++++ b/src/ipa/simple/algorithms/af.cpp
+@@ -48,6 +48,15 @@ static constexpr unsigned int kRescanSamples = 15;
+  * travel, longest for the jump to the start of a scan.
+  */
+ static constexpr unsigned int kLensStepSettleSamples = 4;
++
++/*
++ * The coarse scan stops once kPeakDropSamples samples past its best have
++ * fallen below kPeakDropPercent of it: the peak is behind, and the rest
++ * of the range only costs time (the lens starts at infinity, where most
++ * scenes are).
++ */
++static constexpr unsigned int kPeakDropSamples = 2;
++static constexpr uint64_t kPeakDropPercent = 70;
+ static constexpr unsigned int kLensJumpSettleSamples = 6;
+ 
+ int Af::init(IPAContext &context, const ValueNode &tuningData)
+@@ -135,6 +144,28 @@ void Af::startScan(IPAContext &context)
+ 		return;
+ 
+ 	auto &af = context.activeState.af;
++
++	/*
++	 * Continuous focus that lost its subject looks around where the lens
++	 * is first (a subject that moved a little), and scans the whole
++	 * range only if the sharpest sample is at the edge of that.
++	 */
++	if (localNext_) {
++		localNext_ = false;
++		localScan_ = true;
++		af.pendingScan = false;
++		af.pendingSamples = 0;
++		af.scanning = true;
++		af.state = controls::AfStateScanning;
++		af.lowSharpnessSamples = 0;
++		startFineScan(context, af.position, context.configuration.focus.coarseStep);
++		LOG(IPASoftAf, Debug) << "Starting a local autofocus scan";
++		return;
++	}
++	localScan_ = false;
++	coarseSamples_.clear();
++	dropSamples_ = 0;
++
+ 	af.pendingScan = false;
+ 	af.pendingSamples = 0;
+ 	af.scanning = true;
+@@ -248,9 +279,47 @@ void Af::queueRequest([[maybe_unused]] typename Module::Context &context,
+ 	}
+ }
+ 
++void Af::startFineScan(IPAContext &context, int32_t centre, int32_t radius)
++{
++	auto &af = context.activeState.af;
++	const auto &focus = context.configuration.focus;
++
++	af.fineScan = true;
++	af.scanStart = std::max(focus.min, centre - radius);
++	af.scanEnd = std::min(focus.max, centre + radius);
++	af.scanStep = focus.fineStep;
++	af.position = af.scanStart;
++	af.bestPosition = af.position;
++	af.bestSharpness = 0;
++	af.settleSamples = kLensJumpSettleSamples;
++	fineSamples_.clear();
++}
++
++void Af::finishScan(IPAContext &context)
++{
++	auto &af = context.activeState.af;
++
++	af.scanning = false;
++	localScan_ = false;
++	af.position = peakPosition(context, fineSamples_, af.bestPosition,
++				   context.configuration.focus.fineStep);
++	af.bestPosition = af.position;
++	af.lockedSharpness = af.bestSharpness;
++	af.state = af.bestSharpness ? controls::AfStateFocused
++				    : controls::AfStateFailed;
++	af.settleSamples = kContinuousMonitorDelaySamples;
++	af.smoothedSharpness = 0;
++	af.lowSharpnessSamples = 0;
++
++	LOG(IPASoftAf, Info)
++		<< "Autofocus completed at " << af.position
++		<< " (sharpness " << af.bestSharpness << ")";
++}
++
+ void Af::processScan(IPAContext &context, uint64_t sharpness)
+ {
+ 	auto &af = context.activeState.af;
++	const auto &focus = context.configuration.focus;
+ 
+ 	if (af.settleSamples) {
+ 		--af.settleSamples;
+@@ -265,44 +334,42 @@ void Af::processScan(IPAContext &context, uint64_t sharpness)
+ 	if (sharpness > af.bestSharpness) {
+ 		af.bestSharpness = sharpness;
+ 		af.bestPosition = af.position;
++		dropSamples_ = 0;
++	} else if (!af.fineScan &&
++		   sharpness * 100 < af.bestSharpness * kPeakDropPercent) {
++		dropSamples_++;
+ 	}
+-	if (af.fineScan)
+-		fineSamples_.emplace_back(af.position, sharpness);
++	(af.fineScan ? fineSamples_ : coarseSamples_).emplace_back(af.position, sharpness);
+ 
+-	if (af.position + af.scanStep <= af.scanEnd) {
++	const bool peakPassed = !af.fineScan && dropSamples_ >= kPeakDropSamples;
++	if (!peakPassed && af.position + af.scanStep <= af.scanEnd) {
+ 		af.position += af.scanStep;
+ 		af.settleSamples = kLensStepSettleSamples;
+ 		return;
+ 	}
+ 
+ 	if (!af.fineScan) {
+-		const int32_t radius = context.configuration.focus.coarseStep;
+-		af.fineScan = true;
+-		af.scanStart = std::max(context.configuration.focus.min,
+-					af.bestPosition - radius);
+-		af.scanEnd = std::min(context.configuration.focus.max,
+-				      af.bestPosition + radius);
+-		af.scanStep = context.configuration.focus.fineStep;
+-		af.position = af.scanStart;
+-		af.bestSharpness = 0;
+-		af.settleSamples = kLensJumpSettleSamples;
+-		fineSamples_.clear();
++		/*
++		 * The fine scan covers half a coarse step either side of the
++		 * peak a parabola through the coarse samples puts.
++		 */
++		const int32_t centre = peakPosition(context, coarseSamples_,
++						    af.bestPosition, focus.coarseStep);
++		startFineScan(context, centre, std::max(focus.coarseStep / 2, focus.fineStep));
+ 		return;
+ 	}
+ 
+-	af.scanning = false;
+-	af.position = peakPosition(context, af.bestPosition);
+-	af.bestPosition = af.position;
+-	af.lockedSharpness = af.bestSharpness;
+-	af.state = af.bestSharpness ? controls::AfStateFocused
+-				    : controls::AfStateFailed;
+-	af.settleSamples = kContinuousMonitorDelaySamples;
+-	af.smoothedSharpness = 0;
+-	af.lowSharpnessSamples = 0;
++	/* A local scan whose best is at its edge: the subject went further. */
++	if (localScan_ &&
++	    ((af.bestPosition == af.scanStart && af.scanStart > focus.min) ||
++	     (af.bestPosition == af.scanEnd && af.scanEnd < focus.max))) {
++		LOG(IPASoftAf, Debug) << "Local scan peaked at its edge, scanning the range";
++		localScan_ = false;
++		startScan(context);
++		return;
++	}
+ 
+-	LOG(IPASoftAf, Info)
+-		<< "Autofocus completed at " << af.position
+-		<< " (sharpness " << af.bestSharpness << ")";
++	finishScan(context);
+ }
+ 
+ /*
+@@ -310,12 +377,13 @@ void Af::processScan(IPAContext &context, uint64_t sharpness)
+  * enough to leave a visibly soft result. Fit a parabola through the best
+  * sample and its neighbours and move to its vertex.
+  */
+-int32_t Af::peakPosition(const IPAContext &context, int32_t best) const
++int32_t Af::peakPosition(const IPAContext &context, const Samples &samples,
++			 int32_t best, int32_t step) const
+ {
+-	const auto it = std::find_if(fineSamples_.begin(), fineSamples_.end(),
++	const auto it = std::find_if(samples.begin(), samples.end(),
+ 				     [best](const auto &sample) { return sample.first == best; });
+-	if (it == fineSamples_.end() || it == fineSamples_.begin() ||
+-	    std::next(it) == fineSamples_.end())
++	if (it == samples.end() || it == samples.begin() ||
++	    std::next(it) == samples.end())
+ 		return best;
+ 
+ 	const double left = static_cast<double>(std::prev(it)->second);
+@@ -325,7 +393,6 @@ int32_t Af::peakPosition(const IPAContext &context, int32_t best) const
+ 	if (curvature >= 0.0)
+ 		return best;
+ 
+-	const int32_t step = context.configuration.focus.fineStep;
+ 	const double offset = std::clamp(0.5 * (left - right) / curvature, -0.5, 0.5);
+ 	return std::clamp(best + static_cast<int32_t>(std::lround(offset * step)),
+ 			  context.configuration.focus.min,
+@@ -400,6 +467,7 @@ void Af::process(IPAContext &context,
+ 				   af.lockedSharpness * kRescanPercent) {
+ 				if (++af.lowSharpnessSamples >= kRescanSamples) {
+ 					af.pendingScan = true;
++					localNext_ = true;
+ 					af.state = controls::AfStateScanning;
+ 					af.lowSharpnessSamples = 0;
+ 				}

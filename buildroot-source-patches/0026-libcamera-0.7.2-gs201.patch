diff --git a/package/libcamera/0032-ipa-simple-awb-Use-the-grey-candidates-and-smooth-th.patch b/package/libcamera/0032-ipa-simple-awb-Use-the-grey-candidates-and-smooth-th.patch
new file mode 100644
index 0000000..21ead60
--- /dev/null

+From: Derek Ross <derekross@gmail.com>
+Date: Wed, 14 Oct 2026 09:32:21 -0400
+Subject: [PATCH] ipa: simple: agc: Step out of a pinned histogram quickly
+
+When nearly every pixel falls in the darkest (or brightest) histogram
+bin, the mean sample value is at its limit and says only "much too
+dark" (or bright), not by how much. The proportional loop then steps by
+at most 15% a frame, and with the sensor's two-frame control delay the
+Google Pixel 7 Pro's front camera took several seconds to brighten from
+its starting exposure in a dim room.
+
+While the histogram is pinned at an end, double (or halve) the exposure
+each step instead. The sensor's control delay limits the overshoot to
+about one more step, which the proportional loop takes back once the
+histogram has moved off the end.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ src/ipa/simple/algorithms/agc.cpp | 19 +++++++++++++++++++
+ 1 file changed, 19 insertions(+)
+
+diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
+index 0ad36d5..512888b 100644
+--- a/src/ipa/simple/algorithms/agc.cpp
++++ b/src/ipa/simple/algorithms/agc.cpp
+@@ -70,6 +70,21 @@ static constexpr float kExpProportionalGainFar = 0.1;
+  */
+ static constexpr float kExpMaxStep = 0.15;
+ 
++/*
++ * A histogram pinned at one end (nearly everything in the darkest or the
++ * brightest bin) says only "much too dark" or "much too bright", not by how
++ * much, and the bounded steps above then take seconds to get out: from a
++ * camera's starting exposure in a dim room, the front camera of a phone
++ * took several seconds to brighten. Step by these factors until the
++ * histogram moves off the end. The sensor's control delay limits the
++ * overshoot to about one more step, which the proportional loop then
++ * takes back.
++ */
++static constexpr double kExposurePinnedDark = 1.05;
++static constexpr double kExposurePinnedBright = kExposureBinsCount - 0.05;
++static constexpr float kExpPinnedUp = 2.0;
++static constexpr float kExpPinnedDown = 0.5;
++
+ /*
+  * Low light. Once the exposure and the sensor's analogue gain are both at
+  * their limits, the loop goes on with digital gain, up to this factor, which
+@@ -121,6 +136,10 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ 	float step = std::clamp(static_cast<float>(error) * gain,
+ 				-kExpMaxStep, kExpMaxStep);
+ 	float factor = 1.0f + step;
++	if (exposureMSV <= kExposurePinnedDark)
++		factor = kExpPinnedUp;
++	else if (exposureMSV >= kExposurePinnedBright)
++		factor = kExpPinnedDown;
+ 
+ 	if (factor > 1.0f) {
+ 		/* Scene too dark: increase exposure first, then gain. */
+-- 
+2.55.0
+
diff --git a/package/libcamera/0016-software_isp-debayer_egl-Destroy-the-EGL-context-whe.patch b/package/libcamera/0016-software_isp-debayer_egl-Destroy-the-EGL-context-whe.patch
new file mode 100644
index 0000000..02e39b5
--- /dev/null
+++ b/package/libcamera/0016-software_isp-debayer_egl-Destroy-the-EGL-context-whe.patch
@@ -0,0 +1,92 @@
+From 5bf4e5c5b5790cc5264ee0c002096ebf968b1c68 Mon Sep 17 00:00:00 2001
+From: Derek Ross <derekross@gmail.com>
+Date: Wed, 14 Oct 2026 11:58:28 -0400
+Subject: [PATCH] software_isp: debayer_egl: Destroy the EGL context when
+ stopping
+
+DebayerEGL::start() creates a new EGL context every time, and nothing
+destroyed the previous one until the eGL object went away. Each stop
+deleted the cached textures, but the abandoned context still referenced
+the last buffers it had bound, so their imported DMA-BUFs stayed
+allocated. In a long-running application that starts and stops the
+camera repeatedly (a camera app that reconfigures for each photo) this
+leaked the software ISP's output buffers and the camera's own buffers:
+on a Google Pixel 7 Pro, 290 MiB of contiguous memory stayed held after
+the app had closed the camera, and later starts failed to allocate.
+
+Add eGL::destroyEGLContext() and call it at the end of
+DebayerEGL::stop(), after the caches and the program are released.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ include/libcamera/internal/egl.h           |  1 +
+ src/libcamera/egl.cpp                      | 20 ++++++++++++++++++++
+ src/libcamera/software_isp/debayer_egl.cpp |  9 +++++++++
+ 3 files changed, 30 insertions(+)
+
+diff --git a/include/libcamera/internal/egl.h b/include/libcamera/internal/egl.h
+index 1e31d49..290b9e5 100644
+--- a/include/libcamera/internal/egl.h
++++ b/include/libcamera/internal/egl.h
+@@ -103,6 +103,7 @@ public:
+ 	~eGL();
+ 
+ 	int initEGLContext();
++	void destroyEGLContext();
+ 	static bool isAvailable();
+ 
+ 	int createInputDMABufTexture2D(eGLImage &eglImage, int fd);
+diff --git a/src/libcamera/egl.cpp b/src/libcamera/egl.cpp
+index 7ec7a65..b02d4bb 100644
+--- a/src/libcamera/egl.cpp
++++ b/src/libcamera/egl.cpp
+@@ -462,6 +462,26 @@ fail:
+ 	return -ENODEV;
+ }
+ 
++/**
++ * \brief Destroy the EGL context created by initEGLContext()
++ *
++ * Releases the context from the calling thread and destroys it, so that
++ * everything it still references (the last textures and framebuffers it
++ * bound, and through them imported DMA-BUFs) is freed now rather than when
++ * the eGL object goes away. A later initEGLContext() creates a new one.
++ */
++void eGL::destroyEGLContext()
++{
++	if (context_ == EGL_NO_CONTEXT)
++		return;
++
++	ASSERT(tid_ == Thread::currentId());
++
++	eglMakeCurrent(display_, EGL_NO_SURFACE, EGL_NO_SURFACE, EGL_NO_CONTEXT);
++	eglDestroyContext(display_, context_);
++	context_ = EGL_NO_CONTEXT;
++}
++
+ /**
+  * \brief Make the EGL context current for the calling thread
+  *
+diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
+index 5a8a490..dfd0929 100644
+--- a/src/libcamera/software_isp/debayer_egl.cpp
++++ b/src/libcamera/software_isp/debayer_egl.cpp
+@@ -709,6 +709,15 @@ void DebayerEGL::stop()
+ 
+ 	if (programId_)
+ 		glDeleteProgram(programId_);
++	programId_ = 0;
++
++	/*
++	 * start() creates a new context every time. Destroy this one: left
++	 * alive, it kept the last buffers it had bound imported, so a
++	 * long-running application leaked their DMA-BUFs (and the contiguous
++	 * memory behind them) with every stop.
++	 */
++	egl_.destroyEGLContext();
+ }
+ 
+ SizeRange DebayerEGL::sizes(PixelFormat inputFormat, const Size &inputSize)
+-- 
+2.55.0
+
diff --git a/package/libcamera/0017-ipa-simple-agc-Judge-only-frames-taken-with-the-last.patch b/package/libcamera/0017-ipa-simple-agc-Judge-only-frames-taken-with-the-last.patch
new file mode 100644
index 0000000..8f6b5d7
--- /dev/null
+++ b/package/libcamera/0017-ipa-simple-agc-Judge-only-frames-taken-with-the-last.patch
@@ -0,0 +1,231 @@
+From ba67aaa6a4018a9e2b1fb38ccd3fa13bb173a2e9 Mon Sep 17 00:00:00 2001
+From: Derek Ross <derekross@gmail.com>
+Date: Wed, 14 Oct 2026 17:05:40 -0400
+Subject: [PATCH] ipa: simple: agc: Judge only frames taken with the last
+ request
+
+Outdoors the Google Pixel 7 Pro's camera preview strobed between white
+and black, and photos came out blown out. The AGC judged every frame,
+including the frames taken before its last exposure and gain request had
+taken effect, and it based each new request on the values the pipeline
+reports for the frame. When the sensor applies its controls a frame
+later than the pipeline models (or the request changes in large steps
+while the histogram is pinned at an end), the loop corrected the same
+error several times over and oscillated between a white and a black
+picture. A simulation of the loop with the sensor a frame slower than
+modelled reproduces it: in a scene 150 times brighter than a room the
+mean sample value swings between 1.0 and 5.0 for good.
+
+Now the AGC keeps requesting the same values until a frame shows them,
+waits one frame more, and only then judges the exposure again; a request
+that never shows (the sensor clamped or rounded it) is taken as applied
+after eight frames. The correction applies to the total exposure (time,
+analogue gain, digital gain) and is distributed exposure first, so going
+down the gains come off before the exposure shortens, in one step
+rather than one stage per frame. A pinned histogram moves it by x8 or
+1/16 in one decisive step. In the simulation, with the sensor's delay as
+modelled or a frame longer, a change from a room to a 150 times brighter
+scene settles in about 13 frames, and steady bright and bright-to-dark
+scenes settle without oscillating.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ src/ipa/simple/algorithms/agc.cpp | 133 +++++++++++++++++-------------
+ src/ipa/simple/ipa_context.h      |   4 +
+ 2 files changed, 78 insertions(+), 59 deletions(-)
+
+diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
+index 512888b..82d8c46 100644
+--- a/src/ipa/simple/algorithms/agc.cpp
++++ b/src/ipa/simple/algorithms/agc.cpp
+@@ -73,17 +73,29 @@ static constexpr float kExpMaxStep = 0.15;
+ /*
+  * A histogram pinned at one end (nearly everything in the darkest or the
+  * brightest bin) says only "much too dark" or "much too bright", not by how
+- * much, and the bounded steps above then take seconds to get out: from a
+- * camera's starting exposure in a dim room, the front camera of a phone
+- * took several seconds to brighten. Step by these factors until the
+- * histogram moves off the end. The sensor's control delay limits the
+- * overshoot to about one more step, which the proportional loop then
+- * takes back.
++ * much. Change the total exposure by these factors then, in one step, and
++ * only judge again once the change has shown (see updateExposure()).
+  */
+ static constexpr double kExposurePinnedDark = 1.05;
+ static constexpr double kExposurePinnedBright = kExposureBinsCount - 0.05;
+-static constexpr float kExpPinnedUp = 2.0;
+-static constexpr float kExpPinnedDown = 0.5;
++static constexpr double kExpPinnedUp = 8.0;
++static constexpr double kExpPinnedDown = 1.0 / 16.0;
++
++/*
++ * Frames to wait after the sensor reports the last request as applied
++ * before judging the exposure again: the reported values come from the
++ * pipeline's model of the sensor's control delay, and a sensor that takes
++ * a frame longer otherwise makes the loop act on stale pictures and
++ * oscillate.
++ */
++static constexpr unsigned int kExpSettleFrames = 1;
++
++/*
++ * A request that hasn't shown after this many frames (the sensor clamped
++ * it, or rounded the gain to a code further off than the tolerance) is
++ * taken as applied with the values the sensor reports.
++ */
++static constexpr unsigned int kExpPendingMaxFrames = 8;
+ 
+ /*
+  * Low light. Once the exposure and the sensor's analogue gain are both at
+@@ -102,6 +114,8 @@ int Agc::configure(IPAContext &context,
+ 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
+ {
+ 	context.activeState.agc.digitalGain = 1.0;
++	context.activeState.agc.settleFrames = 0;
++	context.activeState.agc.pendingFrames = 0;
+ 
+ 	return 0;
+ }
+@@ -111,73 +125,74 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ {
+ 	int32_t &exposure = frameContext.sensor.exposure;
+ 	double &again = frameContext.sensor.gain;
++	auto &agc = context.activeState.agc;
++	const auto &cfg = context.configuration.agc;
++	double &dgain = agc.digitalGain;
++
+ 	/*
+-	 * Compare consecutive requested values, not the delayed sensor values in
+-	 * this frame context. At a control limit the latter can trail the active
+-	 * request and would keep resetting AE stability indefinitely.
++	 * Judge a frame only once it was taken with the last request: the
++	 * sensor applies a new exposure and gain some frames after they are
++	 * written. Until then keep requesting the same values (the controls
++	 * written for this frame are frameContext.sensor's), and wait one
++	 * frame more in case the sensor is slower than the pipeline assumes.
++	 * Acting on the frames in between made the loop overshoot and, with
++	 * large steps, oscillate between a black and a white picture.
+ 	 */
+-	const int32_t oldExposure = context.activeState.agc.exposure;
+-	const double oldAgain = context.activeState.agc.again;
+-	double &dgain = context.activeState.agc.digitalGain;
+-	const double oldDgain = dgain;
++	const bool pending = exposure != agc.exposure ||
++			     std::abs(again - agc.again) > 0.05 * agc.again;
++	if (pending && agc.pendingFrames < kExpPendingMaxFrames) {
++		agc.pendingFrames++;
++		exposure = agc.exposure;
++		again = agc.again;
++		agc.settleFrames = kExpSettleFrames;
++		return false;
++	}
++	agc.pendingFrames = 0;
++	if (agc.settleFrames) {
++		agc.settleFrames--;
++		return false;
++	}
+ 
+ 	double error = kExposureOptimal - exposureMSV;
+-
+ 	if (std::abs(error) <= kExposureSatisfactory)
+ 		return false;
+ 
+ 	/*
+-	 * Compute a proportional correction factor. The sign of the error
+-	 * determines the direction: positive error means too dark (increase),
+-	 * negative means too bright (decrease).
++	 * The correction applies to the total exposure (time x analogue gain
++	 * x digital gain): a proportional step near the target, larger far
++	 * from it, and a decisive one while the histogram is pinned at an end.
+ 	 */
+-	float gain = std::abs(error) > kExpFarError ? kExpProportionalGainFar
+-						    : kExpProportionalGain;
+-	float step = std::clamp(static_cast<float>(error) * gain,
+-				-kExpMaxStep, kExpMaxStep);
+-	float factor = 1.0f + step;
++	double factor;
+ 	if (exposureMSV <= kExposurePinnedDark)
+ 		factor = kExpPinnedUp;
+ 	else if (exposureMSV >= kExposurePinnedBright)
+ 		factor = kExpPinnedDown;
+-
+-	if (factor > 1.0f) {
+-		/* Scene too dark: increase exposure first, then gain. */
+-		if (exposure < context.configuration.agc.exposureMax) {
+-			int32_t next = static_cast<int32_t>(exposure * factor);
+-			exposure = std::max(next, exposure + 1);
+-		} else if (again < context.configuration.agc.againMax) {
+-			double next = again * factor;
+-			if (next - again < context.configuration.agc.againMinStep)
+-				again += context.configuration.agc.againMinStep;
+-			else
+-				again = next;
+-		} else {
+-			dgain = std::min(dgain * factor, kMaxDigitalGain);
+-		}
+-	} else {
+-		/* Scene too bright: decrease gain first, then exposure. */
+-		if (dgain > 1.0) {
+-			dgain = std::max(dgain * factor, 1.0);
+-		} else if (again > context.configuration.agc.again10) {
+-			double next = again * factor;
+-			if (again - next < context.configuration.agc.againMinStep)
+-				again -= context.configuration.agc.againMinStep;
+-			else
+-				again = next;
+-		} else {
+-			int32_t next = static_cast<int32_t>(exposure * factor);
+-			exposure = std::min(next, exposure - 1);
+-		}
++	else {
++		float gain = std::abs(error) > kExpFarError ? kExpProportionalGainFar
++							    : kExpProportionalGain;
++		factor = 1.0 + std::clamp(static_cast<float>(error) * gain * 2,
++					  -kExpMaxStep * 2, kExpMaxStep * 2);
+ 	}
+ 
+-	exposure = std::clamp(exposure, context.configuration.agc.exposureMin,
+-			      context.configuration.agc.exposureMax);
+-	again = std::clamp(again, context.configuration.agc.againMin,
+-			   context.configuration.agc.againMax);
++	/*
++	 * Distribute it: exposure time first (up to its limit), then the
++	 * sensor's analogue gain, then digital gain. Going down, that takes
++	 * the gains off before shortening the exposure.
++	 */
++	const double total = static_cast<double>(exposure) * again * dgain * factor;
++	const int32_t oldExposure = exposure;
++	const double oldAgain = again;
++	const double oldDgain = dgain;
+ 
+-	context.activeState.agc.exposure = exposure;
+-	context.activeState.agc.again = again;
++	exposure = std::clamp(static_cast<int32_t>(std::lround(total / cfg.again10)),
++			      cfg.exposureMin, cfg.exposureMax);
++	double rest = total / exposure;
++	again = std::clamp(rest, cfg.againMin, cfg.againMax);
++	rest /= again;
++	dgain = std::clamp(rest, 1.0, kMaxDigitalGain);
++
++	agc.exposure = exposure;
++	agc.again = again;
+ 
+ 	LOG(IPASoftExposure, Debug)
+ 		<< "exposureMSV " << exposureMSV
+diff --git a/src/ipa/simple/ipa_context.h b/src/ipa/simple/ipa_context.h
+index b60c994..d490848 100644
+--- a/src/ipa/simple/ipa_context.h
++++ b/src/ipa/simple/ipa_context.h
+@@ -49,6 +49,10 @@ struct IPAActiveState {
+ 		/* Applied by the image processor, past the sensor's limits. */
+ 		double digitalGain;
+ 		unsigned int stableSamples;
++		/* Frames to wait once the last request shows in the sensor values. */
++		unsigned int settleFrames;
++		/* Frames the last request has been waiting to show. */
++		unsigned int pendingFrames;
+ 		bool valid;
+ 	} agc;
+ 
+-- 
+2.55.0
+
diff --git a/package/libcamera/0018-ipa-simple-Carry-the-exposure-over-to-another-mode-o.patch b/package/libcamera/0018-ipa-simple-Carry-the-exposure-over-to-another-mode-o.patch
new file mode 100644
index 0000000..9482126
--- /dev/null
+++ b/package/libcamera/0018-ipa-simple-Carry-the-exposure-over-to-another-mode-o.patch
@@ -0,0 +1,65 @@
+From a0429ac3ad69ca1fbe9410d3a5644a7076abab7b Mon Sep 17 00:00:00 2001
+From: Derek Ross <derekross@gmail.com>
+Date: Wed, 14 Oct 2026 17:06:38 -0400
+Subject: [PATCH] ipa: simple: Carry the exposure over to another mode of the
+ same sensor
+
+A new configuration keeps the AGC and AWB state only when the line
+duration and exposure limits are unchanged. A camera app that takes its
+full-resolution still from a binned preview switches sensor mode, so the
+still started over from the sensor's values: on the Google Pixel 7 Pro
+the sensor driver resets the exposure to the new mode's longest, and
+outdoor stills came out at 1/19 s and blown out.
+
+When the mode differs, keep the converged exposure in time and gain
+rather than in lines: convert it to the new line duration, put the rest
+into analogue and then digital gain, and keep the white balance.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ src/ipa/simple/soft_simple.cpp | 29 +++++++++++++++++++++++++++++
+ 1 file changed, 29 insertions(+)
+
+diff --git a/src/ipa/simple/soft_simple.cpp b/src/ipa/simple/soft_simple.cpp
+index fabb7bc..fdee9d3 100644
+--- a/src/ipa/simple/soft_simple.cpp
++++ b/src/ipa/simple/soft_simple.cpp
+@@ -282,6 +282,35 @@ int IPASoftSimple::configure(const IPAConfigInfo &configInfo)
+ 		context_.activeState.agc = previousAgc;
+ 		context_.activeState.awb = previousAwb;
+ 		LOG(IPASoft, Debug) << "Keeping exposure and white balance";
++	} else if (previousAgc.valid && previousLineDuration.get<std::nano>() > 0 &&
++		   context_.configuration.agc.lineDuration.get<std::nano>() > 0) {
++		/*
++		 * Another sensor mode of the same camera, such as a full-resolution
++		 * still taken from a binned preview: keep the converged exposure
++		 * in time and gain rather than in lines, and the white balance.
++		 * Starting over from the sensor's values exposed the first still
++		 * frames for as long as the new mode allows, which blew them out
++		 * outdoors.
++		 */
++		auto &agc = context_.activeState.agc;
++		const auto &cfg = context_.configuration.agc;
++		const double time = previousAgc.exposure * previousLineDuration.get<std::nano>();
++		const double total = time * previousAgc.again * previousAgc.digitalGain;
++		const double line = cfg.lineDuration.get<std::nano>();
++
++		agc = previousAgc;
++		agc.exposure = std::clamp(static_cast<int32_t>(std::lround(time / line)),
++					  cfg.exposureMin, cfg.exposureMax);
++		double rest = total / (agc.exposure * line);
++		agc.again = std::clamp(rest, cfg.againMin, cfg.againMax);
++		rest /= agc.again;
++		agc.digitalGain = std::clamp(rest, 1.0, 4.0);
++		agc.settleFrames = 0;
++		agc.pendingFrames = 0;
++		context_.activeState.awb = previousAwb;
++		LOG(IPASoft, Debug)
++			<< "Carrying exposure over to the new mode: " << agc.exposure
++			<< " lines, gain " << agc.again << ", digital gain " << agc.digitalGain;
+ 	}
+ 
+ 	/*
+-- 
+2.55.0
+
diff --git a/package/libcamera/0019-ipa-simple-agc-Report-the-AE-state.patch b/package/libcamera/0019-ipa-simple-agc-Report-the-AE-state.patch
new file mode 100644
index 0000000..007ab2c
--- /dev/null
+++ b/package/libcamera/0019-ipa-simple-agc-Report-the-AE-state.patch
@@ -0,0 +1,115 @@
+From e81e9031242c85767b1431d1f0ca8c4dc838e725 Mon Sep 17 00:00:00 2001
+From: Derek Ross <derekross@gmail.com>
+Date: Wed, 14 Oct 2026 17:34:02 -0400
+Subject: [PATCH 19/26] ipa: simple: agc: Report the AE state
+
+Applications need to know when the exposure has settled, for instance
+to take a still only once the loop has caught up with a change of
+scene. Report AeState: searching while a request is waiting to show in
+the sensor's values or the loop is still stepping, converged once the
+histogram is within the target's hysteresis, or when every exposure
+and gain limit has been reached so that nothing is left to change.
+
+Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
+---
+ src/ipa/simple/algorithms/agc.cpp | 21 +++++++++++++++++++--
+ src/ipa/simple/ipa_context.h      |  2 ++
+ src/ipa/simple/soft_simple.cpp    |  1 +
+ 3 files changed, 22 insertions(+), 2 deletions(-)
+
+diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
+index 82d8c46..2369dfd 100644
+--- a/src/ipa/simple/algorithms/agc.cpp
++++ b/src/ipa/simple/algorithms/agc.cpp
+@@ -116,6 +116,7 @@ int Agc::configure(IPAContext &context,
+ 	context.activeState.agc.digitalGain = 1.0;
+ 	context.activeState.agc.settleFrames = 0;
+ 	context.activeState.agc.pendingFrames = 0;
++	context.activeState.agc.state = controls::AeStateSearching;
+ 
+ 	return 0;
+ }
+@@ -145,6 +146,7 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ 		exposure = agc.exposure;
+ 		again = agc.again;
+ 		agc.settleFrames = kExpSettleFrames;
++		agc.state = controls::AeStateSearching;
+ 		return false;
+ 	}
+ 	agc.pendingFrames = 0;
+@@ -154,8 +156,10 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ 	}
+ 
+ 	double error = kExposureOptimal - exposureMSV;
+-	if (std::abs(error) <= kExposureSatisfactory)
++	if (std::abs(error) <= kExposureSatisfactory) {
++		agc.state = controls::AeStateConverged;
+ 		return false;
++	}
+ 
+ 	/*
+ 	 * The correction applies to the total exposure (time x analogue gain
+@@ -200,7 +204,17 @@ bool Agc::updateExposure(IPAContext &context, IPAFrameContext &frameContext,
+ 		<< " exp " << exposure << " again " << again
+ 		<< " dgain " << dgain;
+ 
+-	return exposure != oldExposure || again != oldAgain || dgain != oldDgain;
++	const bool changed = exposure != oldExposure || again != oldAgain ||
++			     dgain != oldDgain;
++	/*
++	 * Nothing left to change (every limit reached) counts as converged,
++	 * so that an application waiting for the exposure to settle doesn't
++	 * wait forever in a very dark or very bright scene.

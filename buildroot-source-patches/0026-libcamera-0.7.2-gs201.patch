+ 
+ #include "libcamera/internal/matrix.h"
+@@ -25,6 +26,11 @@ struct DebayerParams {
+ 	float gamma = 1.0;
+ 	float contrastExp = 1.0;
+ 	RGB<float> gains = RGB<float>({ 1.0, 1.0, 1.0 });
++	/*
++	 * The window for autofocus and spot metering statistics, as x, y,
++	 * width and height in fractions of the statistics window.
++	 */
++	std::array<float, 4> focusWindow = { 0.25f, 0.25f, 0.5f, 0.5f };
+ };
+ 
+ } /* namespace libcamera */
+diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
